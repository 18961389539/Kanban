<Project>
  <!-- 【本地调试构建适配 · 临时】原为：
         <Sdk Name="DotNet.ReproducibleBuilds.Isolated" Version="1.1.1" />
       该 SDK 由 NuGet SDK 解析器加载，依赖可用的 NuGet 设置（APPDATA/ProgramData）。
       在受限 shell / 无 NuGet 设置的沙箱里会报 MSB4236「Failed to load NuGet settings」，
       导致整棵 oxyplot 子树无法求值、拖垮 MainAPP 构建。下次改动可恢复此行。 -->
  <!-- <Sdk Name="DotNet.ReproducibleBuilds.Isolated" Version="1.1.1" /> -->
  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" Version="1.1.1" PrivateAssets="All"/>
  </ItemGroup>
  <PropertyGroup>
    <!-- Kanban 仓库根目录开启 Central Package Management；OxyPlot 源码自带 Version 属性，
         关闭本子树中心管理避免 NU1008（本地源码集成适配，勿删） -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <!-- OxyPlot 源码自带手写 Properties/AssemblyInfo.cs（版本特性）；
         官方 CI 由 GitVersion 自动关闭 SDK 生成，本地集成需显式关闭，否则 CS0579 特性重复 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 同 Kanban 根：排除 obj*/bin* 中间目录（本地集成可能产生 obj_fresh 等重定向目录） -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj*/**;**/bin*/**</DefaultItemExcludes>
    <Copyright>Copyright (c) 2014-2022 OxyPlot Contributors</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/oxyplot/oxyplot.git</RepositoryUrl>
    <!-- 此源码树嵌在无远程 Kanban 工作树中，避免本地构建生成空 SourceLink 映射。 -->
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>