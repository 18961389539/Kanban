{
  "platformOptions": {
    "Coverlet": {
      "format": "cobertura",
      "exclude": "[*]*.Migrations.*,[*]*Tests*,[*]*.AutoGenerated.*,[*]LicenseManager.App.*,[*]LicenseIssuer.CLI.*,[*]MainAPP.Benchmarks.*,[*]MainAPP.E2E.*,[*]MainAPP.UIAutomation.*",
      "excludeByAttribute": "ExcludeFromCodeCoverageAttribute,CompilerGeneratedAttribute,GeneratedCodeAttribute",
      "excludeByFile": "**/obj/**,**/bin/**,**/*.g.cs,**/*.AssemblyInfo.cs",
      "useSourceLink": true,
      "singleHit": false,
      "includeTestAssembly": false
    }
  }
}
