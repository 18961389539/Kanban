<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Kanban.Client</RootNamespace>
    <AssemblyName>Kanban.Client</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SignalR 客户端：优先 MessagePack，同时注册 JSON 供旧 Collector 协商回退 -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kanban.Contracts\Kanban.Contracts.csproj" />
  </ItemGroup>

</Project>
