<Window x:Class="LicenseIssuer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="激活码签发工具"
        Width="620"
        Height="540"
        MinWidth="540"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=MachineCodeBox}"
        Background="#0E1116"
        Foreground="#E5E7EB"
        FontFamily="Segoe UI, Microsoft YaHei, sans-serif">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4F8CFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#212834" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2A323F" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="激活码签发" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="粘贴客户提供的机器码，生成激活码后发给客户" FontSize="12" Foreground="#8B92A0" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 机器码 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="机器码（8 位，A-Z 与 2-7）" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="MachineCodeBox"
                     FontSize="16"
                     Padding="10,8"
                     CharacterCasing="Upper"
                     Background="#1A2029"
                     Foreground="#E5E7EB"
                     BorderBrush="#2A323F"
                     BorderThickness="1" />
        </StackPanel>

        <!-- 授权类型 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="授权类型" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="PermanentCheckBox"
                          Content="永久授权"
                          FontSize="13"
                          Foreground="#E5E7EB"
                          Checked="PermanentCheckBox_Changed"
                          Unchecked="PermanentCheckBox_Changed" />
                <DatePicker x:Name="ExpirePicker"
                            Margin="16,0,0,0"
                            Width="160"
                            Background="#1A2029"
                            Foreground="#E5E7EB"
                            BorderBrush="#2A323F" />
                <TextBlock x:Name="ExpireHint"
                           Text="（到期日，按 UTC）"
                           FontSize="11"
                           Foreground="#8B92A0"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 生成按钮 -->
        <Button Grid.Row="3"
                Content="生成激活码"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left"
                Margin="0,0,0,14"
                Click="Generate_Click" />

        <!-- 激活码输出 -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="激活码" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ActivationCodeBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         FontSize="18"
                         FontFamily="Consolas, Courier New, monospace"
                         Padding="10,8"
                         VerticalContentAlignment="Center"
                         Background="#141A22"
                         Foreground="#34D399"
                         BorderBrush="#2A323F"
                         BorderThickness="1" />
                <Button x:Name="CopyButton"
                        Grid.Column="1"
                        Content="复制"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="Copy_Click" />
            </Grid>
        </StackPanel>

        <!-- 状态 -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="5"
                   FontSize="12"
                   Foreground="#8B92A0"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />
    </Grid>
</Window>
