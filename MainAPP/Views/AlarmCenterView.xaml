<UserControl
    x:Class="MainAPP.Views.AlarmCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:AlarmCenterViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1400"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshAllCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- KPI 紧凑单元格样式 -->
        <Style x:Key="KpiCell" TargetType="Border" BasedOn="{StaticResource InnerCard}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock" BasedOn="{StaticResource KpiLabel}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValueMd}" />
        <Style x:Key="AlarmEventText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EventType}" Value="Triggered">
                    <Setter Property="Foreground" Value="{StaticResource StatusAlarmBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EventType}" Value="Recovered">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EventType}" Value="ShiftChange">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActiveAlarmCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="High">
                    <Setter Property="Background" Value="{StaticResource StatusAlarmSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StatusAlarmBrush}" />
                    <Setter Property="BorderThickness" Value="1,1,3,1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Medium">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                    <Setter Property="BorderThickness" Value="1,1,2,1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 级别筛选 ToggleButton 样式 -->
        <Style x:Key="LevelFilterChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- 时间范围切换按钮（RadioButton 模拟分段按钮，GroupName 互斥） -->
        <Style x:Key="TimeRangeTab" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ 标题栏 + 时间范围切换 ============  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <materialIcons:MaterialIcon
                    Style="{StaticResource PageTitleIcon}" Kind="BellAlert" />
                <TextBlock
                    Style="{StaticResource PageTitleText}"
                    Margin="10,0,0,0" Text="{x:Static resources:Strings.K122}" />
                <!-- 最后刷新时间 -->
                <TextBlock
                    Margin="16,0,0,0" VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeCaption}"
                    Foreground="{StaticResource ThirdlyTextBrush}"
                    Text="{Binding LastUpdateTime, StringFormat=最后刷新 {0:HH:mm:ss}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <ComboBox Width="150" Margin="0,0,8,0" VerticalContentAlignment="Center"
                          ItemsSource="{Binding DeviceFilterItems}" DisplayMemberPath="Name"
                          SelectedValue="{Binding SelectedDeviceId}" SelectedValuePath="Id"
                          ToolTip="{x:Static resources:Strings.K024}" />
                <Button Content="{x:Static resources:Strings.K004}" Padding="8,3" Margin="0,0,8,0"
                    Command="{Binding ClearDeviceFilterCommand}" ToolTip="{x:Static resources:Strings.K123}" />
                <TextBox Width="170" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         Text="{Binding AlarmSearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static resources:Strings.K124}" />
                <!-- 时间范围切换（RadioButton 互斥，双向绑定 IsXxx 派生属性） -->
                <RadioButton GroupName="TimeRange"
                    AutomationProperties.Name="{x:Static resources:Strings.K042}"
                    IsChecked="{Binding IsHour1}"
                    Style="{StaticResource TimeRangeTab}"
                    Content="{x:Static resources:Strings.K042}" />
                <RadioButton GroupName="TimeRange"
                    AutomationProperties.Name="{x:Static resources:Strings.K043}"
                    IsChecked="{Binding IsHours4}"
                    Style="{StaticResource TimeRangeTab}"
                    Content="{x:Static resources:Strings.K043}" />
                <RadioButton GroupName="TimeRange"
                    AutomationProperties.Name="{x:Static resources:Strings.K025}"
                    IsChecked="{Binding IsHours24}"
                    Style="{StaticResource TimeRangeTab}"
                    Margin="0,0,12,0"
                    Content="{x:Static resources:Strings.K025}" />
                <!-- 刷新按钮 -->
                <Button
                    Command="{Binding RefreshAllCommand}"
                    Style="{StaticResource IconButtonPrimary}"
                    Tag="{x:Static mi:MaterialIconKind.Refresh}"
                    Content="{x:Static resources:Strings.K015}"
                    ToolTip="{x:Static resources:Strings.K044}" />
            </StackPanel>
        </DockPanel>

        <!--  ============ 主体内容 ============  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- KPI 条 -->
                <RowDefinition Height="Auto" />
                <!-- 双栏列表 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ─── KPI 条（6 格）───  -->
            <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,12">
                <!-- 活跃报警数 -->
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K125}" />
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ActiveCount}" />
                    </StackPanel>
                </Border>
                <!-- 今日触发 -->
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K126}" />
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TodayTriggerCount}" />
                    </StackPanel>
                </Border>
                <!-- 今日恢复 -->
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K127}" />
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TodayRecoverCount}" />
                    </StackPanel>
                </Border>
                <!-- 最长持续 -->
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K128}" />
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding LongestDurationText}" />
                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="{Binding LongestAlarmText}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LongestAlarmText}" />
                    </StackPanel>
                </Border>
                <!-- 影响设备数 -->
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K129}" />
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding AffectedDeviceCount}" />
                    </StackPanel>
                </Border>
                <!-- 最频繁报警 -->
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K130}" />
                        <TextBlock Style="{StaticResource KpiValue}" FontSize="16"
                                   Text="{Binding MostFrequentAlarm}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding MostFrequentAlarm}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--  ─── 双栏：左活跃报警 + 右事件流/Top ───  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ═══ 左栏：实时活跃报警（左侧红色装饰条区分"需处理"vs 右栏"仅记录"） ═══  -->
                <Border Grid.Column="0" Style="{StaticResource MainCard}" Padding="0"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="3,0,0,0">
                    <DockPanel>
                        <!-- 标题行 + 级别筛选 -->
                        <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Border Style="{StaticResource ChartCardTitleBar}" />
                                <TextBlock Style="{StaticResource SectionTitleText}" Margin="8,0,0,0" Text="{x:Static resources:Strings.K045}" />
                                <!-- 活跃计数徽章 -->
                                <Border Margin="8,0,0,0" Padding="8,1" CornerRadius="10"
                                        Background="{StaticResource DangerBrush}">
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="White"
                                               Text="{Binding ActiveCount}" />
                                </Border>
                            </StackPanel>
                            <!-- 级别筛选 chips -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton Style="{StaticResource LevelFilterChip}"
                                    IsChecked="{Binding ShowHighAlarms}" Content="{x:Static resources:Strings.K131}" />
                                <ToggleButton Style="{StaticResource LevelFilterChip}"
                                    IsChecked="{Binding ShowMediumAlarms}" Content="{x:Static resources:Strings.K132}" />
                                <ToggleButton Style="{StaticResource LevelFilterChip}"
                                    IsChecked="{Binding ShowLowAlarms}" Content="{x:Static resources:Strings.K133}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- 活跃报警列表 -->
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                <ItemsControl ItemsSource="{Binding ActiveAlarms}"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                                              AutomationProperties.Name="{x:Static resources:Strings.K134}">
                                    <!-- 显式设置 ItemsPanel 为 VirtualizingStackPanel，否则默认 StackPanel 不虚拟化 -->
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                                    <Border Margin="16,0,16,8" Padding="12,10" CornerRadius="6"
                                                        Style="{StaticResource ActiveAlarmCard}">
                                                <DockPanel>
                                                    <!-- 左侧级别色条 -->
                                                    <Border DockPanel.Dock="Left" Width="4" Margin="0,0,10,0"
                                                            CornerRadius="2"
                                                            Background="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}" />
                                                    <!-- 右侧持续时间 -->
                                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text="{Binding DurationText}" />
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialIcons:MaterialIcon Width="16" Height="16"
                                                                VerticalAlignment="Center"
                                                                Foreground="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}">
                                                                <materialIcons:MaterialIcon.Style>
                                                                    <Style TargetType="materialIcons:MaterialIcon">
                                                                        <Setter Property="Kind" Value="AlertCircleOutline" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Count">
                                                                                <Setter Property="Kind" Value="Counter" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="High">
                                                                                <Setter Property="Kind" Value="AlertOctagon" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="Medium">
                                                                                <Setter Property="Kind" Value="Alert" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialIcons:MaterialIcon.Style>
                                                            </materialIcons:MaterialIcon>
                                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       Text="{Binding AlarmName}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding AlarmName}" />
                                                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="8"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}">
                                                                <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="White"
                                                                           Text="{Binding Level, Converter={StaticResource AlarmLevelToTextConverter}}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="24,4,0,0">
                                                            <TextBlock FontSize="13" Foreground="{StaticResource ThirdlyTextBrush}"
                                                                       Text="{Binding EventTime, StringFormat={}{0:HH:mm:ss}}" />
                                                            <TextBlock Margin="10,0,0,0" FontSize="13"
                                                                       Foreground="{StaticResource ThirdlyTextBrush}"
                                                                       Text="{Binding DeviceName}" />
                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Margin="24,6,0,0">
                                                                            <Button Content="{x:Static resources:Strings.K026}" Padding="6,2" Margin="0,0,6,0"
                                                                                Command="{Binding DataContext.CopyAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}" ToolTip="{x:Static resources:Strings.K135}" />
                                                                            <Button Content="{x:Static resources:Strings.K136}" Padding="6,2"
                                                                                Command="{Binding DataContext.ViewAlarmHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}" ToolTip="{x:Static resources:Strings.K137}" />
                                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- 空状态 -->
                            <controls:EmptyState
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IconKind="ShieldCheckOutline"
                                Message="{Binding ActiveEmptyStateMessage}">
                                <controls:EmptyState.Style>
                                    <Style TargetType="controls:EmptyState">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveAlarms.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:EmptyState.Style>
                            </controls:EmptyState>
                        </Grid>
                    </DockPanel>
                </Border>

                <!--  ═══ 右栏：事件流 + Top 排行 ═══  -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <!-- 最近事件流 -->
                    <Border Grid.Row="0" Style="{StaticResource MainCard}" Padding="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                                <Border Style="{StaticResource ChartCardTitleBar}" />
                                <TextBlock Style="{StaticResource SectionTitleText}" Margin="8,0,0,0" Text="{x:Static resources:Strings.K046}" />
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                <ItemsControl ItemsSource="{Binding RecentEvents}"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                                              AutomationProperties.Name="{x:Static resources:Strings.K046}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="16,0,16,6" Padding="10,8" CornerRadius="4"
                                                    Background="{StaticResource SecondaryRegionBrush}">
                                                <DockPanel>
                                                    <!-- 事件类型图标 -->
                                                    <materialIcons:MaterialIcon Width="14" Height="14"
                                                        DockPanel.Dock="Left" Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}">
                                                        <materialIcons:MaterialIcon.Style>
                                                            <Style TargetType="materialIcons:MaterialIcon">
                                                                <Setter Property="Kind" Value="BellRingOutline" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EventType}" Value="Recovered">
                                                                        <Setter Property="Kind" Value="CheckCircleOutline" />
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EventType}" Value="ShiftChange">
                                                                        <Setter Property="Kind" Value="SwapHorizontal" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialIcons:MaterialIcon.Style>
                                                    </materialIcons:MaterialIcon>
                                                    <!-- 右侧时间 -->
                                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               Foreground="{StaticResource ThirdlyTextBrush}"
                                                               Text="{Binding EventTime, StringFormat={}{0:MM-dd HH:mm:ss}}" />
                                                    <StackPanel>
                                                                                     <TextBlock FontSize="13" FontWeight="Medium"
                                                                                         Foreground="{StaticResource PrimaryTextBrush}"
                                                                   Text="{Binding AlarmName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding AlarmName}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock FontSize="12" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding DeviceName}" />
                                                            <TextBlock Margin="8,0,0,0" Style="{StaticResource AlarmEventText}"
                                                                       Text="{Binding EventType, Converter={StaticResource EventTypeToTextConverter}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Top 报警排行 -->
                    <Border Grid.Row="2" Style="{StaticResource MainCard}" Padding="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                                <Border Style="{StaticResource ChartCardTitleBar}" />
                                <TextBlock Style="{StaticResource SectionTitleText}" Margin="8,0,0,0" Text="{x:Static resources:Strings.K138}" />
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                <ItemsControl ItemsSource="{Binding TopAlarms}"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                                              AutomationProperties.Name="{x:Static resources:Strings.K139}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="16,0,16,4" VerticalAlignment="Center">
                                                <!-- 排名 -->
                                                <TextBlock DockPanel.Dock="Left" Width="24" TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           Text="{Binding Rank}" />
                                                <!-- 级别色点 -->
                                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="4,0,8,0"
                                                         Fill="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}" />
                                                <!-- 触发次数 -->
                                                <Border DockPanel.Dock="Right" Padding="8,1" CornerRadius="8"
                                                        Background="{StaticResource SecondaryRegionBrush}">
                                                    <TextBlock FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text="{Binding TotalDurationText}" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock FontSize="13" FontWeight="Medium"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               Text="{Binding AlarmName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding AlarmName}" />
                                                    <TextBlock FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}"
                                                               Text="{Binding DeviceName}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
