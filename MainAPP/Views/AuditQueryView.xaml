<UserControl
    x:Class="MainAPP.Views.AuditQueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:resources="clr-namespace:MainAPP.Resources"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  时间预设 chip：单选分段按钮风格（同工单状态筛选），选中时主色填充  -->
        <Style x:Key="AuditPresetChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  审计行样式：失败记录整行浅红高亮（BasedOn 统一看板行样式）  -->
        <Style x:Key="AuditRow" TargetType="DataGridRow" BasedOn="{StaticResource KanbanDataGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Succeeded}" Value="False">
                    <Setter Property="Background" Value="{StaticResource StatusAlarmSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock
                    FontSize="{DynamicResource FontSizePageTitle}"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{x:Static resources:Strings.Nav_Audit}" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="{DynamicResource FontSizeHint}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{x:Static resources:Strings.K613}" />
            </StackPanel>
            <Border
                Padding="10,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{StaticResource PrimarySoftBrush}"
                CornerRadius="14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="{DynamicResource FontSizeHint}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{x:Static resources:Strings.K639}" />
                    <TextBlock Margin="8,0,0,0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource PrimaryBrush}" Text="{Binding Total}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 汇总统计 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="12" Background="{StaticResource SecondaryRegionBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K640}" /><TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Total}" /></StackPanel></Border>
            <Border Grid.Column="2" Padding="12" Background="{StaticResource SecondaryRegionBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K641}" /><TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Text="{Binding PageSucceeded}" /></StackPanel></Border>
            <Border Grid.Column="4" Padding="12" Background="{StaticResource SecondaryRegionBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K642}" /><TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Text="{Binding PageFailed}" /></StackPanel></Border>
            <Border Grid.Column="6" Padding="12" Background="{StaticResource SecondaryRegionBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K643}" /><TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding PageSuccessRateDisplay}" /></StackPanel></Border>
        </Grid>

        <!--  过滤区  -->
        <Border
            Grid.Row="4"
            Padding="12"
            Background="{StaticResource SecondaryRegionBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeHint}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{x:Static resources:Strings.K614}" />
                <RadioButton
                    GroupName="AuditPreset"
                    Click="OnPresetChipClick"
                    Content="{x:Static resources:Strings.K644}"
                    Style="{StaticResource AuditPresetChip}"
                    Tag="1">
                    <RadioButton.IsChecked>
                        <Binding
                            Converter="{StaticResource EqualityConverter}"
                            ConverterParameter="1"
                            Mode="OneWay"
                            Path="PresetIndex" />
                    </RadioButton.IsChecked>
                </RadioButton>
                <RadioButton
                    GroupName="AuditPreset"
                    Click="OnPresetChipClick"
                    Content="{x:Static resources:Strings.K645}"
                    Style="{StaticResource AuditPresetChip}"
                    Tag="2">
                    <RadioButton.IsChecked>
                        <Binding
                            Converter="{StaticResource EqualityConverter}"
                            ConverterParameter="2"
                            Mode="OneWay"
                            Path="PresetIndex" />
                    </RadioButton.IsChecked>
                </RadioButton>
                <RadioButton
                    GroupName="AuditPreset"
                    Click="OnPresetChipClick"
                    Content="{x:Static resources:Strings.K646}"
                    Style="{StaticResource AuditPresetChip}"
                    Tag="3">
                    <RadioButton.IsChecked>
                        <Binding
                            Converter="{StaticResource EqualityConverter}"
                            ConverterParameter="3"
                            Mode="OneWay"
                            Path="PresetIndex" />
                    </RadioButton.IsChecked>
                </RadioButton>
                <RadioButton
                    GroupName="AuditPreset"
                    Click="OnPresetChipClick"
                    Content="{x:Static resources:Strings.K647}"
                    Style="{StaticResource AuditPresetChip}"
                    Tag="4">
                    <RadioButton.IsChecked>
                        <Binding
                            Converter="{StaticResource EqualityConverter}"
                            ConverterParameter="4"
                            Mode="OneWay"
                            Path="PresetIndex" />
                    </RadioButton.IsChecked>
                </RadioButton>
                <DatePicker
                    Margin="10,0,0,0"
                    Width="130"
                    SelectedDate="{Binding From}" />
                <TextBlock
                    Margin="8,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeHint}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="~" />
                <DatePicker
                    Width="130"
                    SelectedDate="{Binding To}" />

                <TextBlock
                    Margin="16,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeHint}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{x:Static resources:Strings.K615}" />
                <hc:TextBox
                    Width="120"
                    VerticalContentAlignment="Center"
                    Text="{Binding OperatorFilter, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Margin="16,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeHint}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{x:Static resources:Strings.K616}" />
                <hc:TextBox
                    Width="130"
                    VerticalContentAlignment="Center"
                    Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Margin="16,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeHint}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{x:Static resources:Strings.K619}" />
                <!--  显式套 ComboBoxExtend 系样式；裸 ComboBox 会回落到 HandyControl 默认浅色样式，
                      与本页深色底形成「浅底近白字」的低对比度。  -->
                <ComboBox
                    Width="90"
                    Style="{StaticResource ComboBoxExtend.Small}"
                    SelectedIndex="{Binding ResultFilterIndex}">
                    <ComboBoxItem Content="{x:Static resources:Strings.K004}" />
                    <ComboBoxItem Content="{x:Static resources:Strings.K620}" />
                    <ComboBoxItem Content="{x:Static resources:Strings.K621}" />
                </ComboBox>

                <Button
                    Margin="16,0,0,0"
                    Padding="16,6"
                    Command="{Binding QueryCommand}"
                    Content="{x:Static resources:Strings.K625}"
                    Style="{StaticResource ButtonDefault}" />
                <Button
                    Margin="8,0,0,0"
                    Padding="16,6"
                    Command="{Binding ResetCommand}"
                    Content="{x:Static resources:Strings.K626}"
                    Style="{StaticResource ButtonDefault}" />
            </StackPanel>
        </Border>

        <!--  查询错误  -->
        <TextBlock
            Grid.Row="5"
            FontSize="{DynamicResource FontSizeHint}"
            Foreground="{StaticResource DangerBrush}"
            Text="{Binding QueryError}"
            Visibility="{Binding QueryError, Converter={StaticResource NullToVisibilityConverter}}" />

        <!--  审计记录列表 + 详情面板  -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="0"
                Background="{StaticResource SecondaryRegionBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <DataGrid
                        AutoGenerateColumns="False"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CellStyle="{StaticResource KanbanDataGridCell}"
                        ColumnHeaderStyle="{StaticResource KanbanDataGridColumnHeader}"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                        IsReadOnly="True"
                        ItemsSource="{Binding Entries}"
                        RowStyle="{StaticResource AuditRow}"
                        SelectedItem="{Binding SelectedEntry}"
                        Style="{StaticResource KanbanDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                FontSize="{DynamicResource FontSizeHint}"
                                Header="{x:Static resources:Strings.K614}"
                                Width="150" />
                            <DataGridTextColumn
                                Binding="{Binding Operator}"
                                FontSize="{DynamicResource FontSizeHint}"
                                Header="{x:Static resources:Strings.K615}"
                                Width="100" />
                            <DataGridTextColumn
                                Binding="{Binding Action}"
                                FontSize="{DynamicResource FontSizeHint}"
                                Header="{x:Static resources:Strings.K616}"
                                Width="140" />
                            <DataGridTextColumn
                                Binding="{Binding TargetType}"
                                FontSize="{DynamicResource FontSizeHint}"
                                Header="{x:Static resources:Strings.K617}"
                                Width="90" />
                            <DataGridTextColumn
                                Binding="{Binding TargetId}"
                                FontSize="{DynamicResource FontSizeHint}"
                                Header="{x:Static resources:Strings.K618}"
                                Width="130" />
                            <DataGridTemplateColumn
                                Header="{x:Static resources:Strings.K619}"
                                Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{x:Static resources:Strings.K620}" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                                            <Setter Property="Text" Value="{x:Static resources:Strings.K621}" />
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Binding="{Binding Detail}"
                                FontSize="{DynamicResource FontSizeHint}"
                                Header="{x:Static resources:Strings.K622}"
                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:EmptyState
                        Margin="0,0,0,40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IconKind="ShieldAccount"
                        Message="{x:Static resources:Strings.K623}"
                        Hint="{x:Static resources:Strings.K613}">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>
                </Grid>
            </Border>

            <!--  详情面板：选中行查看完整元信息 + 格式化前后值 JSON  -->
            <Border
                Grid.Column="2"
                Padding="14"
                Background="{StaticResource SecondaryRegionBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="{DynamicResource FontSizeHint}"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{x:Static resources:Strings.K648}" />

                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                FontSize="{DynamicResource FontSizeHint}"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{x:Static resources:Strings.K649}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K614}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="{DynamicResource FontSizeHint}" Text="{Binding SelectedEntry.Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K615}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}" Text="{Binding SelectedEntry.Operator}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K616}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}" Text="{Binding SelectedEntry.Action}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K617}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}" Text="{Binding SelectedEntry.TargetType}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K618}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}" Text="{Binding SelectedEntry.TargetId}" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K619}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{x:Static resources:Strings.K620}" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedEntry.Succeeded}" Value="False">
                                                        <Setter Property="Text" Value="{x:Static resources:Strings.K621}" />
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K622}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeHint}" Text="{Binding SelectedEntry.Detail}" TextWrapping="Wrap" />
                                </Grid>

                                <Border Margin="0,14,0,0" Padding="10" Background="{StaticResource RegionBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K637}" />
                                        <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedEntry.BeforeJson, Converter={StaticResource JsonPrettyPrintConverter}, TargetNullValue=—}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,8,0,0" Padding="10" Background="{StaticResource RegionBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K638}" />
                                        <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedEntry.AfterJson, Converter={StaticResource JsonPrettyPrintConverter}, TargetNullValue=—}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{StaticResource ThirdlyTextBrush}"
                                    Text="{x:Static resources:Strings.K650}"
                                    Visibility="{Binding SelectedEntry.BeforeJson, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  分页 + 导出归档  -->
        <Grid Grid.Row="7" Margin="0,12,0,0">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Button
                    Padding="12,4"
                    Command="{Binding ExportCsvCommand}"
                    Content="{x:Static resources:Strings.K629}"
                    Style="{StaticResource ButtonDefault}" />
                <Button
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Command="{Binding ExportJsonCommand}"
                    Content="{x:Static resources:Strings.K630}"
                    Style="{StaticResource ButtonDefault}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeHint}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding PageSummary}" />
                <Button
                    Padding="12,4"
                    Command="{Binding PreviousPageCommand}"
                    Content="{x:Static resources:Strings.K627}"
                    Style="{StaticResource ButtonDefault}" />
                <Button
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Command="{Binding NextPageCommand}"
                    Content="{x:Static resources:Strings.K628}"
                    Style="{StaticResource ButtonDefault}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
