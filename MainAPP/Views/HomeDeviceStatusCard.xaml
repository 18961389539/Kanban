<UserControl
    x:Class="MainAPP.Views.HomeDeviceStatusCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="400" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.Resources>
        <Style x:Key="RecessedProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Background" Value="#070B11" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="4" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!--
        主页仪表板卡片 1：设备状态。
        DataContext 由父级 HomeView 传入 HomeViewModel。
        共享样式（DashboardCard/CardTitleIcon/CardTitleText）从全局资源字典 HomeResources.xaml 查找。
    -->
    <Border Style="{StaticResource DashboardCard}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <materialIcons:MaterialIcon Style="{StaticResource CardTitleIcon}" Kind="Harddisk" />
                    <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static resources:Strings.K028}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- 当前班次 -->
                    <Border Margin="0,0,8,0" Padding="6,4" CornerRadius="8"
                            Background="#1B2431" BorderBrush="#2C3A4D" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeviceStatusShiftTag}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding DeviceStatusShiftTag}" />
                            <!--  班次进度百分比（方案 B 由顶栏迁入，ToolTip=已用/剩余时间）  -->
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Bold"
                                       Text="{Binding ShiftProgressPct}"
                                       ToolTip="{Binding ShiftProgressText}" />
                        </StackPanel>
                    </Border>
                    <!-- 日期 + 时钟 -->
                    <Border Padding="6,4" CornerRadius="8"
                            Background="#1B2431" BorderBrush="#2C3A4D" BorderThickness="1">
                        <TextBlock VerticalAlignment="Center" FontFamily="Consolas"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding DeviceStatusClock}" />
                    </Border>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <!-- 内凹工艺台：左环形仪表（中心显示当前状态）+ 右图例 -->
                <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusPieChart}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <oxy:PlotView Model="{Binding StatusPieChart}" Background="Transparent" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeHint}"
                                           Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{x:Static resources:Strings.K083}" />
                                <TextBlock Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeKpiSm}"
                                           FontWeight="Bold"
                                           Foreground="{Binding RealtimeStatus, Converter={StaticResource StateToBrushConverter}}"
                                           Text="{Binding RealtimeStatus, Converter={StaticResource StateToTextConverter}}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Border Style="{StaticResource KpiCardSecondary}">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{StaticResource SuccessBrush}" />
                                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{x:Static resources:Strings.K005}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiSm}" FontWeight="Bold"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           Text="{Binding RunTimeFullFormatted}" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}"
                                                           Foreground="{StaticResource ThirdlyTextBrush}"
                                                           Text="{Binding RunTimeRatio, StringFormat={}{0:P0}}" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource RecessedProgressBar}"
                                                     Foreground="{StaticResource SuccessBrush}"
                                                     Value="{Binding RunTimeRatio, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{StaticResource StatusAlarmBrush}" />
                                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{x:Static resources:Strings.K016}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiSm}" FontWeight="Bold"
                                                           Foreground="{StaticResource StatusAlarmBrush}"
                                                           Text="{Binding AlarmTimeFullFormatted}" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}"
                                                           Foreground="{StaticResource ThirdlyTextBrush}"
                                                           Text="{Binding AlarmTimeRatio, StringFormat={}{0:P0}}" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource RecessedProgressBar}"
                                                     Foreground="{StaticResource StatusAlarmBrush}"
                                                     Value="{Binding AlarmTimeRatio, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{StaticResource StatusPauseBrush}" />
                                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{x:Static resources:Strings.K006}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiSm}" FontWeight="Bold"
                                                           Foreground="{StaticResource StatusPauseBrush}"
                                                           Text="{Binding PausedTimeFullFormatted}" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}"
                                                           Foreground="{StaticResource ThirdlyTextBrush}"
                                                           Text="{Binding PausedTimeRatio, StringFormat={}{0:P0}}" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource RecessedProgressBar}"
                                                     Foreground="{StaticResource StatusPauseBrush}"
                                                     Value="{Binding PausedTimeRatio, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{StaticResource StatusIdleBrush}" />
                                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{x:Static resources:Strings.Status_Offline}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiSm}" FontWeight="Bold"
                                                           Foreground="{StaticResource StatusIdleBrush}"
                                                           Text="{Binding OfflineTimeFullFormatted}" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}"
                                                           Foreground="{StaticResource ThirdlyTextBrush}"
                                                           Text="{Binding OfflineTimeRatio, StringFormat={}{0:P0}}" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource RecessedProgressBar}"
                                                     Foreground="{StaticResource StatusIdleBrush}"
                                                     Value="{Binding OfflineTimeRatio, Mode=OneWay}" />
                                    </StackPanel>
                                    <!-- 设备健康 -->
                                    <Border Margin="0,10,0,0" Padding="0,10,0,0"
                                            BorderBrush="#2D3548" BorderThickness="0,1,0,0"
                                            ToolTip="{Binding DeviceHealthScoreTooltip}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                                           Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.Home_DeviceHealth}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock VerticalAlignment="Center" FontSize="22" FontWeight="Bold"
                                                               Foreground="{Binding DeviceHealthBrush}"
                                                               Text="{Binding DeviceHealthScoreText}" />
                                                    <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="999"
                                                            Background="{Binding DeviceHealthBrush}">
                                                        <TextBlock Foreground="White" FontSize="11" FontWeight="Bold"
                                                                   Text="{Binding DeviceHealthLevel}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Style="{StaticResource RecessedProgressBar}" Maximum="100"
                                                         Foreground="{Binding DeviceHealthBrush}"
                                                         Value="{Binding DeviceHealthScore, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- 总时长 -->
                                    <Border Margin="0,10,0,0" Padding="0,10,0,0"
                                            BorderBrush="#2D3548" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                                       Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.Home_TotalDuration}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiSm}" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding TotalTimeFullFormatted}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 空状态：StatusPieChart 为 null 时显示 -->
                    <controls:EmptyState IconKind="ChartDonut" Message="{x:Static resources:Strings.K318}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusPieChart}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>
            </Grid>
        </Grid>
    </Border>
</UserControl>
