<UserControl
    x:Class="MainAPP.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MainAPP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:models="clr-namespace:Kanban.Core.Models;assembly=Kanban.Collector.Core"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:resources="clr-namespace:MainAPP.Resources"
    d:DesignHeight="500"
    d:DesignWidth="600"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!--  统一卡片内 Section 标题样式：图标 + 文字横向排列  -->
        <Style x:Key="SettingsSectionTitle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
        <!--  统一信息网格标签列宽，保证多行标签右对齐  -->
        <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <!--  统一卡片内输入控件间距  -->
        <Style x:Key="SettingsTextBox" TargetType="hc:TextBox" BasedOn="{StaticResource TextBoxExtend}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SettingsComboBox" TargetType="hc:ComboBox" BasedOn="{StaticResource ComboBoxExtend}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SettingsGroupHeader" TargetType="Border">
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="SettingsGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="SettingsGroupHint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="SettingsActionButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource TouchFocusVisual}" />
        </Style>
    </UserControl.Resources>


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">
                <StackPanel Width="{Binding ActualWidth, ElementName=SettingsScrollViewer}"
                            HorizontalAlignment="Left">
                <!--  ============ 顶部：授权管理卡片 ============  -->
                <Border
                    x:Name="LicenseSection"
                    Margin="0,0,0,16"
                    Padding="20"
                    Style="{StaticResource MainCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Kind="ShieldKeyOutline" />
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="授权管理" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button
                                    AutomationProperties.Name="复制机器码"
                                    Command="{Binding CopyMachineCodeCommand}"
                                    Content="复制机器码"
                                    Style="{StaticResource IconButtonDefault}"
                                    Tag="{x:Static mi:MaterialIconKind.ContentCopy}" />
                                <Button
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="重新激活"
                                    Command="{Binding ReactivateCommand}"
                                    Content="重新激活"
                                    Style="{StaticResource IconButtonPrimary}"
                                    Tag="{x:Static mi:MaterialIconKind.KeyVariant}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="28,0,0,8" FontSize="12" Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="查看当前设备授权状态，必要时重新激活或备份授权信息。" />
                        <hc:Divider Margin="0,8" />

                        <!--  状态行  -->
                        <StackPanel Margin="0,12,0,16" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LicenseStatus}" Value="Active">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LicenseStatus}" Value="Trial">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding LicenseStatusText}" />
                        </StackPanel>

                        <!--  信息网格：标签列统一 90px 右对齐，多行视觉对齐  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource InfoLabel}"
                                Text="机器码：" />
                            <TextBlock
                                Grid.Row="0" Grid.Column="1"
                                FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding MachineCode}" />

                            <TextBlock
                                Grid.Row="0" Grid.Column="3"
                                Style="{StaticResource InfoLabel}"
                                Text="授权类型：" />
                            <TextBlock
                                Grid.Row="0" Grid.Column="4"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding LicenseTypeText}" />

                            <TextBlock
                                Grid.Row="1" Grid.Column="0"
                                Margin="0,8,0,0"
                                Style="{StaticResource InfoLabel}"
                                Text="激活时间：" />
                            <TextBlock
                                Grid.Row="1" Grid.Column="1"
                                Margin="0,8,0,0"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding ActivatedAtText}" />

                            <TextBlock
                                Grid.Row="1" Grid.Column="3"
                                Margin="0,8,0,0"
                                Style="{StaticResource InfoLabel}"
                                Text="到期时间：" />
                            <TextBlock
                                Grid.Row="1" Grid.Column="4"
                                Margin="0,8,0,0"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding ExpireDateText}" />

                            <!--  激活码（已激活时显示，跨全行 + 统一复制按钮风格）  -->
                            <TextBlock
                                Grid.Row="2" Grid.Column="0"
                                Margin="0,8,0,0"
                                Style="{StaticResource InfoLabel}"
                                Text="激活码：">
                                <TextBlock.Visibility>
                                    <Binding Path="CurrentLicense">
                                        <Binding.Converter>
                                            <conv:NullToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Visibility>
                            </TextBlock>
                            <Border
                                Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                                Margin="0,8,0,0"
                                Padding="8,4"
                                Background="{StaticResource DarkBrush}"
                                CornerRadius="4">
                                <Border.Visibility>
                                    <Binding Path="CurrentLicense">
                                        <Binding.Converter>
                                            <conv:NullToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </Border.Visibility>
                                <DockPanel>
                                    <!--  复制激活码：统一 IconButtonDefault 风格，与顶部复制机器码按钮一致  -->
                                    <Button
                                        Margin="8,0,0,0"
                                        AutomationProperties.Name="复制激活码"
                                        Command="{Binding CopyProductKeyCommand}"
                                        Content="复制"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource IconButtonDefault}"
                                        Tag="{x:Static mi:MaterialIconKind.ContentCopy}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="{Binding ProductKeyText}"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                    <Grid Width="{Binding ActualWidth, ElementName=SettingsScrollViewer}"
                        VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  ============ 左列：数据源与运行模式 ============  -->
                    <Border
                        x:Name="DataSourceSection"
                        Grid.Column="0"
                        Padding="20"
                        VerticalAlignment="Top"
                        Style="{StaticResource MainCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleText}" Text="数据源与运行模式" />
                            <TextBlock Margin="0,4,0,4" FontSize="12" Foreground="{StaticResource ThirdlyTextBrush}"
                                       Text="选择数据来源（本地采集 / 远程采集服务）与程序运行模式。" />
                            <hc:Divider Margin="0,8" />

                            <Border Style="{StaticResource SettingsGroupHeader}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="数据采集模式" />
                                    <TextBlock Style="{StaticResource SettingsGroupHint}" Text="远程模式连接 Kanban.Collector 采集服务，支持多屏共享同一数据源。" />
                                </StackPanel>
                            </Border>

                            <RadioButton Content="本地采集（单机模式）"
                                         AutomationProperties.Name="本地采集模式"
                                         IsChecked="{Binding IsLocalMode}" Margin="0,8,0,0" />
                            <RadioButton Content="远程采集（连接采集服务）"
                                         AutomationProperties.Name="远程采集模式"
                                         IsChecked="{Binding IsRemoteMode}" Margin="0,4,0,0" />
                            <hc:TextBox
                                hc:InfoElement.Title="采集服务地址"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="采集服务地址"
                                Style="{StaticResource SettingsTextBox}"
                                IsEnabled="{Binding IsRemoteMode}"
                                Text="{Binding DraftSettings.CollectorHubUrl, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Kanban.Collector 的 SignalR 地址，如 http://192.168.1.10:5129/hubs/kanban" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button
                                    Style="{StaticResource IconButtonDefault}"
                                    AutomationProperties.Name="测试采集服务连接"
                                    Command="{Binding TestCollectorConnectionCommand}"
                                    Content="{Binding TestCollectorButtonText}"
                                    Tag="{x:Static mi:MaterialIconKind.ServerNetwork}"
                                    ToolTip="测试采集服务 SignalR 连接是否可达"
                                    IsEnabled="{Binding IsRemoteMode}" />
                                <TextBlock
                                    VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                                    Text="{Binding CollectorTestResult}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CollectorTestResultType}" Value="Success">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CollectorTestResultType}" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Border Style="{StaticResource SettingsGroupHeader}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="运行模式" />
                                    <TextBlock Style="{StaticResource SettingsGroupHint}" Text="展示模式仅保留大屏页面并限制退出，适合车间屏端（保存后重启生效）。" />
                                </StackPanel>
                            </Border>
                            <RadioButton Content="完整模式（展示 + 管理）"
                                         AutomationProperties.Name="完整模式"
                                         IsChecked="{Binding IsFullMode}" Margin="0,8,0,0" />
                            <RadioButton Content="展示模式（仅大屏页面）"
                                         AutomationProperties.Name="展示模式"
                                         IsChecked="{Binding IsViewerMode}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!--  ============ 左列：PLC 连接配置 ============  -->
                    <Border
                        x:Name="PlcSection"
                        Grid.Column="0"
                        Padding="20"
                        VerticalAlignment="Top"
                        Style="{StaticResource MainCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleText}" Text="PLC 连接配置" />
                            <TextBlock Margin="0,4,0,4" FontSize="12" Foreground="{StaticResource ThirdlyTextBrush}"
                                       Text="配置通信地址、采集频率和显示密度。" />
                            <hc:Divider Margin="0,8" />

                            <Border Style="{StaticResource SettingsGroupHeader}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="连接与协议" />
                                    <TextBlock Style="{StaticResource SettingsGroupHint}" Text="选择 PLC 品牌并配置通信参数。" />
                                </StackPanel>
                            </Border>

                            <hc:ComboBox
                                hc:InfoElement.Title="PLC 品牌"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="PLC 品牌"
                                ItemsSource="{Binding PlcBrands}"
                                SelectedItem="{Binding DraftSettings.PlcConfig.Brand, Mode=TwoWay}"
                                Style="{StaticResource SettingsComboBox}" />

                            <hc:TextBox
                                hc:InfoElement.Title="IP 地址"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="PLC IP 地址"
                                Style="{StaticResource SettingsTextBox}"
                                Text="{Binding DraftSettings.PlcConfig.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <hc:TextBox
                                hc:InfoElement.Title="端口"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="PLC 端口"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PlcConfig.Port" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule
                                                FieldName="端口"
                                                MaxValue="65535"
                                                MinValue="1" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <hc:TextBox
                                hc:InfoElement.Title="连接超时（毫秒）"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="PLC 连接超时（毫秒）"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PlcConfig.TimeoutMs" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule FieldName="连接超时" MaxValue="60000" MinValue="100" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <hc:ComboBox
                                hc:InfoElement.Title="Siemens 型号"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="Siemens 型号"
                                ItemsSource="{Binding SiemensModels}"
                                SelectedItem="{Binding DraftSettings.PlcConfig.SiemensModel, Mode=TwoWay}"
                                Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Siemens}}"
                                Style="{StaticResource SettingsComboBox}" />
                            <hc:TextBox
                                hc:InfoElement.Title="Siemens Rack"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="Siemens Rack"
                                Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Siemens}}"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PlcConfig.SiemensRack" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule FieldName="Siemens Rack" MaxValue="255" MinValue="0" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <hc:TextBox
                                hc:InfoElement.Title="Siemens Slot"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="Siemens Slot"
                                Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Siemens}}"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PlcConfig.SiemensSlot" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule FieldName="Siemens Slot" MaxValue="255" MinValue="0" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <hc:ComboBox
                                hc:InfoElement.Title="Siemens 数据格式"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="Siemens 数据格式"
                                ItemsSource="{Binding PlcDataFormats}"
                                SelectedItem="{Binding DraftSettings.PlcConfig.SiemensDataFormat, Mode=TwoWay}"
                                Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Siemens}}"
                                Style="{StaticResource SettingsComboBox}" />
                            <hc:TextBox
                                hc:InfoElement.Title="Siemens 批量 Int32 上限"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="Siemens 批量 Int32 上限"
                                Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Siemens}}"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PlcConfig.SiemensBatchInt32Limit" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule FieldName="Siemens 批量 Int32 上限" MaxValue="55" MinValue="1" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <hc:TextBox
                                hc:InfoElement.Title="欧姆龙 FINS 读取切割长度"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="欧姆龙 FINS 读取切割长度"
                                Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Omron}}"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PlcConfig.OmronReadSplits" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule FieldName="欧姆龙 FINS 读取切割长度" MaxValue="999" MinValue="1" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <hc:TextBox
                                hc:InfoElement.Title="Modbus UnitId"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="Modbus UnitId"
                                Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.ModbusTcp}}"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PlcConfig.ModbusUnitId" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule FieldName="Modbus UnitId" MaxValue="247" MinValue="1" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <CheckBox
                                Margin="0,0,0,16"
                                Content="Modbus 地址从 0 开始"
                                IsChecked="{Binding DraftSettings.PlcConfig.ModbusAddressStartWithZero, Mode=TwoWay}"
                                Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.ModbusTcp}}" />
                            <hc:TextBox
                                hc:InfoElement.Title="Modbus 寄存器功能码（3/4）"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="Modbus 寄存器功能码"
                                Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.ModbusTcp}}"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PlcConfig.ModbusRegisterFunction" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule FieldName="Modbus 寄存器功能码" MaxValue="4" MinValue="3" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <hc:TextBox
                                hc:InfoElement.Title="Modbus 位功能码（1/2）"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="Modbus 位功能码"
                                Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.ModbusTcp}}"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PlcConfig.ModbusBitFunction" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule FieldName="Modbus 位功能码" MaxValue="2" MinValue="1" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <hc:ComboBox
                                hc:InfoElement.Title="Modbus 数据格式"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="Modbus 数据格式"
                                ItemsSource="{Binding PlcDataFormats}"
                                SelectedItem="{Binding DraftSettings.PlcConfig.ModbusDataFormat, Mode=TwoWay}"
                                Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.ModbusTcp}}"
                                Style="{StaticResource SettingsComboBox}" />
                            <Border Style="{StaticResource SettingsGroupHeader}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="采集策略" />
                                    <TextBlock Style="{StaticResource SettingsGroupHint}" Text="调整批量读取、轮询和历史写入节奏。" />
                                </StackPanel>
                            </Border>
                            <hc:TextBox
                                hc:InfoElement.Title="PLC 批量读取最大数量"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="PLC 批量读取最大数量"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PlcBatchReadMaxLength" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule
                                                FieldName="PLC 批量读取数量"
                                                MaxValue="1024"
                                                MinValue="1" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <hc:TextBox
                                hc:InfoElement.Title="批量读取允许地址空洞数"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="批量读取允许地址空洞数"
                                Style="{StaticResource SettingsTextBox}"
                                ToolTip="允许批次跨过的未配置逻辑地址数量，0 表示仅合并严格连续地址。">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PlcBatchReadMaxGapSlots" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule
                                                FieldName="批量读取地址空洞"
                                                MaxValue="16"
                                                MinValue="0" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>

                            <!--  测试连接：按钮 Content 随 IsTestingConnection 切换为"测试中..."，结果文案着色  -->
                            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                <Button
                                    Content="{Binding TestConnectionButtonText}"
                                    Command="{Binding TestConnectionCommand}"
                                    Style="{StaticResource IconButtonDefault}"
                                    Tag="{x:Static mi:MaterialIconKind.LanConnect}"
                                    ToolTip="使用当前 IP 和端口测试 PLC 连接（不会影响正在运行的数据采集）" />
                                <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Text="{Binding TestConnectionResult}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TestConnectionResult}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TestConnectionResultType}" Value="Success">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TestConnectionResultType}" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center" Text="{Binding PlcConnectionStatus}" />
                            </StackPanel>
                            <hc:TextBox
                                hc:InfoElement.Title="轮询间隔（毫秒）"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="PLC 数据采集轮询间隔（毫秒）"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.PollingIntervalMs" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule
                                                FieldName="轮询间隔"
                                                MaxValue="60000"
                                                MinValue="50" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <hc:TextBox
                                hc:InfoElement.Title="历史写入间隔（扫描次数）"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="历史数据写入间隔（扫描次数）"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.HistoryWriteIntervalScans" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule
                                                FieldName="历史写入间隔"
                                                MaxValue="36000"
                                                MinValue="1" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>
                            <hc:TextBox
                                hc:InfoElement.Title="主页刷新间隔（毫秒）"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="主页仪表板刷新间隔（毫秒）"
                                Style="{StaticResource SettingsTextBox}">
                                <hc:TextBox.Text>
                                    <Binding Path="DraftSettings.DashboardRefreshIntervalMs" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <conv:IntegerRangeValidationRule
                                                FieldName="主页刷新间隔"
                                                MaxValue="60000"
                                                MinValue="500" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </hc:TextBox.Text>
                            </hc:TextBox>

                            <Border Style="{StaticResource SettingsGroupHeader}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{x:Static resources:Strings.Settings_DisplaySettings}" />
                                    <TextBlock Style="{StaticResource SettingsGroupHint}" Text="{x:Static resources:Strings.Settings_DisplayHint}" />
                                </StackPanel>
                            </Border>

                            <!--  看板标题：窗口/页面标题（settings.json 可配置，屏端经 Hub 拉取零配置）  -->
                            <hc:TextBox
                                hc:InfoElement.Title="看板标题"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="看板标题"
                                MaxLength="40"
                                Style="{StaticResource SettingsTextBox}"
                                Text="{Binding DraftSettings.AppTitle, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="看板窗口/页面标题。屏端（Web 大屏）自动从采集服务拉取，无需逐屏配置" />

                            <!--  界面语言（中文/英文/日文，默认中文；重启后生效）  -->
                            <hc:ComboBox
                                hc:InfoElement.Title="{x:Static resources:Strings.Common_Language}"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="界面语言"
                                Style="{StaticResource SettingsComboBox}"
                                SelectedValue="{Binding DraftSettings.Language}"
                                SelectedValuePath="Tag"
                                ToolTip="{x:Static resources:Strings.Settings_LanguageHint}">
                                <ComboBoxItem Content="中文" Tag="0" />
                                <ComboBoxItem Content="English" Tag="1" />
                                <ComboBoxItem Content="日本語" Tag="2" />
                            </hc:ComboBox>

                            <!--  界面字号（大屏远距可读性）：切换后实时预览，保存设置后持久化  -->
                            <hc:ComboBox
                                hc:InfoElement.Title="界面字号（大屏远距可读性）"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="界面字号缩放"
                                Style="{StaticResource SettingsComboBox}"
                                SelectedValue="{Binding DraftSettings.UiScale, Mode=TwoWay, Converter={StaticResource DoubleToInvariantStringConverter}}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="标准 100%" Tag="1" />
                                <ComboBoxItem Content="大屏 115%" Tag="1.15" />
                                <ComboBoxItem Content="超大屏 130%" Tag="1.3" />
                            </hc:ComboBox>
                            <CheckBox
                                Margin="0,0,0,16"
                                AutomationProperties.Name="启用新报警声音"
                                Content="启用新报警声音"
                                IsChecked="{Binding DraftSettings.EnableAlarmSound, Mode=TwoWay}"
                                ToolTip="新报警触发时播放本机系统提示音；关闭后仍保留视觉提醒和历史记录" />
                            <CheckBox
                                Margin="0,0,0,8"
                                AutomationProperties.Name="启用自动日报"
                                Content="自动生成单设备日报 PDF"
                                IsChecked="{Binding DraftSettings.EnableAutomaticDailyReport, Mode=TwoWay}"
                                ToolTip="按设定时刻为每台有数据的设备生成上一自然日 PDF，文件保存在 Reports 目录" />
                            <hc:DateTimePicker
                                hc:InfoElement.Title="自动日报生成时间"
                                hc:InfoElement.TitlePlacement="Top"
                                AutomationProperties.Name="自动日报生成时间"
                                IsEnabled="{Binding DraftSettings.EnableAutomaticDailyReport}"
                                SelectedDateTime="{Binding DraftSettings.AutomaticDailyReportTime, Converter={StaticResource TimeSpanToDateTimeConverter}}"
                                Style="{StaticResource DateTimePickerExtend}"
                                ToolTip="到达该时刻后生成上一自然日单设备日报" />
                        </StackPanel>
                    </Border>

                    <!--  ============ 右列：班次配置 ============  -->
                    <Border
                        x:Name="ShiftSection"
                        Grid.Column="2"
                        Padding="20"
                        VerticalAlignment="Top"
                        Style="{StaticResource MainCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleText}" Text="班次配置" />
                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource ThirdlyTextBrush}"
                                               Text="管理生产班次和时间范围。" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="新增班次"
                                    Command="{Binding AddShiftCommand}"
                                    Content="新增班次"
                                    Style="{StaticResource IconButtonPrimary}"
                                    Tag="{x:Static mi:MaterialIconKind.Plus}" />
                            </Grid>
                            <StackPanel Grid.Row="1">
                                <hc:Divider Margin="0,8" />
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="班次保存后立即生效，采集将在下一个轮询周期使用；当前班次可能被重新判定。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Stretch">
                                <ItemsControl ItemsSource="{Binding DraftSettings.Shifts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ShiftConfig}">
                                            <Border
                                                Margin="0,0,0,10"
                                                Padding="14"
                                                Background="{StaticResource SecondaryRegionBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <hc:TextBox
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            hc:InfoElement.Title="班次名称"
                                                            hc:InfoElement.TitlePlacement="Top"
                                                            AutomationProperties.Name="班次名称"
                                                            Style="{StaticResource TextBoxExtend}"
                                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button
                                                            Grid.Column="2"
                                                            Width="32"
                                                            Height="32"
                                                            Margin="0,16,0,0"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=删除班次 {0}}"
                                                            Command="{Binding DataContext.RemoveShiftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content=""
                                                            Style="{StaticResource IconButtonDanger}"
                                                            Tag="{x:Static mi:MaterialIconKind.Delete}"
                                                            ToolTip="删除此班次" />
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <hc:DateTimePicker
                                                            Grid.Column="0"
                                                            hc:InfoElement.Title="开始"
                                                            hc:InfoElement.TitlePlacement="Top"
                                                            AutomationProperties.Name="班次开始时间"
                                                            SelectedDateTime="{Binding StartTime, Converter={StaticResource TimeSpanToDateTimeConverter}}"
                                                            Style="{StaticResource DateTimePickerExtend}"
                                                            ToolTip="点击时钟图标选择时刻" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="0,0,0,8"
                                                            VerticalAlignment="Bottom"
                                                            FontSize="18"
                                                            Foreground="{StaticResource ThirdlyTextBrush}"
                                                            Text="—" />
                                                        <hc:DateTimePicker
                                                            Grid.Column="2"
                                                            hc:InfoElement.Title="结束"
                                                            hc:InfoElement.TitlePlacement="Top"
                                                            AutomationProperties.Name="班次结束时间"
                                                            SelectedDateTime="{Binding EndTime, Converter={StaticResource TimeSpanToDateTimeConverter}}"
                                                            Style="{StaticResource DateTimePickerExtend}"
                                                            ToolTip="点击时钟图标选择时刻" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!--  空状态：班次列表为空时提示（防御性，VM 至少保留 1 个）  -->
                                <controls:EmptyState
                                    IconKind="CalendarClockOutline"
                                    Message="暂无班次"
                                    Hint="点击右上角「新增班次」开始配置"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <controls:EmptyState.Style>
                                        <Style TargetType="controls:EmptyState">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DraftSettings.Shifts.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:EmptyState.Style>
                                </controls:EmptyState>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--  保存按钮：Content 随 IsSaving 切换为"保存中..."，IsSaving 时禁用  -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="16,10" Background="{StaticResource RegionBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding UnsavedChangesText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="取消修改" Command="{Binding CancelChangesCommand}" Margin="0,0,8,0" Style="{StaticResource SettingsActionButton}" />
            <Button Content="恢复默认" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,8,0" Style="{StaticResource SettingsActionButton}" />
            <Button
            Content="{Binding SaveButtonText}"
            Width="140"
            Margin="0"
            AutomationProperties.Name="保存设置"
            Command="{Binding SaveCommand}"
            Style="{StaticResource IconButtonPrimary}"
            Tag="{x:Static mi:MaterialIconKind.ContentSave}"
            ToolTip="保存设置 (Ctrl+S)" />
        </StackPanel>
        </Border>
    </Grid>
</UserControl>
