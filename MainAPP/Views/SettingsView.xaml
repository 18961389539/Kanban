<UserControl
    x:Class="MainAPP.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MainAPP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:models="clr-namespace:Kanban.Collector.Core.Models;assembly=Kanban.Collector.Core"
    xmlns:core="clr-namespace:Kanban.Collector.Core.Services;assembly=Kanban.Collector.Core"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:resources="clr-namespace:MainAPP.Resources"
    d:DesignHeight="500"
    d:DesignWidth="600"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!--  统一卡片内 Section 标题样式：图标 + 文字横向排列  -->
        <Style x:Key="SettingsSectionTitle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
        <!--  统一卡片内输入控件间距  -->
        <Style x:Key="SettingsTextBox" TargetType="hc:TextBox" BasedOn="{StaticResource TextBoxExtend}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SettingsComboBox" TargetType="hc:ComboBox" BasedOn="{StaticResource ComboBoxExtend}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SettingsGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="SettingsActionButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource TouchFocusVisual}" />
        </Style>

        <!--  ============ 方案 C：玻璃拟态美化 ============  -->
        <!--  页面背景：暗色垂直渐变，为半透明玻璃卡片提供底衬层次  -->
        <LinearGradientBrush x:Key="SettingsPageBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#151C27" />
            <GradientStop Offset="0.5" Color="#10151E" />
            <GradientStop Offset="1" Color="#0D1118" />
        </LinearGradientBrush>

        <!--  玻璃/胶囊阴影：比 CardDropShadow 更柔、更贴地  -->
        <DropShadowEffect x:Key="SettingsGlassShadow" BlurRadius="18" Direction="270" Opacity="0.28" ShadowDepth="2" Color="#000000" />
        <DropShadowEffect x:Key="SettingsCapsuleShadow" BlurRadius="24" Direction="270" Opacity="0.4" ShadowDepth="4" Color="#000000" />

        <!--  玻璃拟态卡片：半透明渐变底 + 浅色钢蓝描边 + 柔和阴影  -->
        <Style x:Key="SettingsGlassCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#D92C3847" />
                        <GradientStop Offset="1" Color="#D91B2330" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Effect" Value="{StaticResource SettingsGlassShadow}" />
        </Style>

        <!--  分段选择容器：深色胶囊底，容纳一组分段单选  -->
        <Style x:Key="SegmentedRadioGroup" TargetType="Border">
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!--  分段单选按钮：容器内胶囊项，选中主色底 + 主色描边 + 加粗  -->
        <Style x:Key="SegmentedRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource TouchFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  授权详情展开/收起切换：默认折叠元信息，点击展开  -->
        <Style x:Key="LicenseExpandToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource TouchFocusVisual}" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Content" Value="{x:Static resources:Strings.Settings_ExpandDetails}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="{x:Static resources:Strings.Settings_CollapseDetails}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>


    <Grid Margin="20" Background="{StaticResource SettingsPageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">
                <StackPanel Width="{Binding ActualWidth, ElementName=SettingsScrollViewer}"
                            HorizontalAlignment="Left">
                <!--  ============ 顶部：授权管理卡片 ============  -->
                <Border
                    x:Name="LicenseSection"
                    Margin="0,0,0,16"
                    Padding="20,16"
                    Style="{StaticResource SettingsGlassCard}"
                    ToolTip="{x:Static resources:Strings.K473}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Kind="ShieldKeyOutline" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitleText}"
                                    Text="{x:Static resources:Strings.K472}" />
                                <Ellipse
                                    Width="9"
                                    Height="9"
                                    Margin="14,0,7,0"
                                    VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LicenseStatus}" Value="Active">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LicenseStatus}" Value="Trial">
                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding LicenseStatusText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ToggleButton
                                    x:Name="LicenseDetailsToggle"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="{x:Static resources:Strings.Settings_LicenseDetails}"
                                    Style="{StaticResource LicenseExpandToggle}" />
                                <Button
                                    AutomationProperties.Name="{x:Static resources:Strings.K101}"
                                    Command="{Binding CopyMachineCodeCommand}"
                                    Content="{x:Static resources:Strings.K101}"
                                    Style="{StaticResource IconButtonDefault}"
                                    Tag="{x:Static mi:MaterialIconKind.ContentCopy}" />
                                <Button
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="{x:Static resources:Strings.K102}"
                                    Command="{Binding ReactivateCommand}"
                                    Content="{x:Static resources:Strings.K102}"
                                    Style="{StaticResource IconButtonPrimary}"
                                    Tag="{x:Static mi:MaterialIconKind.KeyVariant}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel>
                            <StackPanel.Visibility>
                                <Binding ElementName="LicenseDetailsToggle" Path="IsChecked" Converter="{StaticResource BooleanToVisibilityConverter}" />
                            </StackPanel.Visibility>
                            <hc:Divider Margin="0,12" />

                            <!--  元信息：紧凑横向排列，自动换行  -->
                            <WrapPanel>
                            <StackPanel Margin="0,0,20,8" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource ThirdlyTextBrush}"
                                    Text="{x:Static resources:Strings.K474}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding MachineCode}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,8" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource ThirdlyTextBrush}"
                                    Text="{x:Static resources:Strings.K475}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding LicenseTypeText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,8" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource ThirdlyTextBrush}"
                                    Text="{x:Static resources:Strings.K476}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding ActivatedAtText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,8" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource ThirdlyTextBrush}"
                                    Text="{x:Static resources:Strings.K477}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding ExpireDateText}" />
                            </StackPanel>
                            <!--  激活码（仅已激活显示）  -->
                            <StackPanel Margin="0,0,20,8" Orientation="Horizontal">
                                <StackPanel.Visibility>
                                    <Binding Path="CurrentLicense">
                                        <Binding.Converter>
                                            <conv:NullToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </StackPanel.Visibility>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource ThirdlyTextBrush}"
                                    Text="{x:Static resources:Strings.K478}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding ProductKeyText}" />
                                <Button
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="{x:Static resources:Strings.Settings_ShowHideProductKey}"
                                    Command="{Binding ToggleProductKeyMaskCommand}"
                                    Content="{Binding ProductKeyToggleText}"
                                    Style="{StaticResource IconButtonDefault}"
                                    Tag="{x:Static mi:MaterialIconKind.Eye}" />
                                <Button
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="{x:Static resources:Strings.K479}"
                                    Command="{Binding CopyProductKeyCommand}"
                                    Content="{x:Static resources:Strings.K026}"
                                    Style="{StaticResource IconButtonDefault}"
                                    Tag="{x:Static mi:MaterialIconKind.ContentCopy}" />
                            </StackPanel>
                        </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <hc:TabControl Margin="0,16,0,0" Style="{StaticResource TabControlCapsule}">
                    <!--  ============ Tab 1: 通用设置 ============  -->
                    <hc:TabItem Header="{x:Static resources:Strings.M295}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!--  数据来源  -->
                                <Border
                                    x:Name="DataSourceSection"
                                    Padding="20"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource SettingsGlassCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K482}" />
                                        <TextBlock Margin="0,4,0,4" FontSize="12" Foreground="{StaticResource ThirdlyTextBrush}"
                                                   Text="{x:Static resources:Strings.K483}" />
                                        <hc:Divider Margin="0,8" />

                                        <Border Style="{StaticResource SegmentedRadioGroup}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton
                                                    AutomationProperties.Name="{x:Static resources:Strings.K485}"
                                                    Content="{x:Static resources:Strings.K484}"
                                                    GroupName="DataModeGroup"
                                                    IsChecked="{Binding IsLocalMode}"
                                                    Style="{StaticResource SegmentedRadio}" />
                                                <RadioButton
                                                    AutomationProperties.Name="{x:Static resources:Strings.K487}"
                                                    Content="{x:Static resources:Strings.K486}"
                                                    GroupName="DataModeGroup"
                                                    IsChecked="{Binding IsRemoteMode}"
                                                    Style="{StaticResource SegmentedRadio}" />
                                            </StackPanel>
                                        </Border>
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K103}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K103}"
                                            Style="{StaticResource SettingsTextBox}"
                                            IsEnabled="{Binding IsRemoteMode}"
                                            Text="{Binding DraftSettings.CollectorHubUrl, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{x:Static resources:Strings.K488}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button
                                                Style="{StaticResource IconButtonDefault}"
                                                AutomationProperties.Name="{x:Static resources:Strings.K489}"
                                                Command="{Binding TestCollectorConnectionCommand}"
                                                Content="{Binding TestCollectorButtonText}"
                                                Tag="{x:Static mi:MaterialIconKind.ServerNetwork}"
                                                ToolTip="{x:Static resources:Strings.K490}"
                                                IsEnabled="{Binding IsRemoteMode}" />
                                            <TextBlock
                                                VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                                                Text="{Binding CollectorTestResult}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CollectorTestResultType}" Value="Success">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CollectorTestResultType}" Value="Error">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--  运行模式  -->
                                <Border
                                    x:Name="RunModeSection"
                                    Margin="0,16,0,0"
                                    Padding="20"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource SettingsGlassCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K491}" />
                                        <TextBlock Margin="0,4,0,4" FontSize="12" Foreground="{StaticResource ThirdlyTextBrush}"
                                                   Text="{x:Static resources:Strings.K492}" />
                                        <hc:Divider Margin="0,8" />

                                        <Border Style="{StaticResource SegmentedRadioGroup}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton
                                                    AutomationProperties.Name="{x:Static resources:Strings.K494}"
                                                    Content="{x:Static resources:Strings.K493}"
                                                    GroupName="RunModeGroup"
                                                    IsChecked="{Binding IsFullMode}"
                                                    Style="{StaticResource SegmentedRadio}" />
                                                <RadioButton
                                                    AutomationProperties.Name="{x:Static resources:Strings.K496}"
                                                    Content="{x:Static resources:Strings.K495}"
                                                    GroupName="RunModeGroup"
                                                    IsChecked="{Binding IsViewerMode}"
                                                    Style="{StaticResource SegmentedRadio}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </hc:TabItem>

                    <!--  ============ Tab 2: 显示设置 ============  -->
                    <hc:TabItem Header="{x:Static resources:Strings.Settings_DisplaySettings}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border
                                    x:Name="DisplaySection"
                                    Padding="20"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource SettingsGlassCard}">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,4,0,4"
                                            FontSize="12"
                                            Foreground="{StaticResource ThirdlyTextBrush}"
                                            Text="{x:Static resources:Strings.Settings_DisplayHint}" />
                                        <hc:Divider Margin="0,8" />

                                        <!--  看板标题：窗口/页面标题（settings.json 可配置，屏端经 Hub 拉取零配置）  -->
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K113}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K113}"
                                            MaxLength="40"
                                            Style="{StaticResource SettingsTextBox}"
                                            Text="{Binding DraftSettings.AppTitle, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{x:Static resources:Strings.K525}" />

                                        <!--  界面语言（中文/英文/日文，默认中文；重启后生效）。
                                             Tag 必须是 AppLanguage 枚举值（String "0"/"1"/"2" 与 enum 不能相等比较，会导致 ComboBox 选中失败、显示空白）。
                                             改用 x:Static 引用枚举值，避免引入 Converter。  -->
                                        <hc:ComboBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.Common_Language}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K526}"
                                            Style="{StaticResource SettingsComboBox}"
                                            SelectedValue="{Binding DraftSettings.Language}"
                                            SelectedValuePath="Tag"
                                            ToolTip="{x:Static resources:Strings.Settings_LanguageHint}">
                                            <ComboBoxItem Content="{x:Static resources:Strings.Language_Chinese}" Tag="{x:Static core:AppLanguage.Zh}" />
                                            <ComboBoxItem Content="{x:Static resources:Strings.Language_English}" Tag="{x:Static core:AppLanguage.En}" />
                                            <ComboBoxItem Content="{x:Static resources:Strings.Language_Japanese}" Tag="{x:Static core:AppLanguage.Ja}" />
                                        </hc:ComboBox>
                                        <TextBlock
                                            Margin="0,-4,0,14"
                                            FontSize="11"
                                            Foreground="{StaticResource WarningBrush}"
                                            Text="{x:Static resources:Strings.Common_RestartRequired}" />

                                        <!--  界面字号（大屏远距可读性）：切换后实时预览，保存设置后持久化  -->
                                        <hc:ComboBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K529}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K530}"
                                            Style="{StaticResource SettingsComboBox}"
                                            SelectedValue="{Binding DraftSettings.UiScale, Mode=TwoWay, Converter={StaticResource DoubleToInvariantStringConverter}}"
                                            SelectedValuePath="Tag">
                                            <ComboBoxItem Content="{x:Static resources:Strings.K531}" Tag="1" />
                                            <ComboBoxItem Content="{x:Static resources:Strings.K532}" Tag="1.15" />
                                            <ComboBoxItem Content="{x:Static resources:Strings.K533}" Tag="1.3" />
                                        </hc:ComboBox>
                                        <CheckBox
                                            Margin="0,0,0,16"
                                            AutomationProperties.Name="{x:Static resources:Strings.K114}"
                                            Content="{x:Static resources:Strings.K114}"
                                            IsChecked="{Binding DraftSettings.EnableAlarmSound, Mode=TwoWay}"
                                            ToolTip="{x:Static resources:Strings.K534}" />
                                        <CheckBox
                                            Margin="0,0,0,8"
                                            AutomationProperties.Name="{x:Static resources:Strings.K535}"
                                            Content="{x:Static resources:Strings.K536}"
                                            IsChecked="{Binding DraftSettings.EnableAutomaticDailyReport, Mode=TwoWay}"
                                            ToolTip="{x:Static resources:Strings.K537}" />
                                        <hc:TimePicker
                                            hc:InfoElement.Title="{x:Static resources:Strings.K115}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K115}"
                                            IsEnabled="{Binding DraftSettings.EnableAutomaticDailyReport}"
                                            SelectedTime="{Binding DraftSettings.AutomaticDailyReportTime, Converter={StaticResource TimeSpanToDateTimeConverter}}"
                                            MinHeight="40"
                                            ToolTip="{x:Static resources:Strings.K538}" />
                                        <CheckBox
                                            Margin="0,16,0,0"
                                            AutomationProperties.Name="{x:Static resources:Strings.Settings_DailyReportMaster}"
                                            Content="{x:Static resources:Strings.Settings_DailyReportMaster}"
                                            IsChecked="{Binding DraftSettings.AutomaticDailyReportIsMaster, Mode=TwoWay}"
                                            IsEnabled="{Binding DraftSettings.EnableAutomaticDailyReport}"
                                            ToolTip="{x:Static resources:Strings.Settings_DailyReportMasterHint}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </hc:TabItem>

                    <!--  ============ Tab 3: PLC 连接 ============  -->
                    <hc:TabItem Header="{x:Static resources:Strings.M296}"
                         Visibility="{Binding IsLocalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border
                                    x:Name="PlcSection"
                                    Padding="20"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding IsLocalMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource SettingsGlassCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K497}" />
                                        <TextBlock Margin="0,4,0,4" FontSize="12" Foreground="{StaticResource ThirdlyTextBrush}"
                                                   Text="{x:Static resources:Strings.K498}" />
                                        <hc:Divider Margin="0,8" />

                                        <hc:ComboBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K104}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K104}"
                                            ItemsSource="{Binding PlcBrands}"
                                            SelectedItem="{Binding DraftSettings.PlcConfig.Brand, Mode=TwoWay}"
                                            Style="{StaticResource SettingsComboBox}" />

                                        <Expander Margin="0,12,0,0" IsExpanded="True">
                                            <Expander.Header>
                                                <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{x:Static resources:Strings.Settings_ConnectionParams}" />
                                            </Expander.Header>
                                            <StackPanel>
                                                <hc:TextBox
                                                    hc:InfoElement.Title="{x:Static resources:Strings.K501}"
                                                    hc:InfoElement.TitlePlacement="Top"
                                                    AutomationProperties.Name="{x:Static resources:Strings.K502}"
                                                    Style="{StaticResource SettingsTextBox}"
                                                    Text="{Binding DraftSettings.PlcConfig.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                                                <hc:TextBox
                                                    hc:InfoElement.Title="{x:Static resources:Strings.K105}"
                                                    hc:InfoElement.TitlePlacement="Top"
                                                    AutomationProperties.Name="{x:Static resources:Strings.K503}"
                                                    Style="{StaticResource SettingsTextBox}">
                                                    <hc:TextBox.Text>
                                                        <Binding Path="DraftSettings.PlcConfig.Port" UpdateSourceTrigger="PropertyChanged">
                                                            <Binding.ValidationRules>
                                                                <conv:IntegerRangeValidationRule
                                                                    FieldName="{x:Static resources:Strings.K105}"
                                                                    MaxValue="65535"
                                                                    MinValue="1" />
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </hc:TextBox.Text>
                                                </hc:TextBox>
                                                <hc:TextBox
                                                    hc:InfoElement.Title="{x:Static resources:Strings.K504}"
                                                    hc:InfoElement.TitlePlacement="Top"
                                                    AutomationProperties.Name="{x:Static resources:Strings.K505}"
                                                    Style="{StaticResource SettingsTextBox}">
                                                    <hc:TextBox.Text>
                                                        <Binding Path="DraftSettings.PlcConfig.TimeoutMs" UpdateSourceTrigger="PropertyChanged">
                                                            <Binding.ValidationRules>
                                                                <conv:IntegerRangeValidationRule FieldName="{x:Static resources:Strings.K506}" MaxValue="60000" MinValue="100" />
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </hc:TextBox.Text>
                                                </hc:TextBox>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Margin="0,12,0,0" IsExpanded="False">
                                            <Expander.Header>
                                                <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{x:Static resources:Strings.Settings_ProtocolParams}" />
                                            </Expander.Header>
                                            <StackPanel>
                                                <hc:ComboBox
                                                    hc:InfoElement.Title="{x:Static resources:Strings.K106}"
                                                    hc:InfoElement.TitlePlacement="Top"
                                                    AutomationProperties.Name="{x:Static resources:Strings.K106}"
                                                    ItemsSource="{Binding SiemensModels}"
                                            SelectedItem="{Binding DraftSettings.PlcConfig.SiemensModel, Mode=TwoWay}"
                                            Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Siemens}}"
                                            Style="{StaticResource SettingsComboBox}" />
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K596}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K596}"
                                            Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Siemens}}"
                                            Style="{StaticResource SettingsTextBox}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.PlcConfig.SiemensRack" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule FieldName="{x:Static resources:Strings.K596}" MaxValue="255" MinValue="0" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K597}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K597}"
                                            Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Siemens}}"
                                            Style="{StaticResource SettingsTextBox}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.PlcConfig.SiemensSlot" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule FieldName="{x:Static resources:Strings.K597}" MaxValue="255" MinValue="0" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:ComboBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K107}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K107}"
                                            ItemsSource="{Binding PlcDataFormats}"
                                            SelectedItem="{Binding DraftSettings.PlcConfig.SiemensDataFormat, Mode=TwoWay}"
                                            Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Siemens}}"
                                            Style="{StaticResource SettingsComboBox}" />
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K039}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K039}"
                                            Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Siemens}}"
                                            Style="{StaticResource SettingsTextBox}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.PlcConfig.SiemensBatchInt32Limit" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule FieldName="{x:Static resources:Strings.K039}" MaxValue="55" MinValue="1" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K040}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K040}"
                                            Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.Omron}}"
                                            Style="{StaticResource SettingsTextBox}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.PlcConfig.OmronReadSplits" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule FieldName="{x:Static resources:Strings.K040}" MaxValue="999" MinValue="1" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K598}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K598}"
                                            Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.ModbusTcp}}"
                                            Style="{StaticResource SettingsTextBox}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.PlcConfig.ModbusUnitId" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule FieldName="{x:Static resources:Strings.K598}" MaxValue="247" MinValue="1" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <CheckBox
                                            Margin="0,0,0,16"
                                            Content="{x:Static resources:Strings.K507}"
                                            IsChecked="{Binding DraftSettings.PlcConfig.ModbusAddressStartWithZero, Mode=TwoWay}"
                                            Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.ModbusTcp}}" />
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K508}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K108}"
                                            Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.ModbusTcp}}"
                                            Style="{StaticResource SettingsTextBox}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.PlcConfig.ModbusRegisterFunction" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule FieldName="{x:Static resources:Strings.K108}" MaxValue="4" MinValue="3" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K509}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K109}"
                                            Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.ModbusTcp}}"
                                            Style="{StaticResource SettingsTextBox}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.PlcConfig.ModbusBitFunction" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule FieldName="{x:Static resources:Strings.K109}" MaxValue="2" MinValue="1" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:ComboBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K110}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K110}"
                                            ItemsSource="{Binding PlcDataFormats}"
                                            SelectedItem="{Binding DraftSettings.PlcConfig.ModbusDataFormat, Mode=TwoWay}"
                                            Visibility="{Binding DraftSettings.PlcConfig.Brand, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static models:PlcBrand.ModbusTcp}}"
                                            Style="{StaticResource SettingsComboBox}" />
                                            </StackPanel>
                                        </Expander>

                                        <!--  测试连接：按钮 Content 随 IsTestingConnection 切换为"测试中..."，结果文案着色  -->
                                        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                            <Button
                                                Content="{Binding TestConnectionButtonText}"
                                                Command="{Binding TestConnectionCommand}"
                                                Style="{StaticResource IconButtonDefault}"
                                                Tag="{x:Static mi:MaterialIconKind.LanConnect}"
                                                ToolTip="{x:Static resources:Strings.K515}" />
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSizeCaption}"
                                                Text="{Binding TestConnectionResult}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TestConnectionResult}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TestConnectionResultType}" Value="Success">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TestConnectionResultType}" Value="Error">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding PlcConnectionStatus}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </hc:TabItem>

                    <!--  ============ Tab 4: 采集策略 ============  -->
                    <hc:TabItem Header="{x:Static resources:Strings.M297}"
                         Visibility="{Binding IsLocalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border
                                    x:Name="AcquisitionSection"
                                    Padding="20"
                                    Visibility="{Binding IsLocalMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource SettingsGlassCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K510}" />
                                        <TextBlock
                                            Margin="0,4,0,4"
                                            FontSize="12"
                                            Foreground="{StaticResource ThirdlyTextBrush}"
                                            Text="{x:Static resources:Strings.K511}" />
                                        <hc:Divider Margin="0,8" />

                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K111}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K111}"
                                            Style="{StaticResource SettingsTextBox}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.PlcBatchReadMaxLength" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule
                                                            FieldName="{x:Static resources:Strings.K512}"
                                                            MaxValue="1024"
                                                            MinValue="1" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K112}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K112}"
                                            Style="{StaticResource SettingsTextBox}"
                                            ToolTip="{x:Static resources:Strings.K513}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.PlcBatchReadMaxGapSlots" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule
                                                            FieldName="{x:Static resources:Strings.K514}"
                                                            MaxValue="16"
                                                            MinValue="0" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K516}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K517}"
                                            Style="{StaticResource SettingsTextBox}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.PollingIntervalMs" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule
                                                            FieldName="{x:Static resources:Strings.K518}"
                                                            MaxValue="60000"
                                                            MinValue="50" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K519}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K520}"
                                            Style="{StaticResource SettingsTextBox}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.HistoryWriteIntervalScans" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule
                                                            FieldName="{x:Static resources:Strings.K521}"
                                                            MaxValue="36000"
                                                            MinValue="1" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:TextBox
                                            hc:InfoElement.Title="{x:Static resources:Strings.K522}"
                                            hc:InfoElement.TitlePlacement="Top"
                                            AutomationProperties.Name="{x:Static resources:Strings.K523}"
                                            Style="{StaticResource SettingsTextBox}">
                                            <hc:TextBox.Text>
                                                <Binding Path="DraftSettings.DashboardRefreshIntervalMs" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <conv:IntegerRangeValidationRule
                                                            FieldName="{x:Static resources:Strings.K524}"
                                                            MaxValue="60000"
                                                            MinValue="500" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </hc:TabItem>

                    <!--  ============ Tab 5: 班次配置 ============  -->
                    <hc:TabItem Header="{x:Static resources:Strings.M298}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border
                                    x:Name="ShiftSection"
                                    Padding="20"
                                    Style="{StaticResource SettingsGlassCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K539}" />
                                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource ThirdlyTextBrush}"
                                                           Text="{x:Static resources:Strings.K540}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                AutomationProperties.Name="{x:Static resources:Strings.K116}"
                                                Command="{Binding AddShiftCommand}"
                                                Content="{x:Static resources:Strings.K116}"
                                                Style="{StaticResource IconButtonPrimary}"
                                                Tag="{x:Static mi:MaterialIconKind.Plus}" />
                                        </Grid>
                                        <StackPanel Grid.Row="1">
                                            <hc:Divider Margin="0,8" />
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontSize="{DynamicResource FontSizeCaption}"
                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                Text="{x:Static resources:Strings.K541}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Grid Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Stretch">
                                            <ItemsControl ItemsSource="{Binding DraftSettings.Shifts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ShiftConfig}">
                                                        <Border
                                                            Margin="0,0,0,10"
                                                            Padding="14"
                                                            Background="{StaticResource SecondaryRegionBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <hc:TextBox
                                                                        Grid.Column="0"
                                                                        VerticalAlignment="Center"
                                                                        hc:InfoElement.Title="{x:Static resources:Strings.K117}"
                                                                        hc:InfoElement.TitlePlacement="Top"
                                                                        AutomationProperties.Name="{x:Static resources:Strings.K117}"
                                                                        Style="{StaticResource TextBoxExtend}"
                                                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <Button
                                                                        Grid.Column="2"
                                                                        Width="32"
                                                                        Height="32"
                                                                        Margin="0,16,0,0"
                                                                        Padding="0"
                                                                        VerticalAlignment="Center"
                                                                        AutomationProperties.Name="{Binding Name, StringFormat={x:Static resources:Strings.F288}}"
                                                                        Command="{Binding DataContext.RemoveShiftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content=""
                                                                        Style="{StaticResource IconButtonDanger}"
                                                                        Tag="{x:Static mi:MaterialIconKind.Delete}"
                                                                        ToolTip="{x:Static resources:Strings.K542}" />
                                                                </Grid>

                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="20" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <hc:TimePicker
                                                                        Grid.Column="0"
                                                                        hc:InfoElement.Title="{x:Static resources:Strings.K036}"
                                                                        hc:InfoElement.TitlePlacement="Top"
                                                                        AutomationProperties.Name="{x:Static resources:Strings.K543}"
                                                                        SelectedTime="{Binding StartTime, Converter={StaticResource TimeSpanToDateTimeConverter}}"
                                                                        MinHeight="40"
                                                                        ToolTip="{x:Static resources:Strings.K118}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Margin="0,0,0,8"
                                                                        VerticalAlignment="Bottom"
                                                                        FontSize="18"
                                                                        Foreground="{StaticResource ThirdlyTextBrush}"
                                                                        Text="—" />
                                                                    <hc:TimePicker
                                                                        Grid.Column="2"
                                                                        hc:InfoElement.Title="{x:Static resources:Strings.K544}"
                                                                        hc:InfoElement.TitlePlacement="Top"
                                                                        AutomationProperties.Name="{x:Static resources:Strings.K545}"
                                                                        SelectedTime="{Binding EndTime, Converter={StaticResource TimeSpanToDateTimeConverter}}"
                                                                        MinHeight="40"
                                                                        ToolTip="{x:Static resources:Strings.K118}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!--  空状态：班次列表为空时提示（防御性，VM 至少保留 1 个）  -->
                                            <controls:EmptyState
                                                IconKind="CalendarClockOutline"
                                                Message="{x:Static resources:Strings.K546}"
                                                Hint="{x:Static resources:Strings.K547}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <controls:EmptyState.Style>
                                                    <Style TargetType="controls:EmptyState">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DraftSettings.Shifts.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:EmptyState.Style>
                                            </controls:EmptyState>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </hc:TabItem>
                </hc:TabControl>
            </StackPanel>
        </ScrollViewer>

        <!--  底部操作胶囊：吸底 + 未保存状态 + 取消/恢复默认/保存，保存中禁用  -->
        <Border
            Grid.Row="1"
            Margin="0,16,0,0"
            Padding="12,8"
            HorizontalAlignment="Right"
            Background="#D91A2029"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource SettingsCapsuleShadow}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="4,0,16,0" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding UnsavedChangesText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding CancelChangesCommand}"
                    Content="{x:Static resources:Strings.K548}"
                    Style="{StaticResource SettingsActionButton}" />
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding RestoreDefaultsCommand}"
                    Content="{x:Static resources:Strings.K549}"
                    Style="{StaticResource SettingsActionButton}" />
                <Button
                    Width="140"
                    Margin="0"
                    AutomationProperties.Name="{x:Static resources:Strings.K550}"
                    Command="{Binding SaveCommand}"
                    Content="{Binding SaveButtonText}"
                    Style="{StaticResource IconButtonPrimary}"
                    Tag="{x:Static mi:MaterialIconKind.ContentSave}"
                    ToolTip="{x:Static resources:Strings.K551}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
