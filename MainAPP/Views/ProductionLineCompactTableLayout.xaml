<UserControl
    x:Class="MainAPP.Views.ProductionLineCompactTableLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="1200" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        产线页布局 3：紧凑表格（16+ 台设备）。
        DockPanel 承载表头 + 分隔线 + 合计行（Dock=Bottom）+ 表体 ItemsControl。
        Grid.IsSharedSizeScope=True 使表头/合计行/表体三处列宽对齐。
        DataContext 由父级 ProductionLineView 传入 ProductionLineViewModel；
        ItemsControl.ItemTemplate 的 DataContext 是单个 LineDeviceItem。
        共享样式（StateText/StateBrush）从父级视觉树资源查找继承；
        TableHeader/TableCell 仅本布局使用，定义在本地 Resources。
    -->
    <UserControl.Resources>
        <!--  表格表头文本  -->
        <Style x:Key="TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,6" />
        </Style>
        <!--  表格单元格文本  -->
        <Style x:Key="TableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,7" />
        </Style>
    </UserControl.Resources>

    <DockPanel
        Visibility="{Binding IsTableLayout, Converter={StaticResource BooleanToVisibilityConverter}}"
        Grid.IsSharedSizeScope="True">
        <!--  表头  -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="c_status" Width="90" />
                <ColumnDefinition SharedSizeGroup="c_name" Width="*" />
                <ColumnDefinition SharedSizeGroup="c_recipe" Width="150" />
                <ColumnDefinition SharedSizeGroup="c_oee" Width="90" />
                <ColumnDefinition SharedSizeGroup="c_qual" Width="90" />
                <ColumnDefinition SharedSizeGroup="c_ok" Width="110" />
                <ColumnDefinition SharedSizeGroup="c_ng" Width="80" />
                <ColumnDefinition SharedSizeGroup="c_run" Width="110" />
                <ColumnDefinition SharedSizeGroup="c_alarm" Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource TableHeader}" Text="{x:Static resources:Strings.K003}" />
            <TextBlock Grid.Column="1" Style="{StaticResource TableHeader}" Text="{x:Static resources:Strings.K403}" />
            <TextBlock Grid.Column="2" Style="{StaticResource TableHeader}" Text="{x:Static resources:Strings.K027}" />
            <TextBlock Grid.Column="3" Style="{StaticResource TableHeader}" Text="OEE" />
            <TextBlock Grid.Column="4" Style="{StaticResource TableHeader}" Text="{x:Static resources:Strings.K001}" />
            <TextBlock Grid.Column="5" Style="{StaticResource TableHeader}" Text="{x:Static resources:Strings.K080}" />
            <TextBlock Grid.Column="6" Style="{StaticResource TableHeader}" Text="{x:Static resources:Strings.K404}" />
            <TextBlock Grid.Column="7" Style="{StaticResource TableHeader}" Text="{x:Static resources:Strings.K007}" />
            <TextBlock Grid.Column="8" Style="{StaticResource TableHeader}" Text="{x:Static resources:Strings.K038}" />
        </Grid>

        <Border Background="{StaticResource DividerBrush}" Height="1" DockPanel.Dock="Top" />

        <!--  合计行（DockPanel.Dock=Bottom 固定在表体下方）  -->
        <Border DockPanel.Dock="Bottom" Margin="0,4,0,0" Padding="0,3"
                Background="{StaticResource SecondaryRegionBrush}" CornerRadius="4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="c_status" Width="90" />
                    <ColumnDefinition SharedSizeGroup="c_name" Width="*" />
                    <ColumnDefinition SharedSizeGroup="c_recipe" Width="150" />
                    <ColumnDefinition SharedSizeGroup="c_oee" Width="90" />
                    <ColumnDefinition SharedSizeGroup="c_qual" Width="90" />
                    <ColumnDefinition SharedSizeGroup="c_ok" Width="110" />
                    <ColumnDefinition SharedSizeGroup="c_ng" Width="80" />
                    <ColumnDefinition SharedSizeGroup="c_run" Width="110" />
                    <ColumnDefinition SharedSizeGroup="c_alarm" Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource TableCell}" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource SecondaryTextBrush}" Text="—" />
                <TextBlock Grid.Column="1" Style="{StaticResource TableCell}" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="{Binding DeviceCount, StringFormat=合计（{0} 台）}" />
                <TextBlock Grid.Column="2" Style="{StaticResource TableCell}" Text="—" />
                <TextBlock Grid.Column="3">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TableCell}">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="{Binding WeightedOee, Converter={StaticResource OeeThreshold}}" />
                            <Setter Property="Text" Value="{Binding WeightedOee, StringFormat=P0}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WeightedOee}" Value="0">
                                    <Setter Property="Text" Value="—" />
                                    <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="4" Style="{StaticResource TableCell}" FontFamily="Consolas" FontWeight="Bold"
                           Foreground="{Binding OverallQualityRate, Converter={StaticResource RatioThreshold}}"
                           Text="{Binding OverallQualityRate, StringFormat=P1}" />
                <TextBlock Grid.Column="5" Style="{StaticResource TableCell}" FontFamily="Consolas" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="{Binding TotalOkProduction, StringFormat={}{0:N0} 件}" />
                <TextBlock Grid.Column="6" Style="{StaticResource TableCell}" FontFamily="Consolas" FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}"
                           Text="{Binding TotalNgProduction, StringFormat={}{0:N0} 件}" />
                <TextBlock Grid.Column="7" Style="{StaticResource TableCell}" Text="—" />
                <TextBlock Grid.Column="8" Style="{StaticResource TableCell}" Text="—" />
            </Grid>
        </Border>

        <!--  表体  -->
        <ItemsControl ItemsSource="{Binding FilteredLineDevices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.FocusDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Device.Id}"
                            AutomationProperties.Name="{Binding Device.Name, StringFormat=查看 {0} 详情}"
                            Cursor="Hand" Margin="0,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Button.Template>
                        <Border CornerRadius="4" Padding="0,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
                                    <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                        <Binding Path="Device.Id" />
                                                        <Binding Path="DataContext.SelectedDeviceId" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                            </DataTrigger>
                                        <!--  报警行：Soft 红底（适配暗色模式）  -->
                                        <DataTrigger Binding="{Binding Runtime.StatusWord}" Value="Alarm">
                                            <Setter Property="Background" Value="{StaticResource StatusAlarmSoftBrush}" />
                                        </DataTrigger>
                                        <!--  待机行：Soft 黄底（适配暗色模式）  -->
                                        <DataTrigger Binding="{Binding Runtime.StatusWord}" Value="Paused">
                                            <Setter Property="Background" Value="{StaticResource StatusPauseSoftBrush}" />
                                        </DataTrigger>
                                        <!--  初始行：Soft 灰底（适配暗色模式）  -->
                                        <DataTrigger Binding="{Binding Runtime.StatusWord}" Value="Unknown">
                                            <Setter Property="Background" Value="{StaticResource StatusIdleSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="c_status" Width="90" />
                                    <ColumnDefinition SharedSizeGroup="c_name" Width="*" />
                                    <ColumnDefinition SharedSizeGroup="c_recipe" Width="150" />
                                    <ColumnDefinition SharedSizeGroup="c_oee" Width="90" />
                                    <ColumnDefinition SharedSizeGroup="c_qual" Width="90" />
                                    <ColumnDefinition SharedSizeGroup="c_ok" Width="110" />
                                    <ColumnDefinition SharedSizeGroup="c_ng" Width="80" />
                                    <ColumnDefinition SharedSizeGroup="c_run" Width="110" />
                                    <ColumnDefinition SharedSizeGroup="c_alarm" Width="100" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,7">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                             Fill="{Binding Runtime.StatusWord, Converter={StaticResource StateBrush}}" />
                                    <TextBlock FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding Runtime.StatusWord, Converter={StaticResource StateText}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TableCell}"
                                               Text="{Binding Device.Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource DangerBrush}" Text="{Binding ActiveAlarmText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveAlarmText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource TableCell}"
                                           Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{Binding Device.RecipeName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TableCell}">
                                            <Setter Property="FontFamily" Value="Consolas" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{Binding Runtime.Oee, Converter={StaticResource OeeThreshold}}" />
                                            <Setter Property="Text" Value="{Binding Runtime.Oee, StringFormat=P0}" />
                                            <Style.Triggers>
                                                <!--  OEE=0 时通常为无数据（设备未运行/未采集），显示占位符避免误读为真实 0%  -->
                                                <DataTrigger Binding="{Binding Runtime.Oee}" Value="0">
                                                    <Setter Property="Text" Value="—" />
                                                    <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Style="{StaticResource TableCell}"
                                           FontFamily="Consolas"
                                           Foreground="{Binding Runtime.QualityRate, Converter={StaticResource RatioThreshold}}"
                                           Text="{Binding Runtime.QualityRate, StringFormat=P1}" />
                                <TextBlock Grid.Column="5" Style="{StaticResource TableCell}"
                                           FontFamily="Consolas"
                                           Text="{Binding Runtime.TotalOkProduction, StringFormat={}{0:N0} 件}" />
                                <TextBlock Grid.Column="6" Style="{StaticResource TableCell}"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource DangerBrush}"
                                           Text="{Binding Runtime.TotalNgProduction, StringFormat={}{0:N0} 件}" />
                                <TextBlock Grid.Column="7" Style="{StaticResource TableCell}"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Text="{Binding RunTimeFormatted}" />
                                <TextBlock Grid.Column="8" Style="{StaticResource TableCell}"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource DangerBrush}"
                                           Text="{Binding AlarmTimeFormatted}" />
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
