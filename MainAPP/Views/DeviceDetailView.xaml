<UserControl
    x:Class="MainAPP.Views.DeviceDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DeviceDetailViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1400"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Esc" Command="{Binding GoBackCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- KPI 紧凑单元格（KpiCell/KpiCellLabel/KpiCellValue 已全局化至 Styles/Cards.xaml） -->
        <!-- OEE 三环进度颜色按阈值着色 -->
        <Style x:Key="OeePctText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-56,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="—">
                    <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 配置表行 hover -->
        <Style x:Key="ConfigRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ════════ 无设备空状态 ════════ -->
        <controls:EmptyState
            Grid.RowSpan="2"
            IconKind="HarddiskRemove"
            Message="{x:Static resources:Strings.K144}"
            Hint="{x:Static resources:Strings.K145}"
            Visibility="{Binding HasNoDevice, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- ════════ 有设备内容 ════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12" Visibility="{Binding HasDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 标题栏：返回 + 设备名 + 状态 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.ArrowLeft}"
                    Content="{x:Static resources:Strings.K146}"
                    ToolTip="{x:Static resources:Strings.K147}" />
                <materialIcons:MaterialIcon Style="{StaticResource PageTitleIcon}" Kind="Harddisk" Margin="16,0,0,0" />
                <TextBlock Style="{StaticResource PageTitleText}" Margin="10,0,0,0"
                           Text="{Binding CurrentDevice.Name, FallbackValue={x:Static resources:Strings.K403}}" />
                <!-- 状态徽章：根据 StatusText 切换背景色 -->
                <Border Margin="16,0,0,0" Padding="10,3" CornerRadius="11">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource StatusIdleBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusText}" Value="{x:Static resources:Strings.K005}">
                                    <Setter Property="Background" Value="{StaticResource StatusRunBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="{x:Static resources:Strings.K016}">
                                    <Setter Property="Background" Value="{StaticResource StatusAlarmBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="{x:Static resources:Strings.K006}">
                                    <Setter Property="Background" Value="{StaticResource StatusPauseBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="White" />
                        <TextBlock Margin="6,0,0,0" FontSize="12" FontWeight="Bold" Foreground="White"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                </Border>
                <!-- 设备 Id -->
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeMicro}"
                           Foreground="{StaticResource ThirdlyTextBrush}"
                           Text="{Binding CurrentDevice.Id, StringFormat=ID: {0}}" />
            </StackPanel>

            <!-- 右侧：刷新按钮 + 最后更新时间 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="{DynamicResource FontSizeHint}"
                           Foreground="{StaticResource ThirdlyTextBrush}"
                           Text="{Binding DataScopeText}" />
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeMicro}"
                           Foreground="{StaticResource ThirdlyTextBrush}"
                           Text="{Binding LastUpdateTime, Converter={StaticResource LocFormatConverter}, ConverterParameter=F249}" />
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="{DynamicResource FontSizeHint}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding RefreshStatusText}" />
                <Button
                    Margin="12,0,0,0"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource IconButtonPrimary}"
                    Tag="{x:Static mi:MaterialIconKind.Refresh}"
                    Content="{x:Static resources:Strings.K015}"
                    ToolTip="{x:Static resources:Strings.K044}" />
            </StackPanel>
        </Grid>

        <!-- ════════ 主体内容 ════════ -->
        <Grid Grid.Row="1" Visibility="{Binding HasDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ─── KPI 条 ─── -->
            <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,12">
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K047}" />
                        <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding TotalOk}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K148}" />
                        <TextBlock Style="{StaticResource KpiCellValue}" Foreground="{StaticResource DangerBrush}" Text="{Binding TotalNg}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K001}" />
                        <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding QualityRate, StringFormat={}{0:P0}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCellLabel}" Text="OEE" />
                        <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding Oee, StringFormat={}{0:P0}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K149}" />
                        <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding TodayAlarmCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K007}" />
                        <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding RunTimeHours, StringFormat={}{0:F1}h}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ─── 信息卡条：设备配置 | PLC 实时 | 工单信息 | 节拍对比 ─── -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                <!-- 设备配置 -->
                <Border Style="{StaticResource KpiCell}" Margin="2,2,4,2">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K150}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K017}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" FontSize="12" FontFamily="Consolas" FontWeight="Bold"
                                       Text="{Binding TargetCycle, Converter={StaticResource LocFormatConverter}, ConverterParameter=F246}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K027}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" FontSize="12" FontWeight="Bold"
                                       Text="{Binding RecipeName}" />
                            <Expander Grid.Row="2" Grid.ColumnSpan="2" Header="{x:Static resources:Strings.K048}" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}">
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontFamily="Consolas" Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding OkCountAddress, StringFormat=OK: {0}}" />
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontFamily="Consolas" Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding NgCountAddress, StringFormat=NG: {0}}" />
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontFamily="Consolas" Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding StatusAddress, Converter={StaticResource LocFormatConverter}, ConverterParameter=F253}" />
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PLC 实时数据 -->
                <Border Style="{StaticResource KpiCell}" Margin="2,2,4,2">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K151}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K152}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" FontSize="13" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                       Text="{Binding PlcOkCount}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K153}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" FontSize="13" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"
                                       Text="{Binding PlcNgCount}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K028}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" FontSize="13" FontWeight="Bold"
                                       Foreground="{Binding PlcStatusWord, Converter={StaticResource StateToBrushConverter}}"
                                       Text="{Binding PlcStatusWord, Converter={StaticResource StateToTextConverter}}"
                                       ToolTip="{Binding PlcStatusWord, Converter={StaticResource LocFormatConverter}, ConverterParameter=F289}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 工单信息 -->
                <Border Style="{StaticResource KpiCell}" Margin="2,2,4,2">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K049}" />
                        <Grid Margin="0,4,0,0" Visibility="{Binding HasWorkOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K008}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" FontSize="12" FontWeight="Bold" Text="{Binding WorkOrderNo}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K154}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding ProductName}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K155}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock FontSize="{DynamicResource FontSizeMicro}" FontFamily="Consolas" Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding WorkOrderStatusText}" />
                                <!-- 进度条 -->
                                <ProgressBar Style="{x:Null}" Height="6" Margin="0,4,0,0" Minimum="0" Maximum="1"
                                             Value="{Binding WorkOrderProgress}" Background="{StaticResource SecondaryRegionBrush}"
                                             Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <!-- 无工单时显示空状态文本 -->
                        <TextBlock Margin="0,8,0,0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K156}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWorkOrder}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 节拍与理论产量对比 -->
                <Border Style="{StaticResource KpiCell}" Margin="2,2,4,2">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K157}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K050}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" FontSize="12" FontFamily="Consolas" FontWeight="Bold"
                                       Text="{Binding ActualCycleRate, Converter={StaticResource LocFormatConverter}, ConverterParameter=F267}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K017}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" FontSize="12" FontFamily="Consolas" FontWeight="Bold"
                                       Text="{Binding TargetCycle, Converter={StaticResource LocFormatConverter}, ConverterParameter=F246}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K158}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" FontSize="12" FontFamily="Consolas" FontWeight="Bold"
                                       Text="{Binding CycleGapPercent, StringFormat={}{0:F1}%}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CycleGapPercent, Converter={StaticResource ComparisonConverter}, ConverterParameter=&lt;0}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CycleGapPercent}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <!-- 理论 vs 实际产量 -->
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K159}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock FontSize="{DynamicResource FontSizeMicro}" FontFamily="Consolas" Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding TheoreticalOutput, Converter={StaticResource LocFormatConverter}, ConverterParameter=F245}" />
                                <TextBlock Margin="4,0,4,0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}" Text="/" />
                                <TextBlock FontSize="{DynamicResource FontSizeMicro}" FontFamily="Consolas" FontWeight="Bold"
                                           Text="{Binding ActualTotalOutput, Converter={StaticResource LocFormatConverter}, ConverterParameter=F245}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ─── 数据采集源：实时卡 / 趋势图（设计稿《采集模块扩展设计方案》） ─── -->
            <Border
                Grid.Row="2"
                Margin="0,0,0,12"
                Style="{StaticResource MainCard}"
                Visibility="{Binding HasSources, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                        <Border Style="{StaticResource ChartCardTitleBar}" />
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.Dsm_DataSourceSectionTitle}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Foreground="{StaticResource ThirdlyTextBrush}"
                            Text="{x:Static resources:Strings.Dsm_DataSourceSectionHint}" />
                    </DockPanel>
                    <Grid>
                        <!-- 实时卡：每源一张卡片（名称 / 当前值+单位 / 告警态着色） -->
                        <ItemsControl
                            Margin="16,0,16,16"
                            ItemsSource="{Binding SourceCards}"
                            Visibility="{Binding ShowTrend, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource KpiCell}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource KpiCellLabel}" Text="{Binding DisplayName}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontSize="22"
                                                FontFamily="Consolas"
                                                FontWeight="Bold"
                                                Text="{Binding Value.CurrentDisplayText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Value.IsTriggered}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="{DynamicResource FontSizeCaption}"
                                                Foreground="{StaticResource ThirdlyTextBrush}"
                                                Text="{Binding Value.Unit, Converter={StaticResource LocFormatConverter}, ConverterParameter=Dsm_UnitFormat}" />
                                            <Button
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.ShowTrendChartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{x:Static resources:Strings.Dsm_TrendChart}"
                                                Style="{StaticResource ButtonDefault}"
                                                Padding="10,4"
                                                FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 趋势图：选中源最近 2 小时快照折线（Local 模式数据源快照；Remote 模式为空库） -->
                        <DockPanel
                            Margin="16,0,16,16"
                            Visibility="{Binding ShowTrend, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock
                                    DockPanel.Dock="Left"
                                    FontSize="{DynamicResource FontSizeHint}"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{Binding SelectedTrendSource.DisplayName, Converter={StaticResource LocFormatConverter}, ConverterParameter=Dsm_SourceFormat}" />
                                <Button
                                    DockPanel.Dock="Right"
                                    Command="{Binding BackToLiveCommand}"
                                    Content="{x:Static resources:Strings.Dsm_BackToLiveCard}"
                                    Style="{StaticResource ButtonDefault}"
                                    Padding="10,4"
                                    FontSize="12" />
                            </DockPanel>
                            <oxy:PlotView Model="{Binding TrendPlotModel}" Background="Transparent" />
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ─── 三栏：OEE分解 + 活跃报警 + 最近事件 ─── -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：OEE 分解 + 状态时长 + 按小时产量趋势 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- OEE 三环 -->
                    <Border Grid.Row="0" Style="{StaticResource MainCard}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                                <Border Style="{StaticResource ChartCardTitleBar}" />
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K160}" />
                            </DockPanel>
                            <UniformGrid Columns="3" Margin="16,8,16,16">
                                <StackPanel HorizontalAlignment="Center">
                                    <Grid Width="90" Height="90">
                                        <!-- 背景圆环 -->
                                        <Ellipse Stroke="{StaticResource DividerBrush}" StrokeThickness="8" />
                                        <!-- 进度圆环：StrokeDashArray 控制绘制长度，RotateTransform(-90) 从顶部顺时针 -->
                                        <Ellipse Stroke="{StaticResource SuccessBrush}" StrokeThickness="8"
                                                 StrokeDashArray="{Binding AvailabilityRate, Converter={StaticResource ProgressToStrokeDashArrayConverter}}"
                                                 StrokeDashOffset="0"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock Style="{StaticResource OeePctText}" Text="{Binding AvailabilityRate, StringFormat={}{0:P0}}" />
                                        <Button Style="{StaticResource ButtonDefault}" Padding="0" Background="Transparent" BorderThickness="0" Content="{x:Static resources:Strings.K009}"
                                            Command="{Binding ShowOeeExplanationCommand}" CommandParameter="Availability" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <Grid Width="90" Height="90">
                                        <Ellipse Stroke="{StaticResource DividerBrush}" StrokeThickness="8" />
                                        <Ellipse Stroke="{StaticResource WarningBrush}" StrokeThickness="8"
                                                 StrokeDashArray="{Binding PerformanceRate, Converter={StaticResource ProgressToStrokeDashArrayConverter}}"
                                                 StrokeDashOffset="0"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock Style="{StaticResource OeePctText}" Text="{Binding PerformanceRate, StringFormat={}{0:P0}}" />
                                        <Button Style="{StaticResource ButtonDefault}" Padding="0" Background="Transparent" BorderThickness="0" Content="{x:Static resources:Strings.K029}"
                                            Command="{Binding ShowOeeExplanationCommand}" CommandParameter="Performance" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <Grid Width="90" Height="90">
                                        <Ellipse Stroke="{StaticResource DividerBrush}" StrokeThickness="8" />
                                        <Ellipse Stroke="{StaticResource SuccessBrush}" StrokeThickness="8"
                                                 StrokeDashArray="{Binding QualityRate, Converter={StaticResource ProgressToStrokeDashArrayConverter}}"
                                                 StrokeDashOffset="0"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock Style="{StaticResource OeePctText}" Text="{Binding QualityRate, StringFormat={}{0:P0}}" />
                                        <Button Style="{StaticResource ButtonDefault}" Padding="0" Background="Transparent" BorderThickness="0" Content="{x:Static resources:Strings.K001}"
                                            Command="{Binding ShowOeeExplanationCommand}" CommandParameter="Quality" />
                                </StackPanel>
                            </UniformGrid>
                        </DockPanel>
                    </Border>

                    <!-- 状态时长分布（堆叠条形图：按比例展示运行/报警/待机时长） -->
                    <Border Grid.Row="2" Style="{StaticResource MainCard}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                                <Border Style="{StaticResource ChartCardTitleBar}" />
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K161}" />
                            </DockPanel>
                            <StackPanel Margin="16,8,16,16">
                                <!-- 堆叠条形图：三列按 Ratio 分配宽度，无数据时整条为空 -->
                                <Grid Height="22" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding RunTimeRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                        <ColumnDefinition Width="{Binding AlarmTimeRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                        <ColumnDefinition Width="{Binding PausedTimeRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="{StaticResource StatusRunBrush}" RadiusX="3" RadiusY="3" />
                                    <Rectangle Grid.Column="1" Fill="{StaticResource StatusAlarmBrush}" />
                                    <Rectangle Grid.Column="2" Fill="{StaticResource StatusPauseBrush}" RadiusX="3" RadiusY="3" />
                                </Grid>
                                <!-- 图例 + 数值 -->
                                <UniformGrid Columns="3">
                                    <StackPanel HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" Fill="{StaticResource StatusRunBrush}" />
                                            <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K005}" />
                                        </StackPanel>
                                        <TextBlock Margin="16,4,0,0" FontSize="14" FontWeight="Bold" FontFamily="Consolas"
                                                   Text="{Binding RunTimeHours, StringFormat={}{0:F1}h}" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" Fill="{StaticResource StatusAlarmBrush}" />
                                            <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K016}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" FontFamily="Consolas"
                                                   Text="{Binding AlarmTimeHours, StringFormat={}{0:F1}h}" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Rectangle Width="10" Height="10" Fill="{StaticResource StatusPauseBrush}" />
                                            <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K006}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,16,0" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" FontFamily="Consolas"
                                                   Text="{Binding PausedTimeHours, StringFormat={}{0:F1}h}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 按小时产量柱状图（最近 24 小时） -->
                    <Border Grid.Row="4" Style="{StaticResource MainCard}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8" LastChildFill="False">
                                <Border Style="{StaticResource ChartCardTitleBar}" />
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{Binding HourlyRangeText, Converter={StaticResource LocFormatConverter}, ConverterParameter=F268}" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Margin="4,0,0,0" Padding="8,2" Content="8h"
                                            Command="{Binding SetHourlyRangeCommand}" CommandParameter="8" />
                                    <Button Margin="4,0,0,0" Padding="8,2" Content="24h"
                                            Command="{Binding SetHourlyRangeCommand}" CommandParameter="24" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Margin="8,8,8,16">
                                <oxy:PlotView Model="{Binding HourlyProductionChart}" Background="Transparent" />
                                <controls:EmptyState IconKind="ChartBar" Message="{x:Static resources:Strings.K051}"
                                                     Visibility="{Binding HourlyProductionChart, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- 中栏：实时活跃报警 -->
                <Border Grid.Column="2" Style="{StaticResource MainCard}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                            <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource DangerBrush}" />
                            <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K045}" />
                            <Border Margin="8,0,0,0" Padding="8,1" CornerRadius="10" Background="{StaticResource DangerBrush}">
                                <TextBlock FontSize="{DynamicResource FontSizeMicro}" FontWeight="Bold" Foreground="White" Text="{Binding ActiveAlarmCount}" />
                            </Border>
                        </DockPanel>
                        <Grid Margin="12,0,12,12">
                        <ListBox ItemsSource="{Binding ActiveAlarms}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4,0,4,6" Padding="10,8" CornerRadius="6"
                                            Background="{StaticResource SecondaryRegionBrush}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="3" Margin="0,0,8,0"
                                                    Background="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}" />
                                            <Button DockPanel.Dock="Right" Padding="6,2" Content="{x:Static resources:Strings.K162}"
                                                Command="{Binding DataContext.ViewAlarmHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                            <TextBlock DockPanel.Dock="Right" Margin="8,0,8,0" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeMicro}" FontFamily="Consolas"
                                                       Foreground="{StaticResource ThirdlyTextBrush}"
                                                       Text="{Binding DurationText}" />
                                            <StackPanel>
                                                <TextBlock FontSize="13" FontWeight="Bold" Text="{Binding Name}" />
                                                <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}"
                                                   Text="{Binding ValueText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <controls:EmptyState IconKind="ShieldCheckOutline" Message="{x:Static resources:Strings.K163}"
                                             Hint="{x:Static resources:Strings.K164}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:EmptyState.Style>
                                <Style TargetType="controls:EmptyState">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveAlarmCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:EmptyState.Style>
                        </controls:EmptyState>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 右栏：最近报警事件 + 缺陷占比饼图 -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 最近报警事件 -->
                    <Border Grid.Row="0" Style="{StaticResource MainCard}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                                <Border Style="{StaticResource ChartCardTitleBar}" />
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K165}" />
                                <TextBlock DockPanel.Dock="Right" FontSize="{DynamicResource FontSizeMicro}" Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{x:Static resources:Strings.K025}" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding RecentAlarms}" Margin="12,0,12,12"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,0,4,6" Padding="10,8" CornerRadius="6"
                                                Background="{StaticResource SecondaryRegionBrush}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource FontSizeMicro}" FontWeight="Bold"
                                                           Foreground="{StaticResource ThirdlyTextBrush}"
                                                           Text="{Binding EventType, Converter={StaticResource EventTypeToTextConverter}}" />
                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource FontSizeMicro}" FontFamily="Consolas"
                                                           Foreground="{StaticResource ThirdlyTextBrush}"
                                                           Text="{Binding EventTime, StringFormat={}{0:HH:mm}}" />
                                                <TextBlock FontSize="13" Text="{Binding AlarmName}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- 缺陷占比饼图 -->
                    <Border Grid.Row="2" Style="{StaticResource MainCard}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8" LastChildFill="False">
                                <Border Style="{StaticResource ChartCardTitleBar}" />
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K166}" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeMicro}"
                                               Foreground="{StaticResource ThirdlyTextBrush}"
                                               Text="{Binding DefectTotal, Converter={StaticResource LocFormatConverter}, ConverterParameter=F266}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeMicro}"
                                               Foreground="{StaticResource ThirdlyTextBrush}"
                                               Text="{Binding DefectTypeCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F269}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeMicro}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding TopDefectText, Converter={StaticResource LocFormatConverter}, ConverterParameter=F270}" />
                                </StackPanel>
                            </DockPanel>
                            <Grid MinHeight="180" Margin="8,8,8,16">
                                <oxy:PlotView Model="{Binding DefectPieChart}" Background="Transparent"
                                              Visibility="{Binding DefectPieChart, Converter={StaticResource NullToVisibilityConverter}}" />
                                <controls:EmptyState IconKind="ChartPie" Message="{x:Static resources:Strings.K052}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Visibility="{Binding DefectPieChart, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
