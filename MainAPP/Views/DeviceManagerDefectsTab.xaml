<UserControl
    x:Class="MainAPP.Views.DeviceManagerDefectsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:conv="clr-namespace:MainAPP.Converters"
    xmlns:models="clr-namespace:MainAPP.Models;assembly=Kanban.Collector.Core"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="800">
    <UserControl.Resources>
        <!--  缺陷严重等级 / 类别枚举值（ComboBox 数据源），仅本 Tab 使用  -->
        <ObjectDataProvider
            x:Key="DefectSeverityValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DefectSeverity" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="DefectCategoryValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DefectCategory" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <!--
        设备管理 Tab 3：缺陷管理。
        DataContext 由父级 DeviceManagerView 传入 DeviceManagerViewModel；
        内层 Grid 重设 DataContext={Binding SelectedDevice} 切换到当前设备。
        按钮通过 RelativeSource AncestorType=UserControl 找到子 UserControl（其 DataContext 仍是 VM）。
    -->
    <Grid Margin="24,16" DataContext="{Binding SelectedDevice}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" LastChildFill="True">
            <Button
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="新增缺陷"
                Command="{Binding DataContext.AddDefectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="新增缺陷"
                DockPanel.Dock="Top"
                Style="{StaticResource IconButtonDefault}"
                Tag="{x:Static mi:MaterialIconKind.Plus}" />
            <ListBox
                AutomationProperties.Name="缺陷列表"
                ItemContainerStyle="{StaticResource CardListItemStyle}"
                ItemsSource="{Binding Defects}"
                SelectedItem="{Binding DataContext.SelectedDefect, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel
                            VerticalAlignment="Stretch"
                            LastChildFill="True">
                            <Rectangle
                                Width="5"
                                RadiusX="2.5"
                                RadiusY="2.5"
                                Margin="0,0,8,0"
                                VerticalAlignment="Stretch"
                                Fill="{Binding Severity, Converter={StaticResource DefectSeverityToBrushConverter}}" />
                            <Border
                                Margin="6,0,0,0"
                                Padding="8,1"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                CornerRadius="10"
                                Background="{Binding Severity, Converter={StaticResource DefectSeverityToBrushConverter}}">
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeMicro}"
                                    Foreground="White"
                                    Text="{Binding Severity, Converter={StaticResource DefectSeverityToTextConverter}}" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border
            Grid.Column="2"
            Padding="20"
            Background="{StaticResource SecondaryRegionBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{Binding DataContext.SelectedDefect, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel DataContext="{Binding DataContext.SelectedDefect, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <hc:TextBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="缺陷名称"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="缺陷名称"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <hc:TextBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="PLC 地址（如 D200）"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="缺陷 PLC 地址"
                    Style="{StaticResource TextBoxExtend}">
                    <hc:TextBox.Text>
                        <Binding Path="PlcAddress" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <conv:PlcAddressValidationRule ExpectedType="DWord" />
                            </Binding.ValidationRules>
                        </Binding>
                    </hc:TextBox.Text>
                </hc:TextBox>
                <hc:ComboBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="严重等级"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="缺陷严重等级"
                    ItemsSource="{Binding Source={StaticResource DefectSeverityValues}}"
                    SelectedItem="{Binding Severity, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ComboBoxExtend}">
                    <hc:ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource DefectSeverityToTextConverter}}" />
                        </DataTemplate>
                    </hc:ComboBox.ItemTemplate>
                </hc:ComboBox>
                <hc:ComboBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="缺陷类别"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="缺陷类别"
                    ItemsSource="{Binding Source={StaticResource DefectCategoryValues}}"
                    SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ComboBoxExtend}">
                    <hc:ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource DefectCategoryToTextConverter}}" />
                        </DataTemplate>
                    </hc:ComboBox.ItemTemplate>
                </hc:ComboBox>
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="删除缺陷"
                    Command="{Binding DataContext.RemoveDefectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Content="删除缺陷"
                    Style="{StaticResource IconButtonDanger}"
                    Tag="{x:Static mi:MaterialIconKind.Delete}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
