<Window
    x:Class="MainAPP.Views.ShortcutHelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:MainAPP.Resources"
    Title="{x:Static resources:Strings.Ux_ShortcutHelpTitle}"
    Width="540"
    Height="560"
    MinWidth="440"
    MinHeight="400"
    Background="#1A2029"
    FontFamily="Microsoft YaHei"
    FontSize="14"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,14"
            FontSize="18"
            FontWeight="SemiBold"
            Foreground="#F3F4F6"
            Text="{x:Static resources:Strings.Ux_ShortcutHelpTitle}" />

        <!--  快捷键列表  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Padding="10,6"
                                Background="#111827"
                                BorderBrush="#374151"
                                BorderThickness="1"
                                CornerRadius="4">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontWeight="Bold"
                                    Foreground="#60A5FA"
                                    Text="{Binding Shortcut}"
                                    TextAlignment="Center" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#E5E7EB"
                                Text="{Binding Description}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>