<UserControl
    x:Class="MainAPP.Views.ProductionLineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:views="clr-namespace:MainAPP.Views"
    d:DataContext="{d:DesignInstance Type=vm:ProductionLineViewModel}"
    d:DesignHeight="1080"
    d:DesignWidth="1712"
    PreviewKeyDown="OnPreviewKeyDown"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.Resources>
        <!--  共享资源（StateText/StateBrush/StatusStripe/DeviceCardBorder）已移至 Styles/ProductionLineResources.xaml
              并在 App.xaml 全局注册：子 UserControl 在 XAML 加载阶段无法跨 UserControl 边界查找父级资源。  -->

        <!--  顶部 KPI 小卡：BasedOn MainCard（仅本视图使用）  -->
        <Style x:Key="SummaryKpiBox" TargetType="Border" BasedOn="{StaticResource MainCard}">
            <Setter Property="Padding" Value="18,14" />
        </Style>

        <!--  产线页筛选/排序分段按钮样式（选中态通过 EqualityConverter 比对 LineStatusFilter/LineSortBy 与 Button.Tag）  -->
        <Style x:Key="LineSegmentButton" TargetType="Button">
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                            <Binding Path="DataContext.LineStatusFilter" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LineSortButton" TargetType="Button" BasedOn="{StaticResource LineSegmentButton}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                            <Binding Path="DataContext.LineSortBy" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  BooleanToVisibilityConverter（来自 App.xaml 全局注册）  -->
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ 标题栏 ============  -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <materialIcons:MaterialIcon Style="{StaticResource PageTitleIcon}" Kind="Factory" />
            <TextBlock Style="{StaticResource PageTitleText}" Margin="10,0,0,0" Text="{x:Static resources:Strings.K405}" />
            <Border Width="1" Margin="20,4" Background="{StaticResource BorderBrush}" />
            <TextBlock
                VerticalAlignment="Center" FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="{Binding DeviceCount, StringFormat=共 {0} 台设备}" />
        </StackPanel>

        <!--  ============ 工具栏：搜索 / 状态筛选 / 排序 ============  -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <hc:SearchBar
                x:Name="LineSearchBar"
                Width="220"
                Height="34"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static resources:Strings.K406}"
                Style="{StaticResource SearchBarExtend}"
                Text="{Binding LineSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static resources:Strings.K407}" />
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K003}" />
                <Button Content="{x:Static resources:Strings.K004}" Style="{StaticResource LineSegmentButton}"
                        Tag="{x:Static vm:LineStatusFilter.All}"
                        Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static vm:LineStatusFilter.All}" />
                <Button Content="{x:Static resources:Strings.K005}" Style="{StaticResource LineSegmentButton}"
                        Tag="{x:Static vm:LineStatusFilter.Running}"
                        Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static vm:LineStatusFilter.Running}" />
                <Button Content="{x:Static resources:Strings.K016}" Style="{StaticResource LineSegmentButton}"
                        Tag="{x:Static vm:LineStatusFilter.Alarm}"
                        Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static vm:LineStatusFilter.Alarm}" />
                <Button Content="{x:Static resources:Strings.K006}" Style="{StaticResource LineSegmentButton}"
                    Tag="{x:Static vm:LineStatusFilter.Paused}"
                    Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static vm:LineStatusFilter.Paused}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K408}" />
                <Button Content="{x:Static resources:Strings.K409}" Style="{StaticResource LineSortButton}"
                    Tag="{x:Static vm:LineSortBy.AlarmFirst}"
                    Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:LineSortBy.AlarmFirst}" />
                <Button Content="{x:Static resources:Strings.K410}" Style="{StaticResource LineSortButton}"
                        Tag="{x:Static vm:LineSortBy.Default}"
                        Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:LineSortBy.Default}" />
                <Button Content="OEE↓" Style="{StaticResource LineSortButton}"
                        Tag="{x:Static vm:LineSortBy.OeeDesc}"
                        Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:LineSortBy.OeeDesc}" />
                <Button Content="{x:Static resources:Strings.K411}" Style="{StaticResource LineSortButton}"
                        Tag="{x:Static vm:LineSortBy.OutputDesc}"
                        Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:LineSortBy.OutputDesc}" />
            </StackPanel>
        </StackPanel>

        <!--  ============ 顶部汇总 KPI 条 ============  -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  运行  -->
            <Border Grid.Column="0" Style="{StaticResource SummaryKpiBox}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K005}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock FontFamily="Consolas" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                   Text="{Binding RunningCount}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  报警  -->
            <Border Grid.Column="1" Style="{StaticResource SummaryKpiBox}" Margin="8,0">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K412}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource DangerBrush}" />
                        <TextBlock FontFamily="Consolas" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"
                                   Text="{Binding AlarmCount}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  待机  -->
            <Border Grid.Column="2" Style="{StaticResource SummaryKpiBox}" Margin="8,0">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K006}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource StatusPauseBrush}" />
                        <TextBlock FontFamily="Consolas" FontSize="28" FontWeight="Bold" Foreground="{StaticResource StatusPauseBrush}"
                                   Text="{Binding PausedCount}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  总产量  -->
            <Border Grid.Column="3" Style="{StaticResource SummaryKpiBox}" Margin="8,0">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K023}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock FontFamily="Consolas" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="{Binding TotalOutput, StringFormat={}{0:N0} 件}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Bottom" FontSize="13"
                                   Foreground="{StaticResource DangerBrush}"
                                   Text="{Binding TotalNgProduction, StringFormat=不良 {0:N0} 件}" />
                    </StackPanel>
                    <!--  趋势箭头：较上一班次（HasLastShift=false 或 diff=0 时隐藏）  -->
                    <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeHint}" FontFamily="Consolas"
                               Text="{Binding OutputDiffText, StringFormat=较上班次 {0} 件}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLastShift}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OutputDiffText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OutputDiff, Converter={StaticResource ComparisonConverter}, ConverterParameter=&lt;0}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OutputDiff, Converter={StaticResource ComparisonConverter}, ConverterParameter=&gt;0}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  整体合格率  -->
            <Border Grid.Column="4" Style="{StaticResource SummaryKpiBox}" Margin="8,0">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K413}" />
                    <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                               Foreground="{Binding OverallQualityRate, Converter={StaticResource RatioThreshold}}"
                               Text="{Binding OverallQualityRate, StringFormat=P1}" />
                </StackPanel>
            </Border>

            <!--  加权 OEE  -->
            <Border Grid.Column="5" Style="{StaticResource SummaryKpiBox}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K414}" />
                    <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                               Foreground="{Binding WeightedOee, Converter={StaticResource OeeThreshold}}"
                               Text="{Binding WeightedOee, StringFormat=P1}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  ============ 当前班次标注 ============  -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center">
                <Run Text="{x:Static resources:Strings.K415}" />
                <Run FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding CurrentShiftName, Mode=OneWay}" />
                <Run Text="  " />
                <Run Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding CurrentShiftTimeRange, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!--  ============ 设备列表（按 LayoutMode 切换，3 个布局互斥显示） ============  -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!--  Layout 1: 大卡片 (1-8 设备)  -->
                <views:ProductionLineLargeLayout />
                <!--  Layout 2: 中卡片 (9-15 设备)  -->
                <views:ProductionLineMediumLayout />
                <!--  Layout 3: 紧凑表格 (16+ 设备)  -->
                <views:ProductionLineCompactTableLayout />
            </Grid>
        </ScrollViewer>

        <!--  空状态：无设备时引导  -->
        <Border Grid.Row="4"
                Visibility="{Binding HasNoDevices, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{StaticResource RegionBrush}" CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <controls:EmptyState IconKind="Factory" Message="{x:Static resources:Strings.K416}" Hint="{x:Static resources:Strings.K417}" />
        </Border>
    </Grid>
</UserControl>
