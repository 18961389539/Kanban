<UserControl
    x:Class="MainAPP.Views.ProductionLineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    d:DataContext="{d:DesignInstance Type=vm:ProductionLineViewModel}"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    PreviewKeyDown="OnPreviewKeyDown"
    IsVisibleChanged="OnIsVisibleChanged"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">

    <UserControl.Resources>
        <Style x:Key="LineFilterChip" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="LineDeviceCardList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        </Style>
        <Style x:Key="LineDeviceCardListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题行：产线总览 + 设备数 + 当前班次  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <materialIcons:MaterialIcon Style="{StaticResource PageTitleIcon}" Kind="Factory" />
                <TextBlock Style="{StaticResource PageTitleText}" Margin="10,0,0,0" Text="{x:Static resources:Strings.K405}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeKpiLabel}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding DeviceCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F248}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        ToolTip="{Binding ShiftTooltip}"
                        ToolTipService.ShowDuration="30000">
                <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center">
                    <Run Text="{x:Static resources:Strings.K415}" />
                    <Run FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding CurrentShiftName, Mode=OneWay}" />
                    <Run Text="  " />
                    <Run Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding CurrentShiftTimeRange, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!--  目标产能 + 四态设备数：同一行  -->
        <Grid Grid.Row="1" Margin="0,0,0,16"
              Visibility="{Binding HasNoDevices, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiCard}" Padding="12,10" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <hc:TextBox
                        Width="220"
                        hc:InfoElement.Title="{x:Static resources:Strings.K196}"
                        hc:InfoElement.TitlePlacement="Top"
                        AutomationProperties.Name="{x:Static resources:Strings.K196}"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding BatchTargetPcsPerHour, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Margin="12,0,0,0"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource IconButtonPrimary}"
                        Tag="{x:Static mi:MaterialIconKind.CheckAll}"
                        Content="{x:Static resources:Strings.Ln_ApplyTargetCycleAll}"
                        Command="{Binding ApplyBatchTargetCycleCommand}"
                        AutomationProperties.Name="{x:Static resources:Strings.Ln_ApplyTargetCycleAll}" />
                </StackPanel>
            </Border>

            <!--  四态设备数：合并为两张双指标卡（运行|报警、待机|离线），卡内细分隔线分隔  -->
            <UniformGrid Grid.Column="1" Columns="2">
                <Border Style="{StaticResource KpiCard}" Margin="0,0,6,0" Padding="10,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                    ToolTip="{Binding RunningCountTooltip}"
                                    ToolTipService.ShowDuration="30000">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.Status_Running}" />
                            <TextBlock Style="{StaticResource KpiCellValue}" Foreground="{StaticResource SuccessBrush}"
                                       Text="{Binding RunningCount, StringFormat={}{0:N0}}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Margin="12,2" Background="{StaticResource DividerBrush}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    ToolTip="{Binding AlarmCountTooltip}"
                                    ToolTipService.ShowDuration="30000">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.Status_Alarm}" />
                            <TextBlock Style="{StaticResource KpiCellValue}" Foreground="{StaticResource DangerBrush}"
                                       Text="{Binding AlarmCount, StringFormat={}{0:N0}}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource KpiCard}" Padding="10,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                    ToolTip="{Binding PausedCountTooltip}"
                                    ToolTipService.ShowDuration="30000">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.Status_Paused}" />
                            <TextBlock Style="{StaticResource KpiCellValue}" Foreground="{StaticResource WarningBrush}"
                                       Text="{Binding PausedCount, StringFormat={}{0:N0}}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Margin="12,2" Background="{StaticResource DividerBrush}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    ToolTip="{Binding OfflineCountTooltip}"
                                    ToolTipService.ShowDuration="30000">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.Status_Offline}" />
                            <TextBlock Style="{StaticResource KpiCellValue}" Foreground="{StaticResource ThirdlyTextBrush}"
                                       Text="{Binding OfflineCount, StringFormat={}{0:N0}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!--  一键全部设备 OEE 清零：危险写操作（二次确认 + 断线/无权限时禁用）。
                  2026-09-17 UI 精修：与筛选区拉开距离移至最右 + ghost 红边样式，
                  避免与「应用到全部设备」等常规操作混淆误触。  -->
            <Button Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K929}"
                    Command="{Binding ResetAllProductionCommand}"
                    Content="{x:Static resources:Strings.K928}"
                    Style="{StaticResource GhostDangerButton}"
                    Tag="{x:Static mi:MaterialIconKind.DeleteSweep}"
                    ToolTip="{x:Static resources:Strings.K930}"
                    ToolTipService.ShowOnDisabled="True" />
        </Grid>

        <!--  筛选 / 搜索 / 排序  -->
        <Grid Grid.Row="2" Margin="0,0,0,16"
              Visibility="{Binding HasNoDevices, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <Button Content="{x:Static resources:Strings.Web_Ln_FilterAll}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="{x:Static vm:LineStatusFilter.All}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LineFilterChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LineStatusFilter}" Value="{x:Static vm:LineStatusFilter.All}">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static resources:Strings.Status_Running}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="{x:Static vm:LineStatusFilter.Running}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LineFilterChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LineStatusFilter}" Value="{x:Static vm:LineStatusFilter.Running}">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static resources:Strings.Status_Alarm}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="{x:Static vm:LineStatusFilter.Alarm}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LineFilterChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LineStatusFilter}" Value="{x:Static vm:LineStatusFilter.Alarm}">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static resources:Strings.Status_Paused}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="{x:Static vm:LineStatusFilter.Paused}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LineFilterChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LineStatusFilter}" Value="{x:Static vm:LineStatusFilter.Paused}">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static resources:Strings.Status_Offline}"
                        Command="{Binding SetStatusFilterCommand}"
                        CommandParameter="{x:Static vm:LineStatusFilter.Offline}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LineFilterChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LineStatusFilter}" Value="{x:Static vm:LineStatusFilter.Offline}">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <hc:SearchBar
                    x:Name="LineSearchBar"
                    Width="260"
                    Margin="0,0,10,0"
                    AutomationProperties.Name="{x:Static resources:Strings.K406}"
                    Style="{StaticResource SearchBarExtend}"
                    Text="{Binding LineSearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                <hc:ComboBox
                    Width="150"
                    AutomationProperties.Name="{x:Static resources:Strings.K408}"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding LineSortOptions}"
                    SelectedValue="{Binding LineSortBy}"
                    SelectedValuePath="Value"
                    Style="{StaticResource ComboBoxExtend}" />
            </StackPanel>
        </Grid>

        <!--  主体：设备卡片网格  -->
        <Grid Grid.Row="3">
            <Border Background="{StaticResource RegionBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasNoDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:EmptyState IconKind="Factory" Message="{x:Static resources:Strings.K416}"
                                     Hint="{x:Static resources:Strings.K417}" />
            </Border>

            <Border Background="{StaticResource RegionBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasNoFilteredDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:EmptyState IconKind="FilterRemoveOutline" Message="{x:Static resources:Strings.Web_Ln_EmptyFilter}" />
            </Border>

            <ListBox x:Name="LineDeviceCards"
                     ItemTemplate="{StaticResource LineDeviceCardTemplate}"
                     ItemContainerStyle="{StaticResource LineDeviceCardListItem}"
                     ItemsSource="{Binding FilteredLineDevices}">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource LineDeviceCardList}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoDevices}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasNoFilteredDevices}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel ItemsPerRow="4" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
