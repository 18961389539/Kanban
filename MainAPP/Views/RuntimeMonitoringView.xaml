<UserControl
    x:Class="MainAPP.Views.RuntimeMonitoringView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:RuntimeMonitoringViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1400"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ConnectionKpiValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValueMd}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HealthKpiValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValueMd}">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthText}" Value="运行正常">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthText}" Value="通信中断">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MetricProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="MetricListView" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="MetricColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ConnectionIndicator" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        CanContentScroll="False"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalContentAlignment="Top"
        VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <materialIcons:MaterialIcon Style="{StaticResource PageTitleIcon}" Kind="MonitorDashboard" />
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="运行状态监控" />
                    <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="PLC 通信、采集循环与设备读取健康度" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding LastRefreshTime, StringFormat=刷新于 {0:HH:mm:ss}}" />
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource IconButtonPrimary}" Tag="{x:Static mi:MaterialIconKind.Refresh}" Content="刷新" ToolTip="刷新运行指标（F5）" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,0,0,14" Padding="14,10"
                Background="{StaticResource StatusAlarmSoftBrush}"
                BorderBrush="{StaticResource StatusAlarmBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveFailure}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource StatusAlarmBrush}" Text="采集异常" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding LastFailureMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding LastFailureAt, StringFormat=最近发生：{0:HH:mm:ss}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" Text="连续失败" />
                    <TextBlock HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="{StaticResource StatusAlarmBrush}" Text="{Binding ConsecutiveFailureCycles}" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="PLC 连接" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource ConnectionIndicator}" />
                        <TextBlock Style="{StaticResource ConnectionKpiValue}" Text="{Binding ConnectionStatus}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding PlcEndpoint}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="系统健康" />
                    <TextBlock Style="{StaticResource HealthKpiValue}" Text="{Binding HealthText}" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding IsAcquisitionRunning, StringFormat=采集服务运行：{0}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="最近采集周期" />
                    <TextBlock Style="{StaticResource KpiValueMd}" Text="{Binding LastCycleMilliseconds, StringFormat={}{0} ms}" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding AverageCycleMilliseconds, StringFormat=平均 {0:F1} ms}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="累计断线" />
                    <TextBlock Style="{StaticResource KpiValueMd}" Text="{Binding TotalDisconnectCount}" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding FailedCycles, StringFormat=失败轮询 {0:N0} 次}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MainCard}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="采集循环" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="完成轮询" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding CompletedCycles, StringFormat={}{0:N0} 次}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="平均周期" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding AverageCycleMilliseconds, StringFormat={}{0:F1} ms}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="最大周期" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding MaxCycleMilliseconds, StringFormat={}{0} ms}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="配置轮询间隔" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding PollingIntervalMs, StringFormat={}{0} ms}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="历史写入频率" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding HistoryWriteIntervalScans, StringFormat=每 {0} 次轮询}" />
                    </Grid>
                    <Border Style="{StaticResource HintCard}" Margin="0,22,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Text="实际采集周期包含 PLC 读取耗时和轮询等待时间。若最大周期持续高于配置间隔，建议检查 PLC 响应、网络或地址数量。" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MainCard}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="设备读取" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="配置设备数" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding TotalDeviceCount}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="最近成功读取" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LastSuccessfulDevices}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="最近成功时间" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LastSuccessfulAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=暂无}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="累计失败轮询" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding FailedCycles, StringFormat={}{0:N0} 次}" />
                    </Grid>
                    <Border Style="{StaticResource HintCard}" Margin="0,22,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Text="最近成功读取表示上一轮至少成功读取到的设备数量；0 台时会触发断线判定或表示当前没有可读地址。" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MainCard}" Padding="20" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="PLC 通信详情" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="连接端点" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding PlcEndpoint}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="断线持续" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding DisconnectDurationText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="连续失败重试" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ConsecutiveFailures, StringFormat={}{0} 次}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="累计断线" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding TotalDisconnectCount, StringFormat={}{0} 次}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MainCard}" Padding="20" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="采集质量与读取性能" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="轮询成功率" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding SuccessRatePercent, StringFormat={}{0:F1}%}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="读取点数 / 配置" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ReadDetailText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="最近成功设备" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding DeviceReadSummary}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="最大采集周期" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding MaxCycleMilliseconds, StringFormat={}{0} ms}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource MetricProgressBar}" Value="{Binding SuccessRatePercent}" Maximum="100" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource HintText}" Text="采集成功率" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MainCard}" Padding="20" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="历史写入健康度" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="待写入快照" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding PendingHistoryCount}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="恢复文件" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding RecoveryFileText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="最近成功写入历史" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LastHistoryFlushAt, StringFormat={}{0:HH:mm:ss}, TargetNullValue=暂无}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="写入失败次数" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding HistoryFlushFailureCount}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="数据库存储" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding HistoryStorageText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MainCard}" Padding="20" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="系统资源与数据一致性" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="CPU / 内存" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding CpuMemoryText}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="程序运行时长" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ProcessUptimeText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="GPU 使用率" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding GpuUsageText}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="配置检查" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding DataConsistencyText}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="进程资源" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ProcessResourceText}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="内存 / 磁盘" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding SystemMemoryText}" />
                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="磁盘剩余" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding DiskFreeText}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource MetricProgressBar}" Value="{Binding GpuUsagePercent}" Maximum="100" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource HintText}" Text="GPU 引擎负载" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}" Text="阶段耗时" />
                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding StageTimingText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}" Text="批次计划" />
                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding BatchPlanText}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource MainCard}" Padding="16" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="设备级采集状态" />
                    <ListView Margin="0,12,0,0" Height="220" Style="{StaticResource MetricListView}" ItemsSource="{Binding DeviceStatuses}">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource MetricColumnHeader}">
                                <GridViewColumn Header="设备" Width="150" DisplayMemberBinding="{Binding DeviceName}" />
                                <GridViewColumn Header="当前状态" Width="92" DisplayMemberBinding="{Binding StatusText}" />
                                <GridViewColumn Header="本轮采集" Width="92" DisplayMemberBinding="{Binding AcquisitionText}" />
                                <GridViewColumn Header="读取配置" Width="110" DisplayMemberBinding="{Binding ReadSummary}" />
                                <GridViewColumn Header="OK / NG" Width="100">
                                    <GridViewColumn.DisplayMemberBinding>
                                        <Binding Path="ProductionSummary" />
                                    </GridViewColumn.DisplayMemberBinding>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource MainCard}" Padding="16" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="轮询周期趋势" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource HintText}" Text="最近 60 次刷新 · 单位 ms" />
                    <oxy:PlotView Height="220" Margin="0,10,0,0" Model="{Binding PollingTrend}" Background="Transparent" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
