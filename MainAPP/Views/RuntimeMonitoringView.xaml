<UserControl
    x:Class="MainAPP.Views.RuntimeMonitoringView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    d:DataContext="{d:DesignInstance Type=vm:RuntimeMonitoringViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1400"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources;assembly=Kanban.Localization">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 问题计数：非 0 时高亮，0 时与常规字段一致（静默）。 -->
        <Style x:Key="IssueCountValue" TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="0">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ConnectionKpiValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValueMd}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HealthKpiValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValueMd}">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthText}" Value="{x:Static resources:Strings.Lbl_RunningNormally}">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthText}" Value="{x:Static resources:Strings.Lbl_CommunicationLost}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MetricProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="MetricListView" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="MetricColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ConnectionIndicator" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        CanContentScroll="False"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalContentAlignment="Top"
        VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <materialIcons:MaterialIcon Style="{StaticResource PageTitleIcon}" Kind="MonitorDashboard" />
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="{x:Static resources:Strings.Lbl_RuntimeMonitoring}" />
                    <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.Lbl_HealthPLCCommunicationAcquisitionLoopDevice}" />
                </StackPanel>
                <controls:PageHelpButton Margin="8,0,0,0" VerticalAlignment="Center" PageKey="runtime-monitor" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding LastRefreshTime, Converter={StaticResource LocFormatConverter}, ConverterParameter=F284}" />
                    <!-- 真·重连：绑定 ReconnectCommand（后台线程调 IPlcConnectionManager.EnsureConnected）。
                         原实现绑的是 RefreshCommand，点了只刷新显示、不重连，属误导性按钮。
                         Remote 模式下 SignalR 连接归上层 Coordinator 统一重连，本页不越权建链，故隐藏。 -->
                    <Button Margin="0,0,8,0" Command="{Binding ReconnectCommand}" Content="{x:Static resources:Strings.Rtmon_RetryConnect}" Tag="{x:Static mi:MaterialIconKind.LanConnect}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonWarning}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLocalMode}" Value="True" />
                                            <Condition Binding="{Binding IsConnected}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 1Hz 刷新会让 P99/队列峰值/磁盘剩余这类准静态指标一直跳，排查时先暂停再读数 -->
                    <Button Margin="0,0,8,0" Command="{Binding ToggleAutoRefreshCommand}" Content="{Binding AutoRefreshToggleText}" Tag="{x:Static mi:MaterialIconKind.Pause}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonDefault}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoRefreshPaused}" Value="True">
                                        <Setter Property="Tag" Value="{x:Static mi:MaterialIconKind.Play}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 诊断快照导出/复制：排查故障时只靠截图会丢数值精度也无法检索，
                          这里给出结构化文本出口（工单页有导出 CSV，本页对齐该能力）。 -->
                    <Button Margin="0,0,8,0" Style="{StaticResource IconButtonDefault}"
                            Command="{Binding CopyDiagnosticsCommand}"
                            Content="{x:Static resources:Strings.Rtmon_CopyDiagnostics}"
                            Tag="{x:Static mi:MaterialIconKind.ContentCopy}"
                            ToolTip="{x:Static resources:Strings.Rtmon_CopyDiagnostics}" />
                    <Button Margin="0,0,8,0" Style="{StaticResource IconButtonDefault}"
                            Command="{Binding ExportDiagnosticsCommand}"
                            Content="{x:Static resources:Strings.Rtmon_ExportDiagnostics}"
                            Tag="{x:Static mi:MaterialIconKind.FileExport}"
                            ToolTip="{x:Static resources:Strings.Rtmon_ExportDiagnostics}" />
                </WrapPanel>
                <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}" Style="{StaticResource IconButtonPrimary}"
                        Tag="{x:Static mi:MaterialIconKind.Refresh}" Content="{x:Static resources:Strings.Lbl_Refresh}"
                        ToolTip="{x:Static resources:Strings.Lbl_RefreshRuntimeMetricsF5}" />
            </Grid>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,14" Padding="14,10"
                Background="{StaticResource StatusAlarmSoftBrush}"
                BorderBrush="{StaticResource StatusAlarmBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveFailure}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource StatusAlarmBrush}" Text="{x:Static resources:Strings.Lbl_AcquisitionAbnormal}" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding LastFailureMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding LastFailureAt, Converter={StaticResource LocFormatConverter}, ConverterParameter=F279}" />
                    <!-- 刷新本身抛异常（配置校验/设备快照/资源采样）：数据已停止更新，必须显式告知，
                         否则页面看上去"正常但不动"。 -->
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource StatusAlarmBrush}" TextWrapping="Wrap">
                        <Run Text="{x:Static resources:Strings.Rtmon_RefreshFailed}" />
                        <Run Text="：" />
                        <Run Text="{Binding RefreshErrorMessage, Mode=OneWay}" />
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRefreshError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <!-- 断连时展示"连续失败 N 次"会自相矛盾（刚断连时 N 还是 0，看着像"没失败却报警"）。
                     断连状态下改展示断线持续时长——此时用户真正想知道的是"断了多久"。 -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.Lbl_ConsecutiveFailures}" />
                    <TextBlock HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="{StaticResource StatusAlarmBrush}"
                               Text="{Binding ConsecutiveFailureCycles}"
                               ToolTip="{Binding ConsecutiveFailTooltip}" ToolTipService.ShowDuration="30000" />
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.Lbl_DisconnectDuration}" />
                    <TextBlock HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="{StaticResource StatusAlarmBrush}" Text="{Binding DisconnectDurationText}"
                               ToolTip="{Binding DisconnectDurationTooltip}" ToolTipService.ShowDuration="30000" />
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI 行按可用宽度自适应列数：写死 Columns=4 时窄窗口会把 4 张卡挤成细条
             （连接状态卡的 "192.168.x.x:502" 会被截断）。≥1000 才排 4 列，630~1000 排 2 列，再窄单列。
             触发器按声明顺序生效，后命中的覆盖先命中的，故阈值从低到高排列。 -->
        <UniformGrid x:Name="KpiRow" Grid.Row="2" Margin="0,0,0,6">
            <UniformGrid.Style>
                <Style TargetType="UniformGrid">
                    <Setter Property="Columns" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource ComparisonConverter}, ConverterParameter='&gt;=630'}" Value="True">
                            <Setter Property="Columns" Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource ComparisonConverter}, ConverterParameter='&gt;=1000'}" Value="True">
                            <Setter Property="Columns" Value="4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </UniformGrid.Style>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8"
                    ToolTip="{Binding ConnectionTooltip}" ToolTipService.ShowDuration="30000">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.Lbl_PLCConnection}" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource ConnectionIndicator}" />
                        <TextBlock Style="{StaticResource ConnectionKpiValue}" Text="{Binding ConnectionStatus}" />
                    </StackPanel>
                    <!-- 采集服务不可达时 PLC 地址无意义（本进程根本拿不到 PLC 状态），换成明确的故障定位信息，
                         避免"PLC 连接：未连接"让人误以为是 PLC 侧掉线而去查网线。 -->
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding PlcEndpoint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollectorUnreachable}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource DangerBrush}" Text="{x:Static resources:Strings.Rtmon_CollectorUnreachable}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollectorUnreachable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8"
                    ToolTip="{Binding AcquisitionHealthTooltip}" ToolTipService.ShowDuration="30000">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.Lbl_SystemHealth}" />
                    <TextBlock Style="{StaticResource HealthKpiValue}" Text="{Binding HealthText}" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding IsAcquisitionRunning, Converter={StaticResource LocFormatConverter}, ConverterParameter=F280}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.Lbl_RecentAcquisitionCycle}" />
                    <TextBlock Style="{StaticResource KpiValueMd}" Text="{Binding LastCycleMilliseconds, StringFormat={}{0} ms}" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding AverageCycleMilliseconds, Converter={StaticResource LocFormatConverter}, ConverterParameter=F281}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.Lbl_CumulativeDisconnects}" />
                    <TextBlock Style="{StaticResource KpiValueMd}" Text="{Binding TotalDisconnectCount}" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding FailedCycles, Converter={StaticResource LocFormatConverter}, ConverterParameter=F282}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 设备状态表与趋势图独占整行（跨 2 列）：这两块内容天然需要宽度，
             挤在半栏里表格要横向滚动、趋势图也看不出变化。 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MainCard}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static resources:Strings.Lbl_AcquisitionLoop}" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_CompletedPolls}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding CompletedCycles, Converter={StaticResource LocFormatConverter}, ConverterParameter=F247}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_AverageCycle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding AverageCycleMilliseconds, StringFormat={}{0:F1} ms}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_MaxCycle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding MaxCycleMilliseconds, StringFormat={}{0} ms}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_ConfiguredPollInterval}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding PollingIntervalMs, StringFormat={}{0} ms}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_HistoryWriteFrequency}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding HistoryWriteIntervalScans, Converter={StaticResource LocFormatConverter}, ConverterParameter=F283}" />
                    </Grid>
                    <Border Style="{StaticResource HintCard}" Margin="0,22,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.Lbl_ActualCycleIncludesPLCReadTime}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MainCard}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static resources:Strings.Lbl_DeviceReads}" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_ConfiguredDevices}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding TotalDeviceCount}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_RecentSuccessfulReads}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LastSuccessfulDevices}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_LastSuccessTime}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LastSuccessfulAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue={x:Static resources:Strings.Lbl_N}}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_ReadPointsConfigured}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ReadDetailText}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_RecentSuccessfulDevices}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding DeviceReadSummary}" />
                    </Grid>
                    <Border Style="{StaticResource HintCard}" Margin="0,22,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.Lbl_SuccessfulReadsLastRound0Triggers}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MainCard}" Padding="20" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static resources:Strings.Lbl_PLCCommunicationDetails}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_ConnectionEndpoint}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding PlcEndpoint}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_DisconnectDuration}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding DisconnectDurationText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_ConsecutiveFailureRetries}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ConsecutiveFailures, Converter={StaticResource LocFormatConverter}, ConverterParameter=F291}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MainCard}" Padding="20" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static resources:Strings.Lbl_AcquisitionQualityReadPerformance}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_PollSuccessRate}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}"
                                   Text="{Binding SuccessRateDisplay, StringFormat={}{0:F1}%, TargetNullValue={x:Static resources:Strings.Lbl_N}}"
                                   ToolTip="{Binding SuccessRateTooltip}" ToolTipService.ShowDuration="30000" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Rtmon_P95Cycle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding CycleP95Milliseconds, StringFormat={}{0} ms}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Rtmon_P99Cycle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding CycleP99Milliseconds, StringFormat={}{0} ms}" />
                    </Grid>
                    <!-- 无采集周期时隐藏进度条：空条 + "0.0%" 会被读成"全部失败"，实际只是还没数据 -->
                    <ProgressBar Value="{Binding SuccessRatePercent}" Maximum="100">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource MetricProgressBar}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuccessRateDisplay}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource HintText}" Text="{x:Static resources:Strings.Lbl_AcquisitionSuccessRate}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MainCard}" Padding="20" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static resources:Strings.Lbl_HistoryWriteHealth}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_PendingSnapshots}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}"
                                   Text="{Binding PendingHistoryCount}"
                                   ToolTip="{Binding PendingHistoryTooltip}" ToolTipService.ShowDuration="30000" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_RecoveryFiles}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding RecoveryFileText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_LastSuccessfulWrite}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LastHistoryFlushAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue={x:Static resources:Strings.Lbl_N}}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_WriteFailures}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding HistoryFlushFailureCount}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_DatabaseStorage}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding HistoryStorageText}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Rtmon_DataSourcePending}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding PendingDataSourceCount}" />
                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Rtmon_DataSourceRecovery}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding DataSourceRecoveryFileText}" />
                        <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Rtmon_QueuePeakOverflow}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding HistoryQueueText}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Rtmon_FlushLatency}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding HistoryFlushLatencyText}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Rtmon_DataSourceDatabase}" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding DataSourceStorageText}" />
                        <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Rtmon_TotalDatabase}" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding TotalStorageText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MainCard}" Padding="20" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static resources:Strings.Lbl_AcquisitionProcessResourcesConfiguration}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_CPUMemory}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding CpuMemoryText}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_ProgramUptime}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ProcessUptimeText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_GPUUsage}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding GpuUsageText}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_ConfigCheck}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding DataConsistencyText}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_ProcessResources}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ProcessResourceText}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_MemoryDisk}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding SystemMemoryText}" />
                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_FreeDisk}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding DiskFreeText}" />
                        <!-- 配置校验算了三个指标，原来只露出"配置检查"一项汇总：
                             用户看到"发现 3 项问题"却定位不到是地址冲突还是非法地址。 -->
                        <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Rtmon_AddressConflict}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource IssueCountValue}" Text="{Binding AddressConflictCount}" />
                        <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Rtmon_InvalidAddress}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource IssueCountValue}" Text="{Binding InvalidAddressCount}" />
                        <!-- 阶段耗时/批次计划原本是卡片底部两对"孤立小标题 + 长文本"，
                             把卡片撑得比数据区还长；收进表体后与其他指标对齐，也便于扫读。 -->
                        <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_StageDuration}" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding StageTimingText}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Lbl_BatchPlan}" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding BatchPlanText}" TextWrapping="Wrap" />
                    </Grid>
                    <!-- GPU 不可用时整块隐藏：原来只留一条空进度条 + 孤立标题 -->
                    <TextBlock Margin="0,6,0,0" Text="{x:Static resources:Strings.Lbl_GPUEngineLoad}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GpuAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Value="{Binding GpuUsagePercent}" Maximum="100">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource MetricProgressBar}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GpuAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource MainCard}" Padding="16" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static resources:Strings.Lbl_DeviceAcquisitionStatus}" />
                    <Grid>
                        <!-- 不再写死 Height=220：本页外层已有 ScrollViewer，固定高度会让列表内部再长出一条
                             独立滚动条（外层滚 + 内层滚 = 双层滚动，滚到底就得先"穿过"内层）。
                             改为按内容自适应，MaxHeight 只作为设备极多时的兜底（同时保住虚拟化）。 -->
                        <ListView x:Name="DeviceStatusList" Margin="0,12,0,0" MaxHeight="480" Style="{StaticResource MetricListView}" ItemsSource="{Binding DeviceStatuses}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource MetricColumnHeader}">
                                    <GridViewColumn Header="{x:Static resources:Strings.Lbl_Device}" Width="220" DisplayMemberBinding="{Binding DeviceName}" />
                                    <GridViewColumn Header="{x:Static resources:Strings.Lbl_CurrentStatus}" Width="140" DisplayMemberBinding="{Binding StatusText}" />
                                    <GridViewColumn Header="{x:Static resources:Strings.Lbl_Round}" Width="140" DisplayMemberBinding="{Binding AcquisitionText}" />
                                    <GridViewColumn Header="{x:Static resources:Strings.Lbl_ReadConfig}" Width="160" DisplayMemberBinding="{Binding ReadSummary}" />
                                    <GridViewColumn Header="{x:Static resources:Strings.Wo_OkNg}" Width="140" DisplayMemberBinding="{Binding ProductionSummary}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="{x:Static resources:Strings.Lbl_NoData}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeviceStatuses.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource MainCard}" Padding="16" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static resources:Strings.Lbl_PollCycleTrend}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource HintText}" Text="{x:Static resources:Strings.Lbl_Last60RefreshesMs}" />
                    <Grid>
                        <!-- PlotView 自身没有滚动条，但整行宽度下 220 太扁，趋势起伏看不出来；加高到 280。 -->
                        <oxy:PlotView x:Name="PollingTrendChart" Height="280" Margin="0,10,0,0" Model="{Binding PollingTrend}" Background="Transparent" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="{x:Static resources:Strings.Lbl_NoData}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPollingTrendData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
