<Window
    x:Class="MainAPP.Views.ChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="{Binding Title}"
    Width="380"
    Height="330"
    Background="{StaticResource RegionBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    FocusManager.FocusedElement="{Binding ElementName=NewPasswordBox}"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            FontWeight="Medium"
            Foreground="{StaticResource PrimaryTextBrush}"
            Text="{Binding Message}" />

        <!-- 新密码 + 强度条 -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <PasswordBox
                x:Name="NewPasswordBox"
                hc:InfoElement.Title="{x:Static resources:Strings.M317}"
                hc:InfoElement.TitlePlacement="Top"
                FontSize="{DynamicResource FontSizeKpiLabel}"
                PasswordChanged="OnPasswordChanged"
                KeyDown="OnKeyDown" />
            <Border Height="5" Margin="0,6,0,0" CornerRadius="3" Background="{StaticResource DarkBrush}">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,0,5" />
                </Border.Clip>
                <Border x:Name="StrengthBar" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
            </Border>
            <TextBlock x:Name="StrengthText" Margin="0,4,0,0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" />
        </StackPanel>

        <!-- 确认密码 -->
        <PasswordBox
            x:Name="ConfirmPasswordBox"
            Grid.Row="2"
            Margin="0,12,0,0"
            hc:InfoElement.Title="{x:Static resources:Strings.M365}"
            hc:InfoElement.TitlePlacement="Top"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            PasswordChanged="OnPasswordChanged"
            KeyDown="OnKeyDown" />

        <!-- 错误提示 -->
        <TextBlock
            x:Name="ErrorText"
            Grid.Row="3"
            Margin="0,6,0,0"
            FontSize="{DynamicResource FontSizeHint}"
            Foreground="{StaticResource DangerBrush}" />

        <StackPanel
            Grid.Row="4"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="70"
                Click="Cancel_Click"
                Content="{x:Static resources:Strings.K092}"
                IsCancel="True"
                Style="{StaticResource ButtonDefault}" />
            <Button
                Margin="8,0,0,0"
                Width="70"
                Click="Confirm_Click"
                Content="{x:Static resources:Strings.K093}"
                IsDefault="True"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </Grid>
</Window>
