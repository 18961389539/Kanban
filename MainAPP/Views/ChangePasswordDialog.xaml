<Window
    x:Class="MainAPP.Views.ChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    Title="{Binding Title}"
    Width="380"
    Height="410"
    Background="{StaticResource RegionBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    FocusManager.FocusedElement="{Binding ElementName=NewPasswordBox}"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialIcons:MaterialIcon Kind="Key" Width="30" Height="30" VerticalAlignment="Center"
                                            Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="{Binding Title}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                       FontSize="{DynamicResource FontSizeKpiLabel}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="{Binding Message}" />
        </StackPanel>

        <!-- 新密码 + 强度条 -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Margin="0,0,0,6" FontSize="{DynamicResource FontSizeHint}"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="{x:Static resources:Strings.M317}" />
            <PasswordBox
                x:Name="NewPasswordBox"
                FontSize="{DynamicResource FontSizeKpiLabel}"
                PasswordChanged="OnPasswordChanged"
                KeyDown="OnKeyDown" />
            <Border Height="5" Margin="0,6,0,0" CornerRadius="3" Background="{StaticResource DarkBrush}">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,0,5" />
                </Border.Clip>
                <Border x:Name="StrengthBar" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
            </Border>
            <TextBlock x:Name="StrengthText" Margin="0,4,0,0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>

        <!-- 确认密码 -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Margin="0,0,0,6" FontSize="{DynamicResource FontSizeHint}"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="确认密码" />
            <PasswordBox
                x:Name="ConfirmPasswordBox"
                FontSize="{DynamicResource FontSizeKpiLabel}"
                PasswordChanged="OnPasswordChanged"
                KeyDown="OnKeyDown" />
        </StackPanel>

        <!-- 错误提示 -->
        <TextBlock
            x:Name="ErrorText"
            Grid.Row="3"
            Margin="0,6,0,0"
            FontSize="{DynamicResource FontSizeHint}"
            Foreground="{StaticResource DangerBrush}" />

        <StackPanel
            Grid.Row="4"
            Margin="0,16,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="70"
                Click="Cancel_Click"
                Content="{x:Static resources:Strings.K092}"
                IsCancel="True"
                Style="{StaticResource ButtonDefault}" />
            <Button
                Margin="8,0,0,0"
                Width="70"
                Click="Confirm_Click"
                Content="{x:Static resources:Strings.K093}"
                IsDefault="True"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </Grid>
</Window>
