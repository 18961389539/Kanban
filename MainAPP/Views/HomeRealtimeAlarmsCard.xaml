<UserControl
    x:Class="MainAPP.Views.HomeRealtimeAlarmsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="400" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        主页仪表板卡片 3：实时故障（卡片式列表 + 级别筛选 + 静音按钮）。
        DataContext 由父级 HomeView 传入 HomeViewModel。
        共享样式（DashboardCard/CardTitleIcon/CardTitleText）从全局资源字典 HomeResources.xaml 查找。
    -->
    <Border Style="{StaticResource DashboardCard}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  标题行：标题 + 计数徽章（左）| 级别筛选 chips + 静音按钮（右）  -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                <!--  左：标题 + 报警计数徽章（High 级别时红色）  -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <materialIcons:MaterialIcon Style="{StaticResource CardTitleIcon}" Kind="BellAlert" />
                    <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static resources:Strings.K329}" />
                    <TextBlock Style="{StaticResource HomeDataStatusBadge}" Text="{Binding DataStatusText}" ToolTip="{Binding DataStatusTooltip}" />
                    <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="11"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHighLevelAlarm}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="White"
                                   Text="{Binding ActiveAlarms.Count, Converter={StaticResource LocFormatConverter}, ConverterParameter=F291}" />
                    </Border>
                </StackPanel>

                <!--  右：静音按钮（切换新报警闪烁动画）  -->
                <Button DockPanel.Dock="Right" Width="30" Height="30" Padding="0" Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static resources:Strings.K330}"
                        Command="{Binding ToggleAlarmMuteCommand}"
                        Style="{StaticResource ButtonDefault}"
                        ToolTip="{x:Static resources:Strings.K331}">
                    <materialIcons:MaterialIcon Width="16" Height="16" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon.Style>
                            <Style TargetType="materialIcons:MaterialIcon">
                                <Setter Property="Kind" Value="VolumeHigh" />
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlarmMuted}" Value="True">
                                        <Setter Property="Kind" Value="VolumeMute" />
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialIcons:MaterialIcon.Style>
                    </materialIcons:MaterialIcon>
                </Button>

                <!--  右：级别筛选 chips（H / M / L），ToggleButton 双向绑定 ShowXxxAlarms  -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0"
                            VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,6,0"
                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K332}" />
                    <!--  High：红色，对应 Danger  -->
                    <ToggleButton Width="28" Height="24" Margin="2,0" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                                  AutomationProperties.Name="{x:Static resources:Strings.K086}"
                                  IsChecked="{Binding ShowHighAlarms, Mode=TwoWay}"
                                  ToolTip="{x:Static resources:Strings.K086}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <ToggleButton.Content>H</ToggleButton.Content>
                    </ToggleButton>
                    <!--  Medium：黄色，对应 Warning  -->
                    <ToggleButton Width="28" Height="24" Margin="2,0" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                                  AutomationProperties.Name="{x:Static resources:Strings.K087}"
                                  IsChecked="{Binding ShowMediumAlarms, Mode=TwoWay}"
                                  ToolTip="{x:Static resources:Strings.K087}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <ToggleButton.Content>M</ToggleButton.Content>
                    </ToggleButton>
                    <!--  Low：主色蓝紫，对应 Primary  -->
                    <ToggleButton Width="28" Height="24" Margin="2,0" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                                  AutomationProperties.Name="{x:Static resources:Strings.K088}"
                                  IsChecked="{Binding ShowLowAlarms, Mode=TwoWay}"
                                  ToolTip="{x:Static resources:Strings.K088}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <ToggleButton.Content>L</ToggleButton.Content>
                    </ToggleButton>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <!-- 卡片式故障列表（绑定过滤视图）。
                     看板为大屏场景，卡片随首页 Row 1（* 网格，占视口一半高度）自然撑满，
                     因此不设 MaxHeight 上限：列表区域 Stretch 占满卡片可用高度，
                     报警多时内部滚动，卡片高度始终有界于所在网格行，不会顶出第二行。 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                    <ItemsControl ItemsSource="{Binding FilteredActiveAlarms}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  AutomationProperties.Name="{x:Static resources:Strings.K333}">
                        <!-- ItemsControl 默认 ItemsPanel 是 StackPanel（非虚拟化），
                             VirtualizingStackPanel.IsVirtualizing 附加属性仅在 Panel 为 VirtualizingStackPanel 时生效。
                             必须显式设置 ItemsPanel 为 VirtualizingStackPanel 才能真正启用虚拟化，
                             否则报警列表长时全部实例化，严重卡顿。 -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <!-- 新报警：固定底色，仅让外层边框做低频脉冲，避免整张卡片和文字闪烁 -->
                                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 左侧级别色条 -->
                                                <Border Grid.Column="0" Width="4" Margin="0,0,10,0"
                                                        CornerRadius="2"
                                                        Background="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}" />
                                                <!-- 中间内容（报警名 + 级别 + 时间 + 设备）撑满 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- 类型/级别图标 -->
                                                        <materialIcons:MaterialIcon Width="16" Height="16"
                                                                                    VerticalAlignment="Center"
                                                                                    Foreground="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}">
                                                            <materialIcons:MaterialIcon.Style>
                                                                <Style TargetType="materialIcons:MaterialIcon">
                                                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Count">
                                                                            <Setter Property="Kind" Value="Counter" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="High">
                                                                            <Setter Property="Kind" Value="AlertOctagon" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Medium">
                                                                            <Setter Property="Kind" Value="Alert" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialIcons:MaterialIcon.Style>
                                                        </materialIcons:MaterialIcon>
                                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   Text="{Binding AlarmName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding AlarmName}" />
                                                        <!-- 级别徽章：与设备管理页一致，色条+文字双重显示，色盲友好 -->
                                                        <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="8"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}">
                                                            <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="White"
                                                                       Text="{Binding Level, Converter={StaticResource AlarmLevelToTextConverter}}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="24,4,0,0">
                                                        <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}"
                                                                   Text="{Binding EventTime, StringFormat={}{0:HH:mm:ss}}" />
                                                        <TextBlock Margin="10,0,0,0" FontSize="{DynamicResource FontSizeKpiLabel}"
                                                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                                                   Text="{Binding DeviceName}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- 右侧持续时间（对齐到右边缘） -->
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Margin="12,0,0,0"
                                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="{Binding DurationText}" />
                                            </Grid>

                                        <!-- 独立脉冲层：只改变边框透明度，不影响卡片文字可读性 -->
                                        <Border IsHitTestVisible="False"
                                                BorderBrush="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}"
                                                BorderThickness="2"
                                                CornerRadius="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="AlarmPulseStoryboard">
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="Opacity"
                                                                            From="0.15"
                                                                            To="0.8"
                                                                            Duration="0:0:0.65"
                                                                            AutoReverse="True"
                                                                            RepeatBehavior="Forever" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="AlarmPulseStoryboard" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态 -->
                <controls:EmptyState IconKind="ShieldCheckOutline" Message="{x:Static resources:Strings.K334}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:EmptyState.Style>
                        <Style TargetType="controls:EmptyState">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveAlarms.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyState.Style>
                </controls:EmptyState>
            </Grid>
        </Grid>
    </Border>
</UserControl>
