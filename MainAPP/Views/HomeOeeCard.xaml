<UserControl
    x:Class="MainAPP.Views.HomeOeeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="500" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        主页仪表板卡片 4：OEE设备综合使用效率（OEE 主环 + 可用率/性能率/合格率三环小卡 + 标题栏设备健康分）。
        DataContext 由父级 HomeView 传入 HomeViewModel。
        共享样式（DashboardCard/CardTitleIcon/CardTitleText）从全局资源字典 HomeResources.xaml 查找。
    -->
    <Border Style="{StaticResource DashboardCard}"
            ToolTipService.InitialShowDelay="300"
            ToolTipService.ShowDuration="30000">
        <!--  内边距 20→16：紧凑化以容纳 2×3 看板在 1080 设计高度内的完整展示（修复 2026-08-30，见 HomeView.xaml 说明）  -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  标题 + 压缩设备健康分（自设备状态卡迁入）  -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <materialIcons:MaterialIcon Style="{StaticResource CardTitleIcon}" Kind="Gauge" />
                    <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static resources:Strings.K319}" />
                    <controls:KpiScopeChip Kind="Shift" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="{Binding DeviceHealthScoreTooltip}">
                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{x:Static resources:Strings.Home_DeviceHealth}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                               Foreground="{Binding DeviceHealthBrush}"
                               Text="{Binding DeviceHealthScoreText}" />
                    <!--  2026-09-18 UI 精修：原「白字压满色块」在琥珀/黄等浅语义色档位下
                          对比度约 1.8:1 不可读。改为 18% 语义色底 + 同色文字 + 同色描边
                          （与全站状态药丸一致），任何档位都满足可读性。  -->
                    <Grid Margin="8,0,0,0" VerticalAlignment="Center">
                        <Border CornerRadius="999" Background="{Binding DeviceHealthBrush}" Opacity="0.18" />
                        <Border CornerRadius="999" BorderBrush="{Binding DeviceHealthBrush}"
                                BorderThickness="1" Opacity="0.55" />
                        <TextBlock Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding DeviceHealthBrush}"
                                   Text="{Binding DeviceHealthLevel}" />
                    </Grid>
                </StackPanel>
            </DockPanel>

            <!--  左右布局：OEE 主环居左，A/P/Q 三环指标居右，避免上下堆叠导致底部文字被压缩/重叠  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  左：OEE 主环 + 中心百分比  -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="235" Height="235" HorizontalAlignment="Center">
                        <oxy:PlotView Model="{Binding OeeRingChart}" Width="235" Height="235"
                                      Background="Transparent" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="{Binding OeeTooltip}">
                            <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLg}" FontWeight="Bold"
                                       Foreground="{Binding OeeValue, Converter={StaticResource OeeThreshold}}"
                                       Text="{Binding OeeDisplay}" />
                            <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{StaticResource ThirdlyTextBrush}" Text="OEE" />
                        </StackPanel>
                        <!-- 空状态：OeeRingChart 为 null 时显示，遮盖空环和 0% 文本 -->
                        <controls:EmptyState IconKind="ChartArc" Message="{x:Static resources:Strings.K320}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:EmptyState.Style>
                                <Style TargetType="controls:EmptyState">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OeeRingChart}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:EmptyState.Style>
                        </controls:EmptyState>
                    </Grid>
                </StackPanel>

                <!--  右：可用率 / 性能率 / 合格率 三环小卡  -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <!--  可用率  -->
                    <Border Padding="8" Margin="0,0,0,6" Style="{StaticResource KpiCardSecondary}"
                            ToolTip="{Binding AvailabilityTooltip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <oxy:PlotView Grid.Column="0" Model="{Binding AvailabilityRingChart}"
                                          Width="42" Height="42" Background="Transparent" />
                            <!--  2026-09-18 UI 精修：名称 16→12、数值 26→20 两行紧凑排布，
                                  可见的公式行删除（Tooltip 已含公式：HomeViewModel.AvailabilityTooltip），
                                  单卡高度 76→约 56，三卡不再高过左侧 OEE 主环。  -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeMicro}"
                                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K321}" />
                                    <controls:KpiScopeChip Kind="Shift" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeKpiSm}" FontWeight="Bold"
                                           Foreground="{Binding AvailabilityRate, Converter={StaticResource OeeThreshold}}"
                                           Text="{Binding AvailabilityRateDisplay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  性能率  -->
                    <Border Padding="8" Margin="0,0,0,6" Style="{StaticResource KpiCardSecondary}"
                            ToolTip="{Binding PerformanceTooltip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <oxy:PlotView Grid.Column="0" Model="{Binding PerformanceRingChart}"
                                          Width="42" Height="42" Background="Transparent" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeMicro}"
                                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K322}" />
                                    <controls:KpiScopeChip Kind="Shift" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeKpiSm}" FontWeight="Bold"
                                           Foreground="{Binding PerformanceRate, Converter={StaticResource OeeThreshold}}"
                                           Text="{Binding PerformanceRateDisplay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  合格率  -->
                    <Border Padding="8" Style="{StaticResource KpiCardSecondary}"
                            ToolTip="{Binding QualityTooltip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <oxy:PlotView Grid.Column="0" Model="{Binding QualityRingChart}"
                                          Width="42" Height="42" Background="Transparent" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeMicro}"
                                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K084}" />
                                    <controls:KpiScopeChip Kind="Shift" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeKpiSm}" FontWeight="Bold"
                                           Foreground="{Binding QualityRate, Converter={StaticResource QualityThreshold}}"
                                           Text="{Binding QualityRateDisplay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
