<UserControl
    x:Class="MainAPP.Views.HomeQualityRateCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="500" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        主页仪表板卡片 5：当前班次良率（当班总产量 + 累计良率，下为小时良品柱与累计良率折线）。
        DataContext 由父级 HomeView 传入 HomeViewModel。
        共享样式（DashboardCard/CardTitleIcon/CardTitleText）从全局资源字典 HomeResources.xaml 查找。
    -->
    <Border Style="{StaticResource DashboardCard}"
            ToolTipService.InitialShowDelay="300"
            ToolTipService.ShowDuration="30000">
        <!--  内边距 20→16：紧凑化以容纳 2×3 看板在 1080 设计高度内的完整展示（修复 2026-08-30，见 HomeView.xaml 说明）  -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <materialIcons:MaterialIcon Style="{StaticResource CardTitleIcon}" Kind="CheckCircle" />
                    <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static resources:Strings.K328}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                            ToolTip="{Binding TotalOutputTooltip}">
                    <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}"
                               Foreground="{StaticResource ThirdlyTextBrush}"
                               Text="{x:Static resources:Strings.Home_ShiftTotalOutput}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="{Binding TotalOutputDisplay}" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Bottom"
                                   FontSize="{DynamicResource FontSizeKpiLabel}"
                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="{x:Static resources:Strings.K014}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                            ToolTip="{Binding QualityTooltip}">
                    <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}"
                               Foreground="{StaticResource ThirdlyTextBrush}"
                               Text="{x:Static resources:Strings.Home_CumulativeQuality}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                   Text="{Binding QualityRateDisplay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding QualityRate, Converter={StaticResource QualityThreshold}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QualityRateDisplay}" Value="—">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Bottom"
                                   FontSize="{DynamicResource FontSizeHint}" FontWeight="Bold"
                                   Text="{Binding QualityGapText}"
                                   ToolTip="{Binding QualityGapTooltip}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding QualityRate, Converter={StaticResource QualityThreshold}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QualityRateDisplay}" Value="—">
                                            <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" ToolTip="{x:Static resources:Strings.Home_Tip_QualityTrend}">
                <oxy:PlotView Model="{Binding QualityTrendChart}" Background="Transparent">
                    <oxy:PlotView.Style>
                        <Style TargetType="oxy:PlotView">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QualityTrendChart}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </oxy:PlotView.Style>
                </oxy:PlotView>
                <controls:EmptyState IconKind="ChartLineVariant" Message="{x:Static resources:Strings.K051}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:EmptyState.Style>
                        <Style TargetType="controls:EmptyState">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QualityTrendChart}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyState.Style>
                </controls:EmptyState>
            </Grid>
        </Grid>
    </Border>
</UserControl>
