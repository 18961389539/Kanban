<UserControl
    x:Class="MainAPP.Views.HomeQualityRateCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="500" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        主页仪表板卡片 5：合格率概览（合格率饼图 + OK/NG + 班次对比）。
        DataContext 由父级 HomeView 传入 HomeViewModel。
        共享样式（DashboardCard/CardTitleIcon/CardTitleText）从全局资源字典 HomeResources.xaml 查找。
        OkDiffBadge/NgDiffBadge 仅本卡片使用，放本地 Resources。
    -->
    <UserControl.Resources>
        <!--
            班次对比差异徽章共用样式：基于 ComparisonConverter 判断 diff 正负切换颜色。
            空文本（无差异）时隐藏徽章。
            - OkDiffBadge：默认绿色（OK 增长=好），diff<0 时变红（OK 下降=坏）
            - NgDiffBadge：默认红色（NG 增加=坏），diff<0 时变绿（NG 减少=好）
            抽取为命名样式避免在 XAML 主体中重复内联 Style。
        -->
        <Style x:Key="OkDiffBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShiftOutputDiffText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShiftOutputDiff, Converter={StaticResource ComparisonConverter}, ConverterParameter=&lt;0}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NgDiffBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShiftNgDiffText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShiftNgDiff, Converter={StaticResource ComparisonConverter}, ConverterParameter=&lt;0}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource DashboardCard}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 主体区 *（2026-08-11 布局修正）：弹性行 + 内容垂直居中——空白在饼图上下
                     对称分布且被大饼图压缩，班次区紧贴底部（Auto 模式会把空白留在班次区下方） -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,12" Orientation="Horizontal">
                <materialIcons:MaterialIcon Style="{StaticResource CardTitleIcon}" Kind="CheckCircle" />
                <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static resources:Strings.K328}" />
                <!-- 良品率状态 chip 已移除（2026-08-11 用户要求）：达标状态由大数字与
                     距目标差距行的 QualityThreshold 着色表达（≥95% 绿 / 未达红） -->
                <TextBlock Style="{StaticResource HomeDataStatusBadge}" Text="{Binding DataStatusText}" ToolTip="{Binding DataStatusTooltip}" />
            </StackPanel>

            <!-- 主体：左侧小环图 + 右侧详细指标。
                 原 HorizontalAlignment=Center + 双 Auto 列会在内容（如 6 位数产量）变宽时整体居中溢出卡片边界，
                 导致右侧数字被推出卡片而显示不全。改为 Stretch + 列1 占 *，让右侧区铺满饼图右侧剩余宽度，
                 数字右对齐贴卡片右内边界，完整显示。 -->
            <Grid Grid.Row="1" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：小饼图 + 中心合格率（2026-08-11：160→180 继续放大，垂直居中与右侧文本对称平衡） -->
                <Grid Grid.Column="0" Width="180" Height="180" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <oxy:PlotView Width="180" Height="180" Model="{Binding QualityPieChart}" Background="Transparent">
                        <oxy:PlotView.Style>
                            <Style TargetType="oxy:PlotView">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QualityPieChart}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </oxy:PlotView.Style>
                    </oxy:PlotView>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                               Foreground="{Binding QualityRate, Converter={StaticResource QualityThreshold}}"
                               Text="{Binding QualityRateDisplay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QualityPieChart}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 空状态 -->
                    <controls:EmptyState IconKind="CheckCircleOutline" Message="{x:Static resources:Strings.K051}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QualityPieChart}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>
                </Grid>

                <!-- 右侧：指标明细。HorizontalAlignment=Stretch 让其在列1(* 宽)内铺满，
                     内部 DockPanel 右对齐的数字贴右边界，避免溢出卡片。
                     VerticalAlignment=Center（2026-08-11）：饼图放大到 160 后与右侧文本
                     均垂直居中，左右对称平衡。 -->
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                    <!-- 合格率 -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                   Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K084}" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeHero}" FontWeight="Bold"
                                   Foreground="{Binding QualityRate, Converter={StaticResource QualityThreshold}}"
                                   Text="{Binding QualityRateDisplay}" />
                    </DockPanel>
                    <!-- 距目标差距（2026-08-11）：+0.6% 超目标（绿）/ -0.5% 还差（红），阈值与 chip 同源 -->
                    <TextBlock Margin="0,2,0,0" HorizontalAlignment="Right"
                               FontSize="{DynamicResource FontSizeHint}" FontWeight="Bold"
                               Foreground="{Binding QualityRate, Converter={StaticResource QualityThreshold}}"
                               Text="{Binding QualityGapText}" />

                    <!-- 总产量 -->
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                   Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K023}" />
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding TotalOutputDisplay}" />
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Bottom"
                                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource ThirdlyTextBrush}"
                                       Text="{x:Static resources:Strings.K014}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- OK / NG 双列：2026-08-11 按用户要求移除（主体区只保留合格率/总产量/不良率，
                         班次对比区仍有 OK/NG 明细） -->

                    <!-- 不良率：使用 InverseRatioThreshold（低=好），避免高不良率被染绿 -->
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                   Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K085}" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                   Foreground="{Binding NgRate, Converter={StaticResource InverseRatioThreshold}}"
                                   Text="{Binding NgRate, StringFormat={}{0:P2}}" />
                    </DockPanel>
                </StackPanel>
            </Grid>

            <!-- 班次产量对比：本班次 vs 上班次（顶部间距 12→4，2026-08-11 按用户要求上移贴近主体区） -->
            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                <!-- 本班次 -->
                <Border Padding="10,6" CornerRadius="6"
                        Background="{StaticResource SecondaryRegionBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource PrimaryBrush}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}" Text="{x:Static resources:Strings.K078}" />
                        </StackPanel>
                        <!-- OK + diff -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource SuccessBrush}" />
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}"
                                       Foreground="{StaticResource SecondaryTextBrush}" Text="OK" />
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiSm}"
                                       FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding ShiftOkProductionDisplay, Converter={StaticResource LocFormatConverter}, ConverterParameter=F245}" />
                            <TextBlock Style="{StaticResource OkDiffBadge}"
                                       Text="{Binding ShiftOutputDiffText}" />
                        </StackPanel>
                        <!-- NG + diff -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource DangerBrush}" />
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}"
                                       Foreground="{StaticResource SecondaryTextBrush}" Text="NG" />
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiSm}"
                                       FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding ShiftNgProductionDisplay, Converter={StaticResource LocFormatConverter}, ConverterParameter=F245}" />
                            <TextBlock Style="{StaticResource NgDiffBadge}"
                                       Text="{Binding ShiftNgDiffText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 上班次：始终显示；无数据时标签只显示"上班次"、OK/NG 显示 0（2026-08-11 用户要求） -->
                <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="6"
                        Background="{StaticResource SecondaryRegionBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource ThirdlyTextBrush}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding LastShiftLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource SuccessBrush}" />
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}"
                                       Foreground="{StaticResource SecondaryTextBrush}" Text="OK" />
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiSm}"
                                       FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding LastShiftOk, Converter={StaticResource LocFormatConverter}, ConverterParameter=F245}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource DangerBrush}" />
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}"
                                       Foreground="{StaticResource SecondaryTextBrush}" Text="NG" />
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiSm}"
                                       FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding LastShiftNg, Converter={StaticResource LocFormatConverter}, ConverterParameter=F245}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
