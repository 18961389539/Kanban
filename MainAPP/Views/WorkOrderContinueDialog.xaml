<Window
    x:Class="MainAPP.Views.WorkOrderContinueDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:resources="clr-namespace:MainAPP.Resources"
    Title="{x:Static resources:Strings.Wo_ContinueTitle}"
    Width="480"
    SizeToContent="Height"
    Background="{StaticResource RegionBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            FontWeight="Medium"
            Foreground="{StaticResource PrimaryTextBrush}"
            Text="{Binding Message}"
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="1"
            Margin="0,16,0,6"
            FontSize="{DynamicResource FontSizeHint}"
            Foreground="{StaticResource SecondaryTextBrush}"
            Text="{x:Static resources:Strings.Wo_ContinuePendingList}" />

        <hc:ComboBox
            Grid.Row="2"
            hc:InfoElement.Placeholder="{x:Static resources:Strings.Wo_ContinueNoPending}"
            AutomationProperties.Name="{x:Static resources:Strings.Wo_ContinuePendingList}"
            DisplayMemberPath="DisplayText"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            IsEnabled="{Binding HasPendingOrders}"
            ItemsSource="{Binding PendingOrders}"
            SelectedItem="{Binding SelectedPending, Mode=TwoWay}"
            Style="{StaticResource ComboBoxExtend}" />

        <Button
            Grid.Row="3"
            Margin="0,12,0,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            AutomationProperties.Name="{x:Static resources:Strings.Wo_ContinueSelect}"
            Click="Select_Click"
            Content="{x:Static resources:Strings.Wo_ContinueSelect}"
            IsEnabled="{Binding HasPendingOrders}"
            Style="{StaticResource IconButtonPrimary}"
            Tag="{x:Static mi:MaterialIconKind.ClipboardListOutline}"
            ToolTip="{x:Static resources:Strings.Wo_ContinueSelectHint}" />

        <Button
            Grid.Row="4"
            Margin="0,8,0,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            AutomationProperties.Name="{x:Static resources:Strings.Wo_ContinueCreate}"
            Click="Create_Click"
            Content="{x:Static resources:Strings.Wo_ContinueCreate}"
            Style="{StaticResource IconButtonDefault}"
            Tag="{x:Static mi:MaterialIconKind.Plus}"
            ToolTip="{x:Static resources:Strings.Wo_ContinueCreateHint}" />

        <Button
            Grid.Row="5"
            Margin="0,8,0,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            AutomationProperties.Name="{x:Static resources:Strings.Wo_ContinueCopy}"
            Click="Copy_Click"
            Content="{x:Static resources:Strings.Wo_ContinueCopy}"
            Style="{StaticResource IconButtonSuccess}"
            Tag="{x:Static mi:MaterialIconKind.ContentCopy}"
            ToolTip="{x:Static resources:Strings.Wo_ContinueCopyHint}" />

        <Button
            Grid.Row="6"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Width="100"
            AutomationProperties.Name="{x:Static resources:Strings.Wo_ContinueLater}"
            Click="Later_Click"
            Content="{x:Static resources:Strings.Wo_ContinueLater}"
            IsCancel="True"
            Style="{StaticResource ButtonDefault}" />
    </Grid>
</Window>
