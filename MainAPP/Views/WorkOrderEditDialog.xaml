<Window
    x:Class="MainAPP.Views.WorkOrderEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="工单编辑"
    Width="520"
    Height="640"
    Background="{StaticResource RegionBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    FocusManager.FocusedElement="{Binding ElementName=OrderNoBox}"
    mc:Ignorable="d">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  工单号  -->
        <hc:TextBox
            x:Name="OrderNoBox"
            Grid.Row="0"
            Margin="0,0,0,12"
            hc:InfoElement.Title="工单号"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="工单号"
            FontSize="14"
            Style="{StaticResource TextBoxExtend}"
            Text="{Binding OrderNo, UpdateSourceTrigger=PropertyChanged}" />

        <!--  产品编码  -->
        <hc:TextBox
            x:Name="ProductCodeBox"
            Grid.Row="1"
            Margin="0,0,0,12"
            hc:InfoElement.Title="产品编码"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="产品编码"
            FontSize="14"
            Style="{StaticResource TextBoxExtend}"
            Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" />

        <!--  产品名称  -->
        <hc:TextBox
            x:Name="ProductNameBox"
            Grid.Row="2"
            Margin="0,0,0,12"
            hc:InfoElement.Title="产品名称"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="产品名称"
            FontSize="14"
            Style="{StaticResource TextBoxExtend}"
            Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" />

        <!--  绑定设备  -->
        <hc:ComboBox
            x:Name="DeviceComboBox"
            Grid.Row="3"
            Margin="0,0,0,12"
            hc:InfoElement.Title="绑定设备"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="绑定设备"
            DisplayMemberPath="Name"
            FontSize="14"
            ItemsSource="{Binding AvailableDevices}"
            SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay}"
            SelectedValuePath="Id"
            Style="{StaticResource ComboBoxExtend}" />

        <!--  计划产量  -->
        <hc:TextBox
            x:Name="TargetQuantityBox"
            Grid.Row="4"
            Margin="0,0,0,12"
            hc:InfoElement.Title="计划产量（件）"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="计划产量"
            FontSize="14"
            Style="{StaticResource TextBoxExtend}"
            Text="{Binding TargetQuantityText, UpdateSourceTrigger=PropertyChanged}" />

        <!--  计划开始时间  -->
        <hc:DateTimePicker
            x:Name="PlannedStartPicker"
            Grid.Row="5"
            Margin="0,0,0,12"
            hc:InfoElement.Title="计划开始时间"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="计划开始时间"
            FontSize="14"
            SelectedDateTime="{Binding PlannedStart, Mode=TwoWay}"
            Style="{StaticResource DateTimePickerExtend}" />

        <!--  计划结束时间  -->
        <hc:DateTimePicker
            x:Name="PlannedEndPicker"
            Grid.Row="6"
            Margin="0,0,0,12"
            hc:InfoElement.Title="计划结束时间"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="计划结束时间"
            FontSize="14"
            SelectedDateTime="{Binding PlannedEnd, Mode=TwoWay}"
            Style="{StaticResource DateTimePickerExtend}" />

        <!--  备注  -->
        <hc:TextBox
            x:Name="RemarkBox"
            Grid.Row="7"
            Margin="0,0,0,12"
            hc:InfoElement.Title="备注"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="备注"
            FontSize="14"
            Style="{StaticResource TextBoxExtend}"
            Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" />

        <!--  占位  -->
        <Border Grid.Row="9" />

        <!--  操作按钮  -->
        <StackPanel
            Grid.Row="10"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Click="Cancel_Click"
                Content="取消"
                IsCancel="True"
                Style="{StaticResource ButtonDefault}" />
            <Button
                Margin="8,0,0,0"
                Width="80"
                Click="Confirm_Click"
                Content="确定"
                IsDefault="True"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </Grid>
</Window>
