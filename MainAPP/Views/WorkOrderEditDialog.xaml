<Window
    x:Class="MainAPP.Views.WorkOrderEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Static resources:Strings.K552}"
    Width="520"
    Height="640"
    Background="{StaticResource RegionBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    FocusManager.FocusedElement="{Binding ElementName=OrderNoBox}"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  工单号  -->
        <hc:TextBox
            x:Name="OrderNoBox"
            Grid.Row="0"
            Margin="0,0,0,12"
            hc:InfoElement.Title="{x:Static resources:Strings.K008}"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="{x:Static resources:Strings.K008}"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            Style="{StaticResource TextBoxExtend}"
            Text="{Binding OrderNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <!--  产品编码  -->
        <hc:TextBox
            x:Name="ProductCodeBox"
            Grid.Row="1"
            Margin="0,0,0,12"
            hc:InfoElement.Title="{x:Static resources:Strings.K019}"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="{x:Static resources:Strings.K019}"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            Style="{StaticResource TextBoxExtend}"
            Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <!--  产品名称  -->
        <hc:TextBox
            x:Name="ProductNameBox"
            Grid.Row="2"
            Margin="0,0,0,12"
            hc:InfoElement.Title="{x:Static resources:Strings.K020}"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="{x:Static resources:Strings.K020}"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            Style="{StaticResource TextBoxExtend}"
            Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <!--  绑定设备  -->
        <hc:ComboBox
            x:Name="DeviceComboBox"
            Grid.Row="3"
            Margin="0,0,0,12"
            hc:InfoElement.Title="{x:Static resources:Strings.K041}"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="{x:Static resources:Strings.K041}"
            DisplayMemberPath="Name"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            ItemsSource="{Binding AvailableDevices}"
            SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
            SelectedValuePath="Id"
            Style="{StaticResource ComboBoxExtend}"
            Validation.ErrorTemplate="{StaticResource SafeValidationErrorTemplate}" />

        <!--  计划产量  -->
        <hc:TextBox
            x:Name="TargetQuantityBox"
            Grid.Row="4"
            Margin="0,0,0,12"
            hc:InfoElement.Title="{x:Static resources:Strings.K553}"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="{x:Static resources:Strings.K035}"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            Style="{StaticResource TextBoxExtend}"
            Text="{Binding TargetQuantityText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <!--  计划开始时间  -->
        <hc:DateTimePicker
            x:Name="PlannedStartPicker"
            Grid.Row="5"
            Margin="0,0,0,12"
            hc:InfoElement.Title="{x:Static resources:Strings.K119}"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="{x:Static resources:Strings.K119}"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            SelectedDateTime="{Binding PlannedStart, Mode=TwoWay}"
            Style="{StaticResource DateTimePickerExtend}" />

        <!--  计划结束时间  -->
        <hc:DateTimePicker
            x:Name="PlannedEndPicker"
            Grid.Row="6"
            Margin="0,0,0,12"
            hc:InfoElement.Title="{x:Static resources:Strings.K120}"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="{x:Static resources:Strings.K120}"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            SelectedDateTime="{Binding PlannedEnd, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
            Style="{StaticResource DateTimePickerExtend}"
            Validation.ErrorTemplate="{StaticResource SafeValidationErrorTemplate}" />

        <!--  备注  -->
        <hc:TextBox
            x:Name="RemarkBox"
            Grid.Row="7"
            Margin="0,0,0,12"
            hc:InfoElement.Title="{x:Static resources:Strings.K021}"
            hc:InfoElement.TitlePlacement="Top"
            AutomationProperties.Name="{x:Static resources:Strings.K021}"
            FontSize="{DynamicResource FontSizeKpiLabel}"
            Style="{StaticResource TextBoxExtend}"
            Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" />

        <!--  占位  -->
        <Border Grid.Row="9" />

        <!--  操作按钮  -->
        <StackPanel
            Grid.Row="10"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Click="Cancel_Click"
                Content="{x:Static resources:Strings.K092}"
                IsCancel="True"
                Style="{StaticResource ButtonDefault}" />
            <Button
                Margin="8,0,0,0"
                Width="80"
                Click="Confirm_Click"
                Content="{x:Static resources:Strings.K093}"
                IsDefault="True"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </Grid>
</Window>
