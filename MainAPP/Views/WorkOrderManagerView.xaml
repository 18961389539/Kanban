<UserControl
    x:Class="MainAPP.Views.WorkOrderManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:entities="clr-namespace:Kanban.Core.Entities;assembly=Kanban.Collector.Core"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.Resources>
        <!--  工单状态色点/文本/筛选 chip 已全局化至 Styles/Components.xaml（StatusDot/StatusText/TimePresetChip）  -->
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!--  响应式：左列工单列表与右列详情按 2:3 分配，配合 MinWidth 防止过窄。
                  中间列为可拖拽分隔条占位列（参照设备管理器页），分隔条常驻。  -->
            <ColumnDefinition Width="2*" MinWidth="440" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="3*" MinWidth="480" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左侧：工单列表 ============  -->
        <Border Grid.Column="0" Padding="0" Style="{StaticResource MainCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <DockPanel Grid.Row="0" Margin="18,18,18,10">
                    <materialIcons:MaterialIcon Kind="ClipboardListOutline" Style="{StaticResource SectionTitleIcon}" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K554}" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{StaticResource ThirdlyTextBrush}"
                               Text="{Binding WorkOrders.Count, StringFormat={}({0})}" />
                </DockPanel>

                <!--  搜索 + 设备筛选（状态筛选已由下方 chip 单选组承担，避免重复 UI）  -->
                <Grid Grid.Row="1" Margin="18,0,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <hc:TextBox Grid.Column="0"
                                hc:InfoElement.Placeholder="{x:Static resources:Strings.K555}"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                    <hc:ComboBox Grid.Column="2"
                                 FontSize="{DynamicResource FontSizeCaption}"
                                 hc:InfoElement.Placeholder="{x:Static resources:Strings.K002}"
                                 ItemsSource="{Binding DeviceOptions}"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Id"
                                 SelectedValue="{Binding DeviceFilter, Mode=TwoWay}"
                                 Style="{StaticResource ComboBoxExtend}" />
                </Grid>

                <!-- 高级筛选：按计划日期和生产结果快速定位异常工单 -->
                <WrapPanel Grid.Row="2" Margin="18,0,18,8">
                    <DatePicker Width="128" Margin="0,0,6,4" SelectedDate="{Binding FilterFromDate, Mode=TwoWay}" ToolTip="{x:Static resources:Strings.K556}" />
                    <DatePicker Width="128" Margin="0,0,12,4" SelectedDate="{Binding FilterToDate, Mode=TwoWay}" ToolTip="{x:Static resources:Strings.K557}" />
                    <ComboBox Width="150" Margin="0,0,12,4"
                              AutomationProperties.Name="{x:Static resources:Strings.K558}"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding SortOptions}"
                              SelectedValue="{Binding SortMode, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              Style="{StaticResource ComboBoxExtend}"
                              ToolTip="{x:Static resources:Strings.K559}" />
                    <CheckBox Margin="0,0,12,4" VerticalAlignment="Center" Content="{x:Static resources:Strings.K560}" IsChecked="{Binding OnlyOverdue, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,4" VerticalAlignment="Center" Content="{x:Static resources:Strings.K561}" IsChecked="{Binding OnlyAchieved, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,4" VerticalAlignment="Center" Content="{x:Static resources:Strings.K562}" IsChecked="{Binding OnlyHasNg, Mode=TwoWay}" />
                </WrapPanel>

                <!--  状态分布概览：一眼看到各状态工单数量，点击切换筛选（RadioButton 单选互斥）  -->
                <StackPanel Grid.Row="3" Margin="18,0,18,8" Orientation="Horizontal">
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="{x:Null}"
                                 Content="{x:Static resources:Strings.K004}" Style="{StaticResource TimePresetChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="{x:Null}" />
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="{x:Static entities:WorkOrderStatus.Pending}"
                                 Style="{StaticResource TimePresetChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="{x:Static entities:WorkOrderStatus.Pending}" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static resources:Strings.K010}" />
                                <TextBlock FontWeight="Bold" Text="{Binding PendingCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="{x:Static entities:WorkOrderStatus.Running}"
                                 Style="{StaticResource TimePresetChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="{x:Static entities:WorkOrderStatus.Running}" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static resources:Strings.K011}" />
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding RunningCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="{x:Static entities:WorkOrderStatus.Completed}"
                                 Style="{StaticResource TimePresetChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="{x:Static entities:WorkOrderStatus.Completed}" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static resources:Strings.K012}" />
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Text="{Binding CompletedCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="{x:Static entities:WorkOrderStatus.Aborted}"
                                 Style="{StaticResource TimePresetChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="{x:Static entities:WorkOrderStatus.Aborted}" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static resources:Strings.K013}" />
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Text="{Binding AbortedCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource ThirdlyTextBrush}"
                               Text="{Binding FilteredCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F259}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}"
                               Text="{Binding OverdueCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F260}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}"
                               Text="{Binding AchievedCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F261}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}"
                               Text="{Binding NgWorkOrderCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F262}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}"
                               Text="{Binding ScheduleConflictCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F263}" />
                </StackPanel>

                <!--  列表表头  -->
                <Grid Grid.Row="4" Margin="18,0,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K563}" />
                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K002}" />
                    <TextBlock Grid.Column="2" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K003}" />
                </Grid>

                <!--  工单列表 + 空状态提示  -->
                <Grid Grid.Row="5">
                    <ListBox
                        Margin="0,0,0,0"
                        ItemsSource="{Binding FilteredView}"
                        SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource CardListItemStyle}"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        VirtualizingStackPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{Binding OrderNo}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" />
                                        <!--  产量进度（Production 非 null 时显示：已生产 OkCount / 计划 TargetQuantity 件）  -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                    Visibility="{Binding Production, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                       Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K564}" />
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       Text="{Binding Production.OkCount}" />
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                       Foreground="{StaticResource ThirdlyTextBrush}" Text=" / " />
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                       Foreground="{StaticResource ThirdlyTextBrush}"
                                                       Text="{Binding TargetQuantity}" />
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                       Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K014}" />
                                            <TextBlock Margin="8,0,0,0" FontSize="{DynamicResource FontSizeHint}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="{Binding Production.ScheduleStatusText}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource StatusDot}" />
                                        <TextBlock Margin="6,0,0,0" Style="{StaticResource StatusText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  空状态：筛选无结果或无工单时提示  -->
                    <controls:EmptyState
                        Hint="{x:Static resources:Strings.K565}"
                        IconKind="ClipboardListOutline"
                        Message="{x:Static resources:Strings.K566}">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredView.IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>
                </Grid>

                <!--  底部操作按钮  -->
                <DockPanel Grid.Row="6" Margin="18,12,18,18" LastChildFill="False">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding AddCommand}" Content="{x:Static resources:Strings.K033}" Style="{StaticResource IconButtonPrimary}"
                                Tag="{x:Static mi:MaterialIconKind.Plus}" />
                        <Button Margin="8,0,0,0" Command="{Binding EditCommand}" Content="{x:Static resources:Strings.K072}" Style="{StaticResource IconButtonDefault}"
                                Tag="{x:Static mi:MaterialIconKind.PencilOutline}" />
                        <Button Margin="8,0,0,0" Command="{Binding CopyCommand}" Content="{x:Static resources:Strings.K026}" Style="{StaticResource IconButtonDefault}"
                            Tag="{x:Static mi:MaterialIconKind.ContentCopy}" ToolTip="{x:Static resources:Strings.K567}" />
                        <Button Margin="8,0,0,0" Command="{Binding DeleteCommand}" Content="{x:Static resources:Strings.K034}" Style="{StaticResource IconButtonDanger}"
                                Tag="{x:Static mi:MaterialIconKind.Delete}" />
                        <Button Margin="8,0,0,0" Command="{Binding RefreshAllProductionCommand}" Content="{x:Static resources:Strings.K568}"
                                Style="{StaticResource IconButtonDefault}"
                                Tag="{x:Static mi:MaterialIconKind.ChartLineVariant}"
                                ToolTip="{x:Static resources:Strings.K569}" />
                        <Button Margin="8,0,0,0" Command="{Binding ExportCsvCommand}" Content="{x:Static resources:Strings.K079}"
                                Style="{StaticResource IconButtonDefault}"
                                Tag="{x:Static mi:MaterialIconKind.FileExportOutline}"
                                ToolTip="{x:Static resources:Strings.K570}" />
                    </StackPanel>
                    <!--  生成样本工单（需密码确认）  -->
                    <Button DockPanel.Dock="Right"
                            Command="{Binding SeedSampleWorkOrdersCommand}"
                            Content="{x:Static resources:Strings.K571}"
                            Style="{StaticResource IconButtonDefault}"
                            Tag="{x:Static mi:MaterialIconKind.ToyBrickPlus}"
                            ToolTip="{x:Static resources:Strings.K572}" />
                </DockPanel>
            </Grid>
        </Border>

        <!--  ============ 中间：可拖拽分隔条（参照设备管理器页，常驻）  ============  -->
        <GridSplitter
            Grid.Column="1"
            Width="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeWE"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            AutomationProperties.Name="{x:Static resources:Strings.K573}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Rectangle
                            x:Name="Grip"
                            Width="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Fill="{StaticResource BorderBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Fill" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Grip" Property="Width" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!--  ============ 右侧：工单详情 + 状态操作  ============  -->
        <Border Grid.Column="2" Padding="0" Style="{StaticResource MainCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <DockPanel Grid.Row="0" Margin="18,18,18,10">
                    <materialIcons:MaterialIcon Kind="ClipboardTextOutline" Style="{StaticResource SectionTitleIcon}" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K073}" />
                </DockPanel>

                <!--  详情内容  -->
                <Grid Grid.Row="1">
                    <!--  无选中时占位：用 EmptyState 替代裸 TextBlock，与列表空态视觉一致  -->
                    <controls:EmptyState
                        IconKind="ClipboardTextOutline"
                        Message="{x:Static resources:Strings.K074}"
                        Hint="{x:Static resources:Strings.K574}">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedWorkOrder}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>

                    <ScrollViewer Margin="18,0,18,12" VerticalScrollBarVisibility="Auto">
                        <!--  详情字段（仅在 SelectedWorkOrder 非 null 时显示）  -->
                        <StackPanel Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}">
                            <!--  工单号  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K008}" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.OrderNo}" />
                            </DockPanel>
                            <!--  产品编码  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K019}" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.ProductCode}" />
                            </DockPanel>
                            <!--  产品名称  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K020}" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.ProductName}" />
                            </DockPanel>
                            <!--  绑定设备  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K041}" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.DeviceName}" />
                            </DockPanel>
                            <!--  计划产量  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K035}" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding SelectedWorkOrder.TargetQuantity, Converter={StaticResource LocFormatConverter}, ConverterParameter=F244}" />
                            </DockPanel>
                            <!--  实际产量统计（SelectedProduction 非 null 时显示）  -->
                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding SelectedProduction, Converter={StaticResource NullToVisibilityConverter}}">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K047}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Text="{Binding SelectedProduction.OkCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F244}" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K575}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                               Foreground="{StaticResource DangerBrush}"
                                               Text="{Binding SelectedProduction.NgCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F244}" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K576}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="{Binding SelectedProduction.AchievementRate, StringFormat={}{0:P1}}" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K085}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                               Foreground="{StaticResource WarningBrush}"
                                               Text="{Binding SelectedProduction.DefectRate, StringFormat={}{0:P1}}" />
                                </DockPanel>
                            </StackPanel>
                            <!--  计划时间（分别绑定 PlannedStart 与 PlannedEnd，避免原 Bug 两处都显示 PlannedStart）  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K075}" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="{Binding SelectedWorkOrder.PlannedStart, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                    <TextBlock Margin="4,0,4,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource ThirdlyTextBrush}" Text="~" />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="{Binding SelectedWorkOrder.PlannedEnd, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                </StackPanel>
                            </DockPanel>
                            <!--  状态  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K003}" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Style="{StaticResource StatusDot}" DataContext="{Binding SelectedWorkOrder}" />
                                    <TextBlock Margin="6,0,0,0" Style="{StaticResource StatusText}" DataContext="{Binding SelectedWorkOrder}" />
                                </StackPanel>
                            </DockPanel>
                            <!--  备注  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Top"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K021}" />
                                <TextBlock VerticalAlignment="Top" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"
                                           Text="{Binding SelectedWorkOrder.Remark, TargetNullValue=—}" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!--  底部状态操作按钮  -->
                <StackPanel Grid.Row="2" Margin="18,0,18,18" Orientation="Horizontal">
                    <Button Command="{Binding StartCommand}" Content="{x:Static resources:Strings.K036}" Style="{StaticResource IconButtonPrimary}"
                            Tag="{x:Static mi:MaterialIconKind.Play}" ToolTip="{Binding StartActionReason}" />
                    <Button Margin="8,0,0,0" Command="{Binding CompleteCommand}" Content="{x:Static resources:Strings.K076}" Style="{StaticResource IconButtonSuccess}"
                            Tag="{x:Static mi:MaterialIconKind.Check}" ToolTip="{Binding CompleteActionReason}" />
                    <Button Margin="8,0,0,0" Command="{Binding AbortCommand}" Content="{x:Static resources:Strings.K077}" Style="{StaticResource IconButtonWarning}"
                            Tag="{x:Static mi:MaterialIconKind.Stop}" ToolTip="{Binding AbortActionReason}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
