<UserControl
    x:Class="MainAPP.Views.WorkOrderManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:entities="clr-namespace:MainAPP.Entities;assembly=Kanban.Collector.Core"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  工单状态 → 显示文本 + 色点画刷（DataTrigger 内联，避免新建转换器）  -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource ThirdlyTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Pending}">
                    <Setter Property="Fill" Value="{StaticResource ThirdlyTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Running}">
                    <Setter Property="Fill" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Completed}">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Aborted}">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Text" Value="—" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Pending}">
                    <Setter Property="Text" Value="待开始" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Running}">
                    <Setter Property="Text" Value="进行中" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Completed}">
                    <Setter Property="Text" Value="已完成" />
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Aborted}">
                    <Setter Property="Text" Value="已中止" />
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--  状态筛选 chip：单选分段按钮风格，选中时高亮  -->
        <Style x:Key="StatusFilterChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!--  响应式：左列工单列表与右列详情按 2:3 分配，配合 MinWidth 防止过窄。
                  中间列为可拖拽分隔条占位列（参照设备管理器页），分隔条常驻。  -->
            <ColumnDefinition Width="2*" MinWidth="440" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="3*" MinWidth="480" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左侧：工单列表 ============  -->
        <Border Grid.Column="0" Padding="0" Style="{StaticResource MainCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <DockPanel Grid.Row="0" Margin="18,18,18,10">
                    <materialIcons:MaterialIcon Kind="ClipboardListOutline" Style="{StaticResource SectionTitleIcon}" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource SectionTitleText}" Text="工单列表" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{StaticResource ThirdlyTextBrush}"
                               Text="{Binding WorkOrders.Count, StringFormat={}({0})}" />
                </DockPanel>

                <!--  搜索 + 设备筛选（状态筛选已由下方 chip 单选组承担，避免重复 UI）  -->
                <Grid Grid.Row="1" Margin="18,0,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <hc:TextBox Grid.Column="0"
                                hc:InfoElement.Placeholder="搜索工单号/产品/设备"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                    <hc:ComboBox Grid.Column="2"
                                 FontSize="{DynamicResource FontSizeCaption}"
                                 hc:InfoElement.Placeholder="设备"
                                 ItemsSource="{Binding DeviceOptions}"
                                 SelectedItem="{Binding DeviceFilter, Mode=TwoWay}"
                                 Style="{StaticResource ComboBoxExtend}" />
                </Grid>

                <!-- 高级筛选：按计划日期和生产结果快速定位异常工单 -->
                <WrapPanel Grid.Row="2" Margin="18,0,18,8">
                    <DatePicker Width="128" Margin="0,0,6,4" SelectedDate="{Binding FilterFromDate, Mode=TwoWay}" ToolTip="计划时间从" />
                    <DatePicker Width="128" Margin="0,0,12,4" SelectedDate="{Binding FilterToDate, Mode=TwoWay}" ToolTip="计划时间至" />
                    <ComboBox Width="150" Margin="0,0,12,4"
                              AutomationProperties.Name="工单排程排序"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding SortOptions}"
                              SelectedValue="{Binding SortMode, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              Style="{StaticResource ComboBoxExtend}"
                              ToolTip="按计划时间或状态排序" />
                    <CheckBox Margin="0,0,12,4" VerticalAlignment="Center" Content="仅超期" IsChecked="{Binding OnlyOverdue, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,4" VerticalAlignment="Center" Content="仅达标" IsChecked="{Binding OnlyAchieved, Mode=TwoWay}" />
                    <CheckBox Margin="0,0,12,4" VerticalAlignment="Center" Content="有 NG" IsChecked="{Binding OnlyHasNg, Mode=TwoWay}" />
                </WrapPanel>

                <!--  状态分布概览：一眼看到各状态工单数量，点击切换筛选（RadioButton 单选互斥）  -->
                <StackPanel Grid.Row="3" Margin="18,0,18,8" Orientation="Horizontal">
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="全部"
                                 Content="全部" Style="{StaticResource StatusFilterChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="全部" />
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="待开始"
                                 Style="{StaticResource StatusFilterChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="待开始" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="待开始 " />
                                <TextBlock FontWeight="Bold" Text="{Binding PendingCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="进行中"
                                 Style="{StaticResource StatusFilterChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="进行中" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="进行中 " />
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding RunningCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="已完成"
                                 Style="{StaticResource StatusFilterChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="已完成" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="已完成 " />
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Text="{Binding CompletedCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="已中止"
                                 Style="{StaticResource StatusFilterChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="已中止" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="已中止 " />
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Text="{Binding AbortedCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource ThirdlyTextBrush}"
                               Text="{Binding FilteredCount, StringFormat=显示 {0} 条}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}"
                               Text="{Binding OverdueCount, StringFormat=超期 {0}}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}"
                               Text="{Binding AchievedCount, StringFormat=达标 {0}}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}"
                               Text="{Binding NgWorkOrderCount, StringFormat=有NG {0}}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}"
                               Text="{Binding ScheduleConflictCount, StringFormat=计划冲突 {0}}" />
                </StackPanel>

                <!--  列表表头  -->
                <Grid Grid.Row="4" Margin="18,0,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="工单号 / 产品" />
                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="设备" />
                    <TextBlock Grid.Column="2" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="状态" />
                </Grid>

                <!--  工单列表 + 空状态提示  -->
                <Grid Grid.Row="5">
                    <ListBox
                        Margin="0,0,0,0"
                        ItemsSource="{Binding FilteredView}"
                        SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource CardListItemStyle}"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        VirtualizingStackPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{Binding OrderNo}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" />
                                        <!--  产量进度（Production 非 null 时显示：已生产 OkCount / 计划 TargetQuantity 件）  -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                    Visibility="{Binding Production, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                       Foreground="{StaticResource ThirdlyTextBrush}" Text="已生产 " />
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       Text="{Binding Production.OkCount}" />
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                       Foreground="{StaticResource ThirdlyTextBrush}" Text=" / " />
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                       Foreground="{StaticResource ThirdlyTextBrush}"
                                                       Text="{Binding TargetQuantity}" />
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                       Foreground="{StaticResource ThirdlyTextBrush}" Text=" 件" />
                                            <TextBlock Margin="8,0,0,0" FontSize="{DynamicResource FontSizeHint}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="{Binding Production.ScheduleStatusText}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource StatusDot}" />
                                        <TextBlock Margin="6,0,0,0" Style="{StaticResource StatusText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  空状态：筛选无结果或无工单时提示  -->
                    <controls:EmptyState
                        Hint="点击下方「新增」或调整筛选条件"
                        IconKind="ClipboardListOutline"
                        Message="未找到匹配的工单">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredView.IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>
                </Grid>

                <!--  底部操作按钮  -->
                <DockPanel Grid.Row="6" Margin="18,12,18,18" LastChildFill="False">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding AddCommand}" Content="新增" Style="{StaticResource IconButtonPrimary}"
                                Tag="{x:Static mi:MaterialIconKind.Plus}" />
                        <Button Margin="8,0,0,0" Command="{Binding EditCommand}" Content="编辑" Style="{StaticResource IconButtonDefault}"
                                Tag="{x:Static mi:MaterialIconKind.PencilOutline}" />
                        <Button Margin="8,0,0,0" Command="{Binding CopyCommand}" Content="复制" Style="{StaticResource IconButtonDefault}"
                            Tag="{x:Static mi:MaterialIconKind.ContentCopy}" ToolTip="复制当前工单并创建新的待开始工单" />
                        <Button Margin="8,0,0,0" Command="{Binding DeleteCommand}" Content="删除" Style="{StaticResource IconButtonDanger}"
                                Tag="{x:Static mi:MaterialIconKind.Delete}" />
                        <Button Margin="8,0,0,0" Command="{Binding RefreshAllProductionCommand}" Content="刷新产量"
                                Style="{StaticResource IconButtonDefault}"
                                Tag="{x:Static mi:MaterialIconKind.ChartLineVariant}"
                                ToolTip="查询所有工单的产量数据并更新列表进度" />
                        <Button Margin="8,0,0,0" Command="{Binding ExportCsvCommand}" Content="导出"
                                Style="{StaticResource IconButtonDefault}"
                                Tag="{x:Static mi:MaterialIconKind.FileExportOutline}"
                                ToolTip="导出当前筛选结果到 CSV 文件" />
                    </StackPanel>
                    <!--  生成样本工单（需密码确认）  -->
                    <Button DockPanel.Dock="Right"
                            Command="{Binding SeedSampleWorkOrdersCommand}"
                            Content="生成样本"
                            Style="{StaticResource IconButtonDefault}"
                            Tag="{x:Static mi:MaterialIconKind.ToyBrickPlus}"
                            ToolTip="生成样本工单用于预览（需密码确认）" />
                </DockPanel>
            </Grid>
        </Border>

        <!--  ============ 中间：可拖拽分隔条（参照设备管理器页，常驻）  ============  -->
        <GridSplitter
            Grid.Column="1"
            Width="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeWE"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            AutomationProperties.Name="调整工单列表与工单详情的宽度">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Rectangle
                            x:Name="Grip"
                            Width="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Fill="{StaticResource BorderBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Fill" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Grip" Property="Width" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!--  ============ 右侧：工单详情 + 状态操作  ============  -->
        <Border Grid.Column="2" Padding="0" Style="{StaticResource MainCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <DockPanel Grid.Row="0" Margin="18,18,18,10">
                    <materialIcons:MaterialIcon Kind="ClipboardTextOutline" Style="{StaticResource SectionTitleIcon}" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource SectionTitleText}" Text="工单详情" />
                </DockPanel>

                <!--  详情内容  -->
                <Grid Grid.Row="1">
                    <!--  无选中时占位：用 EmptyState 替代裸 TextBlock，与列表空态视觉一致  -->
                    <controls:EmptyState
                        IconKind="ClipboardTextOutline"
                        Message="请选择左侧工单查看详情"
                        Hint="支持搜索工单号、产品名称或设备名快速定位">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedWorkOrder}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>

                    <ScrollViewer Margin="18,0,18,12" VerticalScrollBarVisibility="Auto">
                        <!--  详情字段（仅在 SelectedWorkOrder 非 null 时显示）  -->
                        <StackPanel Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}">
                            <!--  工单号  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="工单号" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.OrderNo}" />
                            </DockPanel>
                            <!--  产品编码  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="产品编码" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.ProductCode}" />
                            </DockPanel>
                            <!--  产品名称  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="产品名称" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.ProductName}" />
                            </DockPanel>
                            <!--  绑定设备  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="绑定设备" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.DeviceName}" />
                            </DockPanel>
                            <!--  计划产量  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="计划产量" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding SelectedWorkOrder.TargetQuantity, StringFormat={}{0:N0} 件}" />
                            </DockPanel>
                            <!--  实际产量统计（SelectedProduction 非 null 时显示）  -->
                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding SelectedProduction, Converter={StaticResource NullToVisibilityConverter}}">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="合格产量" />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Text="{Binding SelectedProduction.OkCount, StringFormat={}{0:N0} 件}" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="不良产量" />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                               Foreground="{StaticResource DangerBrush}"
                                               Text="{Binding SelectedProduction.NgCount, StringFormat={}{0:N0} 件}" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="达成率" />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="{Binding SelectedProduction.AchievementRate, StringFormat={}{0:P1}}" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="不良率" />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                               Foreground="{StaticResource WarningBrush}"
                                               Text="{Binding SelectedProduction.DefectRate, StringFormat={}{0:P1}}" />
                                </DockPanel>
                            </StackPanel>
                            <!--  计划时间（分别绑定 PlannedStart 与 PlannedEnd，避免原 Bug 两处都显示 PlannedStart）  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="计划时间" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="{Binding SelectedWorkOrder.PlannedStart, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                    <TextBlock Margin="4,0,4,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource ThirdlyTextBrush}" Text="~" />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="{Binding SelectedWorkOrder.PlannedEnd, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                </StackPanel>
                            </DockPanel>
                            <!--  状态  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="状态" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Style="{StaticResource StatusDot}" DataContext="{Binding SelectedWorkOrder}" />
                                    <TextBlock Margin="6,0,0,0" Style="{StaticResource StatusText}" DataContext="{Binding SelectedWorkOrder}" />
                                </StackPanel>
                            </DockPanel>
                            <!--  备注  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Top"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="备注" />
                                <TextBlock VerticalAlignment="Top" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"
                                           Text="{Binding SelectedWorkOrder.Remark, TargetNullValue=—}" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!--  底部状态操作按钮  -->
                <StackPanel Grid.Row="2" Margin="18,0,18,18" Orientation="Horizontal">
                    <Button Command="{Binding StartCommand}" Content="开始" Style="{StaticResource IconButtonPrimary}"
                            Tag="{x:Static mi:MaterialIconKind.Play}" ToolTip="{Binding StartActionReason}" />
                    <Button Margin="8,0,0,0" Command="{Binding CompleteCommand}" Content="完成" Style="{StaticResource IconButtonSuccess}"
                            Tag="{x:Static mi:MaterialIconKind.Check}" ToolTip="{Binding CompleteActionReason}" />
                    <Button Margin="8,0,0,0" Command="{Binding AbortCommand}" Content="中止" Style="{StaticResource IconButtonWarning}"
                            Tag="{x:Static mi:MaterialIconKind.Stop}" ToolTip="{Binding AbortActionReason}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
