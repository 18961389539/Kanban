<UserControl
    x:Class="MainAPP.Views.WorkOrderManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:entities="clr-namespace:Kanban.Collector.Core.Entities;assembly=Kanban.Collector.Core"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    PreviewKeyDown="OnPreviewKeyDown"
    IsVisibleChanged="OnIsVisibleChanged"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.InputBindings>
        <!--  F5：刷新全部可见工单产量（与总览/报警/运行监控等页一致）  -->
        <KeyBinding Key="F5" Command="{Binding RefreshAllProductionCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!--  工单状态色点/文本/筛选 chip 已全局化至 Styles/Components.xaml（StatusDot/StatusText/TimePresetChip） -->
        <!--  列表行右键菜单：ContextMenu 附加在 ListBox 上，PlacementTarget=ListBox；
              DataContext=WorkOrderManagerViewModel。命令无参（作用于 SelectedWorkOrder）；
              code-behind 在 PreviewMouseRightButtonDown 先选中右键行，保证菜单操作的是该行。 -->
        <ContextMenu x:Key="WorkOrderRowContextMenu">
            <MenuItem Command="{Binding PlacementTarget.DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="{x:Static resources:Strings.K072}" />
            <MenuItem Command="{Binding PlacementTarget.DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="{x:Static resources:Strings.K036}" />
            <MenuItem Command="{Binding PlacementTarget.DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="{x:Static resources:Strings.K076}" />
            <MenuItem Command="{Binding PlacementTarget.DataContext.AbortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="{x:Static resources:Strings.K077}" />
            <Separator />
            <MenuItem Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="{x:Static resources:Strings.K026}" />
            <MenuItem Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="{x:Static resources:Strings.K034}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!--  响应式：左列工单列表与右侧详情按 2:3 分配，配合 MinWidth 防止过挤。
                 中间列为可拖拽分隔条占位列（参照设备管理器页），分隔条常驻。 -->
            <ColumnDefinition Width="1.1*" MinWidth="360" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="1.4*" MinWidth="480" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左侧：工单列表（精简：搜索 + 状态 + 列表 + 操作） ============  -->
        <Border Grid.Column="0" Padding="0" Style="{StaticResource MainCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <DockPanel Grid.Row="0" Margin="18,18,18,10">
                    <materialIcons:MaterialIcon Kind="ClipboardListOutline" Style="{StaticResource SectionTitleIcon}" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K554}" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{StaticResource ThirdlyTextBrush}"
                               Text="{Binding FilteredCount, StringFormat={}({0})}" />
                </DockPanel>

                <!--  搜索 + 设备筛选  -->
                <Grid Grid.Row="1" Margin="18,0,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <hc:TextBox Grid.Column="0" x:Name="WorkOrderSearchBox"
                                hc:InfoElement.Placeholder="{x:Static resources:Strings.K555}"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                    <hc:ComboBox Grid.Column="2"
                                 FontSize="{DynamicResource FontSizeCaption}"
                                 hc:InfoElement.Placeholder="{x:Static resources:Strings.K002}"
                                 ItemsSource="{Binding DeviceOptions}"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Id"
                                 SelectedValue="{Binding DeviceFilter, Mode=TwoWay}"
                                 Style="{StaticResource ComboBoxExtend}" />
                </Grid>

                <!--  状态分布：点击切换筛选  -->
                <ScrollViewer Grid.Row="2" Margin="18,0,18,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="{x:Null}"
                                 Content="{x:Static resources:Strings.K004}" Style="{StaticResource TimePresetChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="{x:Null}" />
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="{x:Static entities:WorkOrderStatus.Pending}"
                                 Style="{StaticResource TimePresetChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="{x:Static entities:WorkOrderStatus.Pending}" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static resources:Strings.K010}" />
                                <TextBlock FontWeight="Bold" Text="{Binding PendingCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="{x:Static entities:WorkOrderStatus.Running}"
                                 Style="{StaticResource TimePresetChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="{x:Static entities:WorkOrderStatus.Running}" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static resources:Strings.K011}" />
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding RunningCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="{x:Static entities:WorkOrderStatus.Completed}"
                                 Style="{StaticResource TimePresetChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="{x:Static entities:WorkOrderStatus.Completed}" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static resources:Strings.K012}" />
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Text="{Binding CompletedCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="WoStatusFilter" Click="OnStatusChipClick" Tag="{x:Static entities:WorkOrderStatus.Aborted}"
                                 Style="{StaticResource TimePresetChip}">
                        <RadioButton.IsChecked>
                            <Binding Path="StatusFilter" Mode="OneWay" Converter="{StaticResource EqualityConverter}" ConverterParameter="{x:Static entities:WorkOrderStatus.Aborted}" />
                        </RadioButton.IsChecked>
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static resources:Strings.K013}" />
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Text="{Binding AbortedCount}" />
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!--  工单列表（紧凑行：工单号 + 摘要一行）  -->
                <Grid Grid.Row="3">
                    <ListBox
                        x:Name="WorkOrderListBox"
                        AutomationProperties.AutomationId="WorkOrderListBox"
                        Margin="0,0,0,0"
                        ItemsSource="{Binding FilteredView}"
                        SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource CardListItemStyle}"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        VirtualizingStackPanel.ScrollUnit="Pixel"
                        MouseDoubleClick="OnWorkOrderListDoubleClick"
                        PreviewMouseRightButtonDown="OnWorkOrderListPreviewMouseRightButtonDown"
                        KeyDown="OnWorkOrderListKeyDown"
                        ContextMenu="{StaticResource WorkOrderRowContextMenu}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{Binding OrderNo}" TextTrimming="CharacterEllipsis" />
                                        <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="6" Background="Transparent"
                                                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource CollectionContainsConverter}">
                                                                    <Binding Path="Id" />
                                                                    <Binding Path="DataContext.ConflictOrderIds" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="{DynamicResource FontSizeMicro}" FontWeight="Bold"
                                                       Foreground="{StaticResource WarningBrush}" Text="{x:Static resources:Strings.K762}" />
                                        </Border>
                                        <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="6" Background="Transparent"
                                                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource CollectionContainsConverter}">
                                                                    <Binding Path="Id" />
                                                                    <Binding Path="DataContext.OverdueOrderIds" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="{DynamicResource FontSizeMicro}" FontWeight="Bold"
                                                       Foreground="{StaticResource DangerBrush}" Text="{x:Static resources:Strings.K763}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="4,0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="&#x00B7;" />
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource PrimaryBrush}"
                                                   Text="{Binding Production.AchievementRate, StringFormat={}{0:P0}, TargetNullValue=-}" />
                                        <TextBlock Margin="4,0" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="&#x00B7;" />
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource StatusDot}" Width="7" Height="7" />
                                            <TextBlock Margin="4,0,0,0" Style="{StaticResource StatusText}" FontSize="{DynamicResource FontSizeHint}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  空状态：筛选无结果或无工单时提示  -->
                    <controls:EmptyState
                        Hint="{x:Static resources:Strings.K565}"
                        IconKind="ClipboardListOutline"
                        Message="{x:Static resources:Strings.K566}">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredView.IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>
                </Grid>

                <!--  底部操作：新建 / 编辑 / 删除 + 更多（复制、样本工单）  -->
                <StackPanel Grid.Row="4" Margin="18,12,18,18" Orientation="Horizontal">
                    <Button Margin="0,0,6,0"
                            Command="{Binding AddCommand}" Content="{x:Static resources:Strings.K033}" Style="{StaticResource IconButtonPrimary}"
                            Tag="{x:Static mi:MaterialIconKind.Plus}" />
                    <Button Margin="0,0,6,0"
                            Command="{Binding EditCommand}" Content="{x:Static resources:Strings.K072}" Style="{StaticResource IconButtonDefault}"
                            Tag="{x:Static mi:MaterialIconKind.PencilOutline}" ToolTip="{x:Static resources:Strings.K789}" />
                    <Button Margin="0,0,6,0"
                            Command="{Binding DeleteCommand}" Content="{x:Static resources:Strings.K034}" Style="{StaticResource IconButtonDanger}"
                            Tag="{x:Static mi:MaterialIconKind.Delete}" />
                    <Button x:Name="MoreActionsButton"
                            AutomationProperties.Name="{x:Static resources:Strings.K234}"
                            Click="OnMoreActionsClick"
                            Content="{x:Static resources:Strings.K235}"
                            Style="{StaticResource IconButtonDefault}"
                            Tag="{x:Static mi:MaterialIconKind.DotsHorizontal}"
                            ToolTip="{x:Static resources:Strings.K236}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding CopyCommand}" Header="{x:Static resources:Strings.K026}"
                                          ToolTip="{x:Static resources:Strings.K567}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentCopy" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding SeedSampleWorkOrdersCommand}" Header="{x:Static resources:Strings.K571}"
                                          ToolTip="{x:Static resources:Strings.K572}"
                                          Visibility="{Binding IsDebugBuild, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ToyBrickPlus" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ============ 中间：可拖拽分隔条（参照设备管理器页，常驻） ============  -->
        <GridSplitter
            Grid.Column="1"
            Width="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeWE"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            AutomationProperties.Name="{x:Static resources:Strings.K573}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Rectangle
                            x:Name="Grip"
                            Width="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Fill="{StaticResource BorderBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Fill" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Grip" Property="Width" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>


        <!--  ============ 右侧：筛选 + 详情 Tab ============  -->
        <Border Grid.Column="2" Padding="0" Style="{StaticResource MainCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  紧凑筛选条 + 高级筛选折叠  -->
                <Border Grid.Row="0" Margin="18,16,18,10" Padding="12,10" CornerRadius="10"
                        Background="{StaticResource SecondaryRegionBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Margin="0,0,6,0" Command="{Binding RefreshAllProductionCommand}"
                                        Content="{x:Static resources:Strings.K568}" FontSize="{DynamicResource FontSizeCaption}"
                                        Padding="8,4" Style="{StaticResource ButtonDefault}" ToolTip="{x:Static resources:Strings.K569}" />
                                <Button Margin="0,0,6,0" Command="{Binding ImportCsvCommand}"
                                        Content="{x:Static resources:Strings.K788}" FontSize="{DynamicResource FontSizeCaption}"
                                        Padding="8,4" Style="{StaticResource ButtonDefault}" />
                                <Button Margin="0,0,6,0" Command="{Binding ExportCsvCommand}"
                                        Content="{x:Static resources:Strings.K079}" FontSize="{DynamicResource FontSizeCaption}"
                                        Padding="8,4" Style="{StaticResource ButtonDefault}" />
                                <Border Padding="6,3" CornerRadius="6" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                                    <TextBlock FontSize="{DynamicResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"
                                               Text="{Binding ScheduleConflictCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F263}" />
                                </Border>
                            </StackPanel>
                            <WrapPanel>
                                <Border Margin="0,0,6,0" Padding="5,2" CornerRadius="6" Background="{StaticResource RegionBrush}">
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding FilteredCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F259}" />
                                </Border>
                                <Border Margin="0,0,6,0" Padding="5,2" CornerRadius="6" Background="{StaticResource RegionBrush}">
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{x:Static resources:Strings.K765}">
                                        <Run FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding FilteredTargetTotal, Mode=OneWay, StringFormat={}{0:N0}}" />
                                    </TextBlock>
                                </Border>
                                <Border Margin="0,0,6,0" Padding="5,2" CornerRadius="6" Background="{StaticResource RegionBrush}">
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{x:Static resources:Strings.K766}">
                                        <Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding FilteredOkTotal, Mode=OneWay, StringFormat={}{0:N0}}" />
                                    </TextBlock>
                                </Border>
                                <Border Padding="5,2" CornerRadius="6" Background="{StaticResource RegionBrush}">
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{x:Static resources:Strings.K767}">
                                        <Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding FilteredAchievementRate, Mode=OneWay, StringFormat={}{0:P1}}" />
                                    </TextBlock>
                                </Border>
                            </WrapPanel>
                        </DockPanel>
                        <Expander Margin="0,8,0,0" IsExpanded="False" Header="{x:Static resources:Strings.K558}">
                            <WrapPanel Margin="0,6,0,0">
                                <DatePicker Width="128" Margin="0,0,6,4" SelectedDate="{Binding FilterFromDate, Mode=TwoWay}" />
                                <DatePicker Width="128" Margin="0,0,12,4" SelectedDate="{Binding FilterToDate, Mode=TwoWay}" />
                                <ComboBox Width="150" Margin="0,0,12,4" DisplayMemberPath="Label" ItemsSource="{Binding SortOptions}"
                                          SelectedValue="{Binding SortMode, Mode=TwoWay}" SelectedValuePath="Value" Style="{StaticResource ComboBoxExtend}" />
                                <CheckBox Margin="0,0,12,4" Content="{x:Static resources:Strings.K560}" IsChecked="{Binding OnlyOverdue, Mode=TwoWay}" />
                                <CheckBox Margin="0,0,12,4" Content="{x:Static resources:Strings.K561}" IsChecked="{Binding OnlyAchieved, Mode=TwoWay}" />
                                <CheckBox Margin="0,0,12,4" Content="{x:Static resources:Strings.K562}" IsChecked="{Binding OnlyHasNg, Mode=TwoWay}" />
                            </WrapPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!--  详情 Tab 区  -->
                <Grid Grid.Row="1" Margin="18,0,18,0">
                    <controls:EmptyState IconKind="ClipboardTextOutline" Message="{x:Static resources:Strings.K074}" Hint="{x:Static resources:Strings.K574}">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedWorkOrder}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>

                    <Grid Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  工单头  -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Text="{Binding SelectedWorkOrder.OrderNo}" />
                                <Button Margin="6,0,0,0" Padding="3,0" Command="{Binding CopyOrderNoCommand}"
                                        Style="{StaticResource IconButtonDefault}" Tag="{x:Static mi:MaterialIconKind.ContentCopy}" />
                            </StackPanel>
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding SelectedWorkOrder.ProductName}" />
                                <TextBlock Margin="6,0" Foreground="{StaticResource ThirdlyTextBrush}" Text="&#x00B7;" />
                                <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding SelectedWorkOrder.DeviceName}" />
                                <Ellipse Margin="8,0,0,0" Style="{StaticResource StatusDot}" DataContext="{Binding SelectedWorkOrder}" />
                                <TextBlock Margin="6,0,0,0" Style="{StaticResource StatusText}" DataContext="{Binding SelectedWorkOrder}" />
                                <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="6" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                        Visibility="{Binding SelectedOverdueHintText, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock FontSize="{DynamicResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"
                                               Text="{Binding SelectedOverdueHintText}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,8">
                            <StackPanel>
                                <!--  KPI 概览  -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="12" CornerRadius="8" Background="{StaticResource SecondaryRegionBrush}"
                                            ToolTip="{Binding TargetTooltip}" ToolTipService.ShowDuration="30000">
                                        <StackPanel>
                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K035}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="Bold"
                                                       Text="{Binding SelectedWorkOrder.TargetQuantity, Converter={StaticResource LocFormatConverter}, ConverterParameter=F244}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Padding="12" CornerRadius="8" Background="{StaticResource SecondaryRegionBrush}"
                                            ToolTip="{Binding AchievementTooltip}" ToolTipService.ShowDuration="30000">
                                        <StackPanel>
                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K576}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding SelectedAchievementText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Padding="12" CornerRadius="8" Background="{StaticResource SecondaryRegionBrush}"
                                            ToolTip="{Binding DefectRateTooltip}" ToolTipService.ShowDuration="30000">
                                        <StackPanel>
                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K085}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Text="{Binding SelectedDefectRateText}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Margin="0,0,0,12" Padding="14,12" CornerRadius="10"
                                        Background="{StaticResource SecondaryRegionBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsProductionLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <hc:LoadingCircle Width="14" Height="14" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.M159}" />
                                        </StackPanel>
                                        <TextBlock Foreground="{StaticResource DangerBrush}" Text="{x:Static resources:Strings.M158}"
                                                   Visibility="{Binding IsProductionLoadFailed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"
                                                       Text="{Binding SelectedOkCountText}"
                                                       ToolTip="{Binding OkTooltip}" ToolTipService.ShowDuration="30000" />
                                            <Grid Grid.Column="1" Margin="12,0" Height="8">
                                                <Border CornerRadius="4" Background="{StaticResource RegionBrush}" />
                                                <Grid ClipToBounds="True" Visibility="{Binding HasSelectedProductionBar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding SelectedOkBarGridLength, Mode=OneWay}" />
                                                        <ColumnDefinition Width="{Binding SelectedNgBarGridLength, Mode=OneWay}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{StaticResource SuccessBrush}" />
                                                    <Border Grid.Column="1" Background="{StaticResource DangerBrush}" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                                                       Text="{Binding SelectedNgCountText}"
                                                       ToolTip="{Binding NgTooltip}" ToolTipService.ShowDuration="30000" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K075}" />
                                            <TextBlock Margin="6,0,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                                       Text="{Binding SelectedWorkOrder.PlannedStart, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                            <TextBlock Margin="4,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource ThirdlyTextBrush}" Text="~" />
                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                       Text="{Binding SelectedWorkOrder.PlannedEnd, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K021}" />
                                            <TextBlock Margin="6,0,0,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="{Binding SelectedWorkOrder.Remark, TargetNullValue=-}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--  SN 追溯  -->
                                <Border Margin="0,0,0,12" Padding="14,12" CornerRadius="10" Background="{StaticResource SecondaryRegionBrush}"
                                        Visibility="{Binding IsSnSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Left" FontWeight="Bold" Text="{x:Static resources:Strings.K914}" />
                                            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource ThirdlyTextBrush}"
                                                       Text="{Binding SnTotalCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=K919}" />
                                        </DockPanel>
                                        <Grid MinHeight="120">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding IsSnLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <hc:LoadingCircle Width="14" Height="14" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.M159}" />
                                            </StackPanel>
                                            <DataGrid MaxHeight="220" ItemsSource="{Binding SnItems}"
                                                      CellStyle="{StaticResource KanbanDataGridCell}" ColumnHeaderStyle="{StaticResource KanbanDataGridColumnHeader}"
                                                      IsReadOnly="True" BorderThickness="0" Background="Transparent">
                                                <DataGrid.Style>
                                                    <Style TargetType="DataGrid" BasedOn="{StaticResource KanbanDataGrid}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSnLoading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.Style>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="*" />
                                                    <DataGridTextColumn Header="{x:Static resources:Strings.K037}" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150" />
                                                    <DataGridTemplateColumn Header="{x:Static resources:Strings.K924}" Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="OK" Foreground="{StaticResource SuccessBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Result}" Value="1">
                                                                                    <Setter Property="Text" Value="NG" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ThirdlyTextBrush}"
                                                       Text="{x:Static resources:Strings.K920}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowSnEmptyState}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                            <Button Command="{Binding SnPreviousPageCommand}" Content="{x:Static resources:Strings.K925}"
                                                    Style="{StaticResource IconButtonDefault}" Tag="{x:Static mi:MaterialIconKind.ChevronLeft}" />
                                            <TextBlock Margin="12,0" VerticalAlignment="Center"
                                                       Text="{Binding SnPage, Converter={StaticResource LocFormatConverter}, ConverterParameter=K927}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding SnTotalPages, StringFormat={}/ {0}}" />
                                            <Button DockPanel.Dock="Right" Command="{Binding SnNextPageCommand}" Content="{x:Static resources:Strings.K926}"
                                                    Style="{StaticResource IconButtonDefault}" Tag="{x:Static mi:MaterialIconKind.ChevronRight}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!--  排程甘特  -->
                                <Border Margin="0,0,0,12" Padding="14,12" CornerRadius="10" Background="{StaticResource SecondaryRegionBrush}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,8" FontWeight="Bold" Text="{x:Static resources:Strings.K901}" />
                                        <Grid Height="200">
                                            <oxy:PlotView Model="{Binding WorkOrderGanttChartModel}" Background="Transparent" />
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ThirdlyTextBrush}"
                                                       Text="{x:Static resources:Strings.K906}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FilteredView.IsEmpty}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!--  时间线  -->
                                <Border Margin="0,0,0,4" Padding="14,12" CornerRadius="10" Background="{StaticResource SecondaryRegionBrush}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,8" FontWeight="Bold" Text="{x:Static resources:Strings.K771}" />
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="3,5,0,0" Fill="{StaticResource ThirdlyTextBrush}" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K772}" />
                                            <TextBlock Grid.Column="2" Text="{Binding SelectedWorkOrder.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                        </Grid>
                                        <Grid Margin="0,4" Visibility="{Binding SelectedWorkOrder.StartedAt, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="3,5,0,0" Fill="{StaticResource PrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K774}" />
                                            <TextBlock Grid.Column="2" Foreground="{StaticResource PrimaryBrush}" Text="{Binding SelectedWorkOrder.StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                        </Grid>
                                        <Grid Margin="0,4" Visibility="{Binding SelectedWorkOrder.CompletedAt, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="3,5,0,0" Fill="{StaticResource SuccessBrush}" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="{Binding SelectedWorkOrder.Status, Converter={StaticResource WorkOrderEndLabelConverter}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding SelectedWorkOrder.CompletedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!--  底栏操作  -->
                <StackPanel Grid.Row="2" Margin="18,10,18,16" Orientation="Horizontal"
                            Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}">
                    <Button Command="{Binding StartCommand}" Content="{x:Static resources:Strings.K036}" Style="{StaticResource IconButtonPrimary}"
                            Tag="{x:Static mi:MaterialIconKind.Play}" ToolTip="{Binding StartActionReason}" />
                    <Button Margin="8,0,0,0" Command="{Binding CompleteCommand}" Content="{x:Static resources:Strings.K076}" Style="{StaticResource IconButtonSuccess}"
                            Tag="{x:Static mi:MaterialIconKind.Check}" ToolTip="{Binding CompleteActionReason}" />
                    <Button Margin="8,0,0,0" Command="{Binding AbortCommand}" Content="{x:Static resources:Strings.K077}" Style="{StaticResource IconButtonWarning}"
                            Tag="{x:Static mi:MaterialIconKind.Stop}" ToolTip="{Binding AbortActionReason}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
