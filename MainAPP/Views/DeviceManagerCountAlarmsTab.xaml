<UserControl
    x:Class="MainAPP.Views.DeviceManagerCounterAlarmsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:conv="clr-namespace:MainAPP.Converters"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="800" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        设备管理 Tab 4：计数报警。
        DataContext 由父级 DeviceManagerView 传入 DeviceManagerViewModel；
        内层 Grid 重设 DataContext={Binding SelectedDevice} 切换到当前设备。
        按钮通过 RelativeSource AncestorType=UserControl 找到子 UserControl（其 DataContext 仍是 VM）。
    -->
    <Grid Margin="24,16" DataContext="{Binding SelectedDevice}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" LastChildFill="True">
            <Button
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{x:Static resources:Strings.K056}"
                Command="{Binding DataContext.AddCounterAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="{x:Static resources:Strings.K056}"
                DockPanel.Dock="Top"
                Style="{StaticResource IconButtonDefault}"
                Tag="{x:Static mi:MaterialIconKind.Plus}" />
            <!--  计数报警 CSV 导入/导出：批量编辑场景（Excel 整理后回导）  -->
            <Border
                Height="1"
                Margin="0,4,0,10"
                Background="{StaticResource DividerBrush}"
                DockPanel.Dock="Top" />
            <Grid
                Margin="0,0,0,10"
                DockPanel.Dock="Top">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsBusyCounterAlarmsCsv, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Height="40"
                    Padding="10,0"
                    AutomationProperties.Name="{x:Static resources:Strings.K609}"
                    Command="{Binding DataContext.ExportCounterAlarmsCsvCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.K653}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.FileExportOutline}"
                    ToolTip="{x:Static resources:Strings.K610}" />
                <Button
                    Grid.Column="2"
                    Height="40"
                    Padding="10,0"
                    AutomationProperties.Name="{x:Static resources:Strings.K611}"
                    Command="{Binding DataContext.ImportCounterAlarmsCsvCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.K654}"
                    Style="{StaticResource IconButtonPrimary}"
                    Tag="{x:Static mi:MaterialIconKind.FileImportOutline}"
                    ToolTip="{x:Static resources:Strings.K612}" />
            </Grid>
            <Grid>
                <ListBox
                    AutomationProperties.Name="{x:Static resources:Strings.K174}"
                ItemContainerStyle="{StaticResource CardListItemStyle}"
                ItemsSource="{Binding CounterAlarms}"
                SelectedItem="{Binding DataContext.SelectedCounterAlarm, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSizeHint}"
                                Text="{Binding Converter={StaticResource LocalizedNameToTextConverter}}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource DangerBrush}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTriggered}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeHint}"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{Binding CurrentValue, Converter={StaticResource LocFormatConverter}, ConverterParameter=F285}" />
                                <TextBlock
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeHint}"
                                    Foreground="{StaticResource ThirdlyTextBrush}"
                                    Text="{Binding Unit}" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeHint}"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{Binding MaxValue, Converter={StaticResource LocFormatConverter}, ConverterParameter=F286}" />
                                <TextBlock
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeHint}"
                                    Foreground="{StaticResource ThirdlyTextBrush}"
                                    Text="{Binding Unit}" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeHint}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ThirdlyTextBrush}"
                                    Text="{x:Static resources:Strings.K652}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MaxValue}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource ThirdlyTextBrush}"
                           Text="{x:Static resources:Strings.K583}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CounterAlarms.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <Border
            Grid.Column="2"
            Padding="20"
            Background="{StaticResource SecondaryRegionBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{Binding DataContext.SelectedCounterAlarm, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel
                DataContext="{Binding DataContext.SelectedCounterAlarm, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding DataContext.CanManageDevices, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <hc:TextBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="{x:Static resources:Strings.K018}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.K175}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <hc:TextBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="{x:Static resources:Strings.K176}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.K177}"
                    Style="{StaticResource TextBoxExtend}">
                    <hc:TextBox.Text>
                        <Binding Path="PlcAddress" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <conv:PlcAddressValidationRule ExpectedType="DWord" />
                            </Binding.ValidationRules>
                        </Binding>
                    </hc:TextBox.Text>
                </hc:TextBox>
                <hc:TextBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="{x:Static resources:Strings.K178}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.K179}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding MaxValue, UpdateSourceTrigger=PropertyChanged}" />
                <hc:TextBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="{x:Static resources:Strings.K180}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.K181}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                <hc:TextBox
                    Height="60"
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="{x:Static resources:Strings.K030}"
                    hc:InfoElement.TitlePlacement="Top"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{x:Static resources:Strings.K182}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                <!--  多语言名称：NameEn/NameJa/NamePt 为空时显示回退主名称 Name  -->
                <TextBlock
                    Margin="0,4,0,8"
                    FontSize="{DynamicResource FontSizeHint}"
                    FontWeight="Medium"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{x:Static resources:Strings.Alarm_LocalizedNames}" />
                <hc:TextBox
                    Margin="0,0,0,12"
                    hc:InfoElement.Title="{x:Static resources:Strings.Alarm_NameEn}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.Alarm_NameEn}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding NameEn, UpdateSourceTrigger=PropertyChanged}" />
                <hc:TextBox
                    Margin="0,0,0,12"
                    hc:InfoElement.Title="{x:Static resources:Strings.Alarm_NameJa}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.Alarm_NameJa}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding NameJa, UpdateSourceTrigger=PropertyChanged}" />
                <hc:TextBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="{x:Static resources:Strings.Alarm_NamePt}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.Alarm_NamePt}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding NamePt, UpdateSourceTrigger=PropertyChanged}" />
                <Border
                    Margin="0,0,0,16"
                    Padding="10,8"
                    Background="{StaticResource SecondaryRegionBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeHint}"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{x:Static resources:Strings.K183}" />
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeKpiLabel}"
                            FontWeight="Bold"
                            Text="{Binding CurrentValue}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTriggered}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTriggered}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeHint}"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding Unit}" />
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeHint}"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding MaxValue, Converter={StaticResource LocFormatConverter}, ConverterParameter=F286}" />
                        <TextBlock
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeHint}"
                            Foreground="{StaticResource ThirdlyTextBrush}"
                            Text="{Binding Unit}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeHint}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ThirdlyTextBrush}"
                            Text="{x:Static resources:Strings.K652}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MaxValue}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!--  2026-09-18 UI 精修：触发角标改红色语义药丸（原白字压满色块）  -->
                        <Border Margin="12,0,0,0" CornerRadius="3" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="{StaticResource StatusAlarmSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusAlarmBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTriggered}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                Margin="6,2"
                                FontSize="{DynamicResource FontSizeHint}"
                                FontWeight="Bold"
                                Foreground="{StaticResource StatusAlarmBrush}"
                                Text="{x:Static resources:Strings.K184}" />
                        </Border>
                    </StackPanel>
                </Border>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        AutomationProperties.Name="{x:Static resources:Strings.K185}"
                        Command="{Binding DataContext.ResetCounterAlarmValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="{x:Static resources:Strings.K186}"
                        Style="{StaticResource IconButtonDefault}"
                        Tag="{x:Static mi:MaterialIconKind.Refresh}" />
                    <Button
                        AutomationProperties.Name="{x:Static resources:Strings.K057}"
                        Command="{Binding DataContext.RemoveCounterAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="{x:Static resources:Strings.K057}"
                        Style="{StaticResource IconButtonDanger}"
                        Tag="{x:Static mi:MaterialIconKind.Delete}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
