<Window
    x:Class="MainAPP.Views.DeviceSetupWizardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:MainAPP.Resources"
    Title="{x:Static resources:Strings.Ux_DeviceWizardTitle}"
    Width="720"
    Height="560"
    MinWidth="620"
    MinHeight="480"
    Background="{StaticResource RegionBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    FocusManager.FocusedElement="{Binding ElementName=NameBox}"
    PreviewKeyDown="OnPreviewKeyDown"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="WizardLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeHint}" />
        </Style>
        <Style x:Key="WizardInput" TargetType="TextBox" BasedOn="{StaticResource TextBoxExtend}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style x:Key="WizardAddressInput" TargetType="TextBox" BasedOn="{StaticResource WizardInput}">
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="WizardStep0" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardStep1" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardStepPill" TargetType="Border">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"
                       Text="{x:Static resources:Strings.Ux_DeviceWizardTitle}" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Foreground="{StaticResource SecondaryTextBrush}"
                       Text="{Binding StepProgress}" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource WizardStepPill}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"
                           Text="{x:Static resources:Strings.Ux_DeviceWizardStepBasic}" />
            </Border>
            <Border Grid.Column="2">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource WizardStepPill}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{x:Static resources:Strings.Ux_DeviceWizardStepAddresses}" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer Style="{StaticResource WizardStep0}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Margin="0,0,0,18" Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{x:Static resources:Strings.Ux_DeviceWizardIntro}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource WizardLabel}" Text="{x:Static resources:Strings.K062}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource WizardInput}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static resources:Strings.K062}" />
                    <TextBlock Style="{StaticResource WizardLabel}" Text="{x:Static resources:Strings.K196}" />
                    <TextBox Style="{StaticResource WizardInput}"
                             Text="{Binding TargetCycle, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static resources:Strings.K196}" />
                    <TextBlock Foreground="{StaticResource ThirdlyTextBrush}"
                               Text="{x:Static resources:Strings.Ux_DeviceWizardTargetCycleHint}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Style="{StaticResource WizardStep1}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Margin="0,0,0,18" Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{x:Static resources:Strings.Ux_DeviceWizardAddressHint}" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource WizardLabel}" Text="{x:Static resources:Strings.K199}" />
                            <TextBox Style="{StaticResource WizardAddressInput}"
                                     Text="{Binding OkCountAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource WizardLabel}" Text="{x:Static resources:Strings.K202}" />
                            <TextBox Style="{StaticResource WizardAddressInput}"
                                     Text="{Binding NgCountAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource WizardLabel}" Text="{x:Static resources:Strings.K205}" />
                            <TextBox Style="{StaticResource WizardAddressInput}"
                                     Text="{Binding StatusCountAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource WizardLabel}" Text="{x:Static resources:Strings.K208}" />
                            <TextBox Style="{StaticResource WizardAddressInput}"
                                     Text="{Binding ProductionResetAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Border Padding="12,10" Background="{StaticResource PrimarySoftBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="6">
                        <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="{x:Static resources:Strings.Ux_DeviceWizardSaveReminder}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Margin="0,16,0,0" Padding="10,8"
                Background="{StaticResource StatusAlarmSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasValidationMessage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Foreground="{StaticResource DangerBrush}" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
        </Border>

        <DockPanel Grid.Row="4" Margin="0,18,0,0">
            <Button DockPanel.Dock="Left" Width="90" Command="{Binding CancelCommand}"
                    Content="{x:Static resources:Strings.K092}" IsCancel="True" Style="{StaticResource ButtonDefault}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="100" Margin="0,0,8,0" Command="{Binding BackCommand}"
                        Content="{x:Static resources:Strings.Ux_DeviceWizardBack}"
                        IsEnabled="{Binding IsFirstStep, Converter={StaticResource InvertedBooleanConverter}}"
                        Style="{StaticResource ButtonDefault}" />
                <Button Width="100" Command="{Binding NextCommand}"
                        Content="{x:Static resources:Strings.Ux_DeviceWizardNext}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                        Style="{StaticResource ButtonPrimary}" />
                <Button Width="120" Command="{Binding FinishCommand}"
                        Content="{x:Static resources:Strings.Ux_DeviceWizardFinish}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource ButtonPrimary}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
