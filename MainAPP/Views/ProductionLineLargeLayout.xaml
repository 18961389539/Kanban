<UserControl
    x:Class="MainAPP.Views.ProductionLineLargeLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="1200" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        产线页布局 1：大卡片网格（2 列 UniformGrid）。
        适用于 1-8 台设备：每卡 2x4 指标网格 + 报警/缺陷文本。
        DataContext 由父级 ProductionLineView 传入 ProductionLineViewModel；
        ItemsControl.ItemTemplate 的 DataContext 是单个 LineDeviceItem。
        共享样式（StateText/StateBrush/StatusStripe/DeviceCardBorder）从父级视觉树资源查找继承。
    -->
    <ItemsControl
        Visibility="{Binding IsLargeCardsLayout, Converter={StaticResource BooleanToVisibilityConverter}}"
        ItemsSource="{Binding FilteredLineDevices}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Command="{Binding DataContext.FocusDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding Device.Id}"
                        AutomationProperties.Name="{Binding Device.Name, StringFormat=查看 {0} 详情}"
                        Cursor="Hand" Margin="8"
                        MinHeight="200"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!--  焦点边框：键盘 Tab 时显示 2px 虚线主色边框  -->
                            <Border x:Name="FocusBorder"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="FocusBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                        <Border CornerRadius="8"
                            Effect="{StaticResource CardDropShadow}"
                            Padding="22"
                            MinHeight="200"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource DeviceCardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StatusStripe}" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1">
                                <!--  顶部：状态徽章 + 设备名 + 配方  -->
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Padding="10,3" CornerRadius="12"
                                            Background="{Binding Runtime.StatusWord, Converter={StaticResource StateBrush}}">
                                        <StackPanel Orientation="Horizontal">
                                            <!--  脉冲点：仅报警状态(StatusWord=2)时动画，其余状态静态  -->
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="White" Opacity="0.4">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Runtime.StatusWord}" Value="2">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="0.3" To="1" Duration="0:0:1.2"
                                                                                             AutoReverse="True" RepeatBehavior="Forever" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="White"
                                                       Text="{Binding Runtime.StatusWord, Converter={StaticResource StateText}}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="{Binding Device.Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <!--  指标带：2 行 × 4 列（核心 4 + 性能参数 4），横向铺满、卡高减半  -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  行 1：核心 4 指标  -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="OEE" />
                                        <TextBlock FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                                   Foreground="{Binding Runtime.Oee, Converter={StaticResource OeeThreshold}}"
                                                   Text="{Binding Runtime.Oee, StringFormat=P0}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,10">
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K001}" />
                                        <TextBlock FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                                   Foreground="{Binding Runtime.QualityRate, Converter={StaticResource RatioThreshold}}"
                                                   Text="{Binding Runtime.QualityRate, StringFormat=P1}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,8,10">
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K094}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"
                                                       Text="{Binding Runtime.TotalOkProduction, StringFormat={}{0:N0} 件}" />
                                            <TextBlock Margin="6,0,0,0" FontSize="13" VerticalAlignment="Bottom"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       Text="{Binding Runtime.TotalNgProduction, StringFormat=/{0} 件}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="8,0,0,10">
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K095}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="13" Foreground="{StaticResource SuccessBrush}"
                                                       Text="{Binding RunTimeFormatted}" />
                                            <TextBlock Margin="6,0,0,0" FontSize="13" Foreground="{StaticResource DangerBrush}"
                                                       Text="{Binding AlarmTimeFormatted}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  行 2：性能参数 4 指标  -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K096}" />
                                        <TextBlock FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                   Foreground="{Binding Runtime.PerformanceRate, Converter={StaticResource OeeThreshold}}"
                                                   Text="{Binding Runtime.PerformanceRate, StringFormat=P1}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K009}" />
                                        <TextBlock FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                   Foreground="{Binding Runtime.AvailabilityRate, Converter={StaticResource OeeThreshold}}"
                                                   Text="{Binding Runtime.AvailabilityRate, StringFormat=P1}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,8,0">
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K097}" />
                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}件/h · {1:F1}s">
                                                    <Binding Path="Device.TargetCycle" />
                                                    <Binding Path="ActualCycleSec" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="8,0,0,0">
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K098}" />
                                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding DowntimeFormatted}" />
                                    </StackPanel>
                                </Grid>
                                <!--  当前报警 / 缺陷文本（P0-1）  -->
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource DangerBrush}" Text="{Binding ActiveAlarmText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveAlarmText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}" Text="{Binding DefectSummaryText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefectSummaryText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
