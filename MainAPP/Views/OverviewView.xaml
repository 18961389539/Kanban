<UserControl
    x:Class="MainAPP.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:OverviewViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1400"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- KPI 紧凑单元格样式：基于 InnerCard，Padding 与 HomeView KPI 一致；Margin=2 避免相邻双线 -->
        <Style x:Key="KpiCell" TargetType="Border" BasedOn="{StaticResource InnerCard}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <!-- KPI 标签样式：基于全局 KpiLabel，追加底部间距 -->
        <Style x:Key="KpiLabel" TargetType="TextBlock" BasedOn="{StaticResource KpiLabel}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- KPI 数值样式：基于全局 KpiValueMd（22px Bold Consolas） -->
        <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValueMd}" />
        <!-- KPI 副标题样式：12px（原 11px 对比度临界） -->
        <Style x:Key="KpiSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- 设备表格行按状态着色 -->
        <Style x:Key="DeviceRowAlarm" TargetType="DataGridRow" BasedOn="{StaticResource KanbanDataGridRow}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="81" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusWord}" Value="2">
                    <Setter Property="BorderBrush" Value="{StaticResource StatusAlarmBrush}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusWord}" Value="3">
                    <Setter Property="BorderBrush" Value="{StaticResource StatusPauseBrush}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusWord}" Value="0">
                    <Setter Property="BorderBrush" Value="{StaticResource StatusIdleBrush}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceNameCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DeviceMetricCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="DeviceCoreMetricCell" TargetType="TextBlock" BasedOn="{StaticResource DeviceMetricCell}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style x:Key="DeviceOutputLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DeviceDurationLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DeviceDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource KanbanDataGridCell}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ 标题栏 + 时间范围切换 ============  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <materialIcons:MaterialIcon
                    Style="{StaticResource PageTitleIcon}" Kind="ChartTimelineVariant" />
                <TextBlock
                    Style="{StaticResource PageTitleText}"
                    Margin="10,0,0,0" Text="{x:Static resources:Strings.K342}" />
                <ComboBox
                    Width="180"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K343}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding DeviceFilterItems}"
                    SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay}"
                    SelectedValuePath="Id"
                    Style="{StaticResource ComboBoxExtend}"
                    ToolTip="{x:Static resources:Strings.K344}" />
                <!-- 当前班次标签：班次名+时间段（主标签）+ 带日期的完整区间（辅助行） -->
                <Border
                    Margin="16,0,0,0" Padding="10,4"
                    Background="{StaticResource SecondaryRegionBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock
                            FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding CurrentShiftName}" />
                        <TextBlock
                            FontSize="{DynamicResource FontSizeMicro}" Margin="0,2,0,0"
                            Foreground="{StaticResource ThirdlyTextBrush}"
                            Text="{Binding CurrentShiftDateRange}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <!-- 时间范围切换 -->
                <ComboBox
                    Width="120" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K345}"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding TimeRangeOptions}"
                    SelectedValue="{Binding SelectedTimeRange}"
                    SelectedValuePath="Value"
                    Style="{StaticResource ComboBoxExtend}" />
                <!-- 刷新按钮 -->
                <Button
                    Margin="8,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K346}"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource ButtonDefault}"
                    ToolTip="{x:Static resources:Strings.K347}">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Width="14" Height="14" Kind="Refresh" />
                        <TextBlock Margin="6,0,0,0" Text="{x:Static resources:Strings.K015}" />
                    </StackPanel>
                </Button>
                <Button
                    Margin="8,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K348}"
                    Command="{Binding ExportReportCommand}"
                    Content="{x:Static resources:Strings.K349}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.FileExportOutline}"
                    ToolTip="{x:Static resources:Strings.K350}" />
                <Button
                    Margin="8,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K351}"
                    Command="{Binding ExportReportPdfCommand}"
                    Content="{x:Static resources:Strings.K352}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.FileExportOutline}"
                    ToolTip="{x:Static resources:Strings.K353}" />
                <!-- 上次更新时间：StringFormat 需用 {0:format} 占位符，否则 "HH:mm:ss" 被当作字面量 -->
                <TextBlock
                    Margin="12,0,0,0" VerticalAlignment="Center"
                    Style="{StaticResource SubtitleText}"
                    FontFamily="Consolas"
                    Text="{Binding LastUpdateTime, StringFormat=更新于 {0:HH:mm:ss}}" />
            </StackPanel>
        </DockPanel>

        <!--  ============ 主内容：滚动区（加载时折叠，由骨架屏占位） ============  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <!-- 数据完整性与目标对比：避免把部分数据误读为完整复盘结果 -->
                <Border
                    Margin="0,0,0,12"
                    Padding="12,8"
                    Background="{StaticResource SecondaryRegionBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding TargetStatusText}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding DataCoverageText}" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K354}" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding HealthScoreText}" Foreground="{StaticResource PrimaryBrush}" />
                            <ItemsControl ItemsSource="{Binding HealthIssues}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource StatusAlarmBrush}" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K049}" />
                            <TextBlock Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding CurrentWorkOrderText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K355}" />
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding CurrentProductText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K356}" />
                            <TextBlock Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding CurrentRecipeText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource KpiSub}" Text="{x:Static resources:Strings.K357}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="18,0,0,0">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K358}" />
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding TimelineSelectionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K359}" />
                            <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K360}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ReviewConclusions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Foreground="{StaticResource PrimaryBrush}" Text="• " />
                                        <TextBlock Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" Text="{Binding Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!--  ──────── KPI 条（1行×5列，仅保留非 OEE 指标） ────────  -->
                <Border Style="{StaticResource MainCard}" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 总产量 -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K023}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalOutput, StringFormat=N0}" />
                                    <TextBlock Style="{StaticResource KpiSub}" Margin="4,0,0,0" Text="{x:Static resources:Strings.K014}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiSub}" Text="{Binding TotalOk, StringFormat=OK {0:N0}}" />
                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource KpiSub}" Text="{Binding TotalNg, StringFormat=NG {0:N0}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource KpiSub}" Text="{Binding OutputAchievementRate, StringFormat=目标达成 {0:P1}}" />
                            </StackPanel>
                        </Border>
                        <!-- 报警次数 -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K090}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiValue}" Foreground="{StaticResource StatusAlarmBrush}" Text="{Binding AlarmCount, StringFormat=N0}" />
                                    <TextBlock Style="{StaticResource KpiSub}" Margin="4,0,0,0" Text="{x:Static resources:Strings.K361}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiSub}" Text="{Binding RecoveredAlarmCount, StringFormat=已恢复 {0}}" />
                                    <!--  待处理 > 0 时才显示，避免 "/ 待处理 0" 噪音  -->
                                    <TextBlock Margin="4,0,0,0" Text="{Binding PendingAlarmCount, StringFormat=/ 待处理 {0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource KpiSub}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PendingAlarmCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 最长停机设备：大数字为停机时长，副标题为设备名+报警名，与其它 KPI 节奏一致 -->
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K091}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiValue}" Foreground="{StaticResource StatusAlarmBrush}" Text="{Binding LongestDowntimeHours, StringFormat={}{0:F1}h}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource KpiSub}" Text="{Binding LongestDowntimeDevice, StringFormat={}{0} ·}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource KpiSub}" Text="{Binding LongestDowntimeAlarm}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <!-- 峰值时段 -->
                        <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K362}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding PeakHour}" />
                                    <TextBlock Style="{StaticResource KpiSub}" Margin="6,0,0,0" Text="{Binding PeakHourOk, StringFormat={}{0} 件}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 谷值时段 -->
                        <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K363}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ValleyHour}" />
                                    <TextBlock Style="{StaticResource KpiSub}" Margin="6,0,0,0" Text="{Binding ValleyHourOk, StringFormat={}{0} 件}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!--  ──────── 单设备基线对比 ────────  -->
                <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K364}" />
                            <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K365}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding ComparisonSummaryText}" />
                        <UniformGrid Columns="4" Margin="24,0,24,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K366}" />
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalOutput, StringFormat=N0}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="{Binding ComparisonLabel}" />
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding BaselineTotalOutput, StringFormat=N0}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K367}" />
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding QualityRate, StringFormat=P1}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="{x:Static resources:Strings.K368}" />
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Oee, StringFormat=P1}" />
                            </StackPanel>
                        </UniformGrid>
                    </DockPanel>
                </Border>

                <!--  ──────── 主区：左趋势图 + 右 Top 报警 ────────  -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 趋势图 -->
                    <Border Grid.Column="0" Style="{StaticResource MainCard}" Padding="14">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource ChartOkSeriesBrush}" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K369}" />
                                    <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K370}" />
                                </StackPanel>
                            </StackPanel>
                            <oxy:PlotView
                                Model="{Binding TrendChart}"
                                Background="Transparent"
                                Height="240" />
                        </DockPanel>
                    </Border>

                    <!-- Top 5 报警 -->
                    <Border Grid.Column="2" Style="{StaticResource MainCard}" Padding="14">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource StatusAlarmBrush}" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K371}" />
                                    <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K372}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid>
                                <ItemsControl ItemsSource="{Binding TopAlarms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13" FontWeight="Medium"
                                                        Foreground="{StaticResource PrimaryTextBrush}"
                                                        Text="{Binding AlarmName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSizeHint}"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="{Binding DeviceName}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock
                                                        FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                                        Foreground="{StaticResource StatusAlarmBrush}"
                                                        Text="{Binding TriggerCount, StringFormat={}{0} 次}" />
                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSizeHint}"
                                                        Foreground="{StaticResource ThirdlyTextBrush}"
                                                        Text="{Binding TotalDurationHours, StringFormat={}{0:F1}h}" />
                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSizeHint}"
                                                        Foreground="{StaticResource ThirdlyTextBrush}"
                                                        Text="{Binding RepeatCount, StringFormat=重复 {0} 次}" />
                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSizeHint}"
                                                        Foreground="{StaticResource ThirdlyTextBrush}"
                                                        Text="{Binding AverageIntervalMinutes, StringFormat=间隔 {0:F0} min}" />
                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSizeHint}"
                                                        Foreground="{StaticResource StatusAlarmBrush}"
                                                        Text="{Binding OutputDelta, StringFormat=前后产量差 {0:N0}}" />
                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSizeHint}"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource StatusAlarmBrush}"
                                                        Text="{x:Static resources:Strings.K373}"
                                                        Visibility="{Binding IsHighFrequency, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- 空状态：TopAlarms 为空时显示 -->
                                <controls:EmptyState IconKind="ShieldCheckOutline" Message="{x:Static resources:Strings.K374}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:EmptyState.Style>
                                        <Style TargetType="controls:EmptyState">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TopAlarms.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:EmptyState.Style>
                                </controls:EmptyState>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource PrimaryBrush}" />
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K375}" />
                                <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K376}" />
                            </StackPanel>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding StatusTimeline}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8" Padding="10,8" MinWidth="180"
                                            Command="{Binding DataContext.SelectTimelineSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
