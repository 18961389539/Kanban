<UserControl
    x:Class="MainAPP.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:OverviewViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1400"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- KPI 紧凑单元格样式（KpiCell/KpiCellLabel/KpiCellValue 已全局化至 Styles/Cards.xaml） -->
        <!-- KPI 副标题样式：12px（原 11px 对比度临界） -->
        <Style x:Key="KpiSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- 设备表格行按状态着色 -->
        <Style x:Key="DeviceRowAlarm" TargetType="DataGridRow" BasedOn="{StaticResource KanbanDataGridRow}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="81" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusWord}" Value="2">
                    <Setter Property="BorderBrush" Value="{StaticResource StatusAlarmBrush}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusWord}" Value="3">
                    <Setter Property="BorderBrush" Value="{StaticResource StatusPauseBrush}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusWord}" Value="0">
                    <Setter Property="BorderBrush" Value="{StaticResource StatusIdleBrush}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceNameCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DeviceMetricCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="DeviceCoreMetricCell" TargetType="TextBlock" BasedOn="{StaticResource DeviceMetricCell}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style x:Key="DeviceOutputLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DeviceDurationLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DeviceDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource KanbanDataGridCell}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ 标题栏 + 时间范围切换 ============  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <materialIcons:MaterialIcon
                    Style="{StaticResource PageTitleIcon}" Kind="ChartTimelineVariant" />
                <TextBlock
                    Style="{StaticResource PageTitleText}"
                    Margin="10,0,0,0" Text="{x:Static resources:Strings.K342}" />
                <ComboBox
                    Width="180"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K343}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding DeviceFilterItems}"
                    SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay}"
                    SelectedValuePath="Id"
                    Style="{StaticResource ComboBoxExtend}"
                    ToolTip="{x:Static resources:Strings.K344}" />
                <!-- 当前班次标签：班次名+时间段（主标签）+ 带日期的完整区间（辅助行） -->
                <Border
                    Margin="16,0,0,0" Padding="10,4"
                    Background="{StaticResource SecondaryRegionBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock
                            FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding CurrentShiftName}" />
                        <TextBlock
                            FontSize="{DynamicResource FontSizeMicro}" Margin="0,2,0,0"
                            Foreground="{StaticResource ThirdlyTextBrush}"
                            Text="{Binding CurrentShiftDateRange}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <!-- 快捷时间 chips：高频范围一键切换（今天/近 24h/近 7 天），其余范围走下拉 -->
                <RadioButton
                    GroupName="OverviewRange"
                    Click="OnTimeRangeChipClick"
                    Content="{x:Static resources:Strings.M108}"
                    Style="{StaticResource TimePresetChip}"
                    Tag="Today">
                    <RadioButton.IsChecked>
                        <Binding
                            Converter="{StaticResource EqualityConverter}"
                            ConverterParameter="{x:Static vm:OverviewTimeRange.Today}"
                            Mode="OneWay"
                            Path="SelectedTimeRange" />
                    </RadioButton.IsChecked>
                </RadioButton>
                <RadioButton
                    GroupName="OverviewRange"
                    Click="OnTimeRangeChipClick"
                    Content="{x:Static resources:Strings.K025}"
                    Style="{StaticResource TimePresetChip}"
                    Tag="Hours24">
                    <RadioButton.IsChecked>
                        <Binding
                            Converter="{StaticResource EqualityConverter}"
                            ConverterParameter="{x:Static vm:OverviewTimeRange.Hours24}"
                            Mode="OneWay"
                            Path="SelectedTimeRange" />
                    </RadioButton.IsChecked>
                </RadioButton>
                <RadioButton
                    GroupName="OverviewRange"
                    Click="OnTimeRangeChipClick"
                    Content="{x:Static resources:Strings.K258}"
                    Style="{StaticResource TimePresetChip}"
                    Tag="Days7">
                    <RadioButton.IsChecked>
                        <Binding
                            Converter="{StaticResource EqualityConverter}"
                            ConverterParameter="{x:Static vm:OverviewTimeRange.Days7}"
                            Mode="OneWay"
                            Path="SelectedTimeRange" />
                    </RadioButton.IsChecked>
                </RadioButton>
                <!-- 时间范围切换（其余范围） -->
                <ComboBox
                    Width="110"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K345}"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding TimeRangeOptions}"
                    SelectedValue="{Binding SelectedTimeRange}"
                    SelectedValuePath="Value"
                    Style="{StaticResource ComboBoxExtend}" />
                <!-- 刷新按钮：加载中转圈 -->
                <Button
                    Margin="8,0,0,0"
                    Padding="14,6"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K346}"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource ButtonDefault}"
                    ToolTip="{x:Static resources:Strings.K347}">
                    <Grid Width="76">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <materialIcons:MaterialIcon Width="14" Height="14" Kind="Refresh" />
                            <TextBlock Margin="6,0,0,0" Text="{x:Static resources:Strings.K015}" />
                        </StackPanel>
                        <hc:LoadingCircle
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Button>
                <Button
                    Margin="8,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K348}"
                    Command="{Binding ExportReportCommand}"
                    Content="{x:Static resources:Strings.K349}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.FileExportOutline}"
                    ToolTip="{x:Static resources:Strings.K350}" />
                <Button
                    Margin="8,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K351}"
                    Command="{Binding ExportReportPdfCommand}"
                    Content="{x:Static resources:Strings.K352}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.FileExportOutline}"
                    ToolTip="{x:Static resources:Strings.K353}" />
                <!-- 上次更新时间：StringFormat 需用 {0:format} 占位符，否则 "HH:mm:ss" 被当作字面量 -->
                <TextBlock
                    Margin="12,0,0,0" VerticalAlignment="Center"
                    Style="{StaticResource SubtitleText}"
                    FontFamily="Consolas"
                    Text="{Binding LastUpdateTime, Converter={StaticResource LocFormatConverter}, ConverterParameter=F250}" />
            </StackPanel>
        </DockPanel>

        <!--  ============ 主内容：滚动区（加载时折叠，由骨架屏占位） ============  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <!-- 数据完整性与目标对比：避免把部分数据误读为完整复盘结果 -->
                <Border
                    Margin="0,0,0,12"
                    Padding="12,8"
                    Background="{StaticResource SecondaryRegionBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding TargetStatusText}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding DataCoverageText}" />
                    </DockPanel>
                </Border>

                <!-- 首屏摘要条：关键指标一行浓缩（不滚动即见核心结论） -->
                <Border
                    Margin="0,0,0,12"
                    Padding="12,8"
                    Background="{StaticResource PrimarySoftBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeHint}"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="{x:Static resources:Strings.K354}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeHint}"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding HealthScoreText}" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K587}" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Oee, StringFormat={}{0:P1}}" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.M238}" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding QualityRate, StringFormat={}{0:P1}}" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K023}" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding TotalOutput, StringFormat={}{0:N0}}" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K090}" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}" FontWeight="Bold" Foreground="{StaticResource StatusAlarmBrush}" Text="{Binding AlarmCount, StringFormat={}{0:N0}}" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{Binding CurrentShiftName}" />
                    </StackPanel>
                </Border>

                <!-- 查询错误提示条：失败可见 + 一键重试 -->
                <Border
                    Margin="0,0,0,12"
                    Padding="12,8"
                    Background="{StaticResource StatusAlarmSoftBrush}"
                    BorderBrush="{StaticResource StatusAlarmBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding QueryErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            Margin="12,0,0,0"
                            Padding="10,3"
                            Command="{Binding RefreshCommand}"
                            Content="{x:Static resources:Strings.K015}"
                            Style="{StaticResource ButtonDefault}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeHint}"
                            Foreground="{StaticResource DangerBrush}"
                            Text="{Binding QueryErrorMessage}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding QueryErrorMessage}" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K354}" />
                            <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding HealthScoreText}" Foreground="{StaticResource PrimaryBrush}" />
                            <ItemsControl ItemsSource="{Binding HealthIssues}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource StatusAlarmBrush}" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K049}" />
                            <TextBlock Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding CurrentWorkOrderText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K355}" />
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding CurrentProductText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                            <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K356}" />
                            <TextBlock Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding CurrentRecipeText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource KpiSub}" Text="{x:Static resources:Strings.K357}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource PrimaryBrush}" />
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K359}" />
                                <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K360}" />
                            </StackPanel>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ReviewConclusions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 方案 A（2026-08-11）：分类图标块 + 达标徽章 + 结论文本 -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="32" Height="32" CornerRadius="8"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource PrimarySoftBrush}">
                                            <materialIcons:MaterialIcon
                                                Width="16" Height="16"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Kind="InformationOutline"
                                                Foreground="{StaticResource ThirdlyTextBrush}">
                                                <materialIcons:MaterialIcon.Style>
                                                    <Style TargetType="materialIcons:MaterialIcon">
                                                        <Setter Property="Kind" Value="InformationOutline" />
                                                        <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Quality">
                                                                <Setter Property="Kind" Value="CheckCircleOutline" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusRunBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Oee">
                                                                <Setter Property="Kind" Value="ChartLine" />
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Downtime">
                                                                <Setter Property="Kind" Value="TimerSandPaused" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusAlarmBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="BestShift">
                                                                <Setter Property="Kind" Value="TrophyOutline" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusPauseBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="TopDefect">
                                                                <Setter Property="Kind" Value="WrenchOutline" />
                                                                <Setter Property="Foreground" Value="{StaticResource ChartBaseSeriesBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="AlarmCount">
                                                                <Setter Property="Kind" Value="BellRingOutline" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusAlarmBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialIcons:MaterialIcon.Style>
                                            </materialIcons:MaterialIcon>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,1,0,0">
                                            <!-- 达标徽章：Met→M112 绿 / NotMet→M113 红 / Neutral→隐藏
                                                 （Text 由 Style 触发器设置——本地值优先级高于触发器，不能设本地 Text） -->
                                            <TextBlock
                                                FontSize="10" FontWeight="Bold"
                                                Margin="0,0,0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusRunBrush}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Met}" Value="Met">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusRunBrush}" />
                                                                <Setter Property="Text" Value="{x:Static resources:Strings.M112}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Met}" Value="NotMet">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusAlarmBrush}" />
                                                                <Setter Property="Text" Value="{x:Static resources:Strings.M113}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                TextWrapping="Wrap"
                                                Text="{Binding Text}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!--  ──────── KPI 条（1行×5列，仅保留非 OEE 指标） ────────  -->
                <Border Style="{StaticResource MainCard}" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 总产量（核心指标：主色强调） -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource KpiCell}"
                            Background="{StaticResource PrimarySoftBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K023}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiCellValue}" Foreground="{StaticResource PrimaryBrush}" Text="{Binding TotalOutput, StringFormat={}{0:N0}}" />
                                    <TextBlock Style="{StaticResource KpiSub}" Margin="4,0,0,0" Text="{x:Static resources:Strings.K014}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiSub}" Text="{Binding TotalOk, StringFormat=OK {0:N0}}" />
                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource KpiSub}" Text="{Binding TotalNg, StringFormat=NG {0:N0}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource KpiSub}" Text="{Binding OutputAchievementRate, Converter={StaticResource LocFormatConverter}, ConverterParameter=F252}" />
                            </StackPanel>
                        </Border>
                        <!-- 报警次数 -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K090}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiCellValue}" Foreground="{StaticResource StatusAlarmBrush}" Text="{Binding AlarmCount, StringFormat={}{0:N0}}" />
                                    <TextBlock Style="{StaticResource KpiSub}" Margin="4,0,0,0" Text="{x:Static resources:Strings.K361}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiSub}" Text="{Binding RecoveredAlarmCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F277}" />
                                    <!--  待处理 > 0 时才显示，避免 "/ 待处理 0" 噪音  -->
                                    <TextBlock Margin="4,0,0,0" Text="{Binding PendingAlarmCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F278}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource KpiSub}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PendingAlarmCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 最长停机设备：大数字为停机时长，副标题为设备名+报警名，与其它 KPI 节奏一致 -->
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K091}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource KpiCellValue}" Foreground="{StaticResource StatusAlarmBrush}" Text="{Binding LongestDowntimeHours, Converter={StaticResource DurationToTextConverter}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource KpiSub}" Text="{Binding LongestDowntimeDevice, StringFormat={}{0} ·}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource KpiSub}" Text="{Binding LongestDowntimeAlarm}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <!-- 峰值时段（方案 A：▲ 图标 + 时间 + 件数 + 占比，2026-08-11） -->
                        <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource StatusRunSoftBrush}">
                                        <TextBlock
                                            Text="▲" FontSize="14" FontWeight="Bold"
                                            Foreground="{StaticResource StatusRunBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Style="{StaticResource KpiCellLabel}"
                                        Text="{x:Static resources:Strings.K362}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding PeakHour}" />
                                    <TextBlock Style="{StaticResource KpiSub}" Margin="6,0,0,0" Text="{Binding PeakHourOk, Converter={StaticResource LocFormatConverter}, ConverterParameter=F245}" />
                                    <TextBlock Style="{StaticResource KpiSub}" Margin="6,0,0,0" Foreground="{StaticResource StatusRunBrush}" Text="{Binding PeakShareText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 谷值时段（方案 A：▼ 图标 + 时间 + 件数 + 占比，2026-08-11） -->
                        <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource StatusAlarmSoftBrush}">
                                        <TextBlock
                                            Text="▼" FontSize="14" FontWeight="Bold"
                                            Foreground="{StaticResource StatusAlarmBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Style="{StaticResource KpiCellLabel}"
                                        Text="{x:Static resources:Strings.K363}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding ValleyHour}" />
                                    <TextBlock Style="{StaticResource KpiSub}" Margin="6,0,0,0" Text="{Binding ValleyHourOk, Converter={StaticResource LocFormatConverter}, ConverterParameter=F245}" />
                                    <TextBlock Style="{StaticResource KpiSub}" Margin="6,0,0,0" Foreground="{StaticResource StatusAlarmBrush}" Text="{Binding ValleyShareText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!--  ──────── 单设备基线对比 ────────  -->
                <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource ChartBaseSeriesBrush}" />
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K364}" />
                                <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K365}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding ComparisonSummaryText}" />
                        <UniformGrid Columns="4" Margin="24,0,24,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K366}" />
                                <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding TotalOutput, StringFormat={}{0:N0}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCellLabel}" Text="{Binding ComparisonLabel}" />
                                <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding BaselineTotalOutput, StringFormat={}{0:N0}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K367}" />
                                <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding QualityRate, StringFormat={}{0:P1}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K368}" />
                                <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding Oee, StringFormat={}{0:P1}}" />
                            </StackPanel>
                        </UniformGrid>
                    </DockPanel>
                </Border>

                <!--  ──────── 主区：左趋势图 + 右 Top 报警 ────────  -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 趋势图 -->
                    <Border Grid.Column="0" Style="{StaticResource MainCard}" Padding="14">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource ChartOkSeriesBrush}" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K369}" />
                                    <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K370}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid Height="240">
                                <oxy:PlotView
                                    x:Name="TrendPlotView"
                                    Model="{Binding TrendChart}"
                                    Background="Transparent" />
                                <!-- 空状态：窗口内无产量数据时提示（P2-9） -->
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSizeHint}"
                                    Foreground="{StaticResource ThirdlyTextBrush}"
                                    Text="{x:Static resources:Strings.Web_Val_NoData}"
                                    Visibility="{Binding HasTrendData, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Top 5 报警 -->
                    <Border Grid.Column="2" Style="{StaticResource MainCard}" Padding="14">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource StatusAlarmBrush}" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K371}" />
                                    <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K372}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid>
                                <ItemsControl ItemsSource="{Binding TopAlarms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 方案 A（2026-08-11）：排名徽章 + 名称/设备分层 + 次数/时长两行核心信息 -->
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 排名徽章：1 红 / 2 黄 / 3 橙 / 其余灰 -->
                                                <Border
                                                    Grid.Column="0"
                                                    Width="26" Height="26"
                                                    CornerRadius="13"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource StatusIdleBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource StatusIdleBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rank}" Value="1">
                                                                    <Setter Property="Background" Value="{StaticResource StatusAlarmBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rank}" Value="2">
                                                                    <Setter Property="Background" Value="{StaticResource StatusPauseBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rank}" Value="3">
                                                                    <Setter Property="Background" Value="{StaticResource StatusWarnBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock
                                                        Text="{Binding Rank}"
                                                        FontSize="13" FontWeight="Medium"
                                                        Foreground="{StaticResource DarkBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13" FontWeight="Medium"
                                                        Foreground="{StaticResource PrimaryTextBrush}"
                                                        Text="{Binding AlarmName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSizeHint}"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="{Binding DeviceName}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock
                                                        FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                                        Foreground="{StaticResource StatusAlarmBrush}"
                                                        Text="{Binding TriggerCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F291}" />
                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSizeHint}"
                                                        Foreground="{StaticResource ThirdlyTextBrush}"
                                                        Text="{Binding TotalDurationText}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- 空状态：TopAlarms 为空时显示 -->
                                <controls:EmptyState IconKind="ShieldCheckOutline" Message="{x:Static resources:Strings.K374}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:EmptyState.Style>
                                        <Style TargetType="controls:EmptyState">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TopAlarms.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:EmptyState.Style>
                                </controls:EmptyState>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource PrimaryBrush}" />
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K375}" />
                                <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K376}" />
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- 时间刻度行：与格子行绑定同一集合同列数，像素级对齐；跨天窗口显示日期 -->
                                <ItemsControl ItemsSource="{Binding HeatmapBuckets}" Height="16" Margin="0,0,0,2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <prim:UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="{Binding TickLabel}"
                                                FontSize="{DynamicResource FontSizeMicro}"
                                                Foreground="{StaticResource ThirdlyTextBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                TextAlignment="Center" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding HeatmapBuckets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <prim:UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Cell" Margin="0" Height="48"
                                                    ToolTip="{Binding ToolTipText}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <!-- 状态格：主色 + 0.6 不透明度（2026-08-11 用户确认 a=0.60；
                                                             原 Soft 15% 在深色卡片上合成过暗，绿红黄不可区分） -->
                                                        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                                                        <Setter Property="Opacity" Value="0.5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusWord}" Value="1">
                                                                <Setter Property="Background" Value="{StaticResource StatusRunBrush}" />
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusWord}" Value="2">
                                                                <Setter Property="Background" Value="{StaticResource StatusAlarmBrush}" />
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusWord}" Value="3">
                                                                <Setter Property="Background" Value="{StaticResource StatusPauseBrush}" />
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <!--  图例（P2）：绿=运行 / 红=报警 / 黄=待机，悬停格子看精确时段；
                              色块与格子实际显示一致（主色 + 0.6，2026-08-11）  -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource StatusRunBrush}" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.Status_Running}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource StatusAlarmBrush}" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.Status_Alarm}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource StatusPauseBrush}" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.Status_Paused}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource BorderBrush}" Opacity="0.5" VerticalAlignment="Center" />
                                <TextBlock Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.Status_Unknown}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--  ──────── 设备明细表格（默认折叠，可展开） ────────  -->
                <Border Style="{StaticResource MainCard}" Padding="14">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ChartCardTitleBar}" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K378}" />
                                    <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K379}" />
                                </StackPanel>
                            </StackPanel>
                            <ToggleButton
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                IsChecked="{Binding IsDeviceTableExpanded}"
                                ToolTip="{x:Static resources:Strings.K379}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Padding" Value="10,3" />
                                        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <materialIcons:MaterialIcon Width="14" Height="14" Kind="ChevronDown">
                                    <materialIcons:MaterialIcon.Style>
                                        <Style TargetType="materialIcons:MaterialIcon">
                                            <Setter Property="Kind" Value="ChevronDown" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                    <Setter Property="Kind" Value="ChevronUp" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialIcons:MaterialIcon.Style>
                                </materialIcons:MaterialIcon>
                            </ToggleButton>
                        </Grid>
                        <DataGrid
                            Style="{StaticResource KanbanDataGrid}"
                            ColumnHeaderStyle="{StaticResource KanbanDataGridColumnHeader}"
                            CellStyle="{StaticResource DeviceDataGridCell}"
                            RowStyle="{StaticResource DeviceRowAlarm}"
                            ItemsSource="{Binding DeviceSummaries}"
                            Background="{StaticResource RegionBrush}"
                            VerticalContentAlignment="Center"
                            GridLinesVisibility="None"
                            RowHeight="81"
                            Height="Auto"
                            MinHeight="92"
                            MaxHeight="520"
                            RowHeaderWidth="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            VirtualizingStackPanel.IsVirtualizing="True"
                            VirtualizingStackPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            Visibility="{Binding IsDeviceTableExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                                </ItemsPanelTemplate>
                            </DataGrid.ItemsPanel>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static resources:Strings.K002}" Binding="{Binding DeviceName}" Width="170" MinWidth="150"
                                                    ElementStyle="{StaticResource DeviceNameCell}" />
                                <DataGridTemplateColumn Header="{x:Static resources:Strings.K380}" Width="160" MinWidth="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="6" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource DeviceOutputLabel}"
                                                               Foreground="{StaticResource StatusRunBrush}"
                                                               Text="{Binding OkCount, StringFormat=OK {0:N0}}" />
                                                    <TextBlock Margin="10,0,0,0"
                                                               Style="{StaticResource DeviceOutputLabel}"
                                                               Foreground="{StaticResource StatusAlarmBrush}"
                                                               Text="{Binding NgCount, StringFormat=NG {0:N0}}" />
                                                </StackPanel>
                                                <Grid Grid.Row="1" Margin="0,6,0,0" Height="7" Background="{StaticResource StatusAlarmSoftBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding OkRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                                        <ColumnDefinition Width="{Binding NgRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{StaticResource StatusRunBrush}" />
                                                    <Border Grid.Column="1" Background="{StaticResource StatusAlarmBrush}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{x:Static resources:Strings.K001}" Binding="{Binding QualityRate, StringFormat={}{0:P1}}" Width="92" MinWidth="86">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DeviceCoreMetricCell}" />
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="OEE" Binding="{Binding Oee, StringFormat={}{0:P1}}" Width="86" MinWidth="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DeviceCoreMetricCell}" />
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="{x:Static resources:Strings.K081}" Width="220" MinWidth="205">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <oxy:PlotView Width="100" Height="24" Margin="0,0,12,0"
                                                              Model="{Binding StatusDistributionChart}"
                                                              Background="Transparent" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource DeviceDurationLabel}"
                                                               Foreground="{StaticResource StatusRunBrush}"
                                                               Text="{Binding RunTimeHours, Converter={StaticResource LocFormatConverter}, ConverterParameter=F254}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource DeviceDurationLabel}"
                                                               Foreground="{StaticResource StatusPauseBrush}"
                                                               Text="{Binding PausedTimeHours, Converter={StaticResource LocFormatConverter}, ConverterParameter=F255}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource DeviceDurationLabel}"
                                                               Foreground="{StaticResource StatusAlarmBrush}"
                                                               Text="{Binding AlarmDurationHours, Converter={StaticResource LocFormatConverter}, ConverterParameter=F256}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{x:Static resources:Strings.K381}" Binding="{Binding TopAlarmName}" Width="*" MinWidth="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                            <DataGrid.InputBindings>
                                <MouseBinding
                                    MouseAction="LeftClick"
                                    Command="{Binding FocusDeviceCommand}"
                                    CommandParameter="{Binding SelectedItem.DeviceId, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataGrid.InputBindings>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!--  ──────── 班次对比表 ────────  -->
                <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource PrimaryBrush}" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K082}" />
                                    <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K382}" />
                                </StackPanel>
                        </StackPanel>
                        <Grid>
                            <DataGrid
                                Style="{StaticResource KanbanDataGrid}"
                                ColumnHeaderStyle="{StaticResource KanbanDataGridColumnHeader}"
                                CellStyle="{StaticResource KanbanDataGridCell}"
                                ItemsSource="{Binding ShiftComparisons}"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                Height="160"
                                RowHeight="52"
                                GridLinesVisibility="None"
                                VirtualizingStackPanel.IsVirtualizing="True"
                                VirtualizingStackPanel.VirtualizationMode="Recycling"
                                VirtualizingPanel.ScrollUnit="Pixel">
                                <DataGrid.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                                    </ItemsPanelTemplate>
                                </DataGrid.ItemsPanel>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static resources:Strings.K022}" Binding="{Binding ShiftName}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="{x:Static resources:Strings.K383}" Width="230" MinWidth="210">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center" Margin="8,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="6" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource StatusRunBrush}"
                                                                   Text="{Binding OkCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F257}" />
                                                        <TextBlock Margin="12,0,0,0" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource StatusAlarmBrush}"
                                                                   Text="{Binding NgCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F258}" />
                                                    </StackPanel>
                                                    <Grid Grid.Row="1" Margin="0,5,0,0" Background="{StaticResource StatusAlarmSoftBrush}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding OkRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                                            <ColumnDefinition Width="{Binding NgRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{StaticResource StatusRunBrush}" />
                                                        <Border Grid.Column="1" Background="{StaticResource StatusAlarmBrush}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{x:Static resources:Strings.K023}" Binding="{Binding TotalCount, StringFormat={}{0:N0}}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{x:Static resources:Strings.K001}" Binding="{Binding OkRatio, StringFormat={}{0:P1}}" Width="88">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{StaticResource StatusRunBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{x:Static resources:Strings.K090}" Binding="{Binding AlarmCount, StringFormat={}{0:N0}}" Width="88">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Setter Property="Foreground" Value="{StaticResource StatusAlarmBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{x:Static resources:Strings.K384}" Binding="{Binding AlarmRate, StringFormat={}{0:P1}}" Width="92">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Setter Property="Foreground" Value="{StaticResource StatusAlarmBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="OEE" Binding="{Binding Oee, StringFormat={}{0:P1}}" Width="86">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{x:Static resources:Strings.K007}" Binding="{Binding RunTimeHours, StringFormat={}{0:F1}h}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontFamily" Value="Consolas" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{x:Static resources:Strings.K038}" Binding="{Binding AlarmDurationHours, StringFormat={}{0:F1}h}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Setter Property="Foreground" Value="{StaticResource StatusAlarmBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{x:Static resources:Strings.K385}" Binding="{Binding TargetAchievementRate, StringFormat={}{0:P1}}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Setter Property="Foreground" Value="{StaticResource StatusRunBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!--  空状态：未配置班次或无数据时提示  -->
                            <controls:EmptyState IconKind="CalendarClockOutline" Message="{x:Static resources:Strings.K386}" Hint="{x:Static resources:Strings.K387}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:EmptyState.Style>
                                    <Style TargetType="controls:EmptyState">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShiftComparisons.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:EmptyState.Style>
                            </controls:EmptyState>
                        </Grid>
                    </DockPanel>
                </Border>

                <!--  ──────── OEE 瀑布图 + 缺陷帕累托（左右布局） ────────  -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- OEE 瀑布图 -->
                    <Border Grid.Column="0" Style="{StaticResource MainCard}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource ChartBaseSeriesBrush}" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K388}" />
                                    <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K389}" />
                                </StackPanel>
                            </StackPanel>
                            <oxy:PlotView
                                Grid.Row="1"
                                x:Name="OeeWaterfallPlotView"
                                Model="{Binding OeeWaterfallChart}"
                                Background="Transparent"
                                MinHeight="200" />
                            <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                                <TextBlock Margin="0,0,12,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding AvailabilityLossText}" />
                                <TextBlock Margin="0,0,12,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding PerformanceLossText}" />
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding QualityLossText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 缺陷帕累托图 -->
                    <Border Grid.Column="2" Style="{StaticResource MainCard}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource DangerBrush}" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K390}" />
                                    <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K391}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid Grid.Row="1" MinHeight="200">
                                <oxy:PlotView
                                    x:Name="DefectParetoPlotView"
                                    Model="{Binding DefectParetoChart}"
                                    Background="Transparent"
                                    MinHeight="200" />
                                <controls:EmptyState IconKind="ShieldCheckOutline" Message="{x:Static resources:Strings.K392}" Hint="{x:Static resources:Strings.K393}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:EmptyState.Style>
                                        <Style TargetType="controls:EmptyState">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefectParetos.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:EmptyState.Style>
                                </controls:EmptyState>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!--  ──────── 停机分析 ────────  -->
                <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource StatusAlarmBrush}" />
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K395}" />
                                <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K396}" />
                            </StackPanel>
                        </StackPanel>
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K397}" />
                                <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding TotalDowntimeHours, Converter={StaticResource DurationToTextConverter}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K398}" />
                                <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding AverageAlarmDurationMinutes, StringFormat={}{0:F1}min}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCellLabel}" Text="MTBF" />
                                <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding MtbfHours, Converter={StaticResource DurationToTextConverter}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCellLabel}" Text="{x:Static resources:Strings.K091}" />
                                <TextBlock Style="{StaticResource KpiCellValue}" Text="{Binding LongestDowntimeHours, Converter={StaticResource DurationToTextConverter}}" />
                            </StackPanel>
                        </UniformGrid>
                    </DockPanel>
                </Border>

                <!--  ──────── 时段产量热力图 ────────  -->
                <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Border Style="{StaticResource ChartCardTitleBar}" Background="{StaticResource ChartBaseSeriesBrush}" />
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K399}" />
                                <TextBlock Style="{StaticResource SubtitleText}" Text="{x:Static resources:Strings.K400}" />
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <oxy:PlotView
                                x:Name="HeatmapPlotView"
                                Model="{Binding ProductionHeatmapChart}"
                                Background="Transparent"
                                Height="180" />
                            <!--  空状态：无设备或无产量数据时提示  -->
                            <controls:EmptyState IconKind="GridLarge" Message="{x:Static resources:Strings.K401}" Hint="{x:Static resources:Strings.K402}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:EmptyState.Style>
                                    <Style TargetType="controls:EmptyState">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DeviceSummaries.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:EmptyState.Style>
                            </controls:EmptyState>
                        </Grid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  ============ 骨架屏占位（IsLoading=true 时显示，模拟 KPI 条 + 趋势图 + 表格布局） ============  -->
        <StackPanel Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- KPI 骨架条（1 行 × 5 列） -->
            <Border Style="{StaticResource MainCard}" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InnerCard}" Margin="2" Padding="14,10">
                        <StackPanel>
                            <Border Style="{StaticResource SkeletonBorder}" Width="48" Height="13" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="70" Height="22" Margin="0,6,0,0" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="56" Height="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InnerCard}" Margin="2" Padding="14,10">
                        <StackPanel>
                            <Border Style="{StaticResource SkeletonBorder}" Width="48" Height="13" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="70" Height="22" Margin="0,6,0,0" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="56" Height="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource InnerCard}" Margin="2" Padding="14,10">
                        <StackPanel>
                            <Border Style="{StaticResource SkeletonBorder}" Width="48" Height="13" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="70" Height="22" Margin="0,6,0,0" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="56" Height="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource InnerCard}" Margin="2" Padding="14,10">
                        <StackPanel>
                            <Border Style="{StaticResource SkeletonBorder}" Width="48" Height="13" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="70" Height="22" Margin="0,6,0,0" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="56" Height="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource InnerCard}" Margin="2" Padding="14,10">
                        <StackPanel>
                            <Border Style="{StaticResource SkeletonBorder}" Width="48" Height="13" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="70" Height="22" Margin="0,6,0,0" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="56" Height="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 趋势图 + Top 报警 骨架 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MainCard}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource SkeletonBorder}" Width="3" Height="14" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="120" Height="17" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource SkeletonBorder}" Height="240" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MainCard}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource SkeletonBorder}" Width="3" Height="14" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="90" Height="17" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource SkeletonBorder}" Height="36" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonBorder}" Height="36" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonBorder}" Height="36" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonBorder}" Height="36" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonBorder}" Height="36" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 设备明细表格骨架 -->
            <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource SkeletonBorder}" Width="3" Height="14" />
                        <Border Style="{StaticResource SkeletonBorder}" Width="80" Height="17" Margin="8,0,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource SkeletonBorder}" Height="32" Margin="0,0,0,4" />
                    <Border Style="{StaticResource SkeletonBorder}" Height="32" Margin="0,0,0,4" />
                    <Border Style="{StaticResource SkeletonBorder}" Height="32" Margin="0,0,0,4" />
                    <Border Style="{StaticResource SkeletonBorder}" Height="32" Margin="0,0,0,4" />
                    <Border Style="{StaticResource SkeletonBorder}" Height="32" Margin="0,0,0,4" />
                    <Border Style="{StaticResource SkeletonBorder}" Height="32" Margin="0,0,0,4" />
                    <Border Style="{StaticResource SkeletonBorder}" Height="32" />
                </StackPanel>
            </Border>

            <!-- 班次对比表骨架 -->
            <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource SkeletonBorder}" Width="3" Height="14" />
                        <Border Style="{StaticResource SkeletonBorder}" Width="80" Height="17" Margin="8,0,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource SkeletonBorder}" Height="32" Margin="0,0,0,4" />
                    <Border Style="{StaticResource SkeletonBorder}" Height="32" Margin="0,0,0,4" />
                    <Border Style="{StaticResource SkeletonBorder}" Height="32" />
                </StackPanel>
            </Border>

            <!-- OEE 瀑布图 + 缺陷帕累托 骨架 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MainCard}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource SkeletonBorder}" Width="3" Height="14" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="100" Height="17" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource SkeletonBorder}" Height="220" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MainCard}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource SkeletonBorder}" Width="3" Height="14" />
                            <Border Style="{StaticResource SkeletonBorder}" Width="90" Height="17" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource SkeletonBorder}" Height="36" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonBorder}" Height="36" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonBorder}" Height="36" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonBorder}" Height="36" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonBorder}" Height="36" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 热力图骨架 -->
            <Border Style="{StaticResource MainCard}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource SkeletonBorder}" Width="3" Height="14" />
                        <Border Style="{StaticResource SkeletonBorder}" Width="120" Height="17" Margin="8,0,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource SkeletonBorder}" Height="180" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
