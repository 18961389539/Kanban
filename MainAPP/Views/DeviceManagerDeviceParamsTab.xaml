<UserControl
    x:Class="MainAPP.Views.DeviceManagerDeviceParamsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:conv="clr-namespace:MainAPP.Converters"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="800" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        设备管理 Tab 1：设备参数。
        DataContext 由父级 DeviceManagerView 传入 DeviceManagerViewModel；
        内层 StackPanel 重设 DataContext={Binding SelectedDevice} 切换到当前设备。
        按钮通过 RelativeSource AncestorType=UserControl 找到子 UserControl（其 DataContext 仍是 VM）。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" DataContext="{Binding SelectedDevice}">

            <Border Margin="0,0,0,16" Padding="10,8" Background="{StaticResource StatusAlarmSoftBrush}"
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPlcConnected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="LanDisconnect" Width="18" Height="18" Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}"
                               Text="{x:Static resources:Strings.K192}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,16" Padding="10,8" Background="{StaticResource SecondaryRegionBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="{Binding DataContext.PlcOperationStatus, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.PlcOperationStatusType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Success">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.PlcOperationStatusType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Error">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.PlcOperationStatusType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Progress">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="12"
                Background="{StaticResource PrimarySoftBrush}"
                BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="1"
                Visibility="{Binding DataContext.HasCurrentDeviceValidationErrors, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="{StaticResource DangerBrush}"
                        Text="{x:Static resources:Strings.K193}" />
                    <ItemsControl ItemsSource="{Binding DataContext.CurrentDeviceValidationErrors, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,6,0,0"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="{x:Static resources:Strings.K194}"
                                    Command="{Binding DataContext.FocusValidationErrorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding Message}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource DangerBrush}"
                                    Style="{StaticResource ButtonDefault}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K195}" />
            <hc:Divider Margin="0,8" />

            <hc:TextBox
                Margin="0,8,0,16"
                hc:InfoElement.Title="{x:Static resources:Strings.K062}"
                hc:InfoElement.TitlePlacement="Top"
                AutomationProperties.Name="{x:Static resources:Strings.K062}"
                Style="{StaticResource TextBoxExtend}"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <hc:TextBox
                Margin="0,0,0,16"
                hc:InfoElement.Title="{x:Static resources:Strings.K196}"
                hc:InfoElement.TitlePlacement="Top"
                AutomationProperties.Name="{x:Static resources:Strings.K197}"
                Style="{StaticResource TextBoxExtend}"
                Text="{Binding TargetCycle, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource SectionTitleText}"
                Text="{x:Static resources:Strings.K198}" />
            <hc:Divider Margin="0,8" />

            <Grid Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <hc:TextBox
                    x:Name="OkAddressTextBox"
                    Grid.Column="0"
                    hc:InfoElement.Title="{x:Static resources:Strings.K199}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.K200}"
                    Style="{StaticResource TextBoxExtend}">
                    <hc:TextBox.Text>
                        <Binding Path="OkCountAddress" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <conv:PlcAddressValidationRule ExpectedType="DWord" />
                            </Binding.ValidationRules>
                        </Binding>
                    </hc:TextBox.Text>
                </hc:TextBox>
                <Button
                    Grid.Column="2"
                    Margin="0,16,0,0"
                    AutomationProperties.Name="{x:Static resources:Strings.K201}"
                    Command="{Binding DataContext.ReadPlcValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding OkCountAddress}"
                    Content="{x:Static resources:Strings.K031}"
                    Style="{StaticResource IconButtonPrimary}"
                    Tag="{x:Static mi:MaterialIconKind.Eye}"
                    ToolTip="{x:Static resources:Strings.K032}"
                    ToolTipService.ShowOnDisabled="True" />
            </Grid>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <hc:TextBox
                    x:Name="NgAddressTextBox"
                    Grid.Column="0"
                    hc:InfoElement.Title="{x:Static resources:Strings.K202}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.K203}"
                    Style="{StaticResource TextBoxExtend}">
                    <hc:TextBox.Text>
                        <Binding Path="NgCountAddress" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <conv:PlcAddressValidationRule ExpectedType="DWord" />
                            </Binding.ValidationRules>
                        </Binding>
                    </hc:TextBox.Text>
                </hc:TextBox>
                <Button
                    Grid.Column="2"
                    Margin="0,16,0,0"
                    AutomationProperties.Name="{x:Static resources:Strings.K204}"
                    Command="{Binding DataContext.ReadPlcValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding NgCountAddress}"
                    Content="{x:Static resources:Strings.K031}"
                    Style="{StaticResource IconButtonPrimary}"
                    Tag="{x:Static mi:MaterialIconKind.Eye}"
                    ToolTip="{x:Static resources:Strings.K032}"
                    ToolTipService.ShowOnDisabled="True" />
            </Grid>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <hc:TextBox
                    x:Name="StatusAddressTextBox"
                    Grid.Column="0"
                    hc:InfoElement.Title="{x:Static resources:Strings.K205}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.K206}"
                    Style="{StaticResource TextBoxExtend}">
                    <hc:TextBox.Text>
                        <Binding Path="StatusCountAddress" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <conv:PlcAddressValidationRule ExpectedType="DWord" />
                            </Binding.ValidationRules>
                        </Binding>
                    </hc:TextBox.Text>
                </hc:TextBox>
                <Button
                    Grid.Column="2"
                    Margin="0,16,0,0"
                    AutomationProperties.Name="{x:Static resources:Strings.K207}"
                    Command="{Binding DataContext.ReadPlcValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding StatusCountAddress}"
                    Content="{x:Static resources:Strings.K031}"
                    Style="{StaticResource IconButtonPrimary}"
                    Tag="{x:Static mi:MaterialIconKind.Eye}"
                    ToolTip="{x:Static resources:Strings.K032}"
                    ToolTipService.ShowOnDisabled="True" />
            </Grid>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <hc:TextBox
                    x:Name="ResetAddressTextBox"
                    Grid.Column="0"
                    hc:InfoElement.Title="{x:Static resources:Strings.K208}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.K209}"
                    Style="{StaticResource TextBoxExtend}"
                    ToolTip="{x:Static resources:Strings.K210}">
                    <hc:TextBox.Text>
                        <Binding Path="ProductionResetAddress" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <conv:PlcAddressValidationRule ExpectedType="DWord" />
                            </Binding.ValidationRules>
                        </Binding>
                    </hc:TextBox.Text>
                </hc:TextBox>
                <Button
                    Grid.Column="2"
                    Margin="0,16,0,0"
                    AutomationProperties.Name="{x:Static resources:Strings.K211}"
                    Command="{Binding DataContext.ResetProductionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.K212}"
                    Style="{StaticResource IconButtonPrimary}"
                    Tag="{x:Static mi:MaterialIconKind.DeleteSweep}"
                    ToolTip="{x:Static resources:Strings.K213}"
                    ToolTipService.ShowOnDisabled="True" />
            </Grid>

            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource SectionTitleText}"
                Text="{x:Static resources:Strings.K214}" />
            <hc:Divider Margin="0,8" />

            <hc:TextBox
                Margin="0,8,0,16"
                hc:InfoElement.Title="{x:Static resources:Strings.K063}"
                hc:InfoElement.TitlePlacement="Top"
                AutomationProperties.Name="{x:Static resources:Strings.K063}"
                Style="{StaticResource TextBoxExtend}"
                Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}" />
            <hc:TextBox
                Margin="0,0,0,16"
                hc:InfoElement.Title="{x:Static resources:Strings.K215}"
                hc:InfoElement.TitlePlacement="Top"
                AutomationProperties.Name="{x:Static resources:Strings.K216}"
                Style="{StaticResource TextBoxExtend}"
                Text="{Binding RecipeValue, UpdateSourceTrigger=PropertyChanged}" />
            <hc:TextBox
                Margin="0,0,0,16"
                hc:InfoElement.Title="{x:Static resources:Strings.K217}"
                hc:InfoElement.TitlePlacement="Top"
                AutomationProperties.Name="{x:Static resources:Strings.K218}"
                Style="{StaticResource TextBoxExtend}"
                Text="{Binding RecipeAddress, UpdateSourceTrigger=PropertyChanged}" />
            <DockPanel Margin="0,4,0,16">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeHint}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding DataContext.RecipeStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static resources:Strings.K219}"
                    Command="{Binding DataContext.WriteRecipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.K220}"
                    Style="{StaticResource IconButtonPrimary}"
                    Tag="{x:Static mi:MaterialIconKind.Upload}"
                    ToolTip="{x:Static resources:Strings.K221}"
                    ToolTipService.ShowOnDisabled="True" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
