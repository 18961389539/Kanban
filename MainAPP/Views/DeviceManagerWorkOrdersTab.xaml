<UserControl
    x:Class="MainAPP.Views.DeviceManagerWorkOrdersTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:entities="clr-namespace:MainAPP.Entities;assembly=Kanban.Collector.Core"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="800">
    <!--
        设备管理 Tab 5：工单管理（设备维度，左右布局）。
        DataContext 由父级 DeviceManagerView 传入 DeviceManagerViewModel。
        列表绑定到 VM.SelectedDeviceWorkOrders（按当前设备过滤），操作按钮绑定到 VM 的工单命令。
        布局参照 DeviceManagerAlarmsTab：左侧 220px 列表 + 右侧详情面板。
    -->
    <UserControl.Resources>
        <!--  工单状态 → 色点画刷  -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource ThirdlyTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Pending}">
                    <Setter Property="Fill" Value="{StaticResource ThirdlyTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Running}">
                    <Setter Property="Fill" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Completed}">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Aborted}">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Text" Value="—" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Pending}">
                    <Setter Property="Text" Value="待开始" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Running}">
                    <Setter Property="Text" Value="进行中" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Completed}">
                    <Setter Property="Text" Value="已完成" />
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static entities:WorkOrderStatus.Aborted}">
                    <Setter Property="Text" Value="已中止" />
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左侧：工单列表 ============  -->
        <DockPanel Grid.Column="0" LastChildFill="True">
            <!--  顶部操作按钮  -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Orientation="Horizontal">
                <Button Command="{Binding AddWorkOrderCommand}" Content="新增" Style="{StaticResource IconButtonPrimary}"
                        Tag="{x:Static mi:MaterialIconKind.Plus}" />
                <Button Margin="8,0,0,0" Command="{Binding EditWorkOrderCommand}" Content="编辑" Style="{StaticResource IconButtonDefault}"
                        Tag="{x:Static mi:MaterialIconKind.PencilOutline}" />
                <Button Margin="8,0,0,0" Command="{Binding DeleteWorkOrderCommand}" Content="删除" Style="{StaticResource IconButtonDanger}"
                        Tag="{x:Static mi:MaterialIconKind.Delete}" />
            </StackPanel>

            <!--  工单列表  -->
            <ListBox ItemsSource="{Binding SelectedDeviceWorkOrders}"
                     SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource CardListItemStyle}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2" VerticalAlignment="Center">
                            <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding OrderNo}" TextTrimming="CharacterEllipsis" />
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Top" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <Ellipse Style="{StaticResource StatusDot}" />
                                    <TextBlock Margin="6,0,0,0" Style="{StaticResource StatusText}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!--  ============ 右侧：工单详情 ============  -->
        <Border
            Grid.Column="2"
            Padding="20"
            Background="{StaticResource SecondaryRegionBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <materialIcons:MaterialIcon Kind="ClipboardTextOutline" Style="{StaticResource SectionTitleIcon}" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource SectionTitleText}" Text="工单详情" />
                </DockPanel>

                <!--  详情内容  -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--  无选中时占位  -->
                        <TextBlock HorizontalAlignment="Center" Margin="0,80,0,0"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="请选择左侧工单查看详情"
                                   Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />

                        <!--  详情字段（仅在 SelectedWorkOrder 非 null 时显示）  -->
                        <StackPanel Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}">
                            <!--  工单号  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="工单号" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.OrderNo}" />
                            </DockPanel>
                            <!--  产品编码  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="产品编码" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.ProductCode}" />
                            </DockPanel>
                            <!--  产品名称  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="产品名称" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.ProductName}" />
                            </DockPanel>
                            <!--  计划产量  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="计划产量" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding SelectedWorkOrder.TargetQuantity, StringFormat={}{0:N0} 件}" />
                            </DockPanel>
                            <!--  计划时间  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="计划时间" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="{Binding SelectedWorkOrder.PlannedStart, StringFormat={}{0:MM-dd HH:mm}}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource ThirdlyTextBrush}"
                                               Text="{Binding SelectedWorkOrder.PlannedEnd, StringFormat={}~ {0:MM-dd HH:mm}}" />
                                </StackPanel>
                            </DockPanel>
                            <!--  状态  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="状态" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Style="{StaticResource StatusDot}" DataContext="{Binding SelectedWorkOrder}" />
                                    <TextBlock Margin="6,0,0,0" Style="{StaticResource StatusText}" DataContext="{Binding SelectedWorkOrder}" />
                                </StackPanel>
                            </DockPanel>
                            <!--  备注  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Top"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="备注" />
                                <TextBlock VerticalAlignment="Top" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"
                                           Text="{Binding SelectedWorkOrder.Remark, TargetNullValue=—}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!--  底部状态操作按钮  -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal"
                            Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}">
                    <Button Command="{Binding StartWorkOrderCommand}" Content="开始" Style="{StaticResource IconButtonPrimary}"
                            Tag="{x:Static mi:MaterialIconKind.Play}" />
                    <Button Margin="8,0,0,0" Command="{Binding CompleteWorkOrderCommand}" Content="完成" Style="{StaticResource IconButtonSuccess}"
                            Tag="{x:Static mi:MaterialIconKind.Check}" />
                    <Button Margin="8,0,0,0" Command="{Binding AbortWorkOrderCommand}" Content="中止" Style="{StaticResource IconButtonWarning}"
                            Tag="{x:Static mi:MaterialIconKind.Stop}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
