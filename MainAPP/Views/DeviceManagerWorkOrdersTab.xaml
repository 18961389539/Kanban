<UserControl
    x:Class="MainAPP.Views.DeviceManagerWorkOrdersTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:entities="clr-namespace:Kanban.Core.Entities;assembly=Kanban.Collector.Core"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="800" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        设备管理 Tab 5：工单管理（设备维度，左右布局）。
        DataContext 由父级 DeviceManagerView 传入 DeviceManagerViewModel。
        列表绑定到 VM.SelectedDeviceWorkOrders（按当前设备过滤），操作按钮绑定到 VM 的工单命令。
        布局参照 DeviceManagerAlarmsTab：左侧 220px 列表 + 右侧详情面板。
    -->
    <UserControl.Resources>
        <!--  工单状态色点/文本已全局化至 Styles/Components.xaml（StatusDot/StatusText）  -->
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左侧：工单列表 ============  -->
        <DockPanel Grid.Column="0" LastChildFill="True">
            <!--  顶部操作按钮：新增（高频留文字）+ 更多（编辑/删除收进下拉，左列 220px 放不下三按钮）  -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Orientation="Horizontal">
                <Button Command="{Binding AddWorkOrderCommand}" Content="{x:Static resources:Strings.K033}" Style="{StaticResource IconButtonPrimary}"
                        Tag="{x:Static mi:MaterialIconKind.Plus}" />
                <Button
                    Margin="8,0,0,0"
                    x:Name="WorkOrderMoreButton"
                    AutomationProperties.Name="{x:Static resources:Strings.K234}"
                    Click="OnWorkOrderMoreClick"
                    Content="{x:Static resources:Strings.K235}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.DotsHorizontal}"
                    ToolTip="{x:Static resources:Strings.K236}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                AutomationProperties.Name="{x:Static resources:Strings.K072}"
                                Command="{Binding EditWorkOrderCommand}"
                                Header="{x:Static resources:Strings.K072}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="PencilOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                AutomationProperties.Name="{x:Static resources:Strings.K034}"
                                Command="{Binding DeleteWorkOrderCommand}"
                                Header="{x:Static resources:Strings.K034}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="Delete" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <!--  工单列表  -->
            <ListBox ItemsSource="{Binding SelectedDeviceWorkOrders}"
                     SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource CardListItemStyle}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2" VerticalAlignment="Center">
                            <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding OrderNo}" TextTrimming="CharacterEllipsis" />
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Top" FontSize="{DynamicResource FontSizeHint}" Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <Ellipse Style="{StaticResource StatusDot}" />
                                    <TextBlock Margin="6,0,0,0" Style="{StaticResource StatusText}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!--  ============ 右侧：工单详情 ============  -->
        <Border
            Grid.Column="2"
            Padding="20"
            Background="{StaticResource SecondaryRegionBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <materialIcons:MaterialIcon Kind="ClipboardTextOutline" Style="{StaticResource SectionTitleIcon}" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K073}" />
                </DockPanel>

                <!--  详情内容  -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--  无选中时占位  -->
                        <TextBlock HorizontalAlignment="Center" Margin="0,80,0,0"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="{x:Static resources:Strings.K074}"
                                   Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />

                        <!--  详情字段（仅在 SelectedWorkOrder 非 null 时显示）  -->
                        <StackPanel Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}">
                            <!--  工单号  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K008}" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.OrderNo}" />
                            </DockPanel>
                            <!--  产品编码  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K019}" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.ProductCode}" />
                            </DockPanel>
                            <!--  产品名称  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K020}" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedWorkOrder.ProductName}" />
                            </DockPanel>
                            <!--  计划产量  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K035}" />
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding SelectedWorkOrder.TargetQuantity, Converter={StaticResource LocFormatConverter}, ConverterParameter=F244}" />
                            </DockPanel>
                            <!--  计划时间  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K075}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="{Binding SelectedWorkOrder.PlannedStart, StringFormat={}{0:MM-dd HH:mm}}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource ThirdlyTextBrush}"
                                               Text="{Binding SelectedWorkOrder.PlannedEnd, StringFormat={}~ {0:MM-dd HH:mm}}" />
                                </StackPanel>
                            </DockPanel>
                            <!--  状态  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K003}" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Style="{StaticResource StatusDot}" DataContext="{Binding SelectedWorkOrder}" />
                                    <TextBlock Margin="6,0,0,0" Style="{StaticResource StatusText}" DataContext="{Binding SelectedWorkOrder}" />
                                </StackPanel>
                            </DockPanel>
                            <!--  备注  -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="100" VerticalAlignment="Top"
                                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K021}" />
                                <TextBlock VerticalAlignment="Top" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"
                                           Text="{Binding SelectedWorkOrder.Remark, TargetNullValue=—}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!--  底部状态操作按钮  -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal"
                            Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}">
                    <Button Command="{Binding StartWorkOrderCommand}" Content="{x:Static resources:Strings.K036}" Style="{StaticResource IconButtonPrimary}"
                            Tag="{x:Static mi:MaterialIconKind.Play}" />
                    <Button Margin="8,0,0,0" Command="{Binding CompleteWorkOrderCommand}" Content="{x:Static resources:Strings.K076}" Style="{StaticResource IconButtonSuccess}"
                            Tag="{x:Static mi:MaterialIconKind.Check}" />
                    <Button Margin="8,0,0,0" Command="{Binding AbortWorkOrderCommand}" Content="{x:Static resources:Strings.K077}" Style="{StaticResource IconButtonWarning}"
                            Tag="{x:Static mi:MaterialIconKind.Stop}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
