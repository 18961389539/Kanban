<UserControl
    x:Class="MainAPP.Views.UserManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    xmlns:resources="clr-namespace:MainAPP.Resources"
    d:DesignHeight="560"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="480" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="1.2*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!--  ══ 左：用户列表 ══  -->
        <Border Grid.Column="0" Padding="0" Style="{StaticResource MainCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题 + 计数 + 风险徽章 -->
                <DockPanel Grid.Row="0" Margin="18,18,18,12">
                    <materialIcons:MaterialIcon Kind="AccountGroup" Style="{StaticResource SectionTitleIcon}" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.M320}" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{StaticResource ThirdlyTextBrush}"
                               Text="{Binding Users.Count, StringFormat={}({0})}" />
                    <Border DockPanel.Dock="Right" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                            ToolTip="{x:Static resources:Strings.M372}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSecurityRisks}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}" Text="{x:Static resources:Strings.M372}" />
                            <TextBlock Margin="4,0,0,0" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"
                                       Text="{Binding SecurityRisks.Count, StringFormat={}({0})}" />
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- 安全体检横幅 -->
                <ItemsControl Grid.Row="1" Margin="18,0,18,0" ItemsSource="{Binding SecurityRisks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="6" BorderThickness="1"
                                    Background="{StaticResource SecondaryRegionBrush}"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="Bold"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="{Binding DisplayLabel}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Text="{Binding Text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 搜索 + 角色筛选 -->
                <Grid Grid.Row="2" Margin="18,10,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <hc:TextBox Grid.Row="0"
                                hc:InfoElement.Placeholder="{x:Static resources:Strings.M379}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl Grid.Row="1" Margin="0,8,0,8" ItemsSource="{Binding RoleFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,4" Padding="10,3" Cursor="Hand"
                                        Command="{Binding DataContext.SelectRoleFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Display}" />
                                        <TextBlock Margin="5,0,0,0" Opacity="0.75" Text="{Binding Count, StringFormat=({0})}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- 用户表格 -->
                <Grid Grid.Row="4" Margin="0,0,0,0">
                    <DataGrid
                        AutoGenerateColumns="False"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                        IsReadOnly="True"
                        ItemsSource="{Binding FilteredUsers}"
                        SelectedItem="{Binding SelectedUser}"
                        CellStyle="{StaticResource KanbanDataGridCell}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="180">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon Kind="AccountGroup" Width="14" Height="14" VerticalAlignment="Center"
                                                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock Margin="6,0,0,0" Text="{x:Static resources:Strings.Um_User}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    Background="{Binding Role, Converter={StaticResource UserRoleToBrushConverter}}">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontWeight="Bold" Foreground="{StaticResource PrimaryContrastBrush}"
                                                           Text="{Binding Username, Converter={StaticResource FirstCharacterConverter}}" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           Text="{Binding Username}" />
                                                <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="{Binding DisplayName}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon Kind="ShieldKeyOutline" Width="14" Height="14" VerticalAlignment="Center"
                                                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock Margin="6,0,0,0" Text="{x:Static resources:Strings.Um_Role}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,0" CornerRadius="9" HorizontalAlignment="Center"
                                                BorderThickness="1"
                                                BorderBrush="{Binding Role, Converter={StaticResource UserRoleToBrushConverter}}">
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Role, Converter={StaticResource UserRoleToBrushConverter}}"
                                                       Text="{Binding Role, Converter={StaticResource UserRoleToTextConverter}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14" VerticalAlignment="Center"
                                                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock Margin="6,0,0,0" Text="{x:Static resources:Strings.K003}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{Binding Converter={StaticResource UserStatusToBrushConverter}}"
                                                   Text="{Binding Converter={StaticResource UserStatusToTextConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Binding="{Binding LastLoginAt, Converter={StaticResource UtcToLocalConverter}}"
                                FontSize="{DynamicResource FontSizeHint}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon Kind="History" Width="14" Height="14" VerticalAlignment="Center"
                                                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock Margin="6,0,0,0" Text="{x:Static resources:Strings.Um_LastLogin}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="14" Height="14" VerticalAlignment="Center"
                                                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock Margin="6,0,0,0" Text="{x:Static resources:Strings.Um_Security}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Text="{Binding Converter={StaticResource UserRiskToTextConverter}}"
                                                   ToolTip="{Binding Converter={StaticResource UserRiskToTextConverter}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource UserRiskToTextConverter}}" Value="">
                                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="110">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon Kind="Cog" Width="14" Height="14" VerticalAlignment="Center"
                                                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock Margin="6,0,0,0" Text="{x:Static resources:Strings.Um_Actions}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button Padding="8,6" Margin="0,0,4,0" Cursor="Hand"
                                                    AutomationProperties.Name="{x:Static resources:Strings.M324}"
                                                    ToolTip="{x:Static resources:Strings.M324}"
                                                    Command="{Binding DataContext.ResetPasswordForCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Width="16" Height="16" Kind="Key" />
                                            </Button>
                                            <Button Padding="8,6" Margin="0,0,4,0" Cursor="Hand"
                                                    AutomationProperties.Name="{x:Static resources:Strings.M367}"
                                                    ToolTip="{x:Static resources:Strings.M367}"
                                                    Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding Converter={StaticResource UserIsLockedToVisibilityConverter}}">
                                                <materialIcons:MaterialIcon Width="16" Height="16" Kind="LockOpenVariantOutline" />
                                            </Button>
                                            <Button Padding="8,6" Cursor="Hand"
                                                    AutomationProperties.Name="{x:Static resources:Strings.M323}"
                                                    ToolTip="{x:Static resources:Strings.M323}"
                                                    Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Width="16" Height="16" Foreground="{StaticResource DangerBrush}" Kind="DeleteOutline" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空态 -->
                    <controls:EmptyState
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IconKind="AccountGroup"
                        Message="{x:Static resources:Strings.M380}"
                        Hint="{x:Static resources:Strings.M322}">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>
                </Grid>
            </Grid>
        </Border>

        <!-- 分隔条（参照工单/配方页） -->
        <GridSplitter Grid.Column="1" Width="10" Margin="0,2"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" Cursor="SizeWE"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Grip" Width="2"
                                   HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                   Fill="{StaticResource BorderBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Fill" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Grip" Property="Width" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!--  ══ 右：操作区（Tab：编辑选中用户 / 添加新用户） ══  -->
        <Border Grid.Column="2" Padding="0" Style="{StaticResource MainCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Tab 头 -->
                <StackPanel Grid.Row="0" Margin="16,16,16,-1" Orientation="Horizontal">
                    <Button Margin="0,0,2,0" Padding="14,6" BorderThickness="1,1,1,0" Cursor="Hand"
                            Command="{Binding ShowEditTabCommand}">
                        <Button.FocusVisualStyle>
                            <Style>
                                <Setter Property="Control.Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5"
                                                    CornerRadius="6,6,0,0" Margin="-1.5" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.FocusVisualStyle>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6,6,0,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✎ " /><TextBlock Text="{x:Static resources:Strings.M320}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="2,0,0,0" Padding="14,6" BorderThickness="1,1,1,0" Cursor="Hand"
                            Command="{Binding ShowAddTabCommand}">
                        <Button.FocusVisualStyle>
                            <Style>
                                <Setter Property="Control.Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5"
                                                    CornerRadius="6,6,0,0" Margin="-1.5" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.FocusVisualStyle>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6,6,0,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋ " /><TextBlock Text="{x:Static resources:Strings.M322}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 编辑面板（选中用户时显示） -->
                <Border Grid.Row="1" Margin="16,0,16,16" Padding="16" CornerRadius="0,6,6,6"
                        Background="{StaticResource SecondaryRegionBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="{DynamicResource FontSizeCaption}"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding SelectedUser.DisplayLabel}" />

                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="{DynamicResource FontSizeHint}"
                            Foreground="{StaticResource WarningBrush}"
                            Text="{x:Static resources:Strings.M362}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUserEdits}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <hc:TextBox
                            Margin="0,0,0,12"
                            hc:InfoElement.Title="{x:Static resources:Strings.M330}"
                            hc:InfoElement.TitlePlacement="Top"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                        <hc:ComboBox
                            Margin="0,0,0,12"
                            hc:InfoElement.Title="{x:Static resources:Strings.M321}"
                            hc:InfoElement.TitlePlacement="Top"
                            ItemsSource="{Binding Source={x:Static vm:UserManagerViewModel.AvailableRoles}}"
                            SelectedItem="{Binding EditRole, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource ComboBoxExtend}" />

                        <CheckBox
                            Margin="0,0,0,12"
                            Content="{x:Static resources:Strings.M331}"
                            IsChecked="{Binding EditIsActive, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- 解锁（仅锁定中显示） -->
                        <Button
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding UnlockCommand}"
                            CommandParameter="{Binding SelectedUser}"
                            Content="{x:Static resources:Strings.M367}"
                            Visibility="{Binding SelectedUser, Converter={StaticResource UserIsLockedToVisibilityConverter}}"
                            Style="{StaticResource ButtonDefault}" />

                        <Button
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding UpdateUserCommand}"
                            Content="{x:Static resources:Strings.Common_Save}"
                            Style="{StaticResource ButtonPrimary}" />

                        <Button
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ResetPasswordForCommand}"
                            CommandParameter="{Binding SelectedUser}"
                            Content="{x:Static resources:Strings.M324}"
                            Style="{StaticResource ButtonDefault}" />

                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{Binding DeleteUserCommand}"
                            CommandParameter="{Binding SelectedUser}"
                            Content="{x:Static resources:Strings.M323}"
                            Style="{StaticResource ButtonDanger}" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 添加面板（未选中用户时显示） -->
                <Border Grid.Row="1" Margin="16,0,16,16" Padding="16" CornerRadius="0,6,6,6"
                        Background="{StaticResource SecondaryRegionBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <hc:TextBox
                            x:Name="NewUsernameBox"
                            Margin="0,0,0,12"
                            hc:InfoElement.Title="{x:Static resources:Strings.M316}"
                            hc:InfoElement.TitlePlacement="Top"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" />

                        <hc:TextBox
                            Margin="0,0,0,12"
                            hc:InfoElement.Title="{x:Static resources:Strings.M330}"
                            hc:InfoElement.TitlePlacement="Top"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                        <hc:ComboBox
                            Margin="0,0,0,12"
                            hc:InfoElement.Title="{x:Static resources:Strings.M321}"
                            hc:InfoElement.TitlePlacement="Top"
                            ItemsSource="{Binding Source={x:Static vm:UserManagerViewModel.AvailableRoles}}"
                            SelectedItem="{Binding NewUserRole, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource ComboBoxExtend}" />

                        <PasswordBox
                            x:Name="NewPasswordBox"
                            Margin="0,0,0,4"
                            hc:InfoElement.Title="{x:Static resources:Strings.M317}"
                            hc:InfoElement.TitlePlacement="Top"
                            AutomationProperties.Name="{x:Static resources:Strings.M317}"
                            PasswordChanged="OnNewPasswordChanged">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Height="5" VerticalAlignment="Center"
                                         Maximum="100" Minimum="0"
                                         Value="{Binding NewPasswordStrengthPercent, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeHint}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding NewPasswordStrengthText}" />
                        </Grid>

                        <PasswordBox
                            x:Name="ConfirmPasswordBox"
                            Margin="0,12,0,12"
                            hc:InfoElement.Title="{x:Static resources:Strings.M365}"
                            hc:InfoElement.TitlePlacement="Top"
                            AutomationProperties.Name="{x:Static resources:Strings.M365}"
                            PasswordChanged="OnNewPasswordChanged">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <CheckBox
                            Margin="0,0,0,12"
                            Content="{x:Static resources:Strings.M368}"
                            IsChecked="{Binding NewMustChangePassword, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            HorizontalAlignment="Stretch"
                            Click="OnAddUserClick"
                            Content="{x:Static resources:Strings.M322}"
                            Style="{StaticResource ButtonPrimary}" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
