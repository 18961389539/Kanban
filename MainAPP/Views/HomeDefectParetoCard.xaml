<UserControl
    x:Class="MainAPP.Views.HomeDefectParetoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="400" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        主页仪表板卡片 6：缺陷 TOP5 列表（与 WASM Home 缺陷卡对齐：名称 ToolTip=设备名 + 横向柱 + 计数）。
        DataContext 由父级 HomeView 传入 HomeViewModel。
    -->
    <Border Style="{StaticResource DashboardCard}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal">
                <materialIcons:MaterialIcon Style="{StaticResource CardTitleIcon}" Kind="Bug" />
                <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static resources:Strings.K317}" />
            </StackPanel>

            <Grid Grid.Row="1" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding DefectTop}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DeviceName}" />
                                <Border Grid.Column="1"
                                        Height="8"
                                        Margin="8,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SecondaryRegionBrush}"
                                        CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding BarRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource WarningBrush}"
                                                CornerRadius="4" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding Count, StringFormat=N0}"
                                           TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:EmptyState IconKind="CheckCircleOutline" Message="{x:Static resources:Strings.K052}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:EmptyState.Style>
                        <Style TargetType="controls:EmptyState">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDefectTopEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyState.Style>
                </controls:EmptyState>
            </Grid>
        </Grid>
    </Border>
</UserControl>
