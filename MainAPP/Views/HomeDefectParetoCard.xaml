<UserControl
    x:Class="MainAPP.Views.HomeDefectParetoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:metrics="clr-namespace:Kanban.Contracts.Metrics;assembly=Kanban.Contracts"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="400" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        主页仪表板卡片 6：缺陷帕累托 TOP5（条宽相对合计、累计占比、严重度配色）。
        DataContext 由父级 HomeView 传入 HomeViewModel。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Border Style="{StaticResource DashboardCard}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Style="{StaticResource CardTitleIcon}" Kind="Bug" />
                    <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static resources:Strings.K317}" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0"
                           FontSize="{DynamicResource FontSizeHint}"
                           Foreground="{StaticResource ThirdlyTextBrush}"
                           Text="{x:Static resources:Strings.Hp_DefectSubtitle}" />
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal"
                            Visibility="{Binding HasDefectParetoData, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding DefectParetoSummaryText}" />
                    <TextBlock Margin="6,0,0,0"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding DefectNgShareText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DefectNgShareText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasDefectParetoData, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding DefectTop}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8" ToolTip="{Binding Tooltip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                                   Text="{Binding RankText}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVitalFew}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontFamily="Consolas"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{Binding Count, StringFormat=N0}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="18,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource SecondaryRegionBrush}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{Binding Severity, Converter={StaticResource DefectSeverityToBrushConverter}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOthers}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource ThirdlyTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeHint}"
                                                   FontFamily="Consolas"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding ShareText}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeHint}"
                                                   FontFamily="Consolas"
                                                   Text="{Binding CumulativeText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVitalFew}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <controls:EmptyState IconKind="InboxOutline"
                                     Message="{x:Static resources:Strings.K052}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:EmptyState.Style>
                        <Style TargetType="controls:EmptyState">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DefectParetoEmptyKind}" Value="{x:Static metrics:DefectParetoEmptyKind.NoDevice}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyState.Style>
                </controls:EmptyState>
                <controls:EmptyState IconKind="CogOutline"
                                     Message="{x:Static resources:Strings.Hp_DefectEmptyUnconfigured}"
                                     Hint="{x:Static resources:Strings.Hp_DefectEmptyUnconfiguredHint}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:EmptyState.Style>
                        <Style TargetType="controls:EmptyState">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DefectParetoEmptyKind}" Value="{x:Static metrics:DefectParetoEmptyKind.NotConfigured}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyState.Style>
                </controls:EmptyState>
                <controls:EmptyState IconKind="CheckCircleOutline"
                                     Message="{x:Static resources:Strings.Hp_DefectEmptyZero}"
                                     Hint="{x:Static resources:Strings.Hp_DefectEmptyZeroHint}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:EmptyState.Style>
                        <Style TargetType="controls:EmptyState">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DefectParetoEmptyKind}" Value="{x:Static metrics:DefectParetoEmptyKind.AllZero}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyState.Style>
                </controls:EmptyState>
            </Grid>
        </Grid>
    </Border>
</UserControl>
