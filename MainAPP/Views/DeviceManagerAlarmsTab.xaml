<UserControl
    x:Class="MainAPP.Views.DeviceManagerAlarmsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:conv="clr-namespace:MainAPP.Converters"
    xmlns:models="clr-namespace:Kanban.Collector.Core.Models;assembly=Kanban.Collector.Core"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="800" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.Resources>
        <!--  报警级别枚举值（ComboBox 数据源），仅本 Tab 使用  -->
        <ObjectDataProvider
            x:Key="AlarmLevelValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:AlarmLevel" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <!--
        设备管理 Tab 2：报警管理。
        DataContext 由父级 DeviceManagerView 传入 DeviceManagerViewModel；
        内层 Grid 重设 DataContext={Binding SelectedDevice} 切换到当前设备。
        按钮通过 RelativeSource AncestorType=UserControl 找到子 UserControl（其 DataContext 仍是 VM）。
    -->
    <Grid Margin="24,16" DataContext="{Binding SelectedDevice}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" LastChildFill="True">
            <Button
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{x:Static resources:Strings.K053}"
                Command="{Binding DataContext.AddAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="{x:Static resources:Strings.K053}"
                DockPanel.Dock="Top"
                Style="{StaticResource IconButtonDefault}"
                Tag="{x:Static mi:MaterialIconKind.Plus}" />
            <!--  报警 CSV 导入/导出：批量编辑场景（Excel 整理后回导）  -->
            <Border
                Height="1"
                Margin="0,4,0,10"
                Background="{StaticResource DividerBrush}"
                DockPanel.Dock="Top" />
            <Grid
                Margin="0,0,0,10"
                DockPanel.Dock="Top">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsBusyAlarmsCsv, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Height="40"
                    Padding="10,0"
                    AutomationProperties.Name="{x:Static resources:Strings.K167}"
                    Command="{Binding DataContext.ExportAlarmsCsvCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.K653}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.FileExportOutline}"
                    ToolTip="{x:Static resources:Strings.K168}" />
                <Button
                    Grid.Column="2"
                    Height="40"
                    Padding="10,0"
                    AutomationProperties.Name="{x:Static resources:Strings.K169}"
                    Command="{Binding DataContext.ImportAlarmsCsvCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.K654}"
                    Style="{StaticResource IconButtonPrimary}"
                    Tag="{x:Static mi:MaterialIconKind.FileImportOutline}"
                    ToolTip="{x:Static resources:Strings.K170}" />
            </Grid>
            <Grid>
                <ListBox
                    AutomationProperties.Name="{x:Static resources:Strings.K171}"
                ItemContainerStyle="{StaticResource CardListItemStyle}"
                ItemsSource="{Binding Alarms}"
                SelectedItem="{Binding DataContext.SelectedAlarm, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel
                            VerticalAlignment="Stretch"
                            LastChildFill="True">
                            <Rectangle
                                Width="5"
                                RadiusX="2.5"
                                RadiusY="2.5"
                                Margin="0,0,8,0"
                                VerticalAlignment="Stretch"
                                Fill="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}" />
                            <Border
                                Margin="6,0,0,0"
                                Padding="8,1"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                CornerRadius="10"
                                Background="{Binding Level, Converter={StaticResource AlarmLevelToBrushConverter}}">
                                <TextBlock
                                    FontSize="{DynamicResource FontSizeMicro}"
                                    Foreground="White"
                                    Text="{Binding Level, Converter={StaticResource AlarmLevelToTextConverter}}" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSizeHint}"
                                Text="{Binding Converter={StaticResource LocalizedNameToTextConverter}}"
                                TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource ThirdlyTextBrush}"
                           Text="{x:Static resources:Strings.K374}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Alarms.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <Border
            Grid.Column="2"
            Padding="20"
            Background="{StaticResource SecondaryRegionBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{Binding DataContext.SelectedAlarm, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel
                DataContext="{Binding DataContext.SelectedAlarm, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding DataContext.CanManageDevices, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <hc:TextBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="{x:Static resources:Strings.K018}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.K018}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <hc:TextBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="{x:Static resources:Strings.K172}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.K173}"
                    Style="{StaticResource TextBoxExtend}">
                    <hc:TextBox.Text>
                        <Binding Path="PlcAddress" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <conv:PlcAddressValidationRule ExpectedType="MBit" />
                            </Binding.ValidationRules>
                        </Binding>
                    </hc:TextBox.Text>
                </hc:TextBox>
                <hc:ComboBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="{x:Static resources:Strings.K054}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.K054}"
                    ItemsSource="{Binding Source={StaticResource AlarmLevelValues}}"
                    SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ComboBoxExtend}" />
                <hc:TextBox
                    Height="80"
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="{x:Static resources:Strings.K030}"
                    hc:InfoElement.TitlePlacement="Top"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{x:Static resources:Strings.K030}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                <!--  多语言名称：NameEn/NameJa/NamePt 为空时显示回退主名称 Name  -->
                <TextBlock
                    Margin="0,4,0,8"
                    FontSize="{DynamicResource FontSizeHint}"
                    FontWeight="Medium"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{x:Static resources:Strings.Alarm_LocalizedNames}" />
                <hc:TextBox
                    Margin="0,0,0,12"
                    hc:InfoElement.Title="{x:Static resources:Strings.Alarm_NameEn}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.Alarm_NameEn}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding NameEn, UpdateSourceTrigger=PropertyChanged}" />
                <hc:TextBox
                    Margin="0,0,0,12"
                    hc:InfoElement.Title="{x:Static resources:Strings.Alarm_NameJa}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.Alarm_NameJa}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding NameJa, UpdateSourceTrigger=PropertyChanged}" />
                <hc:TextBox
                    Margin="0,0,0,16"
                    hc:InfoElement.Title="{x:Static resources:Strings.Alarm_NamePt}"
                    hc:InfoElement.TitlePlacement="Top"
                    AutomationProperties.Name="{x:Static resources:Strings.Alarm_NamePt}"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding NamePt, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static resources:Strings.K055}"
                    Command="{Binding DataContext.RemoveAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Content="{x:Static resources:Strings.K055}"
                    Style="{StaticResource IconButtonDanger}"
                    Tag="{x:Static mi:MaterialIconKind.Delete}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
