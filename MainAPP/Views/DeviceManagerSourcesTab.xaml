<UserControl
    x:Class="MainAPP.Views.DeviceManagerSourcesTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:models="clr-namespace:Kanban.Collector.Core.Models;assembly=Kanban.Collector.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:resources="clr-namespace:MainAPP.Resources"
    mc:Ignorable="d"
    d:DesignHeight="720"
    d:DesignWidth="1100">
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="DataSourceValueTypeValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DataSourceValueType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <!--
        设备管理 Tab：数据采集源（多值重构版，设计稿《采集模块扩展设计方案》）。
        两级表格：源表格（标识+触发配置）→ 值表格（采集地址+判定参数）→ 枚举取值表（选中值项）。
        DataContext 由父级 DeviceManagerView 传入 DeviceManagerViewModel；
        外层 Grid 重设 DataContext={Binding SelectedDevice} 切换到当前设备。
        按钮通过 RelativeSource AncestorType=UserControl 找到子 UserControl（其 DataContext 仍是 VM）。
    -->
    <Grid Margin="24,16" DataContext="{Binding SelectedDevice}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="190" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="190" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Source table (container: identity + trigger config) ============ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock
                DockPanel.Dock="Left"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="{x:Static resources:Strings.Dsm_SourceSectionTitle}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                    AutomationProperties.Name="{x:Static resources:Strings.M360}"
                    Command="{Binding DataContext.ExportDataSourcesCsvCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.K653}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.FileExportOutline}"
                    ToolTip="{x:Static resources:Strings.M360}" />
                <Button
                    Margin="8,0,0,0"
                    AutomationProperties.Name="{x:Static resources:Strings.M361}"
                    Command="{Binding DataContext.ImportDataSourcesCsvCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.K654}"
                    Style="{StaticResource IconButtonPrimary}"
                    Tag="{x:Static mi:MaterialIconKind.FileImportOutline}"
                    ToolTip="{x:Static resources:Strings.M361}" />
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding DataContext.AddSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.Dsm_AddSource}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.Plus}" />
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding DataContext.SelectedSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.Dsm_RemoveSource}"
                    Style="{StaticResource IconButtonDanger}"
                    Tag="{x:Static mi:MaterialIconKind.Delete}" />
            </StackPanel>
        </DockPanel>
        <DataGrid
            x:Name="SourcesGrid"
            Grid.Row="1"
            Style="{StaticResource KanbanDataGrid}"
            CellStyle="{StaticResource KanbanDataGridCell}"
            ColumnHeaderStyle="{StaticResource KanbanDataGridColumnHeader}"
            RowStyle="{StaticResource KanbanDataGridRow}"
            IsReadOnly="{Binding DataContext.IsConfigurationReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ItemsSource="{Binding Sources}"
            SelectedItem="{Binding DataContext.SelectedSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <DataGrid.Columns>
                <!-- 名称列：展示含采集方式标识的多语言名称（定时模式 = 名称 + 「定时采集」），双击/进入编辑时编辑配置名 Name -->
                <DataGridTemplateColumn Width="*" Header="{x:Static resources:Strings.Dsm_Name}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource LocalizedNameToTextConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding NameEn, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Alarm_NameEn}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding NameJa, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Alarm_NameJa}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding NamePt, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Alarm_NamePt}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Dsm_Type}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding TriggerAddress, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Dsm_TriggerAddress}" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding TriggerValue, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Dsm_TriggerValue}" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding AckValue, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Dsm_AckValue}" />
                <DataGridCheckBoxColumn
                    Width="60"
                    Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Dsm_Enabled}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ============ Value table (collect address + judgement params) ============ -->
        <DockPanel Grid.Row="2" Margin="0,10,0,6">
            <TextBlock
                DockPanel.Dock="Left"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="{x:Static resources:Strings.Dsm_ValueSectionTitle}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                    Command="{Binding DataContext.AddValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.Dsm_AddValue}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.Plus}" />
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding DataContext.RemoveValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding DataContext.SelectedValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.Dsm_RemoveValue}"
                    Style="{StaticResource IconButtonDanger}"
                    Tag="{x:Static mi:MaterialIconKind.Delete}" />
            </StackPanel>
        </DockPanel>
        <DataGrid
            x:Name="ValuesGrid"
            Grid.Row="3"
            Style="{StaticResource KanbanDataGrid}"
            CellStyle="{StaticResource KanbanDataGridCell}"
            ColumnHeaderStyle="{StaticResource KanbanDataGridColumnHeader}"
            RowStyle="{StaticResource KanbanDataGridRow}"
            IsReadOnly="{Binding DataContext.IsConfigurationReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ItemsSource="{Binding DataContext.SelectedSource.Values, RelativeSource={RelativeSource AncestorType=UserControl}}"
            SelectedItem="{Binding DataContext.SelectedValue, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="1.2*"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Dsm_Name}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding NameEn, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Alarm_NameEn}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding NameJa, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Alarm_NameJa}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding NamePt, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Alarm_NamePt}" />
                <!--  类型下拉框必须显式套 ComboBoxExtend 系样式：不指定 Style 时会回落到 HandyControl 的
                      默认浅色 ComboBox（底 ~#EAEAEA），而 KanbanDataGridCell 的 Foreground 是
                      PrimaryTextBrush(#F1F5F9)，两者叠加成「浅底近白字」，对比度约 1.1:1 几乎不可读。
                      .Small 变体在保持深色配色的同时收紧内边距与下拉项高度，适配 36px 行高。  -->
                <DataGridComboBoxColumn
                    Width="90"
                    Header="{x:Static resources:Strings.Dsm_Type}"
                    SelectedItemBinding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding Source={StaticResource DataSourceValueTypeValues}}"
                    ElementStyle="{StaticResource ComboBoxExtend.Small}"
                    EditingElementStyle="{StaticResource ComboBoxExtend.Small}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding PlcAddress, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Dsm_Address}" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Dsm_Unit}" />
                <DataGridTemplateColumn Width="80" Header="{x:Static resources:Strings.Dsm_TrendLowerLimit}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="-" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Int32}">
                                                <Setter Property="Text" Value="{Binding LimitMin}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Float32}">
                                                <Setter Property="Text" Value="{Binding FloatLimitMin}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox>
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Int32}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="{Binding LimitMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Float32}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="{Binding FloatLimitMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80" Header="{x:Static resources:Strings.Dsm_TrendUpperLimit}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="-" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Int32}">
                                                <Setter Property="Text" Value="{Binding LimitMax}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Float32}">
                                                <Setter Property="Text" Value="{Binding FloatLimitMax}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox>
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Int32}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="{Binding LimitMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Float32}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="{Binding FloatLimitMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding Hysteresis, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Csv_DataSource_Hysteresis}" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding ConfirmSeconds, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Csv_DataSource_ConfirmSeconds}" />
                <DataGridTemplateColumn Width="90" Header="{x:Static resources:Strings.Dsm_ExpectedValue}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="-" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Int32}">
                                                <Setter Property="Text" Value="{Binding ExpectedValue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Float32}">
                                                <Setter Property="Text" Value="{Binding FloatExpectedValue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Bool}">
                                                <Setter Property="Text" Value="{Binding BoolExpectedValue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.String}">
                                                <Setter Property="Text" Value="{Binding StringExpectedValue}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBox>
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Int32}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Text" Value="{Binding ExpectedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Float32}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Text" Value="{Binding FloatExpectedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.String}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Text" Value="{Binding StringExpectedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <CheckBox HorizontalAlignment="Center" IsThreeState="True">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.Bool}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                    <CheckBox.IsChecked>
                                        <Binding Path="BoolExpectedValue" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
                                    </CheckBox.IsChecked>
                                </CheckBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80" Header="{x:Static resources:Strings.Csv_DataSource_StringLength}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="-" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.String}">
                                                <Setter Property="Text" Value="{Binding StringLength}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding StringLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataType}" Value="{x:Static models:DataSourceValueType.String}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn
                    Width="60"
                    Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Dsm_Enabled}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ============ Enum value table (selected value item) ============ -->
        <DockPanel Grid.Row="4" Margin="0,10,0,6">
            <TextBlock
                DockPanel.Dock="Left"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="{x:Static resources:Strings.Dsm_EnumTableTitle}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                    Command="{Binding DataContext.AddEnumValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.Dsm_AddEnumValue}"
                    Style="{StaticResource IconButtonDefault}"
                    Tag="{x:Static mi:MaterialIconKind.Plus}" />
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding DataContext.RemoveEnumValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding DataContext.SelectedEnumValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{x:Static resources:Strings.Dsm_RemoveEnumValue}"
                    Style="{StaticResource IconButtonDanger}"
                    Tag="{x:Static mi:MaterialIconKind.Delete}" />
            </StackPanel>
        </DockPanel>
        <DataGrid
            Grid.Row="5"
            Style="{StaticResource KanbanDataGrid}"
            CellStyle="{StaticResource KanbanDataGridCell}"
            ColumnHeaderStyle="{StaticResource KanbanDataGridColumnHeader}"
            RowStyle="{StaticResource KanbanDataGridRow}"
            IsReadOnly="{Binding DataContext.IsConfigurationReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ItemsSource="{Binding DataContext.SelectedValue.EnumValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
            SelectedItem="{Binding DataContext.SelectedEnumValue, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Dsm_EnumValue}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Dsm_DisplayName}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding DisplayNameEn, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Alarm_NameEn}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding DisplayNameJa, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Alarm_NameJa}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding DisplayNamePt, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resources:Strings.Alarm_NamePt}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ============ Description ============ -->
        <TextBlock
            Grid.Row="6"
            Margin="0,10,0,0"
            Foreground="{StaticResource SecondaryTextBrush}"
            Text="{x:Static resources:Strings.Dsm_CollectionDescription}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
