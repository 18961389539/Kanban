<UserControl
    x:Class="MainAPP.Views.RecipeManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    d:DataContext="{d:DesignInstance Type=vm:RecipeManagerViewModel}"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ══ 顶部：目标设备 + 下发（+ 进度状态与逐项结果明细） ══  -->
        <Border Grid.Row="0" Background="{StaticResource RegionBrush}" CornerRadius="8" Padding="12,8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Width="16" Height="16" VerticalAlignment="Center"
                                                    Foreground="{StaticResource SecondaryTextBrush}" Kind="Factory" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K683}" />
                        <ComboBox Margin="8,0,0,0" MinWidth="200" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding TargetDevices}" SelectedItem="{Binding SelectedTargetDevice}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeHint}"
                                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                                   Text="{Binding MachineType, TargetNullValue=''}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                   Text="{Binding ApplyStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApplyStatusKind}" Value="{x:Static vm:ApplyStatusKind.Error}">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Padding="14,6" Command="{Binding ApplyRecipeCommand}" Cursor="Hand"
                                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Width="15" Height="15" VerticalAlignment="Center"
                                                            Foreground="White" Kind="Send" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"
                                           Text="{x:Static resources:Strings.K661}" />
                            </StackPanel>
                        </Button>
                        <!-- 取消下发：仅 Local 模式下发进行中显示（Remote 为 SignalR 请求-响应无法中途取消） -->
                        <Button Margin="8,0,0,0" Padding="14,6" Cursor="Hand" Command="{Binding CancelApplyCommand}"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                Content="{x:Static resources:Strings.K696}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsApplying}" Value="True" />
                                                <Condition Binding="{Binding IsRemote}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <!-- 逐项下发结果明细（写/校验每项成败；空集合时不占空间） -->
                <ScrollViewer Grid.Row="1" MaxHeight="90" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ApplyItemResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding ParamName}" />
                                    <TextBlock Margin="6,0" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{StaticResource ThirdlyTextBrush}" Text="·" />
                                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{Binding Message}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  ══ 中部：配方列表 + 编辑表单（参照工单页：MainCard 双卡片 + GridSplitter） ══  -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="3*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- 分隔条（参照工单/设备管理器页样式）：10px 拖拽热区 + 居中 2px 竖条，
                 悬停高亮变主色加宽；浏览（列表加宽）与编辑（表格加宽）诉求冲突由用户权衡 -->
            <GridSplitter Grid.Column="1" Width="10" Margin="0,2"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          AutomationProperties.Name="{x:Static resources:Strings.K705}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="Grip" Width="2"
                                       HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                       Fill="{StaticResource BorderBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Fill" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Grip" Property="Width" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!--  ── 左：配方列表（MainCard 卡片） ──  -->
            <Border Grid.Column="0" Padding="0" Style="{StaticResource MainCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题 + 计数 -->
                    <DockPanel Grid.Row="0" Margin="18,18,18,12">
                        <materialIcons:MaterialIcon Kind="PackageVariant" Style="{StaticResource SectionTitleIcon}" />
                        <TextBlock Margin="8,0,0,0" Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K660}" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="{Binding AvailableRecipes.Count, StringFormat={}({0})}" />
                    </DockPanel>

                    <!-- 搜索框（占满，与工单页一致） -->
                    <hc:TextBox Grid.Row="1" Margin="18,0,18,12"
                                hc:InfoElement.Placeholder="{x:Static resources:Strings.K697}"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding RecipeSearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 机型筛选胶囊 -->
                    <ItemsControl Grid.Row="2" Margin="18,0,18,8" ItemsSource="{Binding MachineTypeFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,6" Padding="10,3" Cursor="Hand"
                                        Command="{Binding DataContext.SelectMachineFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Display}" />
                                        <TextBlock Margin="5,0,0,0" Opacity="0.75" Text="{Binding Count, StringFormat=({0})}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 卡片列表 + 空态覆盖层 -->
                    <Grid Grid.Row="3">
                        <ListBox ItemsSource="{Binding FilteredRecipes}"
                                 SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 BorderThickness="0" Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Background" Value="{StaticResource RegionBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SecondaryBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeHint}"
                                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                                   Text="{Binding UpdatedAt, Converter={StaticResource LocFormatConverter}, ConverterParameter=K701}" />
                                        <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Border Padding="6,1" CornerRadius="999" BorderThickness="1"
                                                BorderBrush="{StaticResource BorderBrush}">
                                            <TextBlock FontSize="{DynamicResource FontSizeHint}"
                                                       Foreground="{StaticResource SecondaryTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding MachineType}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MachineType}" Value="">
                                                                <Setter Property="Text" Value="{x:Static resources:Strings.K698}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeHint}"
                                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                                   Text="{Binding Items.Count, Converter={StaticResource LocFormatConverter}, ConverterParameter=K699}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空态：筛选/搜索无结果时显示 -->
                    <controls:EmptyState IconKind="PackageVariant" Message="{x:Static resources:Strings.K700}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>
                </Grid>

                <!-- 底部操作按钮（图标按钮，参照工单页） -->
                <DockPanel Grid.Row="4" Margin="18,12,18,18" LastChildFill="False">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding NewRecipeCommand}" Content="{x:Static resources:Strings.K662}" Style="{StaticResource IconButtonPrimary}"
                                Tag="{x:Static mi:MaterialIconKind.Plus}" ToolTip="{x:Static resources:Strings.K662}" />
                        <Button Margin="8,0,0,0" Command="{Binding CloneRecipeCommand}" Content="{x:Static resources:Strings.K689}" Style="{StaticResource IconButtonDefault}"
                                Tag="{x:Static mi:MaterialIconKind.ContentCopy}" ToolTip="{x:Static resources:Strings.K689}" />
                        <Button Margin="8,0,0,0" Command="{Binding DeleteRecipeCommand}" Content="{x:Static resources:Strings.K664}" Style="{StaticResource IconButtonDanger}"
                                Tag="{x:Static mi:MaterialIconKind.Delete}" ToolTip="{x:Static resources:Strings.K664}" />
                        <Button Margin="8,0,0,0" Command="{Binding ExportRecipesCommand}" Content="{x:Static resources:Strings.K690}" Style="{StaticResource IconButtonDefault}"
                                Tag="{x:Static mi:MaterialIconKind.FileExportOutline}" ToolTip="{x:Static resources:Strings.K690}" />
                        <Button Margin="8,0,0,0" Command="{Binding ImportRecipesCommand}" Content="{x:Static resources:Strings.K691}" Style="{StaticResource IconButtonDefault}"
                                Tag="{x:Static mi:MaterialIconKind.FileImportOutline}" ToolTip="{x:Static resources:Strings.K691}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
            </Border>

            <!--  ── 右：编辑表单（MainCard 卡片） ──  -->
            <Border Grid.Column="2" Padding="0" Style="{StaticResource MainCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <DockPanel Grid.Row="0" Margin="18,18,18,12">
                        <materialIcons:MaterialIcon Kind="PencilOutline" Style="{StaticResource SectionTitleIcon}" />
                        <TextBlock Margin="8,0,0,0" Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K706}" />
                    </DockPanel>

                <!-- 基本信息 -->
                <Grid Grid.Row="1" Margin="18,0,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K678}" />
                    <TextBox Grid.Column="1" Margin="0,0,16,0" VerticalContentAlignment="Center"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K679}" />
                    <TextBox Grid.Column="3" VerticalContentAlignment="Center"
                             Text="{Binding EditMachineType, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="2" Margin="18,0,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{StaticResource SecondaryTextBrush}" Text="{x:Static resources:Strings.K680}" />
                    <TextBox Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding EditRemark, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- 参数项表头 -->
                <Grid Grid.Row="3" Margin="18,4,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.6*" />
                        <ColumnDefinition Width="0.6*" />
                        <ColumnDefinition Width="0.6*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="{DynamicResource FontSizeHint}"
                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K665}" />
                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FontSizeHint}"
                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K666}" />
                    <TextBlock Grid.Column="2" FontSize="{DynamicResource FontSizeHint}"
                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K667}" />
                    <TextBlock Grid.Column="3" FontSize="{DynamicResource FontSizeHint}"
                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K668}" />
                    <TextBlock Grid.Column="4" FontSize="{DynamicResource FontSizeHint}"
                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K669}" />
                    <TextBlock Grid.Column="5" FontSize="{DynamicResource FontSizeHint}"
                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K670}" />
                    <TextBlock Grid.Column="6" FontSize="{DynamicResource FontSizeHint}"
                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K671}" />
                    <TextBlock Grid.Column="7" FontSize="{DynamicResource FontSizeHint}"
                               Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K704}" />
                </Grid>

                <!-- 参数项表格（ItemsControl 行式编辑 + 行内实时校验） -->
                <ScrollViewer Grid.Row="4" Margin="18,0,18,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding EditItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,4,0" VerticalContentAlignment="Center"
                                             Text="{Binding ParamName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1" Margin="0,0,4,0" VerticalContentAlignment="Center"
                                             Text="{Binding PlcAddress, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="2" Margin="0,0,4,0" VerticalContentAlignment="Center"
                                              ItemsSource="{Binding DataContext.PlcDataTypes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedItem="{Binding DataType, Mode=TwoWay}" />
                                    <!-- Value 列：Bool 类型显示下拉（True/False/0/1），其余类型文本框 -->
                                    <Grid Grid.Column="3" Margin="0,0,4,0">
                                        <TextBox VerticalContentAlignment="Center"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataType}" Value="Bool">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <ComboBox VerticalContentAlignment="Center" Visibility="Collapsed"
                                                  ItemsSource="{Binding DataContext.BoolOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding Value, Mode=TwoWay}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataType}" Value="Bool">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </Grid>
                                    <TextBox Grid.Column="4" Margin="0,0,4,0" VerticalContentAlignment="Center"
                                             Text="{Binding Min, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <TextBox Grid.Column="5" Margin="0,0,4,0" VerticalContentAlignment="Center"
                                             Text="{Binding Max, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <TextBox Grid.Column="6" Margin="0,0,4,0" VerticalContentAlignment="Center"
                                             Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                                    <!-- 行内校验错误（有错误时红色显示，含 ToolTip 全文） -->
                                    <TextBlock Grid.Column="7" Margin="0,0,4,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource DangerBrush}"
                                               FontSize="{DynamicResource FontSizeHint}"
                                               Text="{Binding ErrorText}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ErrorText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="8" Margin="4,0,0,0" Padding="6,3" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <materialIcons:MaterialIcon Width="14" Height="14"
                                                                    Kind="DeleteOutline" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 操作按钮（图标按钮，参照工单页） -->
                <DockPanel Grid.Row="5" Margin="18,12,18,18" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Margin="0,0,8,0" Command="{Binding AddItemCommand}" Content="{x:Static resources:Strings.K672}" Style="{StaticResource IconButtonDefault}"
                                Tag="{x:Static mi:MaterialIconKind.PlusBoxOutline}" ToolTip="{x:Static resources:Strings.K672}" />
                        <Button Command="{Binding SaveRecipeCommand}" Content="{x:Static resources:Strings.K663}" Style="{StaticResource IconButtonPrimary}"
