<UserControl
    x:Class="MainAPP.Views.DeviceManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:conv="clr-namespace:MainAPP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:views="clr-namespace:MainAPP.Views"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.Resources>
        <!--  ObjectDataProvider（AlarmLevelValues/DefectSeverityValues/DefectCategoryValues）
              已移至各 Tab 子 UserControl 的本地 Resources，避免重复定义。  -->

        <!--  设备运行时状态 → 色点画刷 / 文本（列表项实时状态指示）  -->
        <conv:DeviceRuntimeStatusConverter x:Key="DeviceRuntimeStatusConverter" />
        <conv:DeviceAddressConflictConverter x:Key="DeviceAddressConflictConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!--  列表与详情始终采用同一布局：列表固定 360（可被分隔条拖拽调整），详情占剩余。
                  无论是否选中设备都保持一致，未选中时详情区显示"请选择设备"空状态。
                  列表列设 MinWidth，保证 GridSplitter 拖拽时不会被压得过窄。  -->
            <ColumnDefinition x:Name="ListColumn" MinWidth="240" Width="360" />
            <!--  分隔条占位列（常驻）  -->
            <ColumnDefinition x:Name="SplitterColumn" Width="10" />
            <ColumnDefinition x:Name="DetailColumn" MinWidth="320" Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左侧：设备列表 ============  -->

        <Border
            Grid.Column="0"
            Padding="0"
            Style="{StaticResource MainCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <DockPanel Grid.Row="0" Margin="18,18,18,10">
                    <materialIcons:MaterialIcon Kind="ViewList" Style="{StaticResource SectionTitleIcon}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        Style="{StaticResource SectionTitleText}"
                        Text="{x:Static resources:Strings.K064}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSizeHint}"
                        Foreground="{StaticResource ThirdlyTextBrush}"
                        Text="{Binding DeviceList.DeviceSummaryText}" />
                    <TextBlock
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSizeHint}"
                        FontWeight="Bold"
                        Foreground="{StaticResource WarningBrush}"
                        Text="{x:Static resources:Strings.K222}"
                        Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <materialIcons:MaterialIcon
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Kind="Alert"
                        Foreground="{StaticResource WarningBrush}"
                        ToolTip="{Binding AddressConflictCount, Converter={StaticResource LocFormatConverter}, ConverterParameter=F290}"
                        Visibility="{Binding HasAddressConflicts, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </DockPanel>

                <!--  搜索  -->
                <hc:SearchBar
                    x:Name="DeviceSearchBar"
                    Grid.Row="1"
                    Margin="18,0,18,10"
                    AutomationProperties.Name="{x:Static resources:Strings.K223}"
                    Style="{StaticResource SearchBarExtend}"
                    Text="{Binding DeviceList.SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <!--  状态筛选  -->
                <hc:ComboBox
                    Grid.Row="2"
                    Margin="18,0,18,10"
                    Width="150"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Static resources:Strings.K224}"
                    hc:InfoElement.Placeholder="{x:Static resources:Strings.K225}"
                    hc:InfoElement.Title="{x:Static resources:Strings.K003}"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding DeviceList.StatusFilterOptions}"
                    SelectedValue="{Binding DeviceList.StatusFilter}"
                    SelectedValuePath="Value"
                    Style="{StaticResource ComboBoxExtend}" />

                <!--  设备列表  -->
                <ListBox
                    Grid.Row="3"
                    Margin="18,0,18,8"
                    AllowDrop="True"
                    AutomationProperties.Name="{x:Static resources:Strings.K064}"
                    DragOver="OnListDragOver"
                    Drop="OnListDrop"
                    ItemContainerStyle="{StaticResource CardListItemStyle}"
                    ItemsSource="{Binding DeviceList.FilteredDevices}"
                    PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                    PreviewMouseMove="OnListPreviewMouseMove"
                    SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse
                                        Width="10"
                                        Height="10"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <MultiBinding Converter="{StaticResource DeviceRuntimeStatusConverter}">
                                                <Binding Path="." />
                                                <Binding Path="DataContext.DeviceRuntimeMap" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </Ellipse.Fill>
                                        <Ellipse.ToolTip>
                                            <MultiBinding Converter="{StaticResource DeviceRuntimeStatusConverter}" ConverterParameter="Text">
                                                <Binding Path="." />
                                                <Binding Path="DataContext.DeviceRuntimeMap" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </Ellipse.ToolTip>
                                    </Ellipse>
                                    <TextBlock
                                        Padding="0,6"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource FontSizeHint}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource FontSizeHint}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Foreground>
                                            <MultiBinding Converter="{StaticResource DeviceRuntimeStatusConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.DeviceRuntimeMap" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </TextBlock.Foreground>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource DeviceRuntimeStatusConverter}" ConverterParameter="Text">
                                                <Binding />
                                                <Binding Path="DataContext.DeviceRuntimeMap" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource FontSizeHint}"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource WarningBrush}"
                                        Text="*"
                                        Visibility="{Binding DataContext.IsDirty, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button
                                        Margin="6,0,0,0"
                                        Padding="0"
                                        AutomationProperties.Name="{x:Static resources:Strings.K226}"
                                        Command="{Binding DataContext.SelectAddressConflictCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource WarningBrush}"
                                        ToolTipService.ShowOnDisabled="True">
                                        <Button.ToolTip>
                                            <MultiBinding Converter="{StaticResource DeviceAddressConflictConverter}" ConverterParameter="Text">
                                                <Binding />
                                                <Binding Path="DataContext.AddressConflictSummaries" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </Button.ToolTip>
                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource DeviceAddressConflictConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.AddressConflictSummaries" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </Button.Visibility>
                                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                                <!--  摘要行：理论产能，快速定位设备  -->
                                <TextBlock
                                    Margin="18,2,0,4"
                                    FontSize="{DynamicResource FontSizeMicro}"
                                    Foreground="{StaticResource ThirdlyTextBrush}"
                                    Text="{Binding TargetCycle, Converter={StaticResource LocFormatConverter}, ConverterParameter=F246}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态：区分尚未配置设备与筛选无结果。 -->
                <Grid Grid.Row="3" Margin="18,0,18,8">
                    <Border Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeviceList.HasDevices}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:EmptyState IconKind="DevicesOutline" Message="暂无设备" Hint="请点击“新增设备”开始配置" />
                    </Border>
                    <Border Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DeviceList.HasDevices}" Value="True" />
                                            <Condition Binding="{Binding DeviceList.IsFiltering}" Value="True" />
                                            <Condition Binding="{Binding DeviceList.HasFilteredDevices}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:EmptyState IconKind="FilterRemoveOutline" Message="{x:Static resources:Strings.K227}" Hint="{x:Static resources:Strings.K228}" />
                    </Border>
                </Grid>

                <!--  操作按钮：主操作单行 + 更多下拉菜单承载低频操作  -->
                <StackPanel
                    Grid.Row="4"
                    Margin="18,0,18,18"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{x:Static resources:Strings.K229}"
                        Command="{Binding AddDeviceCommand}"
                        Content="{x:Static resources:Strings.K033}"
                        Style="{StaticResource IconButtonPrimary}"
                        Tag="{x:Static mi:MaterialIconKind.Plus}" />
                    <Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{x:Static resources:Strings.K230}"
                        Command="{Binding RemoveDeviceCommand}"
                        CommandParameter="{Binding SelectedDevice}"
                        Content="{x:Static resources:Strings.K034}"
                        Style="{StaticResource IconButtonDanger}"
                        Tag="{x:Static mi:MaterialIconKind.Delete}" />
                    <Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{x:Static resources:Strings.K231}"
                        Command="{Binding SaveCommand}"
                        Content="{x:Static resources:Strings.K232}"
                        Style="{StaticResource IconButtonSuccess}"
                        Tag="{x:Static mi:MaterialIconKind.ContentSave}"
                        ToolTip="{x:Static resources:Strings.K233}" />
                    <!--  更多：复制 / 导入 / 导出 / 恢复 / 虚拟（低频操作收进下拉菜单）  -->
                    <Button
                        x:Name="MoreActionsButton"
                        AutomationProperties.Name="{x:Static resources:Strings.K234}"
                        Click="OnMoreActionsClick"
                        Content="{x:Static resources:Strings.K235}"
                        Style="{StaticResource IconButtonDefault}"
                        Tag="{x:Static mi:MaterialIconKind.DotsHorizontal}"
                        ToolTip="{x:Static resources:Strings.K236}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    AutomationProperties.Name="{x:Static resources:Strings.K237}"
                                    Command="{Binding CopyDeviceCommand}"
                                    CommandParameter="{Binding SelectedDevice}"
                                    Header="{x:Static resources:Strings.K238}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentCopy" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    AutomationProperties.Name="{x:Static resources:Strings.K239}"
                                    Command="{Binding ImportConfigCommand}"
                                    Header="{x:Static resources:Strings.K240}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Import" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    AutomationProperties.Name="{x:Static resources:Strings.K241}"
                                    Command="{Binding ExportConfigCommand}"
                                    Header="{x:Static resources:Strings.K242}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Export" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    AutomationProperties.Name="{x:Static resources:Strings.K243}"
                                    Command="{Binding RollbackToBackupCommand}"
                                    Header="{x:Static resources:Strings.K244}"
                                    ToolTip="{x:Static resources:Strings.K245}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="History" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    AutomationProperties.Name="{x:Static resources:Strings.K065}"
                                    Command="{Binding SeedSampleDevicesCommand}"
                                    Header="{x:Static resources:Strings.K065}"
                                    ToolTip="{x:Static resources:Strings.K246}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ToyBrickPlus" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ============ 中间：可拖拽分隔条（仅选中设备时显示）  ============  -->
        <GridSplitter
            x:Name="ListDetailSplitter"
            Grid.Column="1"
            Width="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeWE"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            AutomationProperties.Name="{x:Static resources:Strings.K247}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Rectangle
                            x:Name="Grip"
                            Width="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Fill="{StaticResource BorderBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Fill" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Grip" Property="Width" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!--  ============ 右侧：设备详情/编辑 ============  -->
        <Border
            Grid.Column="2"
            Padding="0"
            Style="{StaticResource MainCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  详情标题：设备名 + 实时状态徽章（切设备时同步刷新，避免改错设备）  -->
                <DockPanel Grid.Row="0" Margin="24,18,24,12">
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.K066}" />
                    <!--  当前编辑设备名（突出显示，区别于"设备详情"固定标题）  -->
                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            FontSize="17"
                            Text="{Binding SelectedDevice.Name}" />
                        <!--  实时状态徽章：色点 + 文本，与列表项状态指示一致  -->
                        <Ellipse
                            Width="8"
                            Height="8"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <MultiBinding Converter="{StaticResource DeviceRuntimeStatusConverter}">
                                    <Binding Path="SelectedDevice" />
                                    <Binding Path="DeviceRuntimeMap" />
                                </MultiBinding>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionText}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource DeviceRuntimeStatusConverter}" ConverterParameter="Text">
                                    <Binding Path="SelectedDevice" />
                                    <Binding Path="DeviceRuntimeMap" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <Border
                    Grid.Row="0"
                    VerticalAlignment="Bottom"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" />

                <Grid Grid.Row="1">
                    <!--  空状态  -->
                    <controls:EmptyState
                        Hint="{x:Static resources:Strings.K248}"
                        IconKind="Harddisk"
                        Message="{x:Static resources:Strings.K249}">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>

                    <!--  编辑表单  -->
                    <Border Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVisibilityConverter}}">
                        <TabControl
                            Style="{StaticResource KanbanTabControl}"
                            Padding="0"
                            AutomationProperties.Name="{x:Static resources:Strings.K250}"
                            BorderThickness="0"
                            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                            SelectionChanged="OnTabSelectionChanged">

                            <!--  ============ Tab 1：设备参数 ============  -->
                            <TabItem Style="{StaticResource KanbanTabItem}" AutomationProperties.Name="{x:Static resources:Strings.K067}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            Kind="Cog" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Static resources:Strings.K067}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <views:DeviceManagerDeviceParamsTab />
                            </TabItem>

                            <!--  ============ Tab 2：报警管理 ============  -->
                            <TabItem Style="{StaticResource KanbanTabItem}" AutomationProperties.Name="{x:Static resources:Strings.K068}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            Kind="Bell" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Static resources:Strings.K068}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <views:DeviceManagerAlarmsTab DataContext="{Binding AlarmManagerVm}" />
                            </TabItem>

                            <!--  ============ Tab 3：缺陷管理 ============  -->
                            <TabItem Style="{StaticResource KanbanTabItem}" AutomationProperties.Name="{x:Static resources:Strings.K069}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            Kind="Bug" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Static resources:Strings.K069}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <views:DeviceManagerDefectsTab DataContext="{Binding DefectManagerVm}" />
                            </TabItem>

                            <!--  ============ Tab 4：计数报警 ============  -->
                            <TabItem Style="{StaticResource KanbanTabItem}" AutomationProperties.Name="{x:Static resources:Strings.K070}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            Kind="Counter" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Static resources:Strings.K070}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <views:DeviceManagerCounterAlarmsTab DataContext="{Binding CounterAlarmManagerVm}" />
                            </TabItem>

                            <!--  ============ Tab 5：数据采集源 ============  -->
                            <TabItem Style="{StaticResource KanbanTabItem}" AutomationProperties.Name="数据采集源">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            Kind="Gauge" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="数据采集源" />
                                    </StackPanel>
                                </TabItem.Header>
                                <views:DeviceManagerSourcesTab DataContext="{Binding DataSourceManagerVm}" />
                            </TabItem>

                            <!--  ============ Tab 6：工单 ============  -->
                            <TabItem Style="{StaticResource KanbanTabItem}" AutomationProperties.Name="{x:Static resources:Strings.K071}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            Kind="ClipboardListOutline" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Static resources:Strings.K071}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <views:DeviceManagerWorkOrdersTab DataContext="{Binding WorkOrders}" />
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!--  加载中覆盖层：PLC 写入（配方 / 清空计数报警当前值）期间显示  -->
        <Border
            Grid.ColumnSpan="3"
            AutomationProperties.Name="{x:Static resources:Strings.K251}"
            Style="{StaticResource LoadingOverlay}"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <hc:LoadingCircle
                Width="60"
                Height="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource LoadingDefault}" />
        </Border>
    </Grid>
</UserControl>
