<UserControl
    x:Class="MainAPP.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    xmlns:views="clr-namespace:MainAPP.Views"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
    d:DesignHeight="1080"
    d:DesignWidth="1712"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.Resources>
        <!--  共享样式（DashboardCard/CardTitleIcon/CardTitleText）已移至 Styles/HomeResources.xaml
              并在 App.xaml 全局注册：子 UserControl 在 XAML 加载阶段无法跨 UserControl 边界查找父级资源。
              OkDiffBadge/NgDiffBadge 仅合格率卡片使用，已移至 HomeQualityRateCard.xaml 本地 Resources。  -->
    </UserControl.Resources>

    <!--  ScrollViewer 兜底：内容超出可视区时可纵向滚动；MinHeight 绑定视口高度，
          使 * 行在空间充足时仍均分填满，与改前大屏布局一致。  -->
    <ScrollViewer x:Name="HomeScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16"
              MinHeight="{Binding ActualHeight, ElementName=HomeScrollViewer}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ 顶部栏：标题 + 数据状态 + PLC连接 + 设备切换器 + 班次进度 ============  -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- MinWidth=0 允许 * 列在窄窗下收缩，WrapPanel 在列内换行而非与标题叠层 -->
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0"
                        HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Style="{StaticResource PageTitleIcon}" Kind="ChartLineVariant" />
                <TextBlock Style="{StaticResource PageTitleText}" Margin="10,0,0,0" Text="{x:Static resources:Strings.K335}" />
            </StackPanel>

            <!--  右侧状态栏：占满标题右侧剩余宽度，窄窗时在列内换行  -->
            <WrapPanel Grid.Column="1"
                       HorizontalAlignment="Right" VerticalAlignment="Center">
                <!--  PLC 连接状态：仅色点，hover 显示文字  -->
                <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                            <Setter Property="ToolTip" Value="{x:Static resources:Strings.K336}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionManager.IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    <Setter Property="ToolTip" Value="{x:Static resources:Strings.K337}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!--  页面级数据状态（原 6 卡各重复一处，收敛到顶栏；Live 时隐藏，连接色点已表达正常）  -->
                <TextBlock Style="{StaticResource HomeDataStatusBadge}"
                           Margin="0,0,10,0"
                           Text="{Binding DataStatusText}"
                           ToolTip="{Binding DataStatusTooltip}" />

                <!--  设备切换  -->
                <ComboBox
                    Width="200"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.K024}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding DeviceFilterItems}"
                    SelectedValue="{Binding SelectedDeviceId}"
                    SelectedValuePath="Id"
                    Style="{StaticResource ComboBoxExtend}" />

                <!--  工单管理入口  -->
                <Button Margin="10,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static resources:Strings.K089}"
                        Command="{Binding ViewWorkOrderManagerCommand}"
                        Content="{x:Static resources:Strings.K089}"
                        Style="{StaticResource IconButtonPrimary}"
                        Tag="{x:Static mi:MaterialIconKind.ClipboardListOutline}"
                        ToolTip="{x:Static resources:Strings.K338}" />

                <!--  查看设备详情  -->
                <Button Margin="6,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static resources:Strings.K339}"
                        Command="{Binding ViewDeviceDetailCommand}"
                        Content="{x:Static resources:Strings.K066}"
                        Style="{StaticResource IconButtonDefault}"
                        Tag="{x:Static mi:MaterialIconKind.ChartBoxOutline}"
                        ToolTip="{x:Static resources:Strings.K340}" />
            </WrapPanel>
        </Grid>

        <!--  ============ 第 1 行：设备状态 | 当前生产状态 | 实时故障 ============  -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  列 1：设备状态  -->
            <views:HomeDeviceStatusCard Grid.Column="0" />
            <!--  列 2：当前生产状态（速度进度条 + 2x2 KPI 网格）  -->
            <views:HomeProductionOverviewCard Grid.Column="2" />
            <!--  列 3：实时故障（卡片式列表，按级别+时间排序，新报警闪烁）  -->
            <views:HomeRealtimeAlarmsCard Grid.Column="4" />
        </Grid>

        <!--  ============ 第 2 行：OEE 预览 | 合格率概览 | 缺陷图表 ============  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  列 1：OEE 综合效率（大环 + 三行指标条，公式收至 ToolTip）  -->
            <views:HomeOeeCard Grid.Column="0" />
            <!--  列 2：合格率概览（OK / NG + 合格率饼图）  -->
            <views:HomeQualityRateCard Grid.Column="2" />
            <!--  列 3：设备缺陷图表  -->
            <views:HomeDefectParetoCard Grid.Column="4" />
        </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
