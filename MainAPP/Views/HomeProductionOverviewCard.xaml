<UserControl
    x:Class="MainAPP.Views.HomeProductionOverviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="400" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        主页仪表板卡片 2：当前生产进度状态（速度进度条 + 工单 2×1 KPI；节拍已迁至设备状态卡）。
        DataContext 由父级 HomeView 传入 HomeViewModel。
        共享样式（DashboardCard/CardTitleIcon/CardTitleText）从全局资源字典 HomeResources.xaml 查找。
    -->
    <Border Style="{StaticResource DashboardCard}"
            ToolTipService.InitialShowDelay="300"
            ToolTipService.ShowDuration="30000">
        <!--  内边距 20→16：紧凑化以容纳 2×3 看板在 1080 设计高度内的完整展示（修复 2026-08-30，见 HomeView.xaml 说明）  -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal">
                <materialIcons:MaterialIcon Style="{StaticResource CardTitleIcon}" Kind="TrendingUp" />
                <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static resources:Strings.K323}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 当前工单：完成进度高亮区（工单号 + 大字号完成率 + 进度条） -->
                <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,10"
                        Style="{StaticResource KpiCardSecondary}"
                        ToolTip="{Binding WorkOrderProgressTooltip}"
                        Visibility="{Binding HasCurrentWorkOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Width="16" Height="16" VerticalAlignment="Center"
                                                        Foreground="{StaticResource PrimaryBrush}" Kind="ClipboardTextOutline" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding CurrentWorkOrder.OrderNo}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentWorkOrder.OrderNo}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{StaticResource ChartBaseSeriesBrush}"
                                       Text="{Binding CurrentWorkOrder.ProductCode}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                           Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{x:Static resources:Strings.Wo_Progress}" />
                                <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding WorkOrderProgressText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeHero}" FontWeight="Bold"
                                       Foreground="{Binding WorkOrderProgressRatio, Converter={StaticResource RatioThreshold}}"
                                       Text="{Binding WorkOrderProgressPct}" />
                        </Grid>
                        <ProgressBar Margin="0,8,0,0" Height="10" Minimum="0" Maximum="1"
                                       Value="{Binding WorkOrderProgressRatio, Mode=OneWay}"
                                       Background="{StaticResource SecondaryRegionBrush}"
                                       Foreground="{Binding WorkOrderProgressRatio, Converter={StaticResource RatioThreshold}}" />
                    </StackPanel>
                </Border>

                <!-- 顶部：当前速度 + 进度条（主焦点） -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16" ToolTip="{Binding SpeedAchievementTooltip}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="{x:Static resources:Strings.K324}" />
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="{Binding SpeedAchievementRate, Converter={StaticResource LocFormatConverter}, ConverterParameter=F251}" />
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal"
                                    ToolTip="{Binding RealtimeSpeedTooltip}">
                            <TextBlock FontSize="{DynamicResource FontSizeHero}" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding RealtimeSpeedDisplay}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Bottom"
                                       FontSize="{DynamicResource FontSizeKpiSm}" Foreground="{StaticResource ThirdlyTextBrush}"
                                       Text="{x:Static resources:Strings.K325}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- 进度条：Foreground 绑定达成率阈值色，Background 为深灰轨道 -->
                    <Grid Height="26" Margin="0,10,0,0">
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{Binding SpeedAchievementRate, Mode=OneWay}"
                                     Background="{StaticResource SecondaryRegionBrush}"
                                     Foreground="{Binding SpeedAchievementRate, Converter={StaticResource RatioThreshold}}" />
                        <!--  50% 参考线：中性色刻度线（达成率"高=好"，参考线不应使用警告/危险色）  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" HorizontalAlignment="Right" Width="1"
                                    Background="{StaticResource SecondaryBorderBrush}" />
                            <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,2,-14" FontSize="{DynamicResource FontSizeMicro}"
                                       Foreground="{StaticResource ThirdlyTextBrush}" Text="50%" />
                        </Grid>
                        <!--  80% 参考线  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80*" />
                                <ColumnDefinition Width="20*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" HorizontalAlignment="Right" Width="1"
                                    Background="{StaticResource SecondaryBorderBrush}" />
                            <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,2,-14" FontSize="{DynamicResource FontSizeMicro}"
                                       Foreground="{StaticResource ThirdlyTextBrush}" Text="80%" />
                        </Grid>
                    </Grid>
                </StackPanel>

                <!-- 工单 2×2 KPI：目标 / OK / 不良 / 良率 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Padding="12,8" Style="{StaticResource KpiCardSecondary}"
                            ToolTip="{Binding WorkOrderTargetTooltip}">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K326}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding WorkOrderTargetQuantity, StringFormat={}{0:N0}}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Bottom"
                                           FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{x:Static resources:Strings.K014}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Padding="12,8" Style="{StaticResource KpiCardSecondary}"
                            ToolTip="{Binding WorkOrderOkTooltip}">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K327}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding WorkOrderOkProductionDisplay}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Bottom"
                                           FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{x:Static resources:Strings.K014}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Padding="12,8" Style="{StaticResource KpiCardSecondary}"
                            ToolTip="{Binding WorkOrderNgTooltip}">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.Home_WorkOrderNg}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}"
                                           Text="{Binding WorkOrderNgProductionDisplay}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Bottom"
                                           FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{x:Static resources:Strings.K014}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Padding="12,8" Style="{StaticResource KpiCardSecondary}"
                            ToolTip="{Binding WorkOrderQualityTooltip}">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.Home_WorkOrderQuality}" />
                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                       Text="{Binding WorkOrderQualityDisplay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding WorkOrderQualityRate, Converter={StaticResource QualityThreshold}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WorkOrderQualityDisplay}" Value="—">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
