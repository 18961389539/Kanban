<UserControl
    x:Class="MainAPP.Views.HomeProductionOverviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="400" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        主页仪表板卡片 2：当前生产状态（速度进度条 + 2x2 KPI 网格）。
        DataContext 由父级 HomeView 传入 HomeViewModel。
        共享样式（DashboardCard/CardTitleIcon/CardTitleText）从全局资源字典 HomeResources.xaml 查找。
    -->
    <Border Style="{StaticResource DashboardCard}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal">
                <materialIcons:MaterialIcon Style="{StaticResource CardTitleIcon}" Kind="TrendingUp" />
                <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static resources:Strings.K323}" />
                <TextBlock Style="{StaticResource HomeDataStatusBadge}" Text="{Binding DataStatusText}" ToolTip="{Binding DataStatusTooltip}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部：当前速度 + 进度条（主焦点） -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="{x:Static resources:Strings.K324}" />
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeCaption}" Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="{Binding SpeedAchievementRate, StringFormat=达成率 {0:P0}}" />
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock FontSize="{DynamicResource FontSizeHero}" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding RealtimeSpeedDisplay}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Bottom"
                                       FontSize="{DynamicResource FontSizeKpiSm}" Foreground="{StaticResource ThirdlyTextBrush}"
                                       Text="{x:Static resources:Strings.K325}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- 进度条：Foreground 绑定达成率阈值色，Background 为深灰轨道 -->
                    <Grid Height="26" Margin="0,10,0,0">
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{Binding SpeedAchievementRate, Mode=OneWay}"
                                     Background="{StaticResource SecondaryRegionBrush}"
                                     Foreground="{Binding SpeedAchievementRate, Converter={StaticResource RatioThreshold}}" />
                        <!--  50% 参考线：中性色刻度线（达成率"高=好"，参考线不应使用警告/危险色）  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" HorizontalAlignment="Right" Width="1"
                                    Background="{StaticResource SecondaryBorderBrush}" />
                            <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,2,-14" FontSize="{DynamicResource FontSizeMicro}"
                                       Foreground="{StaticResource ThirdlyTextBrush}" Text="50%" />
                        </Grid>
                        <!--  80% 参考线  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80*" />
                                <ColumnDefinition Width="20*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" HorizontalAlignment="Right" Width="1"
                                    Background="{StaticResource SecondaryBorderBrush}" />
                            <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,2,-14" FontSize="{DynamicResource FontSizeMicro}"
                                       Foreground="{StaticResource ThirdlyTextBrush}" Text="80%" />
                        </Grid>
                    </Grid>
                </StackPanel>

                <!-- 2x2 KPI 网格 -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左上：工单设置数量 -->
                    <Border Grid.Row="0" Grid.Column="0" Padding="16,12"
                            Background="{StaticResource SecondaryRegionBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K326}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiLg}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding WorkOrderTargetQuantity, StringFormat={}{0:N0}}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Bottom"
                                           FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{x:Static resources:Strings.K014}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 右上：工单已生产数量 -->
                    <Border Grid.Row="0" Grid.Column="2" Padding="16,12"
                            Background="{StaticResource SecondaryRegionBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K327}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiLg}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding TotalOkProductionDisplay}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Bottom"
                                           FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{x:Static resources:Strings.K014}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 左下：目标节拍 -->
                    <Border Grid.Row="1" Grid.Column="0" Padding="16,12"
                            Background="{StaticResource SecondaryRegionBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K017}" />
                            <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeKpiLg}" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}"
                                       Text="{Binding TargetCycleDisplay}" />
                        </StackPanel>
                    </Border>

                    <!-- 右下：实际节拍 -->
                    <Border Grid.Row="1" Grid.Column="2" Padding="16,12"
                            Background="{StaticResource SecondaryRegionBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K050}" />
                            <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeKpiLg}" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding ActualCycleDisplay}" />
                            <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeKpiLabel}" FontWeight="Bold"
                                       Text="{Binding CycleDiffText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCycleSlow}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CycleDiffText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
