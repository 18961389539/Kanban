<UserControl
    x:Class="MainAPP.Views.HomeProductionOverviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="400" xmlns:resources="clr-namespace:MainAPP.Resources">
    <!--
        主页仪表板卡片 2：当前生产进度状态（工单标识 + 2×2 KPI）。
        DataContext 由父级 HomeView 传入 HomeViewModel。
        共享样式（DashboardCard/CardTitleIcon/CardTitleText）从全局资源字典 HomeResources.xaml 查找。
    -->
    <Border Style="{StaticResource DashboardCard}"
            ToolTipService.InitialShowDelay="300"
            ToolTipService.ShowDuration="30000">
        <!--  内边距 20→16：紧凑化以容纳 2×3 看板在 1080 设计高度内的完整展示（修复 2026-08-30，见 HomeView.xaml 说明）  -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal">
                <materialIcons:MaterialIcon Style="{StaticResource CardTitleIcon}" Kind="TrendingUp" />
                <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static resources:Strings.K323}" />
            </StackPanel>

            <Grid Grid.Row="1" Visibility="{Binding HasCurrentWorkOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,10"
                        Style="{StaticResource KpiCardSecondary}">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Width="16" Height="16" VerticalAlignment="Center"
                                                    Foreground="{StaticResource PrimaryBrush}" Kind="ClipboardTextOutline" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="{Binding CurrentWorkOrder.OrderNo}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentWorkOrder.OrderNo}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{StaticResource ChartBaseSeriesBrush}"
                                   Text="{Binding CurrentWorkOrder.ProductCode}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 工单四槽位（固定，不做成可配置）：工单目标 / 当班良品 / 工单累计良品 / 工单达成率 -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Padding="12,8" Style="{StaticResource KpiCardSecondary}"
                            ToolTip="{Binding WorkOrderTargetTooltip}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" VerticalAlignment="Center"
                                           Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.K326}" />
                                <controls:KpiScopeChip Kind="WorkOrder" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding WorkOrderTargetQuantity, StringFormat={}{0:N0}}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Bottom"
                                           FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{x:Static resources:Strings.K014}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Padding="12,8" Style="{StaticResource KpiCardSecondary}"
                            ToolTip="{Binding ShiftOkTooltip}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" VerticalAlignment="Center"
                                           Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.Home_ShiftOk}" />
                                <controls:KpiScopeChip Kind="Shift" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding ShiftOkProductionDisplay}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Bottom"
                                           FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{x:Static resources:Strings.K014}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Padding="12,8" Style="{StaticResource KpiCardSecondary}"
                            ToolTip="{Binding WorkOrderCumulativeOkTooltip}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" VerticalAlignment="Center"
                                           Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.Home_WorkOrderCumulativeOk}" />
                                <controls:KpiScopeChip Kind="WorkOrder" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding WorkOrderOkProductionDisplay}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Bottom"
                                           FontSize="{DynamicResource FontSizeKpiLabel}" Foreground="{StaticResource ThirdlyTextBrush}"
                                           Text="{x:Static resources:Strings.K014}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Padding="12,8" Style="{StaticResource KpiCardSecondary}"
                            ToolTip="{Binding WorkOrderAchievementTooltip}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="{DynamicResource FontSizeKpiLabel}" VerticalAlignment="Center"
                                           Foreground="{StaticResource ThirdlyTextBrush}" Text="{x:Static resources:Strings.Home_WorkOrderAchievement}" />
                                <controls:KpiScopeChip Kind="WorkOrder" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSizeKpiMd}" FontWeight="Bold"
                                       Text="{Binding WorkOrderAchievementDisplay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding WorkOrderProgressRatio, Converter={StaticResource RatioThreshold}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WorkOrderAchievementDisplay}" Value="—">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 新增：进度排期区（实际进度 vs 计划刻度 + 剩余时间，2026-09-17） -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0"
                            ToolTip="{Binding WorkOrderScheduleTooltip}"
                            Visibility="{Binding HasWorkOrderSchedule, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                                   Text="{Binding WorkOrderScheduleDeltaText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWorkOrderBehindSchedule}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsWorkOrderAheadSchedule}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{StaticResource ThirdlyTextBrush}"
                                   Text="{Binding WorkOrderProgressText}" />
                    </DockPanel>

                    <Grid Height="10" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding WorkOrderPlannedProgressRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 轨道底座 -->
                        <Border Grid.ColumnSpan="3" Background="{StaticResource SecondaryRegionBrush}" CornerRadius="5" />
                        <!-- 计划进度刻度线 -->
                        <Border Grid.Column="1" Background="{StaticResource PrimaryBrush}" Margin="0,-2" CornerRadius="1" />
                        <!-- 实际进度填充（覆盖层，按实际达成率分列） -->
                        <Grid Grid.ColumnSpan="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding WorkOrderProgressRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding WorkOrderProgressRatio, Converter={StaticResource RatioThreshold}}" CornerRadius="5" />
                        </Grid>
                    </Grid>

                    <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{StaticResource ThirdlyTextBrush}"
                               Text="{Binding WorkOrderScheduleText}" />
                </StackPanel>
            </Grid>

            <!-- 无工单空状态：不显示误导性的 0 / — -->
            <controls:EmptyState Grid.Row="1" IconKind="ClipboardTextOutline"
                                 Message="{x:Static resources:Strings.Home_WorkOrderEmpty}"
                                 Hint="{x:Static resources:Strings.Home_WorkOrderEmptyHint}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding HasCurrentWorkOrder, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
