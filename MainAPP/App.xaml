<Application
    x:Class="MainAPP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <DrawingImage x:Key="AppIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#18222F" Geometry="M0,0 L64,0 L64,64 L0,64 Z" />
                        <GeometryDrawing Brush="#38BDF8" Geometry="M10,11 L54,11 L54,53 L10,53 Z" />
                        <GeometryDrawing Brush="#18222F" Geometry="M16,17 L48,17 L48,47 L16,47 Z" />
                        <GeometryDrawing Brush="#34D399" Geometry="M20,39 L20,31 L26,31 L26,39 Z M29,39 L29,25 L35,25 L35,39 Z M38,39 L38,20 L44,20 L44,39 Z" />
                        <GeometryDrawing Brush="#FBBF24" Geometry="M20,43 L44,43 L44,46 L20,46 Z" />
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!--  ============ 合并 HandyControl 资源字典 + 自定义资源字典 ============  -->
            <!--  顺序重要：HC 主题 → 画刷 → 效果 → 转换器 → Tracker → 文本 → 卡片 → 组件
                  被依赖的资源必须先声明（如 Style BasedOn / StaticResource 跨文件引用）。  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <!--  自定义资源字典  -->
                <ResourceDictionary Source="Styles/Brushes.xaml" />
                <ResourceDictionary Source="Styles/Effects.xaml" />
                <ResourceDictionary Source="Styles/Converters.xaml" />
                <ResourceDictionary Source="Styles/TrackerControl.xaml" />
                <ResourceDictionary Source="Styles/FontSizes.xaml" />
                <ResourceDictionary Source="Styles/Texts.xaml" />
                <ResourceDictionary Source="Styles/Cards.xaml" />
                <ResourceDictionary Source="Styles/Components.xaml" />
                <!--  全局暗色细滚动条（放在 Components 之后，确保覆盖默认滚动条样式）  -->
                <ResourceDictionary Source="Styles/ScrollBar.xaml" />
                <!--  产线页布局共享资源：子 UserControl 需通过全局资源访问，无法跨 UserControl 边界查找父级资源  -->
                <ResourceDictionary Source="Styles/ProductionLineResources.xaml" />
                <!--  主页仪表板共享资源：子 UserControl（HomeDeviceStatusCard 等 6 个卡片）需通过全局资源访问  -->
                <ResourceDictionary Source="Styles/HomeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
