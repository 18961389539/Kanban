<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MainAPP</RootNamespace>
    <AssemblyName>MainAPP</AssemblyName>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <!-- 编译前从统一 Localization.csv 生成 WPF 资源和 Strings.cs。 -->
  <Target Name="GenerateStrings" BeforeTargets="AssignCulture">
    <Message Importance="high" Text="Generating WPF localization resources from Localization.csv…" />
    <Exec Command="py $(ProjectDir)..\ci\generate_localization.py --wpf"
          WorkingDirectory="$(ProjectDir).."
          ContinueOnError="false" />
    <ItemGroup>
      <EmbeddedResource Remove="Resources\Strings*.resx" />
      <EmbeddedResource Include="Resources\Strings.resx" />
      <EmbeddedResource Include="Resources\Strings.*.resx">
        <DependentUpon>Strings.resx</DependentUpon>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!-- 多语言资源：Localization.csv 的全部语言列生成 Strings.*.resx，不能只枚举固定语言。 -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.*.resx">
      <DependentUpon>Strings.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- 现场翻译覆盖模板：复制到 Config/Localization.override.csv 后编辑并重启生效。 -->
    <None Update="Resources\Localization.override.sample.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Localization.override.sample.csv</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 内置使用手册（F1 / 帮助按钮） -->
    <None Include="手册\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>手册\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\screenshots\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>screenshots\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="HandyControl" />
    <PackageReference Include="Material.Icons.WPF" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="PdfSharpCore" />
    <!-- SignalR 客户端：Remote 模式连接 Kanban.Collector；MessagePack 与 Collector 服务端协议对齐 -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HslCommunication">
      <HintPath>..\lib\HslCommunication\HslCommunication.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- OxyPlot 使用本地源码（oxyplot\Source）替代 NuGet 包，便于调试/修改渲染行为。
         Wpf 目标框架最高 net8.0-windows7.0（net10.0-windows 可向下引用）；Core/SkiaSharp 支持 net10.0。
         Core 由 Wpf/SkiaSharp 传递引用，不显式列出避免双 TFM 版本冲突。 -->
    <ProjectReference Include="..\oxyplot\Source\OxyPlot.Wpf\OxyPlot.Wpf.csproj" />
    <ProjectReference Include="..\oxyplot\Source\OxyPlot.SkiaSharp\OxyPlot.SkiaSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MainAPP.Tests" />
    <InternalsVisibleTo Include="MainAPP.Benchmarks" />
    <InternalsVisibleTo Include="MainAPP.E2E" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LicenseManager.App\LicenseManager.App.csproj" />
    <!-- SignalR 客户端共享库（WPF/Blazor WASM 共用）：连接封装 + 事件订阅 + 服务调用 -->
    <ProjectReference Include="..\Kanban.Client\Kanban.Client.csproj" />
    <!-- 展示端瘦身过渡期：采集/存储/领域模型已迁入 Core，MainAPP 经项目引用继续使用（第 4 步改为客户端代理后移除） -->
    <ProjectReference Include="..\Kanban.Collector.Core\Kanban.Collector.Core.csproj" />
    <ProjectReference Include="..\Kanban.Contracts\Kanban.Contracts.csproj" />
    <ProjectReference Include="..\Kanban.Analysis\Kanban.Analysis.csproj" />
  </ItemGroup>

</Project>
