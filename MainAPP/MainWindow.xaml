<Window
    x:Class="MainAPP.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:views="clr-namespace:MainAPP.Views"
    x:Name="RootWindow"
    Icon="{StaticResource AppIcon}"
    Title="{Binding WindowTitle}"
    Background="{StaticResource BackgroundBrush}"
    FontFamily="Microsoft YaHei"
    FontSize="14"
    PreviewKeyDown="OnPreviewKeyDown"
    PreviewMouseDown="OnPreviewMouseDown"
    WindowStyle="None"
    ResizeMode="NoResize"
    WindowState="Maximized"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources;assembly=Kanban.Localization">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+1" Command="{Binding SelectPageCommand}" CommandParameter="0" />
        <KeyBinding Gesture="Ctrl+2" Command="{Binding SelectPageCommand}" CommandParameter="1" />
        <KeyBinding Gesture="Ctrl+3" Command="{Binding SelectPageCommand}" CommandParameter="2" />
        <KeyBinding Gesture="Ctrl+4" Command="{Binding SelectPageCommand}" CommandParameter="3" />
        <KeyBinding Gesture="Ctrl+5" Command="{Binding SelectPageCommand}" CommandParameter="4" />
        <KeyBinding Gesture="Ctrl+6" Command="{Binding SelectPageCommand}" CommandParameter="5" />
        <KeyBinding Gesture="Ctrl+7" Command="{Binding SelectPageCommand}" CommandParameter="6" />
        <KeyBinding Gesture="Ctrl+8" Command="{Binding SelectPageCommand}" CommandParameter="7" />
        <KeyBinding Gesture="Ctrl+9" Command="{Binding SelectPageCommand}" CommandParameter="8" />
        <KeyBinding Gesture="F1" Command="{Binding OpenHelpCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding SwitchUserCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+K" Command="{Binding OpenShortcutHelpCommand}" />
        <!-- 展示模式隐藏入口：Ctrl+Shift+S 弹管理员密码验证后切回完整模式（Viewer 下命令方可执行） -->
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding ExitViewerCommand}" />
    </Window.InputBindings>

    <!--  大屏自适应：Viewbox 按实际窗口等比缩放 1920×1080 设计画布。
          Stretch=Uniform：完整适配窗口、内容不裁切（非 16:9 屏以信箱化留边，
          避免 UniformToFill 裁掉边缘 KPI/报警导致大屏远距看不到）。
          统一固定 1920×1080 设计画布（纯大屏看板，按此画布等比缩放铺满）。
          浮层（右键菜单/ComboBox 下拉/Dialog）不在此树内，暂不动。  -->
    <Viewbox x:Name="RootViewbox" Stretch="Uniform">
        <Grid x:Name="RootCanvas" Width="1920" Height="1080">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 侧边栏 ============  -->
        <!--  工业风（方案 C）：右侧 2px 主色分隔条与内容区划界；折叠/展开由 IsSidebarCollapsed 驱动。  -->
        <Border
            x:Name="NavigationBar"
            Grid.Column="0"
            VerticalAlignment="Stretch"
            Visibility="Collapsed"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource PrimaryBrush}"
            BorderThickness="0,0,2,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="208" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(Border.Width)"
                                            To="72"
                                            Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(Border.Width)"
                                            To="208"
                                            Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel LastChildFill="True">
                <!--  顶部：折叠按钮 + Logo。
                      折叠时 logo 文字（SidebarLabel）隐藏，按钮通过 HorizontalAlignment 切换为 Center，
                      避免孤零零偏左；展开时按钮靠左，与 logo 文字左对齐。  -->
                <DockPanel Margin="12,16,12,12" DockPanel.Dock="Top">
                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        AutomationProperties.Name="{x:Static resources:Strings.Lbl_CollapseExpandSidebar}"
                        Command="{Binding ToggleSidebarCommand}"
                        FocusVisualStyle="{StaticResource TouchFocusVisual}"
                        ToolTip="{x:Static resources:Strings.Lbl_CollapseExpandSidebar2}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <!--  工业风：按钮带底色与边框，与导航选中块呼应  -->
                                <Setter Property="Background" Value="{StaticResource RegionBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialIcons:MaterialIcon
                            Width="18"
                            Height="18"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Kind="Menu" />
                    </Button>
                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SidebarLabel}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{x:Static resources:Strings.Lbl_KanbanSystem}" />
                    </StackPanel>
                </DockPanel>

                <!--  顶部主色装饰条（工业风品牌色带）  -->
                <Border
                    Height="4"
                    Background="{StaticResource PrimaryBrush}"
                    DockPanel.Dock="Top" />

                <!--  使用手册（F1）：沉于侧边栏最底部，登录入口之下，避免与导航项重叠。  -->
                <Button
                    Margin="10,0,10,6"
                    Padding="12,10"
                    MinHeight="40"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.Ux_HelpTooltip}"
                    Command="{Binding OpenHelpCommand}"
                    DockPanel.Dock="Bottom"
                    FocusVisualStyle="{StaticResource TouchFocusVisual}"
                    ToolTip="{x:Static resources:Strings.Ux_HelpTooltip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                            <Setter Property="Background" Value="{StaticResource RegionBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <materialIcons:MaterialIcon
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Kind="HelpCircleOutline" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Style="{StaticResource SidebarNavTextStyle}"
                                Text="{x:Static resources:Strings.Ux_HelpTooltip}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!--  切换用户入口：位于使用手册上方，Viewer 模式隐藏。
                      紧凑单行（头像 + 姓名），账户锚点贴近底部符合 Slack/Teams 习惯。  -->
                <Button
                    Margin="0,0,0,6"
                    Padding="12,5"
                    MinHeight="38"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="{x:Static resources:Strings.Msg_SwitchUser}"
                    Command="{Binding SwitchUserCommand}"
                    DockPanel.Dock="Bottom"
                    FocusVisualStyle="{StaticResource TouchFocusVisual}"
                    ToolTip="{x:Static resources:Strings.Msg_SwitchUser}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsViewerMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <!--  工业风：折叠时整个内容收缩居中，仅剩方形头像  -->
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  方形首字符头像（工业风），文字折叠时隐藏  -->
                        <Border
                            Grid.Column="0"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource PrimarySoftBrush}"
                            CornerRadius="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="{Binding CurrentUserDisplay, Converter={StaticResource FirstCharacterConverter}}" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0"
                            FontSize="{DynamicResource FontSizeCaption}"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Style="{StaticResource SidebarLabel}"
                            Text="{Binding CurrentUserDisplay}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!--  导航项（ListBox + ListBoxItem 模板，替代 hc:SideMenu）。
                      原 hc:SideMenuItem 不暴露 AutomationProperties.Name 到 UIA Control 树，
                      导致跨页面交互测试无法 ByName+Click；改用原生 ListBox 后 ListBoxItem
                      原生支持 UIA，AutomationProperties.Name 通过 SidebarNavListBoxStyle 中的
                      ItemContainerStyle Setter 绑定到 NavItem.AccessibleName，可被 UIA 客户端直接识别。  -->
                <ListBox
                    x:Name="NavListBox"
                    Margin="12,8,12,8"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{x:Static resources:Strings.Lbl_MainNavigation}"
                    ItemTemplate="{StaticResource SidebarNavItemTemplate}"
                    ItemsSource="{Binding NavItems}"
                    SelectionChanged="OnNavigationSelectionChanged"
                    SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                    Style="{StaticResource SidebarNavListBoxStyle}" />
            </DockPanel>
        </Border>

        <!--  ============ 内容区（PageTransition：切换时 0.2s 渐显） ============  -->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  页面内容铺满；连接横幅叠在顶部（不占 Auto 行），避免显隐时下方布局跳动。  -->
            <ItemsControl ItemsSource="{Binding Pages, ElementName=RootWindow}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:NavigationPageHost
                            Page="{Binding}"
                            Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Style="{StaticResource PageTransition}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  全局连接状态横幅：断连红底 / 连接中黄底 / 数据停滞（采集卡死）黄底；叠层不占布局行。  -->
            <Border
                x:Name="ConnectionStatusBanner"
                Padding="16,6"
                VerticalAlignment="Top"
                Panel.ZIndex="850"
                Background="{StaticResource DangerBrush}"
                Visibility="{Binding IsConnectionBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlcConnecting}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDataStale}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon
                        Width="14" Height="14"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Kind="AlertCircleOutline"
                        Foreground="White" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="White"
                        Text="{Binding PlcConnectionBannerText}" />
                </StackPanel>
            </Border>

            <Button
                x:Name="FullscreenMenuButton"
                Width="40"
                Height="40"
                Padding="0"
                Margin="16,16,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="900"
                AutomationProperties.AutomationId="FullscreenMenuButton"
                AutomationProperties.Name="{x:Static resources:Strings.Lbl_ShowNavigationMenu}"
                Click="OnFullscreenMenuClick"
                FocusVisualStyle="{StaticResource TouchFocusVisual}"
                ToolTip="{x:Static resources:Strings.Lbl_ShowNavigationMenu}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                        <!--  半透明常驻：全屏时停靠左侧中部，低调不喧宾夺主，悬停时加深便于点击  -->
                        <Setter Property="Opacity" Value="0.35" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <materialIcons:MaterialIcon Width="20" Height="20" Kind="Menu" />
            </Button>

            <!--  本页说明：贴在页面右侧，不盖住左侧内容。正文来自使用手册的 page-help 标记。  -->
            <Border
                Grid.Column="1"
                Width="420"
                Padding="20,16"
                Background="{StaticResource RegionBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding PageHelp.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{x:Static resources:Strings.Ux_PageHelpTitle}" />
                        <Button
                            Width="28"
                            Height="28"
                            MinWidth="28"
                            MinHeight="28"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static resources:Strings.Lbl_Close}"
                            Command="{Binding PageHelp.CloseCommand}"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource TouchFocusVisual}"
                            ToolTip="{x:Static resources:Strings.Lbl_Close}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </Button.Style>
                            <materialIcons:MaterialIcon Width="16" Height="16" Kind="Close" />
                        </Button>
                    </Grid>
                    <Button
                        DockPanel.Dock="Bottom"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenHelpCommand}"
                        Content="{x:Static resources:Strings.Ux_PageHelpOpenManual}"
                        Style="{StaticResource ButtonDefault}" />
                    <controls:PageHelpPanel
                        Error="{Binding PageHelp.Error}"
                        Intro="{Binding PageHelp.Intro}"
                        Sections="{Binding PageHelp.Sections}" />
                </DockPanel>
            </Border>
        </Grid>

        <!--  全局 Growl 通知容器（右下角）。
              HandyControl 的 Growl 需要一个 Panel 容器才能在 UI 显示通知；
              连接横幅已改为顶部叠层，通知放右下角避开顶部状态区。
              用 StackPanel 覆盖全窗口（ColumnSpan=2），Z-order 在最上层。
              容器注册在 MainWindow 构造函数中通过 Growl.SetGrowlParent 完成。  -->
        <StackPanel x:Name="GrowlContainer"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Panel.ZIndex="1000" />
        </Grid>
    </Viewbox>
</Window>
