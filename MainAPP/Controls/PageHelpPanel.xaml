<UserControl
    x:Class="MainAPP.Controls.PageHelpPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate x:Key="BlockTemplate">
            <StackPanel Margin="0,0,0,8">
                <controls:PageHelpTableView Rows="{Binding Rows}">
                    <controls:PageHelpTableView.Style>
                        <Style TargetType="controls:PageHelpTableView">
                            <Setter Property="Margin" Value="0,4,0,4" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:PageHelpTableView.Style>
                </controls:PageHelpTableView>
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTable}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,8,0" Foreground="{StaticResource PrimaryBrush}" Text="•">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBullet}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,0,8,0" Foreground="{StaticResource PrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOrdered}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding Number, Mode=OneWay}" />
                        <Run Text="." />
                    </TextBlock>
                    <controls:PageHelpText
                        Grid.Column="1"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Runs="{Binding Runs}"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="{Binding ViewportWidth, ElementName=Scroller}">
            <TextBlock
                Margin="0,0,0,8"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="{Binding Error, ElementName=Root}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Error, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemTemplate="{StaticResource BlockTemplate}" ItemsSource="{Binding Intro, ElementName=Root}" />
            <ItemsControl ItemsSource="{Binding Sections, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4,0,0">
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{Binding ToggleCommand}"
                                Cursor="Hand"
                                FocusVisualStyle="{StaticResource TouchFocusVisual}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0,6,0,4" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" Margin="0,2,6,0" VerticalAlignment="Top">
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <materialIcons:MaterialIcon Width="16" Height="16" Kind="ChevronRight" />
                                        </Border>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <materialIcons:MaterialIcon Width="16" Height="16" Kind="ChevronDown" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                            <ItemsControl
                                Margin="0,0,0,8"
                                ItemTemplate="{StaticResource BlockTemplate}"
                                ItemsSource="{Binding Blocks}"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
