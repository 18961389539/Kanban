<UserControl
    x:Class="MainAPP.Controls.OperationFeedbackBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:models="clr-namespace:MainAPP.Models"
    AutomationProperties.Name="{x:Static resources:Strings.Ux_StatusSaved}"
    xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.Resources>
        <Style x:Key="FeedbackPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Feedback.Kind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static models:OperationFeedbackKind.Working}">
                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Feedback.Kind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static models:OperationFeedbackKind.Success}">
                    <Setter Property="Background" Value="{StaticResource StatusRunSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Feedback.Kind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static models:OperationFeedbackKind.Warning}">
                    <Setter Property="Background" Value="{StaticResource StatusPauseSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Feedback.Kind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static models:OperationFeedbackKind.Error}">
                    <Setter Property="Background" Value="{StaticResource StatusAlarmSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FeedbackText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Feedback.Kind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static models:OperationFeedbackKind.Working}">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Feedback.Kind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static models:OperationFeedbackKind.Success}">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Feedback.Kind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static models:OperationFeedbackKind.Warning}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Feedback.Kind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static models:OperationFeedbackKind.Error}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Padding="8,5" Style="{StaticResource FeedbackPanel}"
            Visibility="{Binding Feedback.HasMessage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
            ToolTip="{Binding Feedback.Message, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <StackPanel Orientation="Horizontal">
            <materialIcons:MaterialIcon Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Kind="InformationOutline" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource FeedbackText}"
                       Text="{Binding Feedback.Message, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
    </Border>
</UserControl>