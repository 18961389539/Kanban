<UserControl
    x:Class="MainAPP.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
    mc:Ignorable="d" xmlns:resources="clr-namespace:MainAPP.Resources">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon
            Width="64"
            Height="64"
            HorizontalAlignment="Center"
            Foreground="{StaticResource SecondaryTextBrush}"
            Kind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue={x:Static mi:MaterialIconKind.InboxOutline}}" />
        <TextBlock
            Margin="0,18,0,0"
            HorizontalAlignment="Center"
            Style="{StaticResource EmptyStateMessageText}"
            Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=暂无数据}" />
        <TextBlock
            Margin="0,6,0,0"
            HorizontalAlignment="Center"
            Text="{Binding Hint, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateHintText}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Hint, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
