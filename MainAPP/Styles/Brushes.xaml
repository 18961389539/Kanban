<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ============ HC 深色主题覆盖 ============  -->
    <!--  HC 3.5.1 仅内置 7 个 Dark 画刷（Primary/Danger/Success/Warning/Info/Default/Accent），
          背景/区域/边框/文本类无 Dark 变体，需自定义覆盖为深色值。  -->

    <!--  背景/区域  -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0E1116" />
    <SolidColorBrush x:Key="RegionBrush" Color="#1A2029" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#212834" />
    <SolidColorBrush x:Key="DarkBrush" Color="#0F1419" />

    <!--  边框  -->
      <SolidColorBrush x:Key="BorderBrush" Color="#344052" />
      <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#465467" />
      <SolidColorBrush x:Key="DividerBrush" Color="#303B4B" />

    <!--  文本  -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B7C0CC" />
    <!--  辅助文字保留层级，但提高亮度以覆盖 11-13px 小字号、缩放和抗锯齿余量。  -->
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#A7AFBC" />

    <!--  控件状态文字：禁用/占位信息不冒充正文，但仍保持明确可见。  -->
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#7F8A9B" />
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9AA5B5" />

    <!--  覆盖 HC 内置标题画刷：HC 的 InfoElement.Title（TextBoxExtend/ComboBoxExtend 等字段标题）
          默认使用 TitleBrush，深色主题下默认值对比度不足。提亮至主文本色 #E5E7EB 确保可读。  -->
      <SolidColorBrush x:Key="TitleBrush" Color="#F1F5F9" />

    <!--  语义色：用 HC 内置 Dark 变体  -->
    <StaticResource x:Key="PrimaryBrush" ResourceKey="DarkPrimaryBrush" />
    <StaticResource x:Key="DangerBrush" ResourceKey="DarkDangerBrush" />
    <StaticResource x:Key="SuccessBrush" ResourceKey="DarkSuccessBrush" />
    <StaticResource x:Key="WarningBrush" ResourceKey="DarkWarningBrush" />

    <!--  ============ 状态语义色（看板专用） ============ -->
    <!--  运行=绿, 报警=红, 待机=黄, 初始=灰  -->
    <!--  Soft 变体 = 15% 透明度背景，用于状态药丸/卡片底色  -->

    <SolidColorBrush x:Key="StatusRunBrush" Color="#34D399" />
    <SolidColorBrush x:Key="StatusRunSoftBrush" Color="#34D399" Opacity="0.15" />

    <SolidColorBrush x:Key="StatusAlarmBrush" Color="#F87171" />
    <SolidColorBrush x:Key="StatusAlarmSoftBrush" Color="#F87171" Opacity="0.15" />

    <SolidColorBrush x:Key="StatusPauseBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="StatusPauseSoftBrush" Color="#FBBF24" Opacity="0.15" />

    <SolidColorBrush x:Key="StatusWarnBrush" Color="#FB923C" />
    <SolidColorBrush x:Key="StatusWarnSoftBrush" Color="#FB923C" Opacity="0.15" />

    <SolidColorBrush x:Key="StatusIdleBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="StatusIdleSoftBrush" Color="#9CA3AF" Opacity="0.15" />

    <!--  ============ 图表系列色（看板专用） ============ -->
    <!--  与 OverviewViewModel 中 OxyColor.FromRgb 硬编码值保持一致。
          用于图表卡片标题栏色条，使其与图表内主系列颜色视觉对应。  -->
    <SolidColorBrush x:Key="ChartOkSeriesBrush" Color="#818CF8" />     <!-- 趋势图 OK 产量系列/班次背景 -->
    <SolidColorBrush x:Key="ChartBaseSeriesBrush" Color="#60A5FA" />   <!-- 瀑布图起始/最终柱 + 热力图高产量端 -->

    <!--  ============ 交互态软色（看板专用） ============ -->
    <!--  PrimarySoft：列表项选中底色 / 提示卡底色（15% 主色透明感）  -->
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#263040" />
    <!--  HoverBrush：列表项悬停底色  -->
    <SolidColorBrush x:Key="HoverBrush" Color="#1F2733" />
    <!--  PrimaryContrastBrush：主色填充上的深色对比前景（侧边栏工业风选中项图标/文字、
          Logo 方块内图标），与主色块配套使用，避免硬编码色值。  -->
    <SolidColorBrush x:Key="PrimaryContrastBrush" Color="#10141B" />

    <!--  ============ 覆盖层（加载/遮罩） ============ -->
    <!--  OverlayBackgroundBrush：50% 透明背景色，用于 LoadingOverlay 等。
          比 Border.Opacity 更优：仅影响背景，子元素（LoadingCircle 等）保持完整不透明度。  -->
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#800E1116" />

</ResourceDictionary>
