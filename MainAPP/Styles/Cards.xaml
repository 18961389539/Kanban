<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ============ 统一卡片样式 ============  -->
    <!--  主卡片：外层卡片，圆角 6，避免页面层级过度圆润  -->
    <Style x:Key="MainCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Effect" Value="{StaticResource CardDropShadow}" />
    </Style>

    <!--  内部小卡：KPI 小卡/徽章容器，圆角 4  -->
    <Style x:Key="InnerCard" TargetType="Border" BasedOn="{StaticResource MainCard}">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <!--  ============ KPI 卡片样式（看板/查询页通用） ============  -->
    <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource MainCard}">
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--  KPI 卡片强调变体：主色 2px 边框，用于 OEE 综合值  -->
    <Style x:Key="KpiCardAccent" TargetType="Border" BasedOn="{StaticResource KpiCard}">
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!--  KPI 次级卡片：SecondaryRegionBrush 底色，用于明细数据  -->
    <Style x:Key="KpiCardSecondary" TargetType="Border" BasedOn="{StaticResource KpiCard}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--  ============ KPI 单元格（紧凑小卡，AlarmCenter/Overview/DeviceDetail 共用） ============  -->
    <Style x:Key="KpiCell" TargetType="Border" BasedOn="{StaticResource InnerCard}">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <!--  KPI 单元格标签：基于全局 KpiLabel，追加底部间距  -->
    <Style x:Key="KpiCellLabel" TargetType="TextBlock" BasedOn="{StaticResource KpiLabel}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--  KPI 单元格数值：基于全局 KpiValueMd（22px Bold Consolas）  -->
    <Style x:Key="KpiCellValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValueMd}" />

    <!--  ============ 复合卡片样式（看板通用容器） ============  -->

    <!--  图表卡片：包裹 oxy:PlotView，Padding 12  -->
    <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource MainCard}">
        <Setter Property="Padding" Value="12" />
    </Style>

    <!--  提示卡片：PrimarySoftBrush 底色，用于提示/引导文案（区别于普通数据卡）  -->
    <Style x:Key="HintCard" TargetType="Border" BasedOn="{StaticResource InnerCard}">
        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!--  药丸徽章：小标签 / 班次徽章 / 状态徽章等（圆角 12 + Padding 10,3）  -->
    <Style x:Key="PillBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

</ResourceDictionary>
