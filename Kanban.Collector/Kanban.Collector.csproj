<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Kanban.Collector</RootNamespace>
    <AssemblyName>Kanban.Collector</AssemblyName>
    <!-- 服务进程不需要 WPF 特性，但保留 windows TFM 以兼容 HslCommunication 与 System.IO.Ports -->
  </PropertyGroup>

  <ItemGroup>
    <!-- SignalR 服务端位于 ASP.NET Core 共享框架 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HslCommunication">
      <HintPath>..\MainAPP\DLLS\HslCommunication.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kanban.Contracts\Kanban.Contracts.csproj" />
    <ProjectReference Include="..\Kanban.Collector.Core\Kanban.Collector.Core.csproj" />
  </ItemGroup>

</Project>
