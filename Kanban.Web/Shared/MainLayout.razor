@inherits LayoutComponentBase

<div class="app-shell">
    <nav class="topnav">
        <NavLink class="topnav-link" href="/" Match="NavLinkMatch.All">@L.T("Nav_Dashboard")</NavLink>
        <NavLink class="topnav-link" href="/line">@L.T("Nav_Line")</NavLink>
        <NavLink class="topnav-link" href="/history">@L.T("Nav_History")</NavLink>
        <NavLink class="topnav-link" href="/alarms">@L.T("Nav_AlarmCenter")</NavLink>
        <NavLink class="topnav-link" href="/monitoring">@L.T("Nav_Monitoring")</NavLink>
        <NavLink class="topnav-link" href="/review">@L.T("Nav_Review")</NavLink>
        <NavLink class="topnav-link" href="/devices">@L.T("Nav_Devices")</NavLink>
        <NavLink class="topnav-link" href="/workorders">@L.T("Nav_WorkOrders")</NavLink>
        <NavLink class="topnav-link" href="/recipes">@L.T("Nav_Recipes")</NavLink>
        <NavLink class="topnav-link" href="/settings">@L.T("Nav_Settings")</NavLink>
        <NavLink class="topnav-link" href="/audit">@L.T("Nav_Audit")</NavLink>
    </nav>
    <main class="app-body">
        @Body
    </main>
</div>

@code {
    /// <summary>
    /// 嵌套用法（审查修复 2026-08-14）：App.razor 的 NotFound 分支以 <see cref="App.razor"/>
    /// <c>&lt;MainLayout&gt;&lt;div&gt;404&lt;/div&gt;&lt;/MainLayout&gt;</c> 形式嵌套内容——
    /// 缺少本参数时任何未知路由都会抛"MainLayout does not have ChildContent"渲染崩溃，
    /// 404 页面无法优雅显示。与 @Body 并存：RouteView 注入的页面走 @Body，嵌套内容走 ChildContent。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
