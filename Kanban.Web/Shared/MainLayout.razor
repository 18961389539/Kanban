@inherits LayoutComponentBase
@inject DashboardState Dashboard
@inject IJSRuntime JS
@inject NavigationManager Nav
@using Kanban.Contracts.Display
@implements IDisposable

<div class="app-shell" @onpointerdown="OnPointerDown">
    <nav class="topnav">
        <NavLink class="topnav-link" href="/" Match="NavLinkMatch.All">@L.T("Nav_Dashboard")</NavLink>
        <NavLink class="topnav-link" href="/line">@L.T("Nav_Line")</NavLink>
        <NavLink class="topnav-link" href="/history">@L.T("Nav_History")</NavLink>
        <NavLink class="topnav-link" href="/alarms">@L.T("Nav_AlarmCenter")</NavLink>
        <NavLink class="topnav-link" href="/monitoring">@L.T("Nav_Monitoring")</NavLink>
        <NavLink class="topnav-link" href="/review">@L.T("Nav_Review")</NavLink>
        <NavLink class="topnav-link" href="/devices">@L.T("Nav_Devices")</NavLink>
        <NavLink class="topnav-link" href="/workorders">@L.T("Nav_WorkOrders")</NavLink>
        <NavLink class="topnav-link" href="/recipes">@L.T("Nav_Recipes")</NavLink>
        <NavLink class="topnav-link" href="/settings">@L.T("Nav_Settings")</NavLink>
        <NavLink class="topnav-link" href="/audit">@L.T("Nav_Audit")</NavLink>
    </nav>
    <main class="app-body">
        @Body
    </main>
    @if (_overlayVisible)
    {
        <div class="carousel-overlay" title="@L.Tip("Carousel_Tip", _statusText)" aria-hidden="true">
            @for (var i = 0; i < DisplayCarousel.Playlist.Length; i++)
            {
                <span class="carousel-dot @(i == _sceneIndex ? "on" : "")"></span>
            }
            <span class="carousel-status">@_statusText</span>
        </div>
    }
</div>

@code {
    /// <summary>
    /// 嵌套用法（审查修复 2026-08-14）：App.razor 的 NotFound 分支以 <see cref="App.razor"/>
    /// <c>&lt;MainLayout&gt;&lt;div&gt;404&lt;/div&gt;&lt;/MainLayout&gt;</c> 形式嵌套内容——
    /// 缺少本参数时任何未知路由都会抛"MainLayout does not have ChildContent"渲染崩溃，
    /// 404 页面无法优雅显示。与 @Body 并存：RouteView 注入的页面走 @Body，嵌套内容走 ChildContent。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // ─── 壳层同步 ───
    // 1) 订阅 StateChanged：语言切换时顶栏导航文本即时重渲染（此前仅页面级订阅，导航标签滞留旧语言）。
    // 2) 推送 <html lang>/document.title 到 DOM（js/shell.js），供浏览器翻译/无障碍/标签页标题。
    private string? _appliedShellKey;
    private readonly DisplayCarouselClock _carouselClock = new();
    private System.Threading.Timer? _carouselTimer;
    private bool _disposed;
    private bool _overlayVisible;
    private int _sceneIndex;
    private string _statusText = "";

    protected override void OnInitialized()
    {
        Dashboard.StateChanged += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
        _carouselTimer = new System.Threading.Timer(_ => _ = SafeTickAsync(DisplayCarousel.TickMs), null, DisplayCarousel.TickMs, DisplayCarousel.TickMs);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var key = Dashboard.Language + "|" + Dashboard.Title;
        if (key == _appliedShellKey) return;
        _appliedShellKey = key;
        try
        {
            await JS.InvokeVoidAsync("KanbanShell.applyMetadata", Dashboard.Language, Dashboard.Title);
        }
        catch (Exception)
        {
            // JS 不可用（预渲染/启动早期）时忽略——下次渲染重试
            _appliedShellKey = null;
        }
    }

    private void OnStateChanged() => _ = SafeTickAsync(0);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = SafeTickAsync(0);

    private void OnPointerDown(PointerEventArgs _) => _carouselClock.NoteInteraction(DateTime.UtcNow);

    private async Task SafeTickAsync(int deltaMs)
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(() => Tick(deltaMs));
        }
        catch (ObjectDisposedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void Tick(int deltaMs)
    {
        if (_disposed) return;
        var status = _carouselClock.Step(new DisplayCarouselInput(
            UtcNow: DateTime.UtcNow,
            DeltaMs: deltaMs,
            Enabled: Dashboard.DisplayCarouselEnabled,
            HasHighAlarm: Dashboard.HasAnyHighLevelAlarm,
            HasActiveAlarms: Dashboard.HasAnyActiveAlarm,
            CurrentPageKey: CurrentPageKey));

        _overlayVisible = status.OverlayVisible;
        _sceneIndex = status.SceneIndex;
        _statusText = FormatCarouselStatus(status);
        StateHasChanged();

        if (status.NavigateTo is { } target && target != CurrentPageKey)
            Nav.NavigateTo(RouteFor(target));
    }

    private string CurrentPageKey
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Trim('/');
            if (path == "/") return DisplayCarousel.Home;
            return path switch
            {
                "/line" => DisplayCarousel.ProductionLine,
                "/alarms" => DisplayCarousel.AlarmCenter,
                _ => path.TrimStart('/'),
            };
        }
    }

    private static string RouteFor(string scene) => scene switch
    {
        DisplayCarousel.ProductionLine => "/line",
        DisplayCarousel.AlarmCenter => "/alarms",
        _ => "/",
    };

    private static string FormatCarouselStatus(DisplayCarouselStatus status)
    {
        if (!status.OverlayVisible) return "";
        if (status.Frozen) return L.T("Carousel_Frozen");
        var scene = status.Scene switch
        {
            DisplayCarousel.ProductionLine => L.T("Nav_Line"),
            DisplayCarousel.AlarmCenter => L.T("Nav_AlarmCenter"),
            _ => L.T("Nav_Dashboard"),
        };
        return status.Paused
            ? L.T("Carousel_Paused", scene, status.RemainingSeconds)
            : L.T("Carousel_Running", scene, status.RemainingSeconds);
    }

    public void Dispose()
    {
        _disposed = true;
        Dashboard.StateChanged -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _carouselTimer?.Dispose();
    }
}
