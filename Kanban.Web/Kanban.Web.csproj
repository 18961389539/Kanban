<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kanban.Web</RootNamespace>
    <AssemblyName>Kanban.Web</AssemblyName>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- 加载全部全球化数据：WASM 默认只带 invariant 文化，语言切换后 CultureInfo 格式化需要完整 ICU 数据 -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <!-- 编译前从统一 Localization.csv 重新生成 Localization.cs。 -->
  <Target Name="GenerateLocalization" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="Generating Localization.cs from WPF Strings.resx…" />
    <Exec Command="py $(ProjectDir)..\ci\generate_localization.py --web"
          WorkingDirectory="$(ProjectDir).."
          ContinueOnError="false" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 共享 SignalR 客户端：WASM 端 useMessagePack=false 走 JSON（Collector 双协议并存） -->
    <ProjectReference Include="..\Kanban.Client\Kanban.Client.csproj" />
    <!-- 共享分析层（ADR-4 单源）：OEE 公式/CSV 转义不再在 Web 侧复制（此前 OeeAnalysis/ProductionAnalysis 本地实现） -->
    <ProjectReference Include="..\Kanban.Analysis\Kanban.Analysis.csproj" />
  </ItemGroup>

</Project>
