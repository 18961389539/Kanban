@page "/line"
@implements IDisposable
@inject DashboardState Dashboard
@inject KanbanAdminClient Admin
@inject ILogger<ProductionLine> Logger
@using Kanban.Contracts.Dtos
@using Kanban.Contracts.Enums
@using Kanban.Contracts.Metrics
@using Microsoft.Extensions.Logging

<div class="query-page">
    @* ──── 标题行：产线总览 + 设备数 + 当前班次 ──── *@
    <div class="line-header">
        <div class="brand">
            <span class="brand-title">@L.T("Ln_Title")</span>
            <span class="brand-sub">@L.T("Ln_DevCount", Dashboard.DeviceCount)</span>
        </div>
        @if (Dashboard.ShiftProgress is { } shift)
        {
            <div class="line-shift">
                <span class="kpi-label">@L.T("Ln_CurrentShift")</span>
                <b>@shift.Name</b>
                <span class="kpi-sub">@L.T("Ln_ShiftProgress") @shift.Pct</span>
            </div>
        }
    </div>

    @* ──── 一键全部设备 OEE 清零的结果提示（成功/失败） ──── *@
    @if (!string.IsNullOrEmpty(_resetNotice))
    {
        <div class="msg-banner @(_resetNoticeIsError ? "msg-error" : "msg-ok")">
            <span>@_resetNotice</span>
            <button class="msg-close" title="@L.T("Pl_Cancel")" @onclick="() => _resetNotice = null">✕</button>
        </div>
    }

    @* ──── 危险操作二次确认（屏端内联模态，避免浏览器原生 confirm 的样式割裂） ──── *@
    @if (_confirmResetOpen)
    {
        <div class="modal-mask">
            <div class="modal-box">
                <div class="modal-title">@L.T("Pl_ResetAllHint")</div>
                <div class="modal-body">@L.T("Pl_ResetAllConfirm", Dashboard.DeviceCount)</div>
                <div class="modal-actions">
                    <button class="btn" disabled="@_resettingAll" @onclick="CloseResetConfirm">@L.T("Pl_Cancel")</button>
                    <button class="btn btn-danger" disabled="@_resettingAll" @onclick="ConfirmResetAllAsync">
                        @L.T("Pl_ResetAll")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (Dashboard.Snapshots.Count == 0)
    {
        <EmptyState Title="@L.T("Ln_NoDevices")" Hint="@L.T("Ln_NoDevicesHint")" Icon="🏭" />
    }
    else
    {
        @* ──── 汇总 KPI 条：四态合并为两张双指标卡（运行|报警、待机|离线） ──── *@
        <section class="kpi-row">
            <div class="kpi-card dual">
                <div class="kpi-metric">
                    <span class="kpi-label">@L.T("Status_Running")</span>
                    <span class="kpi-value kpi-ok">@Summary.Running</span>
                </div>
                <div class="kpi-metric">
                    <span class="kpi-label">@L.T("Status_Alarm")</span>
                    <span class="kpi-value kpi-ng">@Summary.Alarm</span>
                </div>
            </div>
            <div class="kpi-card dual">
                <div class="kpi-metric">
                    <span class="kpi-label">@L.T("Status_Paused")</span>
                    <span class="kpi-value">@Summary.Paused</span>
                </div>
                <div class="kpi-metric">
                    <span class="kpi-label">@L.T("Status_Offline")</span>
                    <span class="kpi-value">@Summary.Idle</span>
                </div>
            </div>

            @* ──── 一键全部设备 OEE 清零：危险写操作，需二次确认；断线/执行中禁用 ──── *@
            <div class="kpi-card action">
                <button class="btn btn-danger" disabled="@(!CanResetAll)" @onclick="OpenResetConfirm">
                    @L.T("Pl_ResetAll")
                </button>
                <span class="kpi-sub">@L.T("Pl_ResetAllHint")</span>
            </div>
        </section>

        @* ──── 筛选：状态 / 搜索 / 排序 ──── *@
        <div class="filter-bar compact">
            <button class="chip-btn @(StatusFilter == 0 ? "active" : "")" @onclick="() => SetFilter(0)">@L.T("Ln_FilterAll")</button>
            <button class="chip-btn @(StatusFilter == 1 ? "active" : "")" @onclick="() => SetFilter(1)">@L.T("Status_Running")</button>
            <button class="chip-btn @(StatusFilter == 2 ? "active" : "")" @onclick="() => SetFilter(2)">@L.T("Status_Alarm")</button>
            <button class="chip-btn @(StatusFilter == 3 ? "active" : "")" @onclick="() => SetFilter(3)">@L.T("Status_Paused")</button>
            <button class="chip-btn @(StatusFilter == 4 ? "active" : "")" @onclick="() => SetFilter(4)">@L.T("Status_Offline")</button>
            <input class="filter-input line-search" type="search" value="@SearchText" @oninput="OnSearchInput" placeholder="@L.T("Ln_Search")" />
            <select class="filter-input line-sort" value="@SortBy" @onchange="OnSortChange">
                <option value="name">@L.T("Ln_SortName")</option>
                <option value="output">@L.T("Ln_SortOutput")</option>
                <option value="oee">@L.T("Ln_SortOee")</option>
            </select>
        </div>

        @if (FilteredDevices.Count == 0)
        {
            <EmptyState Title="@L.T("Ln_EmptyFilter")" Hint="" Icon="🔍" />
        }
        else
        {
            <div class="mon-grid">
                @foreach (var d in FilteredDevices)
                {
                    <div class="mon-card line-card">
                        <div class="dev-head">
                            <span class="dev-name">@d.DeviceName</span>
                            <span class="status-badge @StateClass(d.Status)">@StateText(d)</span>
                            @if (!string.IsNullOrEmpty(RecipeOf(d.DeviceId)))
                            {
                                <span class="line-recipe">@RecipeOf(d.DeviceId)</span>
                            }
                        </div>

                        @* 报警行：⚠ 报警名 · 持续时长 *@
                        @if (d.ActiveAlarms.Count > 0)
                        {
                            var a = d.ActiveAlarms[0];
                            <div class="line-alarm">
                                <span class="lvl-dot @LevelClass(a.Level)"></span>
                                <span>@a.Name</span>
                                <span class="alarm-dur">@FmtDuration((Dashboard.ServerNow - a.StartTime).TotalSeconds)</span>
                                @if (d.ActiveAlarms.Count > 1)
                                {
                                    <span class="kpi-sub">+@(d.ActiveAlarms.Count - 1)</span>
                                }
                            </div>
                        }

                        <div class="metric-grid">
                            <div><span class="kpi-label">@L.T("Lbl_Ok")</span><span class="kpi-value kpi-ok">@d.TotalOkProduction.ToString("N0")</span></div>
                            <div><span class="kpi-label">@L.T("Lbl_Ng")</span><span class="kpi-value kpi-ng">@d.TotalNgProduction.ToString("N0")</span></div>
                            <div><span class="kpi-label">@L.T("Ln_Cycle")</span><span class="kpi-value @(IsCycleSlow(d) ? "kpi-ng" : "")">@CycleText(d)</span></div>
                            <div><span class="kpi-label">@L.T("Status_Alarm")</span><span class="kpi-value kpi-ng">@FmtDuration(d.AlarmTime)</span></div>
                            <div><span class="kpi-label">@L.T("Status_Paused")</span><span class="kpi-value">@FmtDuration(d.PausedTime)</span></div>
                            <div><span class="kpi-label">@L.T("Status_Offline")</span><span class="kpi-value">@FmtDuration(d.OfflineTime)</span></div>
                        </div>

                        <div class="ring-row">
                            <Ring Value="@d.Oee" ValueText="@Pct(d.Oee)" Label="OEE" Color="@UiPalette.Oee" HasData="@HasWorkOrder(d.DeviceId)" />
                            <Ring Value="@d.AvailabilityRate" ValueText="@Pct(d.AvailabilityRate)" Label="@L.T("Lbl_Availability")" Color="@UiPalette.Availability"
                                  Title="@L.T("Ln_AvailabilityHint")" HasData="@HasWorkOrder(d.DeviceId)" />
                            <Ring Value="@d.PerformanceRate" ValueText="@Pct(d.PerformanceRate)" Label="@L.T("Lbl_Performance")" Color="@UiPalette.Performance" HasData="@HasWorkOrder(d.DeviceId)" />
                            <Ring Value="@d.QualityRate" ValueText="@Pct(d.QualityRate)" Label="@L.T("Lbl_Quality")" Color="@UiPalette.Quality" HasData="@HasWorkOrder(d.DeviceId)" />
                        </div>
                        <div class="meta-line">@L.T("Hq_StatusRun") @FmtDuration(d.RunTime) · @L.T("Lbl_SnapSeq") #@d.Seq</div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private System.Threading.Timer? _renderTimer;
    private bool _disposed;

    // ──── 筛选状态 ────
    private int StatusFilter { get; set; } // 0=全部 1=运行 2=报警 3=待机 4=空闲
    private string SearchText { get; set; } = "";
    private string SortBy { get; set; } = "name";

    // ──── 一键全部设备 OEE 清零状态 ────
    private bool _confirmResetOpen;
    private bool _resettingAll;
    private string? _resetNotice;
    private bool _resetNoticeIsError;

    /// <summary>
    /// 断线 / 无设备 / 执行中时禁用清零入口。
    /// 注意：屏端目前没有登录与角色模型（只读看板），此处只按连接态与设备数兜底，
    /// 不等价于权限控制——危险写操作的访问控制应由部署网络或后续接入的统一鉴权承担。
    /// </summary>
    private bool CanResetAll => !_resettingAll && Dashboard.IsConnected && Dashboard.DeviceCount > 0;

    private void OpenResetConfirm()
    {
        if (!CanResetAll) return;
        _confirmResetOpen = true;
    }

    private void CloseResetConfirm() => _confirmResetOpen = false;

    /// <summary>确认后经管理 Hub 远程清零：PLC 触发位与软件侧累计都由持有 PLC 连接的 Collector 执行。</summary>
    private async Task ConfirmResetAllAsync()
    {
        if (_resettingAll) return;
        _resettingAll = true;
        try
        {
            if (!Admin.IsConnected) await Admin.ConnectAsync();
            var result = await Admin.ResetAllOeeAsync();
            _resetNotice = L.T("Pl_ResetAllOk", result.Triggered, result.Total);
            _resetNoticeIsError = false;
            _confirmResetOpen = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "全部设备 OEE 清零失败");
            _resetNotice = L.T("Pl_ResetAllFail", ex.Message);
            _resetNoticeIsError = true;
        }
        finally
        {
            _resettingAll = false;
        }
    }

    // ──── 渲染缓存：快照每帧变化、筛选条件交互变化时置脏，避免单次渲染内重复全量计算 ────
    private LineSummary? _summaryCache;
    private List<DeviceSnapshotDto>? _filteredCache;
    private Dictionary<string, DeviceConfigDto> _deviceConfigsById = new(StringComparer.OrdinalIgnoreCase);

    private sealed class LineSummary
    {
        public int Running, Alarm, Paused, Idle;
    }

    private LineSummary Summary => _summaryCache ??= ComputeSummary();

    private LineSummary ComputeSummary()
    {
        var s = new LineSummary();
        foreach (var d in Dashboard.Snapshots)
        {
            switch (d.Status)
            {
                case DeviceStatus.Running: s.Running++; break;
                case DeviceStatus.Alarm: s.Alarm++; break;
                case DeviceStatus.Paused: s.Paused++; break;
                default: s.Idle++; break;
            }
        }
        return s;
    }

    /// <summary>筛选 + 搜索 + 排序后的设备列表（缓存：条件变化或快照刷新时置脏）。</summary>
    private List<DeviceSnapshotDto> FilteredDevices => _filteredCache ??= ComputeFilteredDevices();

    private List<DeviceSnapshotDto> ComputeFilteredDevices()
    {
        IEnumerable<DeviceSnapshotDto> list = Dashboard.Snapshots;
        if (StatusFilter > 0)
        {
            var target = StatusFilter switch
            {
                1 => DeviceStatus.Running,
                2 => DeviceStatus.Alarm,
                3 => DeviceStatus.Paused,
                _ => DeviceStatus.Offline,
            };
            list = list.Where(d => d.Status == target);
        }
        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var kw = SearchText.Trim();
            list = list.Where(d => d.DeviceName.Contains(kw, StringComparison.OrdinalIgnoreCase)
                || d.DeviceId.Contains(kw, StringComparison.OrdinalIgnoreCase));
        }
        return SortBy switch
        {
            "output" => list.OrderByDescending(d => d.TotalOkProduction + d.TotalNgProduction).ToList(),
            "oee" => list.OrderByDescending(d => d.Oee).ToList(),
            _ => list.OrderBy(d => d.DeviceName, StringComparer.OrdinalIgnoreCase).ToList(),
        };
    }

    private void SetFilter(int status)
    {
        StatusFilter = status;
        _filteredCache = null;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";
        _filteredCache = null;
    }

    private void OnSortChange(ChangeEventArgs e)
    {
        SortBy = e.Value?.ToString() ?? "name";
        _filteredCache = null;
    }

    private string RecipeOf(string deviceId)
        => _deviceConfigsById.TryGetValue(deviceId, out var config) && !string.IsNullOrWhiteSpace(config.RecipeName)
            ? config.RecipeName : "";

    /// <summary>平均节拍对比 "实际/目标s"：与 WPF LineDeviceItem / SnapshotMetrics 同口径。</summary>
    private static string CycleText(DeviceSnapshotDto d)
    {
        var target = SnapshotMetrics.CycleSeconds(d.TargetCycle);
        var real = SnapshotMetrics.AverageCycleSeconds(d.RunTime, d.TotalOkProduction, d.TotalNgProduction);
        return real > 0 && target > 0 ? $"{real:0.00}/{target:0.00}s" : "—";
    }

    private static bool IsCycleSlow(DeviceSnapshotDto d)
    {
        var target = SnapshotMetrics.CycleSeconds(d.TargetCycle);
        var real = SnapshotMetrics.AverageCycleSeconds(d.RunTime, d.TotalOkProduction, d.TotalNgProduction);
        return target > 0 && real > target;
    }

    private static string StateText(DeviceSnapshotDto d) => d.Status switch
    {
        DeviceStatus.Running => L.T("Status_Running"),
        DeviceStatus.Alarm => L.T("Status_Alarm"),
        DeviceStatus.Paused => L.T("Status_Paused"),
        _ => L.T(DeviceStatusLocKeys.For(DeviceStatus.Offline, d.OfflineCause)),
    };

    private static string StateClass(DeviceStatus status) => status switch
    {
        DeviceStatus.Running => "run",
        DeviceStatus.Alarm => "alarm",
        DeviceStatus.Paused => "paused",
        _ => "offline",
    };

    private static string LevelClass(AlarmLevel level) => level switch
    {
        AlarmLevel.High => "lvl-high",
        AlarmLevel.Medium => "lvl-medium",
        _ => "lvl-low",
    };

    // 百分比口径单源：UiPalette.Pct（P1，与 WPF 一致）
    private static string Pct(double v) => UiPalette.Pct(v);

    /// <summary>有在制工单才显示 OEE 四环数值；无工单显示 "—"（等待投产语义，避免与真实 0% 混淆）。</summary>
    private bool HasWorkOrder(string deviceId) => Dashboard.GetWorkOrder(deviceId) is not null;

    private static string FmtDuration(double seconds) => Kanban.Contracts.Formatting.DurationFormatter.FormatStandard(seconds);

    protected override async Task OnInitializedAsync()
    {
        await Dashboard.InitializeAsync();
        try
        {
            _deviceConfigsById = (await Dashboard.QueryDevicesAsync())
                .Where(c => !string.IsNullOrEmpty(c.Id))
                .GroupBy(c => c.Id, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "拉取设备配置失败（配方标签暂不可用，重进页面后重试）");
        }
        _renderTimer = new System.Threading.Timer(_ => _ = SafeTickAsync(), null, 3000, 3000);
    }

    /// <summary>
    /// 安全渲染 tick：Timer 回调在组件 Dispose 前后触发时，InvokeAsync 会抛 ObjectDisposedException；
    /// 该 Task 若未观察会成为 unhandledrejection → Blazor 显示全局 error UI（页面功能不受影响但横幅误报）。
    /// 仅吞掉释放竞态（ObjectDisposedException），其余异常记日志——避免真实渲染缺陷被静默吞掉导致页面停更无迹可查。
    /// </summary>
    private async Task SafeTickAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(OnRenderTick);
        }
        catch (ObjectDisposedException)
        {
            // 组件已释放的竞态：忽略（页面生命周期正常结束）
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "产线概览渲染 tick 异常");
        }
    }

    private void OnRenderTick()
    {
        if (_disposed) return;
        _summaryCache = null;    // 快照每帧变化：置脏，渲染时各重算一次
        _filteredCache = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _renderTimer?.Dispose();
        GC.SuppressFinalize(this);
    }
}
