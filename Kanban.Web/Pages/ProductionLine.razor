@page "/line"
@implements IDisposable
@inject DashboardState Dashboard
@inject KanbanAdminClient Admin
@inject NavigationManager Nav
@inject ILogger<ProductionLine> Logger
@using Kanban.Contracts.Dtos
@using Kanban.Contracts.Enums
@using Kanban.Contracts.Metrics
@using Microsoft.Extensions.Logging

<div class="query-page">
    @* ──── 标题行：产线总览 + 设备数 + 当前班次 ──── *@
    <div class="line-header">
        <div class="brand">
            <span class="brand-title">@L.T("Ln_Title")</span>
            <span class="brand-sub">@L.T("Ln_DevCount", Dashboard.DeviceCount)</span>
        </div>
        @if (Dashboard.ShiftProgress is { } shift)
        {
            <div class="line-shift" title="@L.Tip("Home_Tip_Shift", shift.Name, $"{shift.ElapsedText} · {shift.Pct}")">
                <span class="kpi-label">@L.T("Ln_CurrentShift")</span>
                <b>@shift.Name</b>
                <span class="kpi-sub">@L.T("Ln_ShiftProgress") @shift.Pct</span>
            </div>
        }
    </div>

    @* ──── 一键全部设备 OEE 清零的结果提示（成功/失败） ──── *@
    @if (!string.IsNullOrEmpty(_resetNotice))
    {
        <div class="msg-banner @(_resetNoticeIsError ? "msg-error" : "msg-ok")">
            <span>@_resetNotice</span>
            <button class="msg-close" title="@L.T("K143")" @onclick="() => _resetNotice = null">✕</button>
        </div>
    }

    @* ──── 危险操作二次确认（屏端内联模态，避免浏览器原生 confirm 的样式割裂） ──── *@
    @if (_confirmResetOpen)
    {
        <div class="modal-mask">
            <div class="modal-box">
                <div class="modal-title">@L.T("Pl_ResetAllHint")</div>
                <div class="modal-body">
                    <p>@L.T("Pl_ResetAllConfirm", Dashboard.DeviceCount)</p>
                    <p>@L.T("Pl_ResetAllTypeHint", L.T("Pl_ResetAllTypeToken"))</p>
                    <input class="filter-input reset-confirm-input" type="text" value="@_resetConfirmText"
                           @oninput="OnResetConfirmInput" placeholder="@L.T("Pl_ResetAllTypeToken")" />
                </div>
                <div class="modal-actions">
                    <button class="btn" disabled="@_resettingAll" @onclick="CloseResetConfirm">@L.T("Pl_Cancel")</button>
                    <button class="btn btn-danger" disabled="@(!CanConfirmReset)" @onclick="ConfirmResetAllAsync">
                        @L.T("Pl_ResetAll")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (Dashboard.Snapshots.Count == 0)
    {
        <EmptyState Title="@L.T("Ln_NoDevices")" Hint="@L.T("Ln_NoDevicesHint")" Icon="🏭" />
    }
    else
    {
        @* ──── 汇总 KPI 条：四态合并为两张双指标卡（运行|报警、待机|离线） ──── *@
        <section class="kpi-row">
            <div class="kpi-card dual">
                <div class="kpi-metric" title="@L.Tip("Ln_Tip_StatusCount", L.T("Status_Running"), Summary.Running)">
                    <span class="kpi-label">@L.T("Status_Running")</span>
                    <span class="kpi-value kpi-ok">@Summary.Running</span>
                </div>
                <div class="kpi-metric" title="@L.Tip("Ln_Tip_StatusCount", L.T("Status_Alarm"), Summary.Alarm)">
                    <span class="kpi-label">@L.T("Status_Alarm")</span>
                    <span class="kpi-value kpi-ng">@Summary.Alarm</span>
                </div>
            </div>
            <div class="kpi-card dual">
                <div class="kpi-metric" title="@L.Tip("Ln_Tip_StatusCount", L.T("Status_Paused"), Summary.Paused)">
                    <span class="kpi-label">@L.T("Status_Paused")</span>
                    <span class="kpi-value">@Summary.Paused</span>
                </div>
                <div class="kpi-metric" title="@L.Tip("Ln_Tip_StatusCount", L.T("Status_Offline"), Summary.Idle)">
                    <span class="kpi-label">@L.T("Status_Offline")</span>
                    <span class="kpi-value">@Summary.Idle</span>
                </div>
            </div>

            @* ──── 一键全部设备 OEE 清零：过道轮播锁定；危险写操作需输入确认词 ──── *@
            @if (!Dashboard.DisplayCarouselEnabled)
            {
            <div class="kpi-card action">
                <button class="btn btn-danger" disabled="@(!CanResetAll)" title="@L.T("K930")" @onclick="OpenResetConfirm">
                    @L.T("Pl_ResetAll")
                </button>
                <span class="kpi-sub">@L.T("Pl_ResetAllHint")</span>
            </div>
            }
            else
            {
            <div class="kpi-card action">
                <button class="btn btn-danger" disabled="true" title="@L.T("Pl_ResetAllCarouselBlocked")">
                    @L.T("Pl_ResetAll")
                </button>
                <span class="kpi-sub">@L.T("Pl_ResetAllCarouselBlocked")</span>
            </div>
            }
        </section>

        @* ──── 筛选：状态 / 搜索 / 排序 ──── *@
        <div class="filter-bar compact">
            <button class="chip-btn @(StatusFilter == 0 ? "active" : "")" @onclick="() => SetFilter(0)">@L.T("Ln_FilterAll")</button>
            <button class="chip-btn @(StatusFilter == 1 ? "active" : "")" @onclick="() => SetFilter(1)">@L.T("Status_Running")</button>
            <button class="chip-btn @(StatusFilter == 2 ? "active" : "")" @onclick="() => SetFilter(2)">@L.T("Status_Alarm")</button>
            <button class="chip-btn @(StatusFilter == 3 ? "active" : "")" @onclick="() => SetFilter(3)">@L.T("Status_Paused")</button>
            <button class="chip-btn @(StatusFilter == 4 ? "active" : "")" @onclick="() => SetFilter(4)">@L.T("Status_Offline")</button>
            <input class="filter-input line-search" type="search" value="@SearchText" @oninput="OnSearchInput" placeholder="@L.T("Ln_Search")" />
            <select class="filter-input line-sort" value="@SortBy" @onchange="OnSortChange">
                <option value="name">@L.T("Ln_SortName")</option>
                <option value="output">@L.T("Ln_SortOutput")</option>
                <option value="oee">@L.T("Ln_SortOee")</option>
            </select>
        </div>

        @if (FilteredDevices.Count == 0)
        {
            <EmptyState Title="@L.T("Ln_EmptyFilter")" Hint="" Icon="🔍" />
        }
        else
        {
            <div class="mon-grid">
                @foreach (var d in FilteredDevices)
                {
                    <div class="mon-card line-card line-device @StateClass(d.Status)"
                         role="link"
                         tabindex="0"
                         aria-label="@d.DeviceName"
                         @onclick="() => OpenDevice(d.DeviceId)"
                         @onkeydown="(e) => OnDeviceCardKey(e, d.DeviceId)">
                        <div class="dev-head">
                            <span class="dev-name">@d.DeviceName</span>
                            <span class="status-badge @StateClass(d.Status)" title="@L.Tip("Home_Tip_DeviceStatus", StateText(d))">@StateText(d)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(RecipeOf(d.DeviceId)))
                        {
                            <div class="line-recipe-name" title="@L.Tip("Home_Tip_Recipe", RecipeOf(d.DeviceId))">@RecipeOf(d.DeviceId)</div>
                        }

                        @if (d.ActiveAlarms.Count > 0)
                        {
                            var a = d.ActiveAlarms[0];
                            <div class="line-alarm">
                                <span class="lvl-dot @LevelClass(a.Level)"></span>
                                <span>@a.Name</span>
                                <span class="alarm-dur" title="@L.Tip("Home_Tip_ActiveAlarmDuration", FmtDuration((Dashboard.ServerNow - a.StartTime).TotalSeconds))">@FmtDuration((Dashboard.ServerNow - a.StartTime).TotalSeconds)</span>
                                @if (d.ActiveAlarms.Count > 1)
                                {
                                    <span class="kpi-sub" title="@L.Tip("Ln_Tip_ExtraAlarms", d.ActiveAlarms.Count - 1)">+@(d.ActiveAlarms.Count - 1)</span>
                                }
                            </div>
                        }

                        <div class="line-split">
                            <div class="line-prod">
                                <div class="mini-stat-row">
                                    <div class="mini-stat" title="@L.Tip("Ln_Tip_SessionOk", d.TotalOkProduction)">
                                        <span class="mini-stat-label">@L.T("K588")</span>
                                        <span class="mini-stat-value kpi-ok">@d.TotalOkProduction.ToString("N0")</span>
                                    </div>
                                    <div class="mini-stat" title="@L.Tip("Ln_Tip_SessionNg", d.TotalNgProduction)">
                                        <span class="mini-stat-label">@L.T("K589")</span>
                                        <span class="mini-stat-value kpi-ng">@d.TotalNgProduction.ToString("N0")</span>
                                    </div>
                                    <div class="mini-stat" title="@L.Tip("Home_Tip_TotalOutput", d.TotalOkProduction, d.TotalNgProduction, SnapshotMetrics.TotalOutput(d.TotalOkProduction, d.TotalNgProduction))">
                                        <span class="mini-stat-label">@L.T("K590")</span>
                                        <span class="mini-stat-value">@SnapshotMetrics.TotalOutput(d.TotalOkProduction, d.TotalNgProduction).ToString("N0")</span>
                                    </div>
                                </div>
                                <div class="line-aux">
                                    <div title="@L.Tip("Ln_Tip_CycleCompare", CycleText(d))">
                                        <span class="kpi-label">@L.T("Ln_Cycle")</span>
                                        <span class="kpi-value @(IsCycleSlow(d) ? "kpi-ng" : "")">@CycleText(d)</span>
                                    </div>
                                    <div title="@L.Tip("Home_Tip_RunTime", FmtDuration(d.RunTime), SnapshotMetrics.TimeRatio(d.RunTime, d.RunTime, d.AlarmTime, d.PausedTime, d.OfflineTime))">
                                        <span class="kpi-label">@L.T("K593")</span>
                                        <span class="kpi-value run">@FmtDuration(d.RunTime)</span>
                                    </div>
                                    <div title="@L.Tip("Home_Tip_AlarmTime", FmtDuration(d.AlarmTime), SnapshotMetrics.TimeRatio(d.AlarmTime, d.RunTime, d.AlarmTime, d.PausedTime, d.OfflineTime))">
                                        <span class="kpi-label">@L.T("Status_Alarm")</span>
                                        <span class="kpi-value alarm">@FmtDuration(d.AlarmTime)</span>
                                    </div>
                                    <div title="@L.Tip("Home_Tip_PausedTime", FmtDuration(d.PausedTime), SnapshotMetrics.TimeRatio(d.PausedTime, d.RunTime, d.AlarmTime, d.PausedTime, d.OfflineTime))">
                                        <span class="kpi-label">@L.T("Status_Paused")</span>
                                        <span class="kpi-value paused">@FmtDuration(d.PausedTime)</span>
                                    </div>
                                    <div title="@L.Tip("Home_Tip_OfflineTime", FmtDuration(d.OfflineTime), SnapshotMetrics.TimeRatio(d.OfflineTime, d.RunTime, d.AlarmTime, d.PausedTime, d.OfflineTime))">
                                        <span class="kpi-label">@L.T("Status_Offline")</span>
                                        <span class="kpi-value idle">@FmtDuration(d.OfflineTime)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="line-oee">
                                <div class="oee-metric" title="@OeeTip(d)">
                                    <span class="oee-metric-label">@L.T("K587")</span>
                                    <span class="oee-metric-value oee-hero @UiPalette.OeeToneClass(d.Oee)">@Pct(d.Oee)</span>
                                </div>
                                <div class="oee-metric" title="@AvailabilityTip(d)">
                                    <span class="oee-metric-label">@L.T("Lbl_Availability")</span>
                                    <span class="oee-metric-value a">@Pct(d.AvailabilityRate)</span>
                                </div>
                                <div class="oee-metric" title="@PerformanceTip(d)">
                                    <span class="oee-metric-label">@L.T("Lbl_Performance")</span>
                                    <span class="oee-metric-value p">@Pct(d.PerformanceRate)</span>
                                </div>
                                <div class="oee-metric" title="@QualityTip(d)">
                                    <span class="oee-metric-label">@L.T("Lbl_Quality")</span>
                                    <span class="oee-metric-value q">@Pct(d.QualityRate)</span>
                                </div>
                            </div>
                        </div>

                        @if (HasShiftTarget(d))
                        {
                            <div class="line-pace" title="@ShiftPaceTooltip(d)">
                                <span class="kpi-label">@L.T("Ln_ShiftPace")</span>
                                <div class="time-bar">
                                    <div class="seg shift" style="width:@ShiftPaceBarPct(d)%"></div>
                                </div>
                                <span class="kpi-value">@ShiftPaceText(d)</span>
                            </div>
                        }

                        <div class="line-open">→ @L.T("Dd_OpenRuntime")</div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private System.Threading.Timer? _renderTimer;
    private bool _disposed;

    // ──── 筛选状态 ────
    private int StatusFilter { get; set; } // 0=全部 1=运行 2=报警 3=待机 4=离线
    private string SearchText { get; set; } = "";
    private string SortBy { get; set; } = "name";

    // ──── 一键全部设备 OEE 清零状态 ────
    private bool _confirmResetOpen;
    private bool _resettingAll;
    private string? _resetNotice;
    private bool _resetNoticeIsError;
    private string _resetConfirmText = "";

    /// <summary>
    /// 断线 / 无设备 / 执行中 / 过道轮播时禁用清零入口。
    /// </summary>
    private bool CanResetAll =>
        !_resettingAll
        && !Dashboard.DisplayCarouselEnabled
        && Dashboard.IsConnected
        && Dashboard.DeviceCount > 0;

    private bool CanConfirmReset =>
        CanResetAll
        && string.Equals(_resetConfirmText.Trim(), L.T("Pl_ResetAllTypeToken"), StringComparison.Ordinal);

    private void OnResetConfirmInput(ChangeEventArgs e)
        => _resetConfirmText = e.Value?.ToString() ?? "";

    private void OpenDevice(string deviceId) => Nav.NavigateTo($"/device/{Uri.EscapeDataString(deviceId)}");

    private void OnDeviceCardKey(KeyboardEventArgs e, string deviceId)
    {
        if (e.Key is "Enter" or " ")
            OpenDevice(deviceId);
    }

    private void OpenResetConfirm()
    {
        if (!CanResetAll) return;
        _resetConfirmText = "";
        _confirmResetOpen = true;
    }

    private void CloseResetConfirm()
    {
        _confirmResetOpen = false;
        _resetConfirmText = "";
    }

    /// <summary>确认后经管理 Hub 远程清零：PLC 触发位与软件侧累计都由持有 PLC 连接的 Collector 执行。</summary>
    private async Task ConfirmResetAllAsync()
    {
        if (!CanConfirmReset) return;
        _resettingAll = true;
        try
        {
            if (!Admin.IsConnected) await Admin.ConnectAsync();
            var result = await Admin.ResetAllOeeAsync();
            _resetNotice = L.T("Pl_ResetAllOk", result.Triggered, result.Total);
            _resetNoticeIsError = false;
            _confirmResetOpen = false;
            _resetConfirmText = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "全部设备 OEE 清零失败");
            _resetNotice = L.T("Pl_ResetAllFail", ex.Message);
            _resetNoticeIsError = true;
        }
        finally
        {
            _resettingAll = false;
        }
    }

    // ──── 渲染缓存：快照每帧变化、筛选条件交互变化时置脏，避免单次渲染内重复全量计算 ────
    private LineSummary? _summaryCache;
    private List<DeviceSnapshotDto>? _filteredCache;
    private Dictionary<string, DeviceConfigDto> _deviceConfigsById = new(StringComparer.OrdinalIgnoreCase);

    private sealed class LineSummary
    {
        public int Running, Alarm, Paused, Idle;
    }

    private LineSummary Summary => _summaryCache ??= ComputeSummary();

    private LineSummary ComputeSummary()
    {
        var s = new LineSummary();
        foreach (var d in Dashboard.Snapshots)
        {
            switch (d.Status)
            {
                case DeviceStatus.Running: s.Running++; break;
                case DeviceStatus.Alarm: s.Alarm++; break;
                case DeviceStatus.Paused: s.Paused++; break;
                default: s.Idle++; break;
            }
        }
        return s;
    }

    /// <summary>筛选 + 搜索 + 排序后的设备列表（缓存：条件变化或快照刷新时置脏）。</summary>
    private List<DeviceSnapshotDto> FilteredDevices => _filteredCache ??= ComputeFilteredDevices();

    private List<DeviceSnapshotDto> ComputeFilteredDevices()
    {
        IEnumerable<DeviceSnapshotDto> list = Dashboard.Snapshots;
        if (StatusFilter > 0)
        {
            var target = StatusFilter switch
            {
                1 => DeviceStatus.Running,
                2 => DeviceStatus.Alarm,
                3 => DeviceStatus.Paused,
                _ => DeviceStatus.Offline,
            };
            list = list.Where(d => d.Status == target);
        }
        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var kw = SearchText.Trim();
            list = list.Where(d => d.DeviceName.Contains(kw, StringComparison.OrdinalIgnoreCase)
                || d.DeviceId.Contains(kw, StringComparison.OrdinalIgnoreCase));
        }
        return SortBy switch
        {
            "output" => list.OrderByDescending(d => d.TotalOkProduction + d.TotalNgProduction).ToList(),
            "oee" => list.OrderByDescending(d => d.Oee).ToList(),
            _ => list.OrderBy(d => d.DeviceName, StringComparer.OrdinalIgnoreCase).ToList(),
        };
    }

    private void SetFilter(int status)
    {
        StatusFilter = status;
        _filteredCache = null;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";
        _filteredCache = null;
    }

    private void OnSortChange(ChangeEventArgs e)
    {
        SortBy = e.Value?.ToString() ?? "name";
        _filteredCache = null;
    }

    private string RecipeOf(string deviceId)
        => _deviceConfigsById.TryGetValue(deviceId, out var config) && !string.IsNullOrWhiteSpace(config.RecipeName)
            ? config.RecipeName : "";

    /// <summary>平均节拍对比 "实际/目标s"：与 WPF LineDeviceItem / SnapshotMetrics 同口径。</summary>
    private static string CycleText(DeviceSnapshotDto d)
    {
        var target = SnapshotMetrics.CycleSeconds(d.TargetCycle);
        var real = SnapshotMetrics.AverageCycleSeconds(d.RunTime, d.TotalOkProduction, d.TotalNgProduction);
        return real > 0 && target > 0 ? $"{real:0.00}/{target:0.00}s" : "—";
    }

    private static bool IsCycleSlow(DeviceSnapshotDto d)
    {
        var target = SnapshotMetrics.CycleSeconds(d.TargetCycle);
        var real = SnapshotMetrics.AverageCycleSeconds(d.RunTime, d.TotalOkProduction, d.TotalNgProduction);
        return target > 0 && real > target;
    }

    private static string StateText(DeviceSnapshotDto d) => d.Status switch
    {
        DeviceStatus.Running => L.T("Status_Running"),
        DeviceStatus.Alarm => L.T("Status_Alarm"),
        DeviceStatus.Paused => L.T("Status_Paused"),
        _ => L.T(DeviceStatusLocKeys.For(DeviceStatus.Offline, d.OfflineCause)),
    };

    private static string StateClass(DeviceStatus status) => status switch
    {
        DeviceStatus.Running => "run",
        DeviceStatus.Alarm => "alarm",
        DeviceStatus.Paused => "paused",
        _ => "offline",
    };

    private static string LevelClass(AlarmLevel level) => level switch
    {
        AlarmLevel.High => "lvl-high",
        AlarmLevel.Medium => "lvl-medium",
        _ => "lvl-low",
    };

    // 百分比口径单源：UiPalette.Pct（P1，与 WPF 一致）
    private static string Pct(double v) => UiPalette.Pct(v);

    private static string FmtDuration(double seconds) => Kanban.Contracts.Formatting.DurationFormatter.FormatStandard(seconds);

    private static string OeeTip(DeviceSnapshotDto d)
        => L.Tip("Home_Tip_Oee", $"{Pct(d.AvailabilityRate)} × {Pct(d.PerformanceRate)} × {Pct(d.QualityRate)}", Pct(d.Oee));

    private static string AvailabilityTip(DeviceSnapshotDto d)
        => L.Tip("Home_Tip_Availability",
            d.RunTime + d.AlarmTime > 0
                ? $"{FmtDuration(d.RunTime)} / {FmtDuration(d.RunTime + d.AlarmTime)}"
                : "— / —",
            Pct(d.AvailabilityRate));

    private static string PerformanceTip(DeviceSnapshotDto d)
        => L.Tip("Home_Tip_Performance",
            d.TargetCycle > 0 && d.RunTime > 0
                ? $"{d.TotalOkProduction}+{d.TotalNgProduction} / {d.TargetCycle * (d.RunTime / 3600.0):N0}"
                : "— / —",
            Pct(d.PerformanceRate));

    private static string QualityTip(DeviceSnapshotDto d)
    {
        var total = SnapshotMetrics.TotalOutput(d.TotalOkProduction, d.TotalNgProduction);
        return L.Tip("Home_Tip_Quality",
            total > 0 ? $"{d.TotalOkProduction} / {total}" : "— / —",
            Pct(d.QualityRate));
    }

    private bool HasShiftTarget(DeviceSnapshotDto d)
        => Dashboard.ShiftProgress is { IsInShift: true, ShiftStart: not null }
           && d.TargetCycle > 0;

    private int ShiftExpectedQuantity(DeviceSnapshotDto d)
    {
        var start = Dashboard.ShiftProgress?.ShiftStart;
        if (start is null || d.TargetCycle <= 0) return 0;
        return SnapshotMetrics.ExpectedOutput(d.TargetCycle, (Dashboard.ServerNow - start.Value).TotalHours);
    }

    private double ShiftPaceRatio(DeviceSnapshotDto d)
    {
        var expected = ShiftExpectedQuantity(d);
        return expected > 0 ? (double)d.TotalOkProduction / expected : 0;
    }

    private int ShiftPaceBarPct(DeviceSnapshotDto d)
        => (int)Math.Round(Math.Clamp(ShiftPaceRatio(d), 0, 1) * 100);

    private string ShiftPaceText(DeviceSnapshotDto d)
    {
        if (!HasShiftTarget(d)) return "";
        var expected = ShiftExpectedQuantity(d);
        var ok = d.TotalOkProduction.ToString("N0");
        if (expected <= 0) return $"{ok} / —";
        return ShiftPaceRatio(d) >= 1
            ? $"{ok} / {expected:N0} · {L.T("Ln_ShiftPaceExceeded")}"
            : $"{ok} / {expected:N0} · {UiPalette.Pct(ShiftPaceRatio(d))}";
    }

    private string ShiftPaceTooltip(DeviceSnapshotDto d)
    {
        if (!HasShiftTarget(d)) return "";
        var expected = ShiftExpectedQuantity(d);
        var ok = d.TotalOkProduction.ToString("N0");
        var full = expected <= 0
            ? $"{ok} / —"
            : $"{ok} / {expected:N0} · {UiPalette.Pct(ShiftPaceRatio(d))}";
        return L.Tip("Ln_Tip_ShiftPace", full);
    }

    protected override async Task OnInitializedAsync()
    {
        await Dashboard.InitializeAsync();
        try
        {
            _deviceConfigsById = (await Dashboard.QueryDevicesAsync())
                .Where(c => !string.IsNullOrEmpty(c.Id))
                .GroupBy(c => c.Id, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "拉取设备配置失败（配方标签暂不可用，重进页面后重试）");
        }
        _renderTimer = new System.Threading.Timer(_ => _ = SafeTickAsync(), null, 3000, 3000);
    }

    /// <summary>
    /// 安全渲染 tick：Timer 回调在组件 Dispose 前后触发时，InvokeAsync 会抛 ObjectDisposedException；
    /// 该 Task 若未观察会成为 unhandledrejection → Blazor 显示全局 error UI（页面功能不受影响但横幅误报）。
    /// 仅吞掉释放竞态（ObjectDisposedException），其余异常记日志——避免真实渲染缺陷被静默吞掉导致页面停更无迹可查。
    /// </summary>
    private async Task SafeTickAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(OnRenderTick);
        }
        catch (ObjectDisposedException)
        {
            // 组件已释放的竞态：忽略（页面生命周期正常结束）
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "产线概览渲染 tick 异常");
        }
    }

    private void OnRenderTick()
    {
        if (_disposed) return;
        _summaryCache = null;    // 快照每帧变化：置脏，渲染时各重算一次
        _filteredCache = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _renderTimer?.Dispose();
        GC.SuppressFinalize(this);
    }
}
