@page "/alarms"
@implements IDisposable
@inject DashboardState Dashboard
@inject IJSRuntime JS
@inject NavigationManager Nav
@using Kanban.Contracts.Dtos
@using Kanban.Contracts.Enums
@using Kanban.Web.Services

<div class="query-page">
    @* ──────────── KPI 汇总 ──────────── *@
    <section class="kpi-row">
        @* 计数颜色状态联动：0 时中性色，非 0 才用红/绿（原恒红/恒绿，无报警也红误导） *@
        <div class="kpi-card" title="@($"{L.T("K709")}\n{ActiveCountText}")"><span class="kpi-label">@L.T("Ac_ActiveCount")</span><span class="kpi-value @(ActiveCount > 0 ? "kpi-ng" : "")">@ActiveCountText</span></div>
        <div class="kpi-card" title="@($"{L.T("K713")}\n{AffectedDeviceCountText}")"><span class="kpi-label">@L.T("Ac_AffectedDevices")</span><span class="kpi-value">@AffectedDeviceCountText</span></div>
        <div class="kpi-card" title="@($"{L.T("K710")}\n{TodayTriggerText}")"><span class="kpi-label">@L.T("Ac_TodayTrigger")</span><span class="kpi-value @(TodayTrigger > 0 ? "kpi-ng" : "")">@TodayTriggerText</span></div>
        <div class="kpi-card" title="@($"{L.T("K711")}\n{TodayRecoverText}")"><span class="kpi-label">@L.T("Ac_TodayRecover")</span><span class="kpi-value @(TodayRecover > 0 ? "kpi-ok" : "")">@TodayRecoverText</span></div>
        <div class="kpi-card" title="@($"{L.T("K712")}\n{LongestText}")"><span class="kpi-label">@L.T("Ac_Longest")</span><span class="kpi-value">@LongestText</span></div>
    </section>

    @* ──────────── 实时活跃报警 ──────────── *@
    <section class="card">
        <div class="card-title">@L.T("Ac_ActiveTitle") <span class="badge-count @(ActiveCount == 0 ? "zero" : "")">@ActiveCount</span></div>
        <div class="filter-bar compact">
            <button class="chip-btn @(ShowHigh ? "active" : "")" title="@L.T("K086")" @onclick="() => ShowHigh = !ShowHigh">@L.T("Ac_LevelHigh")</button>
            <button class="chip-btn @(ShowMedium ? "active" : "")" title="@L.T("K087")" @onclick="() => ShowMedium = !ShowMedium">@L.T("Ac_LevelMedium")</button>
            <button class="chip-btn @(ShowLow ? "active" : "")" title="@L.T("K088")" @onclick="() => ShowLow = !ShowLow">@L.T("Ac_LevelLow")</button>
            <select class="filter-input device-filter" @bind="SelectedDeviceId">
                <option value="">@L.T("Hq_AllDevices")</option>
                @foreach (var d in Dashboard.Snapshots)
                {
                    <option value="@d.DeviceId">@d.DeviceName</option>
                }
            </select>
            @if (MutedCount > 0)
            {
                <button class="chip-btn active" title="@L.T("K331")" @onclick="ClearMute">@L.T("Ac_MutedCount", MutedCount)</button>
            }
        </div>
        @if (VisibleGroupedAlarms.Count == 0)
        {
            <div class="no-data">@L.T("Val_NoAlarms")</div>
        }
        else
        {
            <div class="alarm-list">
                @foreach (var group in VisibleGroupedAlarms)
                {
                    <div class="alarm-group">
                        <div class="alarm-group-head">@group.DeviceName <span class="badge-soft">@L.T("Ac_GroupAlarms", group.Items.Count)</span></div>
                        @foreach (var a in group.Items)
                        {
                            <div class="alarm-item row-click" @onclick="() => OpenAlarmHistory(a.DeviceId, a.AlarmName, a.StartTime)">
                                <span class="lvl-dot @LevelClass(a.Level)"></span>
                                <span class="alarm-name">@a.AlarmName</span>
                                <span class="alarm-dur" title="@L.Tip("Home_Tip_ActiveAlarmDuration", FmtDuration((Dashboard.ServerNow - a.StartTime).TotalSeconds))">@FmtDuration((Dashboard.ServerNow - a.StartTime).TotalSeconds)</span>
                                <button class="icon-btn" title="@L.T("Ac_Copy")" @onclick="() => CopyAlarmAsync(a)" @onclick:stopPropagation="true">⧉</button>
                                <button class="icon-btn" title="@L.T("K330")" @onclick="() => MuteAlarm(a)" @onclick:stopPropagation="true">🔇</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </section>

    @* ──────────── 统计（排行 + 最近事件） ──────────── *@
    <section class="card">
        <div class="card-title">
            @L.T("Ac_StatsTitle")
            <select class="filter-input range-select" value="@RangeHours" @onchange="OnRangeChanged">
                <option value="1">@L.T("Ac_Range1h")</option>
                <option value="4">@L.T("Ac_Range4h")</option>
                <option value="24">@L.T("Ac_Range24h")</option>
            </select>
            @if (StatsLoading)
            {
                <span class="badge-soft">@L.T("Hq_Analyzing")</span>
            }
        </div>
        @if (StatsError is not null)
        {
            <div class="msg-banner msg-error">@StatsError</div>
        }
        else if (StatsLoaded)
        {
            <div class="chart-grid two">
                <div>
                    <div class="card-title sub">@L.T("Ac_TopTitle")</div>
                    <div class="table-scroll">
                        <table class="hq-table">
                        <thead>
                            <tr>
                                <th class="num">@L.T("Ac_Rank")</th>
                                <th>@L.T("Ac_AlarmName")</th>
                                <th>@L.T("Ac_Device")</th>
                                <th>@L.T("Ac_Level")</th>
                                <th class="num">@L.T("Ac_Count")</th>
                                <th class="num">@L.T("Ac_TotalDuration")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in TopAlarms)
                            {
                                <tr class="row-click" @onclick="() => OpenAlarmHistory(LookupDeviceId(t.DeviceName), t.AlarmName, Dashboard.ServerNow.AddHours(-RangeHours))">
                                    <td class="num">@t.Rank</td>
                                    <td>@t.AlarmName</td>
                                    <td>@t.DeviceName</td>
                                    <td><span class="lvl-dot @LevelClass(t.Level)"></span>@LevelText(t.Level)</td>
                                    <td class="num">@t.TriggerCount</td>
                                    <td class="num" title="@L.Tip("Ac_Tip_RankDuration", FmtDuration(t.TotalDurationMinutes * 60))">@FmtDuration(t.TotalDurationMinutes * 60)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
                <div>
                    <div class="card-title sub">@L.T("Ac_RecentTitle")</div>
                    <div class="table-scroll">
                        <table class="hq-table">
                        <thead>
                            <tr>
                                <th>@L.T("Hq_EventTime")</th>
                                <th>@L.T("Ac_Device")</th>
                                <th>@L.T("Ac_AlarmName")</th>
                                <th>@L.T("Hq_AlarmType")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in RecentEvents)
                            {
                                <tr class="row-click" @onclick="() => OpenAlarmHistory(e.DeviceId, e.AlarmName, e.EventTime)">
                                    <td>@e.EventTime.ToString("MM-dd HH:mm:ss")</td>
                                    <td>@e.DeviceName</td>
                                    <td>@e.AlarmName</td>
                                    <td>@AlarmAnalysis.GetEventTypeText(e.EventType, L.T)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="loading-row">@L.T("Hq_Loading")…</div>
        }
    </section>
</div>

@code {
    private const int MaxActiveAlarms = 100;
    private const int TopAlarmsCount = 10;
    private const int MaxRecentEvents = 30;

    /// <summary>设备配置缓存（报警级别查找：设备配置优先，缺失回退 Medium）。</summary>
    private List<DeviceConfigDto> _deviceConfigs = [];

    // ──────────── 实时活跃报警（快照数据源 + 3s 渲染节流） ────────────
    private bool ShowHigh { get; set; } = true;
    private bool ShowMedium { get; set; } = true;
    private bool ShowLow { get; set; } = true;
    private string SelectedDeviceId { get; set; } = "";

    private System.Threading.Timer? _renderTimer;
    private bool _disposed;

    private sealed record ActiveItem(string DeviceId, string DeviceName, string AlarmName, AlarmLevel Level, DateTime StartTime);

    private HashSet<string> _mutedKeys = new(StringComparer.Ordinal);
    private const string MuteStorageKey = "kanban.alarmMute";

    /// <summary>活跃报警缓存：仅在渲染 tick（3s）刷新，避免 AllActiveAlarms 被多个属性重复 SelectMany 物化。</summary>
    private List<ActiveItem> _allActiveAlarms = [];

    private void RefreshActiveCache()
        => _allActiveAlarms = Dashboard.Snapshots
            .SelectMany(s => s.ActiveAlarms.Select(a => new ActiveItem(s.DeviceId, s.DeviceName, a.Name, a.Level, a.StartTime)))
            .ToList();

    private bool IsLevelVisible(AlarmLevel level) => level switch
    {
        AlarmLevel.High => ShowHigh,
        AlarmLevel.Medium => ShowMedium,
        _ => ShowLow,
    };

    /// <summary>级别/设备过滤后的活跃报警（KPI 与列表共用，与 WPF 口径一致；审查修复 2026-08-15）。</summary>
    private List<ActiveItem> FilteredActiveAlarms
    {
        get
        {
            var deviceName = string.IsNullOrEmpty(SelectedDeviceId)
                ? null
                : Dashboard.GetSnapshot(SelectedDeviceId)?.DeviceName;
            return _allActiveAlarms
                .Where(a => IsLevelVisible(a.Level))
                .Where(a => deviceName is null || a.DeviceName == deviceName)
                .ToList();
        }
    }

    private List<ActiveItem> VisibleActiveAlarms => FilteredActiveAlarms
        .Where(a => !_mutedKeys.Contains(MuteKey(a.DeviceId, a.AlarmName)))
        .Take(MaxActiveAlarms)
        .ToList();

    private List<(string DeviceName, List<ActiveItem> Items)> VisibleGroupedAlarms
        => VisibleActiveAlarms
            .GroupBy(a => a.DeviceName)
            .Select(g => (g.Key, g.ToList()))
            .ToList();

    private int ActiveCount => _allActiveAlarms.Count;
    private int MutedCount => _allActiveAlarms.Count(a => _mutedKeys.Contains(MuteKey(a.DeviceId, a.AlarmName)));
    private int AffectedDeviceCount => FilteredActiveAlarms.Select(a => a.DeviceName).Distinct().Count();
    private string ActiveCountText => ActiveCount.ToString("N0");
    private string AffectedDeviceCountText => AffectedDeviceCount.ToString("N0");

    /// <summary>最长持续：过滤后最早触发的活跃报警（与 WPF 口径一致：基于过滤后列表）。</summary>
    private string LongestText
    {
        get
        {
            var filtered = FilteredActiveAlarms;
            if (filtered.Count == 0) return "—";
            var oldest = filtered.MinBy(a => a.StartTime)!;
            return $"{FmtDuration((Dashboard.ServerNow - oldest.StartTime).TotalSeconds)} · {oldest.DeviceName} · {oldest.AlarmName}";
        }
    }

    // ──────────── 统计（历史查询，范围 1/4/24h） ────────────
    private int RangeHours { get; set; } = 4;
    private bool StatsLoaded { get; set; }
    private bool StatsLoading { get; set; }
    private string? StatsError { get; set; }
    // 刷新版本守卫（审查修复 2026-08-13）：范围切换可并发触发多次 RefreshStatsAsync（首屏 +
    // 范围变更/今日 KPI 双拉取），旧响应不得覆盖新响应——只允许最新一次调用写入结果。
    private int _statsVersion;
    private int TodayTrigger { get; set; }
    private int TodayRecover { get; set; }
    private List<(int Rank, string AlarmName, string DeviceName, AlarmLevel Level, int TriggerCount, double TotalDurationMinutes)> TopAlarms { get; set; } = [];
    private List<AlarmEventRecordDto> RecentEvents { get; set; } = [];

    private string TodayTriggerText => TodayTrigger.ToString("N0");
    private string TodayRecoverText => TodayRecover.ToString("N0");

    private void OnRangeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) RangeHours = v;
        _ = RefreshStatsAsync();
    }

    private static string LevelText(AlarmLevel level) => level switch
    {
        AlarmLevel.High => L.T("Ac_LevelHigh"),
        AlarmLevel.Medium => L.T("Ac_LevelMedium"),
        _ => L.T("Ac_LevelLow"),
    };

    private static string LevelClass(AlarmLevel level) => level switch
    {
        AlarmLevel.High => "lvl-high",
        AlarmLevel.Medium => "lvl-medium",
        _ => "lvl-low",
    };

    private static string FmtDuration(double seconds) => Kanban.Contracts.Formatting.DurationFormatter.FormatStandard(seconds);

    protected override async Task OnInitializedAsync()
    {
        await Dashboard.InitializeAsync();
        try
        {
            _deviceConfigs = [.. await Dashboard.QueryDevicesAsync()];
        }
        catch (Exception)
        {
            // 配置不可用：级别回退 Medium（LookupAlarmLevel 兜底）
        }
        RefreshActiveCache(); // 首屏活跃报警缓存（后续由 3s tick 刷新）
        await LoadMuteAsync();
        _ = RefreshStatsAsync(); // 首屏统计（fire-and-forget，失败由横幅提示）
        _renderTimer = new System.Threading.Timer(_ => _ = SafeTickAsync(), null, 3000, 3000);
        await Task.CompletedTask;
    }

        /// <summary>
    /// 安全渲染 tick：Timer 回调在组件 Dispose 前后触发时，InvokeAsync 会抛 ObjectDisposedException；
    /// 该 Task 若未观察会成为 unhandledrejection → Blazor 显示全局 error UI（页面功能不受影响但横幅误报）。
    /// 统一吞掉释放竞态异常，保证任何时序下不产生未观察异常。
    /// </summary>
    private async Task SafeTickAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(OnRenderTick);
        }
        catch (Exception)
        {
            // 组件已释放的竞态：忽略（页面生命周期正常结束）
        }
    }

private void OnRenderTick()
    {
        if (_disposed) return; // Dispose 后 Timer 残留回调守卫
        RefreshActiveCache();  // 3s 刷新活跃报警缓存（快照推送后触发重渲染）
        StateHasChanged();     // 活跃报警列表 + 持续时长 3s 刷新
    }

    /// <summary>
    /// 统计刷新：单次拉取 [min(窗口起点, 今日0点), now]（Top 排行 + 最近事件 + 今日 KPI），
    /// 内存切分窗口与今日事件。事件型数据量小，与 WPF Remote 模式一致。
    /// </summary>
    private async Task RefreshStatsAsync()
    {
        var version = ++_statsVersion;
        StatsLoading = true;
        StatsError = null;
        try
        {
            // 统计窗口以工厂墙钟为准（浏览器时区可能与工厂不同）
            var now = Dashboard.ServerNow;
            var from = now.AddHours(-RangeHours);
            var todayStart = now.Date;

            // 单次拉取 [min(窗口起点, 今日0点), now]，内存切分窗口事件与今日事件（审查修复 2026-08-14，
            // 原实现每次刷新两次全量拉取，24h 范围时高度重叠）
            var (allEvents, _) = await HistoryFetch.FetchAllAsync<AlarmEventRecordDto>(
                Dashboard, HistoryQueryType.AlarmEvent, from < todayStart ? from : todayStart, now, null, null, r => r.AlarmEvents);

            var windowEvents = allEvents.Where(e => e.EventTime >= from).ToList();
            var todayEvents = allEvents.Where(e => e.EventTime >= todayStart).ToList();

            // 版本守卫：期间已有更新的刷新发起（如再次切换范围），本次结果作废
            if (version != _statsVersion) return;

            TodayTrigger = todayEvents.Count(e => e.EventType == AlarmEventType.Triggered);
            TodayRecover = todayEvents.Count(e => e.EventType == AlarmEventType.Recovered);

            // Top 排行（按触发次数降序，与 WPF 口径一致）
            var top = AlarmAnalysis.BuildTopStats(windowEvents).Take(TopAlarmsCount).ToList();
            TopAlarms = top.Select((t, i) => (
                Rank: i + 1,
                t.AlarmName,
                t.DeviceName,
                Level: LookupAlarmLevel(t.AlarmName, t.DeviceName),
                t.TriggerCount,
                t.TotalDurationMinutes)).ToList();

            RecentEvents = windowEvents.OrderByDescending(e => e.EventTime).Take(MaxRecentEvents).ToList();
            StatsLoaded = true;
        }
        catch (Exception)
        {
            if (version == _statsVersion)
                StatsError = L.T("Hq_QueryFailed");
        }
        finally
        {
            if (version == _statsVersion)
                StatsLoading = false;
        }
    }

    /// <summary>报警级别：设备配置优先，配置缺失回退 Medium（与 WPF LookupAlarmLevel 同口径）。</summary>
    private AlarmLevel LookupAlarmLevel(string alarmName, string deviceName)
    {
        try
        {
            var config = _deviceConfigs.FirstOrDefault(d => d.Name == deviceName);
            if (config is null) return AlarmLevel.Medium;
            var alarm = config.Alarms.FirstOrDefault(a => a.Name == alarmName);
            return alarm?.Level ?? AlarmLevel.Medium;
        }
        catch (Exception)
        {
            return AlarmLevel.Medium;
        }
    }

    private static string MuteKey(string deviceId, string alarmName) => $"{deviceId}|{alarmName}";

    private async Task LoadMuteAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("KanbanShell.getSession", MuteStorageKey);
            if (string.IsNullOrEmpty(raw)) return;
            _mutedKeys = raw.Split('\n', StringSplitOptions.RemoveEmptyEntries).ToHashSet(StringComparer.Ordinal);
        }
        catch (Exception)
        {
        }
    }

    private async Task PersistMuteAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("KanbanShell.setSession", MuteStorageKey, string.Join('\n', _mutedKeys));
        }
        catch (Exception)
        {
        }
    }

    private async Task MuteAlarm(ActiveItem a)
    {
        _mutedKeys.Add(MuteKey(a.DeviceId, a.AlarmName));
        await PersistMuteAsync();
    }

    private async Task ClearMute()
    {
        _mutedKeys.Clear();
        await PersistMuteAsync();
    }

    private async Task CopyAlarmAsync(ActiveItem a)
    {
        var text = $"{a.DeviceName} · {a.AlarmName} · {FmtDuration((Dashboard.ServerNow - a.StartTime).TotalSeconds)}";
        try
        {
            await JS.InvokeVoidAsync("KanbanShell.copy", text);
        }
        catch (Exception)
        {
        }
    }

    private void OpenAlarmHistory(string deviceId, string alarmName, DateTime from)
    {
        if (string.IsNullOrEmpty(deviceId)) return;
        var start = from < Dashboard.ServerNow.AddDays(-7) ? Dashboard.ServerNow.AddDays(-7) : from;
        var fromText = start.ToString("yyyy-MM-ddTHH:mm");
        var toText = Dashboard.ServerNow.ToString("yyyy-MM-ddTHH:mm");
        Nav.NavigateTo($"/history?tab=2&deviceId={Uri.EscapeDataString(deviceId)}&alarmName={Uri.EscapeDataString(alarmName)}&from={fromText}&to={toText}");
    }

    private string LookupDeviceId(string deviceName)
        => Dashboard.Snapshots.FirstOrDefault(s => s.DeviceName == deviceName)?.DeviceId
           ?? _deviceConfigs.FirstOrDefault(d => d.Name == deviceName)?.Id
           ?? "";

    public void Dispose()
    {
        _disposed = true;
        _renderTimer?.Dispose();
        GC.SuppressFinalize(this);
    }
}
