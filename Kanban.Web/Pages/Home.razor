    /// <summary>时长占比（百分比，0~100）；分母含离线，与 WPF HomeViewModel *TimeRatio 一致。</summary>
    private static double RatioPercentOf(double value, DeviceSnapshotDto? s)
        => 100.0 * SnapshotMetrics.TimeRatio(
            value, s?.RunTime ?? 0, s?.AlarmTime ?? 0, s?.PausedTime ?? 0, s?.OfflineTime ?? 0);

