@page "/"
@implements IDisposable
@inject DashboardState Dashboard
@inject IJSRuntime JS

<div class="dashboard">
    <header class="topbar">
        <div class="brand">
            <span class="brand-title">@Dashboard.Title</span>
        </div>
        <div class="conn-badge @(Dashboard.IsConnected ? "conn-ok" : "conn-bad")">
            <span class="dot"></span>
            @(Dashboard.IsConnected ? L.T("Conn_Live") : L.T("Conn_Disconnected"))
        </div>
        @* 无设备数据时隐藏选择器：避免渲染一个空白下拉框与下方空状态卡片并存、让用户困惑 *@
        @if (Dashboard.Snapshots.Count > 0)
        {
            <select class="device-select" value="@_selectedDeviceId" @onchange="OnDeviceSelected">
                @foreach (var dev in Dashboard.Snapshots)
                {
                    <option value="@dev.DeviceId">@dev.DeviceName</option>
                }
            </select>
        }
    </header>

    @* 全局连接横幅：断连(红) / 数据停滞(黄，连接正常但采集链路卡死) / 正常不显示。
       与 WPF MainWindow 横幅三态对齐（IsPlcConnecting 态 Web 端无，故只区分断连与停滞）。 *@
    @if (!Dashboard.IsConnected)
    {
        <div class="conn-banner">@L.T("ConnLost")</div>
    }
    else if (Dashboard.IsDataStale)
    {
        <div class="conn-banner warn">@L.T("ConnStale", Dashboard.DataStaleSeconds)</div>
    }

    @if (Dashboard.Snapshots.Count == 0)
    {
        <EmptyState Title="@(Dashboard.IsConnected ? L.T("Msg_NoDeviceData") : L.T("Msg_WaitingConn"))"
                    Hint="@L.T("Msg_EmptyHint")"
                    Icon="@(Dashboard.IsConnected ? "📋" : "🔌")" />
    }
    else
    {
        <div class="summary-bar">
            <span class="sum-item run"><span class="dot"></span>@L.T("Status_Running") <b>@Dashboard.StatusSummary.Running</b></span>
            <span class="sum-item alarm"><span class="dot"></span>@L.T("Status_Alarm") <b>@Dashboard.StatusSummary.Alarm</b></span>
            <span class="sum-item paused"><span class="dot"></span>@L.T("Status_Paused") <b>@Dashboard.StatusSummary.Paused</b></span>
            <span class="sum-item offline"><span class="dot"></span>@L.T("Status_Offline") <b>@Dashboard.StatusSummary.Idle</b></span>
            <span class="sum-item">@L.T("Card_DevCount") <b>@Dashboard.DeviceCount</b></span>
        </div>
    }

    @if (SelectedSnapshot is null)
    {
        <EmptyState Title="@L.T("Msg_NoDevSelected")"
                    Hint="@L.T("Msg_SelectHint")"
                    Icon="🖱️" />
    }
    else
    {
        <main class="grid">
            <section class="card">
                <div class="card-title">@L.T("Card_DevStatus")</div>
                <div class="dev-head">
                    <span class="dev-name">@SelectedSnapshot.DeviceName</span>
                    <span class="status-badge @Status.Class">@Status.Text</span>
                </div>
                <div class="duration-row">
                    <div title="@RunTimeTooltip"><span class="kpi-label">@L.T("Status_Running")</span><span class="kpi-value run">@FmtDuration(SelectedSnapshot.RunTime)</span><span class="ratio-hint">@PctRatio(RunRatio)</span></div>
                    <div title="@AlarmTimeTooltip"><span class="kpi-label">@L.T("Status_Alarm")</span><span class="kpi-value alarm">@FmtDuration(SelectedSnapshot.AlarmTime)</span><span class="ratio-hint">@PctRatio(AlarmRatio)</span></div>
                    <div title="@PausedTimeTooltip"><span class="kpi-label">@L.T("Status_Paused")</span><span class="kpi-value paused">@FmtDuration(SelectedSnapshot.PausedTime)</span><span class="ratio-hint">@PctRatio(PauseRatio)</span></div>
                    <div title="@OfflineTimeTooltip"><span class="kpi-label">@L.T("Status_Offline")</span><span class="kpi-value idle">@FmtDuration(SelectedSnapshot.OfflineTime)</span><span class="ratio-hint">@PctRatio(OfflineRatio)</span></div>
                </div>
                <div class="time-bar">
                    <div class="seg run" style="width:@RunRatio%"></div>
                    <div class="seg alarm" style="width:@AlarmRatio%"></div>
                    <div class="seg paused" style="width:@PauseRatio%"></div>
                    <div class="seg offline" style="width:@OfflineRatio%"></div>
                </div>
                <div class="device-kpi-row" title="@TargetCycleTooltip">
                    <span class="kpi-label">@L.T("Lbl_TargetCycle")</span>
                    <span class="kpi-value">@TargetCycleText</span>
                </div>
                <div class="device-kpi-row" title="@ActualCycleTooltip">
                    <span class="kpi-label">@L.T("Lbl_ActualCycle")</span>
                    <span class="kpi-value">@ActualCycleText</span>
                    @if (!string.IsNullOrEmpty(CycleDiffText))
                    {
                        <span class="cycle-diff @(IsCycleSlow ? "slow" : "ok")">@CycleDiffText</span>
                    }
                </div>
                <div class="meta-line">@L.T("Hq_StatusWord") 0x@(SelectedSnapshot.StatusWord.ToString("X4"))</div>
                @if (!string.IsNullOrEmpty(SelectedSnapshot.RecipeName))
                {
                    <div class="meta-line">@L.T("RecipeInfo", SelectedSnapshot.RecipeName, SelectedSnapshot.RecipeValue)</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_ProdStatus")</div>
                @if (CurrentWorkOrder is not null)
                {
                    <div class="wo-progress-hero" title="@WorkOrderProgressTooltip">
                        <div class="wo-progress-head">
                            <span class="wo-order">@CurrentWorkOrder.OrderNo</span>
                            <span class="wo-product-inline">@CurrentWorkOrder.ProductCode</span>
                        </div>
                        <div class="wo-progress-main">
                            <div class="wo-progress-meta">
                                <span class="wo-progress-text">@WoProgressText</span>
                            </div>
                            <span class="wo-progress-pct @WoProgressPctClass">@WoProgressPctText</span>
                        </div>
                        <div class="time-bar wo-progress-bar">
                            <div class="seg wo @WoProgressPctClass" style="width:@WoProgressRatio%"></div>
                        </div>
                    </div>
                    <div class="metric-grid wo-kpi-grid">
                        <div title="@WorkOrderTargetTooltip"><span class="kpi-label">@L.T("K326")</span><span class="kpi-value">@CurrentWorkOrder.TargetQuantity.ToString("N0")</span></div>
                        <div title="@WorkOrderOkTooltip"><span class="kpi-label">@L.T("K327")</span><span class="kpi-value">@WorkOrderOkText</span></div>
                        <div title="@WorkOrderNgTooltip"><span class="kpi-label">@L.T("Home_WorkOrderNg")</span><span class="kpi-value danger">@WorkOrderNgText</span></div>
                        <div title="@WorkOrderQualityTooltip"><span class="kpi-label">@L.T("Home_WorkOrderQuality")</span><span class="@WorkOrderQualityCssClass">@WorkOrderQualityText</span></div>
                    </div>
                }
                <div class="big-number" title="@RealtimeSpeedTooltip">@RealtimeSpeedText</div>
                <div class="big-label">@L.T("Lbl_RealTimeSpeed")</div>
                <div class="metric-grid">
                    <div title="@TotalOutputTooltip"><span class="kpi-label">@L.T("Lbl_TotalOutput")</span><span class="kpi-value">@TotalOutputText</span></div>
                    <div title="@NgRateTooltip"><span class="kpi-label">@L.T("Lbl_NgRate")</span><span class="@NgRateCssClass">@NgRateText</span></div>
                </div>
                <div class="speed-meter" title="@SpeedAchievementTooltip">
                    <div class="meter-track"><div class="meter-fill" style="width:@(SpeedAchievementRate * 100)%"></div></div>
                    <span class="meter-text">@L.T("Lbl_Achievement") @SpeedAchievementRateText</span>
                </div>
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Alarms") <span class="badge-count @(SelectedSnapshot.ActiveAlarms.Count == 0 ? "zero" : "")">@SelectedSnapshot.ActiveAlarms.Count</span></div>
                @if (SelectedSnapshot.ActiveAlarms.Count == 0)
                {
                    <div class="no-data">@L.T("Val_NoAlarms")</div>
                }
                else
                {
                    <div class="alarm-list">
                        @foreach (var a in SelectedSnapshot.ActiveAlarms)
                        {
                            <div class="alarm-item">
                                <span class="lvl-dot @LevelClass(a.Level)"></span>
                                <span class="alarm-name">@a.Name</span>
                                <span class="alarm-dur">@FmtDuration((Dashboard.ServerNow - a.StartTime).TotalSeconds)</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="card">
                <div class="card-title oee-title">
                    <span>@L.T("Card_Oee")</span>
                    @if (DeviceHealthScore > 0)
                    {
                        <span class="oee-health" title="@DeviceHealthTooltip">
                            @L.T("Rv_Health") <b class="@DeviceHealthCssClass">@DeviceHealthScoreText</b>
                            <span class="health-level @DeviceHealthCssClass">@DeviceHealthLevel</span>
                        </span>
                    }
                </div>
                <div class="ring-row">
                    <Ring Value="@SelectedSnapshot.Oee" ValueText="@Pct(SelectedSnapshot.Oee)" Label="OEE" Color="@UiPalette.Oee" HasData="@HasActiveWorkOrder" Title="@OeeTooltip" />
                    <Ring Value="@SelectedSnapshot.AvailabilityRate" ValueText="@Pct(SelectedSnapshot.AvailabilityRate)" Label="@L.T("Lbl_Availability")" Color="@UiPalette.Availability" HasData="@HasActiveWorkOrder" Title="@AvailabilityTooltip" />
                    <Ring Value="@SelectedSnapshot.PerformanceRate" ValueText="@Pct(SelectedSnapshot.PerformanceRate)" Label="@L.T("Lbl_Performance")" Color="@UiPalette.Performance" HasData="@HasActiveWorkOrder" Title="@PerformanceTooltip" />
                    <Ring Value="@SelectedSnapshot.QualityRate" ValueText="@Pct(SelectedSnapshot.QualityRate)" Label="@L.T("Lbl_Quality")" Color="@UiPalette.Quality" HasData="@HasActiveWorkOrder" Title="@QualityTooltip" />
                </div>
                <div class="oee-formula">@(HasActiveWorkOrder ? $"{Pct(SelectedSnapshot.AvailabilityRate)} × {Pct(SelectedSnapshot.PerformanceRate)} × {Pct(SelectedSnapshot.QualityRate)}" : "—")</div>
            </section>

            <section class="card">
                <div class="card-title">@L.T("DefectTop")</div>
                <div class="defect-sub">@L.T("Hp_DefectSubtitle")</div>
                @if (DefectEmptyKind == DefectParetoEmptyKind.HasData)
                {
                    <div class="defect-summary">
                        <span>@L.T("Hp_DefectSummary", DefectTotalCount)</span>
                        @if (DefectNgShare is { } ngShare)
                        {
                            <span>@L.T("Hp_DefectShareNg", ngShare)</span>
                        }
                    </div>
                    <div class="defect-list">
                        @foreach (var d in DefectTop)
                        {
                            var barPct = DefectBarPercent(d);
                            var fillClass = d.IsOthers ? "other" : DefectFillClass(d.Severity);
                            var displayName = d.IsOthers ? L.T("Hp_DefectOthers", d.OtherKindCount) : d.Name;
                            <div class="defect-row @(d.IsVitalFew ? "vital" : "")" title="@DefectTooltip(d, displayName)">
                                <span class="defect-rank">@(d.Rank > 0 ? d.Rank.ToString() : "")</span>
                                <div class="defect-main">
                                    <div class="defect-head">
                                        <span class="defect-name">@displayName</span>
                                        <span class="defect-count">@d.Count.ToString("N0")</span>
                                    </div>
                                    <div class="defect-barline">
                                        <div class="defect-track"><div class="defect-fill @fillClass" style="width:@barPct.ToString("F1")%"></div></div>
                                        <span class="defect-share">@Pct(DefectItemShare(d))</span>
                                        <span class="defect-cumul @(d.IsVitalFew ? "vital" : "")">@L.T("Hp_DefectCumulative", d.CumulativeShare > 0 ? d.CumulativeShare : DefectItemShare(d))</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (DefectEmptyKind == DefectParetoEmptyKind.NotConfigured)
                {
                    <div class="no-data">@L.T("Hp_DefectEmptyUnconfigured")</div>
                    <div class="no-data-hint">@L.T("Hp_DefectEmptyUnconfiguredHint")</div>
                }
                else if (DefectEmptyKind == DefectParetoEmptyKind.AllZero)
                {
                    <div class="no-data">@L.T("Hp_DefectEmptyZero")</div>
                    <div class="no-data-hint">@L.T("Hp_DefectEmptyZeroHint")</div>
                }
                else
                {
                    <div class="no-data">@L.T("NoDefectData")</div>
                }
            </section>

            <section class="card">
                <div class="card-title">
                    @L.T("K328")
                    <span class="quality-live @QualityCssClass" title="@QualityTooltip">@QualityLiveText</span>
                    <span class="quality-gap @QualityCssClass" title="@QualityGapTooltip">@QualityGapText</span>
                </div>
                <div class="quality-chart" title="@L.T("Home_Tip_QualityTrend")">
                    @if (QualityHistory.Count == 0)
                    {
                        <div class="no-data">@L.T("Val_WaitData")</div>
                    }
                    else
                    {
                        <svg class="spark spark-quality" viewBox="0 0 300 80" preserveAspectRatio="none">
                            <line x1="0" y1="@QualityTargetY" x2="300" y2="@QualityTargetY" fill="none" stroke="#F87171" stroke-width="1" stroke-dasharray="4 3" />
                            @if (QualityPointsText is not null)
                            {
                                <polyline points="@QualityPointsText" fill="none" stroke="#34D399" stroke-width="1.8" />
                            }
                        </svg>
                    }
                </div>
                <div class="quality-row quality-row-compact">
                    <div class="quality-block" title="@TotalOutputTooltip">
                        <div class="quality-num ok">@SelectedSnapshot.TotalOkProduction.ToString("N0")</div>
                        <div class="quality-label">@L.T("Lbl_Ok")</div>
                    </div>
                    <div class="quality-block" title="@NgRateTooltip">
                        <div class="quality-num ng">@SelectedSnapshot.TotalNgProduction.ToString("N0")</div>
                        <div class="quality-label">@L.T("Lbl_Ng")</div>
                    </div>
                </div>
                <div class="meta-line" title="@QualityTooltip">@L.T("Meta_QualityRate", Pct(SelectedSnapshot.QualityRate), NgRateText)</div>
                @if (LastShift is not null)
                {
                    <div class="meta-line" title="@LastShiftTooltip">@L.T("LastShiftLine", LastShift.ShiftName, LastShift.Ok.ToString("N0"), FmtDiff(SelectedSnapshot.TotalOkProduction - LastShift.Ok), LastShift.Ng.ToString("N0"), FmtDiff(SelectedSnapshot.TotalNgProduction - LastShift.Ng))</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_WorkOrder")</div>
                @if (CurrentWorkOrder is null)
                {
                    <div class="no-data">@L.T("Val_NoWorkOrder")</div>
                }
                else
                {
                    <div class="dev-head">
                        <span class="dev-name">@CurrentWorkOrder.OrderNo</span>
                        <span class="status-badge @WoStatusClass">@WoStatusText</span>
                    </div>
                    <div class="wo-product">@CurrentWorkOrder.ProductCode · @CurrentWorkOrder.ProductName</div>
                    <div class="wo-progress-text" title="@WorkOrderProgressTooltip">@WoProgressText</div>
                    <div class="time-bar">
                        <div class="seg wo" style="width:@WoProgressRatio%"></div>
                    </div>
                    <div class="meta-line" title="@WorkOrderTargetTooltip">@L.T("Meta_PlanWo", CurrentWorkOrder.TargetQuantity.ToString("N0"))</div>
                    <div class="meta-line" title="@WorkOrderNgTooltip">@L.T("Home_WorkOrderNg") @WorkOrderNgText</div>
                    <div class="meta-line" title="@WorkOrderQualityTooltip">@L.T("Home_WorkOrderQuality") @WorkOrderQualityText</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Trend") <span class="badge-soft">@L.T("Badge_Recent1Min")</span></div>
                @if (SpeedPointsText is null)
                {
                    <div class="no-data">@L.T("Val_WaitData")</div>
                }
                else
                {
                    <svg class="spark" viewBox="0 0 300 64" preserveAspectRatio="none">
                        <polyline points="@SpeedPointsText" fill="none" stroke="#34D399" stroke-width="1.5" />
                    </svg>
                    <div class="meta-line">@L.T("Meta_TrendCurrent", RealtimeSpeedText)</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Shift")</div>
                @if (Dashboard.ShiftProgress is null)
                {
                    <div class="no-data">@L.T("Val_NoData")</div>
                }
                else
                {
                    <div class="dev-head">
                        <span class="dev-name">@Dashboard.ShiftProgress.Name</span>
                        <span class="kpi-value">@Dashboard.ShiftProgress.Pct</span>
                    </div>
                    <div class="time-bar">
                        <div class="seg shift" style="width:@(Dashboard.ShiftProgress.Ratio * 100)%"></div>
                    </div>
                    <div class="duration-row">
                        <div><span class="kpi-label">@L.T("Lbl_Elapsed")</span><span class="kpi-value">@Dashboard.ShiftProgress.ElapsedText</span></div>
                        <div><span class="kpi-label">@L.T("Lbl_Remaining")</span><span class="kpi-value">@Dashboard.ShiftProgress.RemainingText</span></div>
                    </div>
                    <div class="meta-line">@L.T("Meta_ShiftAuto")</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Source")</div>
                <div class="info-list">
                    <div><span class="kpi-label">@L.T("Lbl_ConnStatus")</span><span class="kpi-value">@(Dashboard.IsConnected ? L.T("Conn_Connected") : L.T("Conn_Disconnected"))</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_DevTotal")</span><span class="kpi-value">@Dashboard.DeviceCount</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_DataFresh")</span><span class="kpi-value">@FreshnessText</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_SnapSeq")</span><span class="kpi-value">#@SelectedSnapshot.Seq</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_SvcAddr")</span><span class="kpi-value mono">@L.T("Val_DynAddr")</span></div>
                    @if (!string.IsNullOrEmpty(Dashboard.ServerVersion))
                    {
                        <div><span class="kpi-label">@L.T("Lbl_SvcVersion")</span><span class="kpi-value mono">@Dashboard.ServerVersion</span></div>
                    }
                </div>
            </section>
        </main>
    }
</div>

@code {
    /// <summary>
    /// 当前选中设备 id（只读暴露给模板）。持久化与兜底修正见 <see cref="SelectedDeviceId"/> setter 与 <see cref="EnsureSelectedDevice"/>。
    /// </summary>
    private string? _selectedDeviceId;
    private System.Threading.Timer? _renderTimer;
    private bool _disposed;

    private const string DevicePreferenceKey = "kanban.selected-device";

    /// <summary>用户切换设备或兜底回退时写入，并同步 localStorage。</summary>
    private string? SelectedDeviceId
    {
        get => _selectedDeviceId;
        set
        {
            if (string.IsNullOrEmpty(value))
                value = null;
            if (_selectedDeviceId == value)
                return;

            _selectedDeviceId = value;
            if (value is null)
                _ = JS.InvokeVoidAsync("localStorage.removeItem", DevicePreferenceKey);
            else
                _ = JS.InvokeVoidAsync("localStorage.setItem", DevicePreferenceKey, value);
        }
    }

    private void OnDeviceSelected(ChangeEventArgs e)
        => SelectedDeviceId = e.Value?.ToString();

    /// <summary>
    /// 快照列表变化后校正选中项：无效或空选时回退第一台，并走 setter 以同步 localStorage。
    /// 不在 getter 内写回，避免与 @bind / localStorage 恢复打架。
    /// </summary>
    private void EnsureSelectedDevice()
    {
        var snaps = Dashboard.Snapshots;
        if (snaps.Count == 0)
            return;

        if (_selectedDeviceId is not null && snaps.Any(s => s.DeviceId == _selectedDeviceId))
            return;

        SelectedDeviceId = snaps[0].DeviceId;
    }

    private DeviceSnapshotDto? SelectedSnapshot
        => SelectedDeviceId is null ? null : Dashboard.GetSnapshot(SelectedDeviceId);

    /// <summary>当前选中设备的工单（Collector 5s 推送缓存，切换设备即时取用）。</summary>
    private WorkOrderDto? CurrentWorkOrder => Dashboard.GetWorkOrder(SelectedDeviceId);

    /// <summary>有在制工单才显示 OEE 四环数值；无工单显示 "—"（等待投产语义，避免与真实 0% 混淆）。</summary>
    private bool HasActiveWorkOrder => CurrentWorkOrder is not null;

    /// <summary>当前选中设备的缺陷帕累托行（Meta 5s 推送；无数据返回空列表）。</summary>
    private IReadOnlyList<DeviceDefectCountDto> DefectTop
        => SelectedDeviceId is null ? [] : Dashboard.GetDefectTop(SelectedDeviceId);

    private DeviceDefectSummaryDto? DefectSummary
        => SelectedDeviceId is null ? null : Dashboard.GetDefectSummary(SelectedDeviceId);

    private DefectParetoEmptyKind DefectEmptyKind
        => DefectSummary?.EmptyKind
           ?? (DefectTop.Count > 0 ? DefectParetoEmptyKind.HasData : DefectParetoEmptyKind.NoDevice);

    private int DefectTotalCount
        => DefectSummary?.TotalCount ?? DefectTop.Sum(x => x.Count);

    private double? DefectNgShare
    {
        get
        {
            var ng = SelectedSnapshot?.TotalNgProduction ?? 0;
            var total = DefectTotalCount;
            if (ng <= 0 || total <= 0) return null;
            return (double)total / ng;
        }
    }

    /// <summary>当前选中设备的上一班次汇总（Meta 5s 推送；无缓存返回 null）。</summary>
    private DeviceShiftSummaryDto? LastShift
        => SelectedDeviceId is null ? null : Dashboard.GetLastShift(SelectedDeviceId);

    /// <summary>产量差文本（对齐 WPF FormatHelper.FormatDiff 零值语义：+N / -N / 0→空）。</summary>
    private static string FmtDiff(int diff) => diff switch
    {
        > 0 => $"+{diff:N0}",
        < 0 => diff.ToString("N0"),
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        // 恢复上次选中的设备（localStorage 持久化）
        try
        {
            _selectedDeviceId = await JS.InvokeAsync<string?>("localStorage.getItem", DevicePreferenceKey);
        }
        catch (Exception)
        {
            // localStorage 不可用（隐私模式等）时静默忽略，回退默认第一台
        }

        EnsureSelectedDevice();
        Dashboard.StateChanged += OnDashboardStateChanged;
        _ = Dashboard.InitializeAsync(); // 连接 Collector（失败由定时器自动重试）
        // 渲染节流：2s 统一重渲染（推送 500ms 只更新内存，避免 render tree 高频 diff）
        _renderTimer = new System.Threading.Timer(_ => _ = SafeTickAsync(), null, 2000, 2000);
        await Task.CompletedTask;
    }

    /// <summary>渲染 tick：2s 统一重渲染（工单/班次由 Collector 推送，无需轮询）。</summary>
        /// <summary>
    /// 安全渲染 tick：Timer 回调在组件 Dispose 前后触发时，InvokeAsync 会抛 ObjectDisposedException；
    /// 该 Task 若未观察会成为 unhandledrejection → Blazor 显示全局 error UI（页面功能不受影响但横幅误报）。
    /// 统一吞掉释放竞态异常，保证任何时序下不产生未观察异常。
    /// </summary>
    private async Task SafeTickAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(OnRenderTick);
        }
        catch (Exception)
        {
            // 组件已释放的竞态：忽略（页面生命周期正常结束）
        }
    }

private void OnRenderTick()
    {
        if (_disposed) return;
        EnsureSelectedDevice();
        Dashboard.RequestWorkOrderProductionRefresh(SelectedDeviceId);
        StateHasChanged();
    }

    private void OnDashboardStateChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            EnsureSelectedDevice();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Dashboard.StateChanged -= OnDashboardStateChanged;
        _renderTimer?.Dispose();
        GC.SuppressFinalize(this);
    }

