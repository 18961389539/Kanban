            var diff = ActualCycleSec - TargetCycleSec;
            if (Math.Abs(diff) < 0.01) return "●";
            return diff > 0 ? $"▼ {diff:F2}s" : $"▲ {Math.Abs(diff):F2}s";
        }
    }
