    /// <summary>速度趋势 sparkline 坐标串（最近 1 分钟，viewBox 300x64）。</summary>
    private string? SpeedPointsText
    {
        get
        {
            var pts = Dashboard.GetSpeedHistory(SelectedSnapshot?.DeviceId ?? "");
            if (pts.Count < 2) return null;
            var max = Math.Max(pts.Max(p => p.Speed), 1);
            var min = pts.Min(p => p.Speed);
            var range = Math.Max(max - min, max * 0.1); // 区间过小时放大避免直线
            return string.Join(" ", pts.Select((p, i) =>
            {
                var x = (double)i / (pts.Count - 1) * 300;
                var y = 56 - (p.Speed - min) / range * 48;
                return $"{x:F0},{y:F0}";
            }));
        }
    }

    private IReadOnlyList<QualityPoint> QualityHistory
        => Dashboard.GetQualityHistory(SelectedSnapshot?.DeviceId ?? "");

    private const double QualityTarget = 0.95;

    private string QualityLiveText
        => SelectedSnapshot is null || TotalOutput <= 0 ? "—" : Pct(SelectedSnapshot.QualityRate);

    private string QualityGapText
        => SelectedSnapshot is null || TotalOutput <= 0
            ? "—"
            : $"{SelectedSnapshot.QualityRate - QualityTarget:+#0.0%;-#0.0%;+0.0%}";

    private string QualityCssClass
        => SelectedSnapshot is null || TotalOutput <= 0 ? ""
        : SelectedSnapshot.QualityRate >= QualityTarget ? "good" : "bad";

    private string QualityGapTooltip
        => Tip("Home_Tip_QualityGap", QualityLiveText, QualityGapText);

    private (double YMin, double Range) QualityScale
    {
        get
        {
            var pts = QualityHistory;
            if (pts.Count == 0) return (0.87, 0.13);
            var minQ = pts.Min(p => p.Quality);
            var yMin = Math.Clamp(Math.Min(QualityTarget - 0.08, minQ - 0.04), 0, 0.98);
            return (yMin, Math.Max(1 - yMin, 0.02));
        }
    }

    private string QualityTargetY
    {
        get
        {
            var (yMin, range) = QualityScale;
            var y = 72 - (QualityTarget - yMin) / range * 64;
            return y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private bool TryGetQualityAxisWindow(out DateTime axisStart, out DateTime axisEnd)
    {
        axisStart = default;
        axisEnd = default;
        var sp = Dashboard.ShiftProgress;
        if (sp is { IsInShift: true, ShiftStart: not null, ShiftEnd: not null })
        {
            axisStart = sp.ShiftStart.Value;
            axisEnd = sp.ShiftEnd.Value;
            if (axisEnd <= axisStart)
                axisEnd = axisStart.AddMinutes(1);
            return true;
        }

        var pts = QualityHistory;
        if (pts.Count == 0)
            return false;
        axisStart = pts[0].Time;
        axisEnd = pts.Count >= 2 ? pts[^1].Time : pts[0].Time.AddMinutes(1);
        if (axisEnd <= axisStart)
            axisEnd = axisStart.AddMinutes(1);
        return true;
    }

    private static double MapQualityX(DateTime time, DateTime axisStart, DateTime axisEnd)
    {
        var span = (axisEnd - axisStart).TotalSeconds;
        if (span <= 0) return 0;
        return Math.Clamp((time - axisStart).TotalSeconds / span * 300, 0, 300);
    }

    /// <summary>当前班次良率 sparkline（viewBox 300x80）。横轴对齐整班时段；单点时只画达标线，等第二点再连线。</summary>
    private string? QualityPointsText
    {
        get
        {
            var pts = QualityHistory;
            if (pts.Count < 2 || !TryGetQualityAxisWindow(out var axisStart, out var axisEnd))
                return null;
            var (yMin, range) = QualityScale;
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            return string.Join(" ", pts.Select(p =>
            {
                var x = MapQualityX(p.Time, axisStart, axisEnd);
                var y = 72 - (p.Quality - yMin) / range * 64;
                return x.ToString("F0", inv) + "," + y.ToString("F0", inv);
            }));
        }
    }

