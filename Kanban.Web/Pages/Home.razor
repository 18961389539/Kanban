@page "/"
@implements IDisposable
@inject DashboardState Dashboard
@inject IJSRuntime JS

<div class="dashboard">
    <header class="topbar">
        <div class="brand">
            <span class="brand-title">@Dashboard.Title</span>
        </div>
        <div class="conn-badge @(Dashboard.IsConnected ? "conn-ok" : "conn-bad")">
            <span class="dot"></span>
            @(Dashboard.IsConnected ? L.T("Conn_Live") : L.T("Conn_Disconnected"))
        </div>
        @* 无设备数据时隐藏选择器：避免渲染一个空白下拉框与下方空状态卡片并存、让用户困惑 *@
        @if (Dashboard.Snapshots.Count > 0)
        {
            <select class="device-select" value="@_selectedDeviceId" @onchange="OnDeviceSelected">
                @foreach (var dev in Dashboard.Snapshots)
                {
                    <option value="@dev.DeviceId">@dev.DeviceName</option>
                }
            </select>
        }
    </header>

    @* 全局连接横幅：断连(红) / 数据停滞(黄，连接正常但采集链路卡死) / 正常不显示。
       与 WPF MainWindow 横幅三态对齐（IsPlcConnecting 态 Web 端无，故只区分断连与停滞）。 *@
    @if (!Dashboard.IsConnected)
    {
        <div class="conn-banner">@L.T("ConnLost")</div>
    }
    else if (Dashboard.IsDataStale)
    {
        <div class="conn-banner warn">@L.T("ConnStale", Dashboard.DataStaleSeconds)</div>
    }

    @if (Dashboard.Snapshots.Count == 0)
    {
        <EmptyState Title="@(Dashboard.IsConnected ? L.T("Msg_NoDeviceData") : L.T("Msg_WaitingConn"))"
                    Hint="@L.T("Msg_EmptyHint")"
                    Icon="@(Dashboard.IsConnected ? "📋" : "🔌")" />
    }
    else
    {
        <div class="summary-bar">
            <span class="sum-item run"><span class="dot"></span>@L.T("Status_Running") <b>@Dashboard.StatusSummary.Running</b></span>
            <span class="sum-item alarm"><span class="dot"></span>@L.T("Status_Alarm") <b>@Dashboard.StatusSummary.Alarm</b></span>
            <span class="sum-item paused"><span class="dot"></span>@L.T("Status_Paused") <b>@Dashboard.StatusSummary.Paused</b></span>
            <span class="sum-item idle"><span class="dot"></span>@L.T("Status_Idle") <b>@Dashboard.StatusSummary.Idle</b></span>
            <span class="sum-item">@L.T("Card_DevCount") <b>@Dashboard.DeviceCount</b></span>
        </div>
    }

    @if (SelectedSnapshot is null)
    {
        <EmptyState Title="@L.T("Msg_NoDevSelected")"
                    Hint="@L.T("Msg_SelectHint")"
                    Icon="🖱️" />
    }
    else
    {
        <main class="grid">
            <section class="card">
                <div class="card-title">@L.T("Card_DevStatus")</div>
                <div class="dev-head">
                    <span class="dev-name">@SelectedSnapshot.DeviceName</span>
                    <span class="status-badge @Status.Class">@Status.Text</span>
                </div>
                <div class="duration-row">
                    <div><span class="kpi-label">@L.T("Status_Running")</span><span class="kpi-value run">@FmtDuration(SelectedSnapshot.RunTime)</span></div>
                    <div><span class="kpi-label">@L.T("Status_Alarm")</span><span class="kpi-value alarm">@FmtDuration(SelectedSnapshot.AlarmTime)</span></div>
                    <div><span class="kpi-label">@L.T("Status_Paused")</span><span class="kpi-value paused">@FmtDuration(SelectedSnapshot.PausedTime)</span></div>
                </div>
                <div class="time-bar">
                    <div class="seg run" style="width:@RunRatio%"></div>
                    <div class="seg alarm" style="width:@AlarmRatio%"></div>
                    <div class="seg paused" style="width:@PauseRatio%"></div>
                </div>
                <div class="meta-line">@L.T("Meta_StatusWord", SelectedSnapshot.StatusWord.ToString("X4"), SelectedSnapshot.TargetCycle)</div>
                @if (!string.IsNullOrEmpty(SelectedSnapshot.RecipeName))
                {
                    <div class="meta-line">@L.T("RecipeInfo", SelectedSnapshot.RecipeName, SelectedSnapshot.RecipeValue)</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_ProdStatus")</div>
                <div class="big-number">@RealtimeSpeedText</div>
                <div class="big-label">@L.T("Lbl_RealTimeSpeed")</div>
                <div class="metric-grid">
                    <div><span class="kpi-label">@L.T("Lbl_TargetCycle")</span><span class="kpi-value">@TargetCycleText</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_ActualCycle")</span><span class="kpi-value">@ActualCycleText</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_TotalOutput")</span><span class="kpi-value">@TotalOutputText</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_NgRate")</span><span class="@NgRateCssClass">@NgRateText</span></div>
                </div>
                <div class="speed-meter">
                    <div class="meter-track"><div class="meter-fill" style="width:@(SpeedAchievementRate * 100)%"></div></div>
                    <span class="meter-text">@L.T("Lbl_Achievement") @SpeedAchievementRateText</span>
                </div>
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Alarms") <span class="badge-count">@SelectedSnapshot.ActiveAlarms.Count</span></div>
                @if (SelectedSnapshot.ActiveAlarms.Count == 0)
                {
                    <div class="no-data">@L.T("Val_NoAlarms")</div>
                }
                else
                {
                    <div class="alarm-list">
                        @foreach (var a in SelectedSnapshot.ActiveAlarms)
                        {
                            <div class="alarm-item">
                                <span class="lvl-dot @LevelClass(a.Level)"></span>
                                <span class="alarm-name">@a.Name</span>
                                <span class="alarm-dur">@FmtDuration((DateTime.Now - a.StartTime).TotalSeconds)</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Oee")</div>
                <div class="ring-row">
                    <Ring Value="@SelectedSnapshot.Oee" ValueText="@Pct(SelectedSnapshot.Oee)" Label="OEE" Color="#34D399" />
                    <Ring Value="@SelectedSnapshot.AvailabilityRate" ValueText="@Pct(SelectedSnapshot.AvailabilityRate)" Label="@L.T("Lbl_Availability")" Color="#378ADD" />
                    <Ring Value="@SelectedSnapshot.PerformanceRate" ValueText="@Pct(SelectedSnapshot.PerformanceRate)" Label="@L.T("Lbl_Performance")" Color="#BA7517" />
                    <Ring Value="@SelectedSnapshot.QualityRate" ValueText="@Pct(SelectedSnapshot.QualityRate)" Label="@L.T("Lbl_Quality")" Color="#639922" />
                </div>
                <div class="oee-formula">@Pct(SelectedSnapshot.AvailabilityRate) × @Pct(SelectedSnapshot.PerformanceRate) × @Pct(SelectedSnapshot.QualityRate)</div>
            </section>

            <section class="card">
                <div class="card-title">@L.T("DefectTop")</div>
                @if (DefectTop.Count == 0)
                {
                    <div class="no-data">@L.T("NoDefectData")</div>
                }
                else
                {
                    var defectMax = DefectTop.Max(x => x.Count);
                    <div class="defect-list">
                        @foreach (var d in DefectTop)
                        {
                            <div class="defect-row">
                                <span class="defect-name" title="@d.DeviceName">@d.Name</span>
                                <div class="defect-track"><div class="defect-fill" style="width:@(100.0 * d.Count / defectMax)%"></div></div>
                                <span class="defect-count">@d.Count.ToString("N0")</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Output")</div>
                <div class="quality-row">
                    <div class="quality-block">
                        <div class="quality-num ok">@SelectedSnapshot.TotalOkProduction.ToString("N0")</div>
                        <div class="quality-label">@L.T("Lbl_Ok")</div>
                    </div>
                    <div class="quality-block">
                        <div class="quality-num ng">@SelectedSnapshot.TotalNgProduction.ToString("N0")</div>
                        <div class="quality-label">@L.T("Lbl_Ng")</div>
                    </div>
                </div>
                <div class="time-bar">
                    <div class="seg ok" style="width:@OkRatio%"></div>
                    <div class="seg ng" style="width:@NgRatio%"></div>
                </div>
                <div class="meta-line">@L.T("Meta_QualityRate", Pct(SelectedSnapshot.QualityRate), NgRateText)</div>
                @if (LastShift is not null)
                {
                    <div class="meta-line">@L.T("LastShiftLine", LastShift.ShiftName, LastShift.Ok.ToString("N0"), FmtDiff(SelectedSnapshot.TotalOkProduction - LastShift.Ok), LastShift.Ng.ToString("N0"), FmtDiff(SelectedSnapshot.TotalNgProduction - LastShift.Ng))</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_WorkOrder")</div>
                @if (CurrentWorkOrder is null)
                {
                    <div class="no-data">@L.T("Val_NoWorkOrder")</div>
                }
                else
                {
                    <div class="dev-head">
                        <span class="dev-name">@CurrentWorkOrder.OrderNo</span>
                        <span class="status-badge @WoStatusClass">@WoStatusText</span>
                    </div>
                    <div class="wo-product">@CurrentWorkOrder.ProductCode · @CurrentWorkOrder.ProductName</div>
                    <div class="wo-progress-text">@WoProgressText</div>
                    <div class="time-bar">
                        <div class="seg wo" style="width:@WoProgressRatio%"></div>
                    </div>
                    <div class="meta-line">@L.T("Meta_PlanWo", CurrentWorkOrder.TargetQuantity.ToString("N0"))</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Trend") <span class="badge-soft">@L.T("Badge_Recent1Min")</span></div>
                @if (SpeedPointsText is null)
                {
                    <div class="no-data">@L.T("Val_WaitData")</div>
                }
                else
                {
                    <svg class="spark" viewBox="0 0 300 64" preserveAspectRatio="none">
                        <polyline points="@SpeedPointsText" fill="none" stroke="#34D399" stroke-width="1.5" />
                    </svg>
                    <div class="meta-line">@L.T("Meta_TrendCurrent", RealtimeSpeedText)</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Shift")</div>
                @if (Dashboard.ShiftProgress is null)
                {
                    <div class="no-data">@L.T("Val_NoData")</div>
                }
                else
                {
                    <div class="dev-head">
                        <span class="dev-name">@Dashboard.ShiftProgress.Name</span>
                        <span class="kpi-value">@Dashboard.ShiftProgress.Pct</span>
                    </div>
                    <div class="time-bar">
                        <div class="seg shift" style="width:@(Dashboard.ShiftProgress.Ratio * 100)%"></div>
                    </div>
                    <div class="duration-row">
                        <div><span class="kpi-label">@L.T("Lbl_Elapsed")</span><span class="kpi-value">@Dashboard.ShiftProgress.ElapsedText</span></div>
                        <div><span class="kpi-label">@L.T("Lbl_Remaining")</span><span class="kpi-value">@Dashboard.ShiftProgress.RemainingText</span></div>
                    </div>
                    <div class="meta-line">@L.T("Meta_ShiftAuto")</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Source")</div>
                <div class="info-list">
                    <div><span class="kpi-label">@L.T("Lbl_ConnStatus")</span><span class="kpi-value">@(Dashboard.IsConnected ? L.T("Conn_Connected") : L.T("Conn_Disconnected"))</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_DevTotal")</span><span class="kpi-value">@Dashboard.DeviceCount</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_DataFresh")</span><span class="kpi-value">@FreshnessText</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_SnapSeq")</span><span class="kpi-value">#@SelectedSnapshot.Seq</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_SvcAddr")</span><span class="kpi-value mono">@L.T("Val_DynAddr")</span></div>
                    @if (!string.IsNullOrEmpty(Dashboard.ServerVersion))
                    {
                        <div><span class="kpi-label">@L.T("Lbl_SvcVersion")</span><span class="kpi-value mono">@Dashboard.ServerVersion</span></div>
                    }
                </div>
            </section>
        </main>
    }
</div>

@code {
    /// <summary>
    /// 当前选中设备 id（只读暴露给模板）。持久化与兜底修正见 <see cref="SelectedDeviceId"/> setter 与 <see cref="EnsureSelectedDevice"/>。
    /// </summary>
    private string? _selectedDeviceId;
    private System.Threading.Timer? _renderTimer;
    private bool _disposed;

    private const string DevicePreferenceKey = "kanban.selected-device";

    /// <summary>用户切换设备或兜底回退时写入，并同步 localStorage。</summary>
    private string? SelectedDeviceId
    {
        get => _selectedDeviceId;
        set
        {
            if (string.IsNullOrEmpty(value))
                value = null;
            if (_selectedDeviceId == value)
                return;

            _selectedDeviceId = value;
            if (value is null)
                _ = JS.InvokeVoidAsync("localStorage.removeItem", DevicePreferenceKey);
            else
                _ = JS.InvokeVoidAsync("localStorage.setItem", DevicePreferenceKey, value);
        }
    }

    private void OnDeviceSelected(ChangeEventArgs e)
        => SelectedDeviceId = e.Value?.ToString();

    /// <summary>
    /// 快照列表变化后校正选中项：无效或空选时回退第一台，并走 setter 以同步 localStorage。
    /// 不在 getter 内写回，避免与 @bind / localStorage 恢复打架。
    /// </summary>
    private void EnsureSelectedDevice()
    {
        var snaps = Dashboard.Snapshots;
        if (snaps.Count == 0)
            return;

        if (_selectedDeviceId is not null && snaps.Any(s => s.DeviceId == _selectedDeviceId))
            return;

        SelectedDeviceId = snaps[0].DeviceId;
    }

    private DeviceSnapshotDto? SelectedSnapshot
        => SelectedDeviceId is null ? null : Dashboard.GetSnapshot(SelectedDeviceId);

    /// <summary>当前选中设备的工单（Collector 5s 推送缓存，切换设备即时取用）。</summary>
    private WorkOrderDto? CurrentWorkOrder => Dashboard.GetWorkOrder(SelectedDeviceId);

    /// <summary>当前选中设备的缺陷计数 TOP5（Meta 5s 推送；无数据返回空列表）。</summary>
    private IReadOnlyList<DeviceDefectCountDto> DefectTop
        => SelectedDeviceId is null ? [] : Dashboard.GetDefectTop(SelectedDeviceId);

    /// <summary>当前选中设备的上一班次汇总（Meta 5s 推送；无缓存返回 null）。</summary>
    private DeviceShiftSummaryDto? LastShift
        => SelectedDeviceId is null ? null : Dashboard.GetLastShift(SelectedDeviceId);

    /// <summary>产量差文本（对齐 WPF FormatHelper.FormatDiff：+N / -N / 0）。</summary>
    private static string FmtDiff(int diff) => diff > 0 ? $"+{diff:N0}" : diff.ToString("N0");

    protected override async Task OnInitializedAsync()
    {
        // 恢复上次选中的设备（localStorage 持久化）
        try
        {
            _selectedDeviceId = await JS.InvokeAsync<string?>("localStorage.getItem", DevicePreferenceKey);
        }
        catch (Exception)
        {
            // localStorage 不可用（隐私模式等）时静默忽略，回退默认第一台
        }

        EnsureSelectedDevice();
        Dashboard.StateChanged += OnDashboardStateChanged;
        _ = Dashboard.InitializeAsync(); // 连接 Collector（失败由定时器自动重试）
        // 渲染节流：2s 统一重渲染（推送 500ms 只更新内存，避免 render tree 高频 diff）
        _renderTimer = new System.Threading.Timer(_ => _ = SafeTickAsync(), null, 2000, 2000);
        await Task.CompletedTask;
    }

    /// <summary>渲染 tick：2s 统一重渲染（工单/班次由 Collector 推送，无需轮询）。</summary>
        /// <summary>
    /// 安全渲染 tick：Timer 回调在组件 Dispose 前后触发时，InvokeAsync 会抛 ObjectDisposedException；
    /// 该 Task 若未观察会成为 unhandledrejection → Blazor 显示全局 error UI（页面功能不受影响但横幅误报）。
    /// 统一吞掉释放竞态异常，保证任何时序下不产生未观察异常。
    /// </summary>
    private async Task SafeTickAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(OnRenderTick);
        }
        catch (Exception)
        {
            // 组件已释放的竞态：忽略（页面生命周期正常结束）
        }
    }

private void OnRenderTick()
    {
        if (_disposed) return;
        EnsureSelectedDevice();
        Dashboard.RequestWorkOrderProductionRefresh(SelectedDeviceId);
        StateHasChanged();
    }

    private void OnDashboardStateChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            EnsureSelectedDevice();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Dashboard.StateChanged -= OnDashboardStateChanged;
        _renderTimer?.Dispose();
        GC.SuppressFinalize(this);
    }

    // ──────────── 展示辅助（纯快照数据换算，无本地计算；颜色走 CSS 语义类） ────────────
    // 换算公式单源：Kanban.Contracts.Metrics.SnapshotMetrics（与 WPF HomeViewModel 共用，禁止内联重复）

    private (string Text, string Class) Status
        => SelectedSnapshot?.Status switch
        {
            DeviceStatus.Running => (L.T("Status_Running"), "run"),
            DeviceStatus.Alarm => (L.T("Status_Alarm"), "alarm"),
            DeviceStatus.Paused => (L.T("Status_Paused"), "paused"),
            _ => (L.T("Status_Idle"), "idle"),
        };

    private string WoStatusText => CurrentWorkOrder?.Status switch
    {
        WorkOrderStatus.Running => L.T("Wo_Running"),
        WorkOrderStatus.Completed => L.T("Wo_Completed"),
        WorkOrderStatus.Aborted => L.T("Wo_Aborted"),
        _ => L.T("Wo_Pending"),
    };

    private string WoStatusClass => CurrentWorkOrder?.Status switch
    {
        WorkOrderStatus.Running => "wo-running",
        WorkOrderStatus.Completed => "wo-completed",
        WorkOrderStatus.Aborted => "wo-aborted",
        _ => "wo-pending",
    };

    /// <summary>工单进度：Running 用工单内 OK 产量/目标（Hub 差分聚合）；Pending 显示 "-- / 目标"。</summary>
    private string WoProgressText
    {
        get
        {
            var wo = CurrentWorkOrder;
            if (wo is null) return "";
            var target = wo.TargetQuantity > 0 ? wo.TargetQuantity.ToString("N0") : "--";
            return wo.Status == WorkOrderStatus.Running
                ? L.T("Wo_Progress", (Dashboard.GetWorkOrderOkCount(SelectedDeviceId) ?? 0).ToString("N0"), target)
                : L.T("Wo_ProgressPending", target);
        }
    }

    private double WoProgressRatio
    {
        get
        {
            var wo = CurrentWorkOrder;
            if (wo is null || wo.TargetQuantity <= 0) return 0;
            var ok = Dashboard.GetWorkOrderOkCount(SelectedDeviceId) ?? 0;
            return Math.Clamp(100.0 * ok / wo.TargetQuantity, 0, 100);
        }
    }

    /// <summary>数据新鲜度文本（距最后收到快照的秒数）。</summary>
    private string FreshnessText
    {
        get
        {
            if (Dashboard.LastDataAt is not { } last) return L.T("Fresh_None");
            var secs = (int)(DateTime.Now - last).TotalSeconds;
            return secs switch
            {
                < 3 => L.T("Fresh_Live"),
                < 60 => L.T("Fresh_Secs", secs),
                _ => L.T("Fresh_Mins", secs / 60),
            };
        }
    }

    /// <summary>速度趋势 sparkline 坐标串（最近 1 分钟，viewBox 300x64）。</summary>
    private string? SpeedPointsText
    {
        get
        {
            var pts = Dashboard.GetSpeedHistory(SelectedSnapshot?.DeviceId ?? "");
            if (pts.Count < 2) return null;
            var max = Math.Max(pts.Max(p => p.Speed), 1);
            var min = pts.Min(p => p.Speed);
            var range = Math.Max(max - min, max * 0.1); // 区间过小时放大避免直线
            return string.Join(" ", pts.Select((p, i) =>
            {
                var x = (double)i / (pts.Count - 1) * 300;
                var y = 56 - (p.Speed - min) / range * 48;
                return $"{x:F0},{y:F0}";
            }));
        }
    }

    private static string Pct(double v) => $"{v:P0}";

    // 时长格式化口径单源：Kanban.Contracts.DurationFormatter.FormatStandard（与 WPF 状态卡一致）
    private static string FmtDuration(double secs)
        => Kanban.Contracts.Formatting.DurationFormatter.FormatStandard(secs);

    private double TotalOutput => SelectedSnapshot is null ? 0
        : SnapshotMetrics.TotalOutput(SelectedSnapshot.TotalOkProduction, SelectedSnapshot.TotalNgProduction);

    /// <summary>实时速度（件/小时）= 总产量 / 运行小时（口径见 SnapshotMetrics，与 WPF 共用）。</summary>
    private double RealtimeSpeed
        => SelectedSnapshot is null ? 0
            : SnapshotMetrics.RealtimeSpeed(SelectedSnapshot.RunTime, SelectedSnapshot.TotalOkProduction, SelectedSnapshot.TotalNgProduction);

    private string RealtimeSpeedText => RealtimeSpeed > 0 ? RealtimeSpeed.ToString("N0") : "—";
    private string TotalOutputText => TotalOutput.ToString("N0");
    private string TargetCycleText => SelectedSnapshot is { TargetCycle: > 0 } ? $"{SnapshotMetrics.CycleSeconds(SelectedSnapshot.TargetCycle):F2}s" : "—";
    private string ActualCycleText => RealtimeSpeed > 0 ? $"{SnapshotMetrics.CycleSeconds(RealtimeSpeed):F2}s" : "—";
    private double NgRate => SelectedSnapshot is null ? 0
        : SnapshotMetrics.NgRate(SelectedSnapshot.TotalOkProduction, SelectedSnapshot.TotalNgProduction);
    private string NgRateText => TotalOutput > 0 ? $"{NgRate:P1}" : "—";
    private string NgRateCssClass => NgRate >= NgRateThresholds.Danger ? "kpi-value danger"
        : NgRate >= NgRateThresholds.Warning ? "kpi-value paused"
        : "kpi-value";
    private double SpeedAchievementRate => SelectedSnapshot is { TargetCycle: > 0 }
        ? SnapshotMetrics.AchievementRate(RealtimeSpeed, SelectedSnapshot.TargetCycle) : 0;
    private string SpeedAchievementRateText => $"{SpeedAchievementRate:P0}";

    private double RunRatio => RatioPercentOf(SelectedSnapshot?.RunTime ?? 0, SelectedSnapshot);
    private double AlarmRatio => RatioPercentOf(SelectedSnapshot?.AlarmTime ?? 0, SelectedSnapshot);
    private double PauseRatio => RatioPercentOf(SelectedSnapshot?.PausedTime ?? 0, SelectedSnapshot);
    private double OkRatio => TotalOutput > 0 ? 100.0 * SelectedSnapshot!.TotalOkProduction / TotalOutput : 0;
    private double NgRatio => TotalOutput > 0 ? 100.0 * SelectedSnapshot!.TotalNgProduction / TotalOutput : 0;

    /// <summary>时长占比（百分比，0~100）；口径见 SnapshotMetrics.TimeRatio。</summary>
    private static double RatioPercentOf(double value, DeviceSnapshotDto? s)
        => 100.0 * SnapshotMetrics.TimeRatio(value, s?.RunTime ?? 0, s?.AlarmTime ?? 0, s?.PausedTime ?? 0);

    private static string LevelClass(AlarmLevel level) => level switch
    {
        AlarmLevel.High => "lvl-high",
        AlarmLevel.Medium => "lvl-medium",
        _ => "lvl-low",
    };
}
