        {
            var pts = Dashboard.GetSpeedHistory(SelectedSnapshot?.DeviceId ?? "");
            if (pts.Count < 2) return null;
            var max = Math.Max(pts.Max(p => p.Speed), 1);
            var min = pts.Min(p => p.Speed);
            var range = Math.Max(max - min, max * 0.1); // 区间过小时放大避免直线
            return string.Join(" ", pts.Select((p, i) =>
            {
                var x = (double)i / (pts.Count - 1) * 300;
                var y = 56 - (p.Speed - min) / range * 48;
                return $"{x:F0},{y:F0}";
            }));
        }
    }

