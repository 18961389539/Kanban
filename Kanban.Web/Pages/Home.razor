    private static string IsoLocal(DateTime time)
        => time.ToString("yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture);

    private async Task MaybeRefreshHourlyOkAsync()
    {
        if (_disposed) return;
        var deviceId = SelectedDeviceId;
        var sp = Dashboard.ShiftProgress;
        if (string.IsNullOrEmpty(deviceId) || sp is not { IsInShift: true, ShiftStart: not null, ShiftEnd: not null })
        {
            if (_hourlyOkHours.Length != 0)
            {
                _hourlyOkHours = [];
                _hourlyOkCounts = [];
            }
            return;
        }

        var start = sp.ShiftStart.Value;
        var end = sp.ShiftEnd.Value;
        var key = $"{deviceId}|{sp.Name}|{start:O}|{end:O}";
        var now = DateTime.Now;
        if (!string.Equals(key, _hourlyOkKey, StringComparison.Ordinal))
        {
            _hourlyOkKey = key;
            _hourlyOkHours = [];
            _hourlyOkCounts = [];
            _lastHourlyOkQueryAt = DateTime.MinValue;
        }
        if (now - _lastHourlyOkQueryAt < HourlyOkThrottle) return;
        if (Interlocked.CompareExchange(ref _hourlyOkRunning, 1, 0) != 0) return;

        _lastHourlyOkQueryAt = now;
        _hourlyOkCts?.Cancel();
        _hourlyOkCts?.Dispose();
        _hourlyOkCts = new CancellationTokenSource();
        var ct = _hourlyOkCts.Token;
        try
        {
            var analysis = await HistoryFetch.AnalyzeProductionWindowAsync(
                Dashboard, start, now, deviceId, null, ct);
            var baselineList = await HistoryFetch.FetchLatestBeforeAsync<ProductionLogDto>(
                Dashboard, HistoryQueryType.ProductionLog, start, deviceId, null,
                r => r.ProductionLogs, ct);
            if (ct.IsCancellationRequested || _disposed) return;
            var baseline = baselineList.Count > 0 ? baselineList[0] : null;
            var series = HourlyProductionDiff.FromSamples(
                analysis.CompactLogs.Select(l => (l.Timestamp, l.OkProduction, l.NgProduction)),
                start, now,
                baseline?.OkProduction ?? 0,
                baseline?.NgProduction ?? 0);
            var padded = HourlyProductionDiff.PadToShiftWindow(series, start, end);
            _hourlyOkHours = padded.Hours;
            _hourlyOkCounts = padded.OkDiff;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // 查询连接未就绪时保留上一轮柱，避免首页闪空。
        }
        finally
        {
            Interlocked.Exchange(ref _hourlyOkRunning, 0);
        }
    }

    private (double YMin, double Range) QualityScale
    {
        get
        {
            var pts = QualityHistory;
            if (pts.Count == 0) return (0.87, 0.13);
            var minQ = pts.Min(p => p.Quality);
            var yMin = Math.Clamp(Math.Min(QualityTarget - 0.08, minQ - 0.04), 0, 0.98);
            return (yMin, Math.Max(1 - yMin, 0.02));
        }
    }

    private bool TryGetQualityAxisWindow(out DateTime axisStart, out DateTime axisEnd)
    {
        axisStart = default;
        axisEnd = default;
        var sp = Dashboard.ShiftProgress;
        if (sp is { IsInShift: true, ShiftStart: not null, ShiftEnd: not null })
        {
            axisStart = sp.ShiftStart.Value;
            axisEnd = sp.ShiftEnd.Value;
            if (axisEnd <= axisStart)
                axisEnd = axisStart.AddMinutes(1);
            return true;
        }

        var pts = QualityHistory;
        if (pts.Count == 0)
            return false;
        axisStart = pts[0].Time;
        axisEnd = pts.Count >= 2 ? pts[^1].Time : pts[0].Time.AddMinutes(1);
        if (axisEnd <= axisStart)
            axisEnd = axisStart.AddMinutes(1);
        return true;
    }

