    private double DefectBarPercent(DeviceDefectCountDto d)
    {
        var share = DefectItemShare(d);
        if (share > 0) return 100.0 * share;
        var max = DefectTop.Count == 0 ? 0 : DefectTop.Max(x => x.Count);
        return max > 0 ? 100.0 * d.Count / max : 0;
    }

    private static double DefectItemShare(DeviceDefectCountDto d) => d.ShareOfTotal;

    private static string DefectFillClass(DefectSeverity severity) => severity switch
    {
        DefectSeverity.Critical => "critical",
        DefectSeverity.Major => "major",
        _ => "minor",
    };

    private static string DefectTooltip(DeviceDefectCountDto d, string displayName)
    {
        if (d.IsOthers) return displayName;
        var sev = d.Severity switch
        {
            DefectSeverity.Critical => L.T("Severity_Critical"),
            DefectSeverity.Major => L.T("Severity_Major"),
            _ => L.T("Severity_Minor"),
        };
        var cat = d.Category switch
        {
            DefectCategory.Appearance => L.T("Defect_Appearance"),
            DefectCategory.Dimension => L.T("Defect_Dimension"),
            DefectCategory.Function => L.T("Defect_Function"),
            DefectCategory.Packaging => L.T("Defect_Packaging"),
            _ => L.T("Defect_Other"),
        };
        var detail = string.IsNullOrWhiteSpace(d.PlcAddress)
            ? L.T("Hp_DefectTooltipNoAddr", sev, cat)
            : L.T("Hp_DefectTooltip", sev, cat, d.PlcAddress);
        return $"{displayName}\n{detail}";
    }
