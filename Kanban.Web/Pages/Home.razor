@page "/"
@implements IDisposable
@inject DashboardState Dashboard
@inject IJSRuntime JS
@inject NavigationManager Nav
@using Kanban.Web.Services

<div class="dashboard">
    <header class="topbar">
        <div class="brand">
            <span class="brand-title">@Dashboard.Title</span>
        </div>
        <div class="conn-badge @(Dashboard.IsConnected ? "conn-ok" : "conn-bad")"
             title="@L.Tip("Home_Tip_ConnBadge", Dashboard.IsConnected ? L.T("Conn_Live") : L.T("Conn_Disconnected"))">
            <span class="dot"></span>
            @(Dashboard.IsConnected ? L.T("Conn_Live") : L.T("Conn_Disconnected"))
        </div>
        @* 无设备数据时隐藏选择器：避免渲染一个空白下拉框与下方空状态卡片并存、让用户困惑 *@
        @if (Dashboard.Snapshots.Count > 0)
        {
            <select class="device-select" value="@_selectedDeviceId" @onchange="OnDeviceSelected">
                @foreach (var dev in Dashboard.Snapshots)
                {
                    <option value="@dev.DeviceId">@dev.DeviceName</option>
                }
            </select>
        }
    </header>

    @* 全局连接横幅：断连(红) / 数据停滞(黄，连接正常但采集链路卡死) / 正常不显示。
       与 WPF MainWindow 横幅三态对齐（IsPlcConnecting 态 Web 端无，故只区分断连与停滞）。 *@
    @if (!Dashboard.IsConnected)
    {
        <div class="conn-banner">@L.T("ConnLost")</div>
    }
    else if (Dashboard.IsDataStale)
    {
        <div class="conn-banner warn">@L.T("ConnStale", Dashboard.DataStaleSeconds)</div>
    }

    @if (Dashboard.Snapshots.Count == 0)
    {
        <EmptyState Title="@(Dashboard.IsConnected ? L.T("Msg_NoDeviceData") : L.T("Msg_WaitingConn"))"
                    Hint="@L.T("Msg_EmptyHint")"
                    Icon="@(Dashboard.IsConnected ? "📋" : "🔌")" />
    }
    else
    {
        <div class="summary-bar">
            <span class="sum-item run" title="@L.Tip("Ln_Tip_StatusCount", L.T("Status_Running"), Dashboard.StatusSummary.Running)"><span class="dot"></span>@L.T("Status_Running") <b>@Dashboard.StatusSummary.Running</b></span>
            <span class="sum-item alarm" title="@L.Tip("Ln_Tip_StatusCount", L.T("Status_Alarm"), Dashboard.StatusSummary.Alarm)"><span class="dot"></span>@L.T("Status_Alarm") <b>@Dashboard.StatusSummary.Alarm</b></span>
            <span class="sum-item paused" title="@L.Tip("Ln_Tip_StatusCount", L.T("Status_Paused"), Dashboard.StatusSummary.Paused)"><span class="dot"></span>@L.T("Status_Paused") <b>@Dashboard.StatusSummary.Paused</b></span>
            <span class="sum-item offline" title="@L.Tip("Ln_Tip_StatusCount", L.T("Status_Offline"), Dashboard.StatusSummary.Idle)"><span class="dot"></span>@L.T("Status_Offline") <b>@Dashboard.StatusSummary.Idle</b></span>
            <span class="sum-item" title="@L.Tip("Home_Tip_DeviceCount", Dashboard.DeviceCount)">@L.T("Card_DevCount") <b>@Dashboard.DeviceCount</b></span>
        </div>

        @if (SelectedSnapshot is null)
        {
            <EmptyState Title="@L.T("Msg_NoDevSelected")"
                        Hint="@L.T("Msg_SelectHint")"
                        Icon="🖱️" />
        }
        else
        {
        <main class="grid">
            <section class="card">
                <div class="card-title">
                    <span>@L.T("Card_DevStatus")</span>
                    <button class="chip-btn" title="@L.T("Dd_OpenRuntime")" @onclick="OpenSelectedDevice">@L.T("Dd_OpenRuntime")</button>
                </div>
                <div class="dev-head">
                    <span class="dev-name linkish" @onclick="OpenSelectedDevice">@SelectedSnapshot.DeviceName</span>
                    <span class="status-badge @Status.Class" title="@L.Tip("Home_Tip_DeviceStatus", Status.Text)">@Status.Text</span>
                </div>
                <div class="duration-row">
                    <div title="@RunTimeTooltip"><span class="kpi-label">@L.T("Status_Running") <KpiScopeChip Kind="Shift" /></span><span class="kpi-value run">@FmtDuration(SelectedSnapshot.RunTime)</span><span class="ratio-hint">@PctRatio(RunRatio)</span></div>
                    <div title="@AlarmTimeTooltip"><span class="kpi-label">@L.T("Status_Alarm") <KpiScopeChip Kind="Shift" /></span><span class="kpi-value alarm">@FmtDuration(SelectedSnapshot.AlarmTime)</span><span class="ratio-hint">@PctRatio(AlarmRatio)</span></div>
                    <div title="@PausedTimeTooltip"><span class="kpi-label">@L.T("Status_Paused") <KpiScopeChip Kind="Shift" /></span><span class="kpi-value paused">@FmtDuration(SelectedSnapshot.PausedTime)</span><span class="ratio-hint">@PctRatio(PauseRatio)</span></div>
                    <div title="@OfflineTimeTooltip"><span class="kpi-label">@L.T("Status_Offline") <KpiScopeChip Kind="Shift" /></span><span class="kpi-value idle">@FmtDuration(SelectedSnapshot.OfflineTime)</span><span class="ratio-hint">@PctRatio(OfflineRatio)</span></div>
                </div>
                <div class="time-bar">
                    <div class="seg run" style="width:@RunRatio%"></div>
                    <div class="seg alarm" style="width:@AlarmRatio%"></div>
                    <div class="seg paused" style="width:@PauseRatio%"></div>
                    <div class="seg offline" style="width:@OfflineRatio%"></div>
                </div>
                @* 2026-09-18 精修：目标/实际周期由两行等权改为「实际为主 + 目标为注 + 差值药丸」 *@
                <div class="cycle-block">
                    <div class="cycle-main" title="@ActualCycleTooltip">
                        <span class="kpi-label">@L.T("Lbl_ActualCycle") <KpiScopeChip Kind="Realtime" /></span>
                        <span class="cycle-actual">@ActualCycleText</span>
                    </div>
                    <div class="cycle-target" title="@TargetCycleTooltip">
                        <span class="kpi-label">@L.T("Lbl_TargetCycle") <KpiScopeChip Kind="Realtime" /></span>
                        <span class="cycle-target-value">@TargetCycleText</span>
                    </div>
                    @if (!string.IsNullOrEmpty(CycleDiffText))
                    {
                        <span class="cycle-diff pill @(IsCycleSlow ? "slow" : "ok")" title="@CycleDiffTooltip">@CycleDiffText</span>
                    }
                </div>
                <div class="meta-line" title="@L.Tip("Home_Tip_StatusWord", $"0x{SelectedSnapshot.StatusWord:X4}")">@L.T("Hq_StatusWord") 0x@(SelectedSnapshot.StatusWord.ToString("X4"))</div>
                @if (!string.IsNullOrEmpty(SelectedSnapshot.RecipeName))
                {
                    <div class="meta-line" title="@L.Tip("Home_Tip_Recipe", L.T("RecipeInfo", SelectedSnapshot.RecipeName, SelectedSnapshot.RecipeValue))">@L.T("RecipeInfo", SelectedSnapshot.RecipeName, SelectedSnapshot.RecipeValue)</div>
                }
            </section>

            <section class="card card-click" @onclick="OpenCurrentWorkOrder">
                <div class="card-title">@L.T("Card_ProdStatus")</div>
                @if (CurrentWorkOrder is null)
                {
                    <EmptyState Compact="true" Title="@L.T("Home_WorkOrderEmpty")" Hint="@L.T("Home_WorkOrderEmptyHint")" Icon="📋" />
                }
                else
                {
                    <div class="wo-progress-hero">
                        <div class="wo-progress-head">
                            <span class="wo-order">@CurrentWorkOrder.OrderNo</span>
                            <span class="wo-product-inline">@CurrentWorkOrder.ProductCode</span>
                        </div>
                    </div>
                    @* 工单四槽位（固定，不做成可配置）：工单目标 / 当班良品 / 工单累计良品 / 工单达成率 *@
                    <div class="metric-grid wo-kpi-grid">
                        <div title="@WorkOrderTargetTooltip"><span class="kpi-label">@L.T("K326") <KpiScopeChip Kind="WorkOrder" /></span><span class="kpi-value">@CurrentWorkOrder.TargetQuantity.ToString("N0")</span></div>
                        <div title="@ShiftOkTooltip"><span class="kpi-label">@L.T("Home_ShiftOk") <KpiScopeChip Kind="Shift" /></span><span class="kpi-value">@ShiftOkText</span></div>
                        <div title="@WorkOrderCumulativeOkTooltip"><span class="kpi-label">@L.T("Home_WorkOrderCumulativeOk") <KpiScopeChip Kind="WorkOrder" /></span><span class="kpi-value">@WorkOrderOkText</span></div>
                        <div title="@WorkOrderAchievementTooltip"><span class="kpi-label">@L.T("Home_WorkOrderAchievement") <KpiScopeChip Kind="WorkOrder" /></span><span class="@WorkOrderAchievementCssClass">@WorkOrderAchievementText</span></div>
                    </div>
                    <div class="wo-schedule" title="@WorkOrderProgressTooltip">
                        <div class="wo-progress-main">
                            <span class="wo-progress-text">@WoProgressText</span>
                            <span class="wo-progress-pct @WoProgressPctClass">@WoProgressPctText</span>
                        </div>
                        <div class="time-bar wo-progress-bar">
                            <div class="seg wo @WoProgressPctClass" style="width:@WoProgressRatio%"></div>
                        </div>
                    </div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Alarms") <span class="badge-count @(SelectedSnapshot.ActiveAlarms.Count == 0 ? "zero" : "")" title="@L.Tip("Home_Tip_ActiveAlarmCount", SelectedSnapshot.ActiveAlarms.Count)">@SelectedSnapshot.ActiveAlarms.Count</span></div>
                @if (SelectedSnapshot.ActiveAlarms.Count == 0)
                {
                    <div class="no-data">@L.T("Val_NoAlarms")</div>
                }
                else
                {
                    <div class="alarm-list">
                        @foreach (var a in SelectedSnapshot.ActiveAlarms)
                        {
                            <div class="alarm-item row-click" @onclick="() => OpenAlarm(a.Name, a.StartTime)" @onclick:stopPropagation="true">
                                <span class="lvl-dot @LevelClass(a.Level)"></span>
                                <span class="alarm-name">@a.Name</span>
                                <span class="alarm-dur" title="@Tip("Home_Tip_ActiveAlarmDuration", FmtDuration((Dashboard.ServerNow - a.StartTime).TotalSeconds))">@FmtDuration((Dashboard.ServerNow - a.StartTime).TotalSeconds)</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="card">
                <div class="card-title oee-title">
                    <span>@L.T("Card_Oee") <KpiScopeChip Kind="Shift" /></span>
                    @if (DeviceHealthScore > 0)
                    {
                        <span class="oee-health" title="@DeviceHealthTooltip">
                            @L.T("Rv_Health") <b class="@DeviceHealthCssClass">@DeviceHealthScoreText</b>
                            <span class="health-level @DeviceHealthCssClass">@DeviceHealthLevel</span>
                        </span>
                    }
                </div>
                <div class="ring-row">
                    <Ring Value="@SelectedSnapshot.Oee" ValueText="@Pct(SelectedSnapshot.Oee)" Label="OEE" Color="@UiPalette.Oee" Title="@OeeTooltip" />
                    <Ring Value="@SelectedSnapshot.AvailabilityRate" ValueText="@Pct(SelectedSnapshot.AvailabilityRate)" Label="@L.T("Lbl_Availability")" Color="@UiPalette.Availability" Title="@AvailabilityTooltip" />
                    <Ring Value="@SelectedSnapshot.PerformanceRate" ValueText="@Pct(SelectedSnapshot.PerformanceRate)" Label="@L.T("Lbl_Performance")" Color="@UiPalette.Performance" Title="@PerformanceTooltip" />
                    <Ring Value="@SelectedSnapshot.QualityRate" ValueText="@Pct(SelectedSnapshot.QualityRate)" Label="@L.T("Lbl_Quality")" Color="@UiPalette.Quality" Title="@QualityTooltip" />
                </div>
                <div class="oee-formula" title="@OeeTooltip">@OeeFormulaText</div>
            </section>

            <section class="card">
                <div class="card-title">@L.T("DefectTop") <KpiScopeChip Kind="Shift" /></div>
                <div class="defect-sub">@L.T("Hp_DefectSubtitle")</div>
                @if (DefectEmptyKind == DefectParetoEmptyKind.HasData)
                {
                    <div class="defect-summary">
                        <span title="@Tip("Home_Tip_DefectSummary", L.T("Hp_DefectSummary", DefectTotalCount))">@L.T("Hp_DefectSummary", DefectTotalCount)</span>
                        @if (DefectNgShare is { } ngShare)
                        {
                            <span title="@Tip("Home_Tip_DefectNgShare", L.T("Hp_DefectShareNg", ngShare))">@L.T("Hp_DefectShareNg", ngShare)</span>
                        }
                    </div>
                    <div class="defect-pareto">
                        <svg class="defect-pareto-svg" viewBox="0 0 300 86" preserveAspectRatio="none">
                            @if (DefectParetoLinePoints is not null)
                            {
                                <polyline points="@DefectParetoLinePoints" fill="none" stroke="#818CF8" stroke-width="1.8" />
                            }
                            @foreach (var bar in DefectParetoBars)
                            {
                                <rect x="@bar.X" y="@bar.Y" width="@bar.W" height="@bar.H" rx="1" fill="@bar.Fill">
                                    <title>@bar.Title</title>
                                </rect>
                                <circle cx="@bar.Cx" cy="@bar.Cy" r="2.4" fill="#818CF8">
                                    <title>@bar.CumTitle</title>
                                </circle>
                            }
                        </svg>
                        <div class="defect-pareto-labels">
                            @foreach (var d in DefectTop)
                            {
                                var name = d.IsOthers ? L.T("Hp_DefectOthers", d.OtherKindCount) : d.Name;
                                <span title="@name">@name</span>
                            }
                        </div>
                    </div>
                }
                else if (DefectEmptyKind == DefectParetoEmptyKind.NotConfigured)
                {
                    <div class="no-data">@L.T("Hp_DefectEmptyUnconfigured")</div>
                    <div class="no-data-hint">@L.T("Hp_DefectEmptyUnconfiguredHint")</div>
                }
                else if (DefectEmptyKind == DefectParetoEmptyKind.AllZero)
                {
                    <div class="no-data">@L.T("Hp_DefectEmptyZero")</div>
                    <div class="no-data-hint">@L.T("Hp_DefectEmptyZeroHint")</div>
                }
                else
                {
                    <div class="no-data">@L.T("NoDefectData")</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("K328") <KpiScopeChip Kind="Shift" /></div>
                <div class="metric-grid quality-kpi-grid">
                    <div title="@TotalOutputTooltip">
                        <span class="kpi-label">@L.T("Home_ShiftTotalOutput") <KpiScopeChip Kind="Shift" /></span>
                        <span class="kpi-value">@TotalOutputText</span>
                    </div>
                    <div>
                        <span class="kpi-label">@L.T("Home_CumulativeQuality") <KpiScopeChip Kind="Shift" /></span>
                        <span class="quality-kpi-value">
                            <span class="quality-live @QualityCssClass" title="@QualityTooltip">@QualityLiveText</span>
                            <span class="quality-gap @QualityCssClass" title="@QualityGapTooltip">@QualityGapText</span>
                        </span>
                    </div>
                </div>
                <div class="quality-chart" title="@L.T("Home_Tip_QualityTrend")">
                    @if (QualityChartOption is null)
                    {
                        <div class="no-data">@L.T("Val_WaitData")</div>
                    }
                    else
                    {
                        <EChart Option="@QualityChartOption" Height="120px" />
                    }
                </div>
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_WorkOrder")</div>
                @if (CurrentWorkOrder is null)
                {
                    <div class="no-data">@L.T("Val_NoWorkOrder")</div>
                }
                else
                {
                    <div class="dev-head">
                        <span class="dev-name">@CurrentWorkOrder.OrderNo</span>
                        <span class="status-badge @WoStatusClass">@WoStatusText</span>
                    </div>
                    <div class="wo-product">@CurrentWorkOrder.ProductCode · @CurrentWorkOrder.ProductName</div>
                    <div class="metric-grid">
                        <div title="@WorkOrderNgTooltip"><span class="kpi-label">@L.T("Home_WorkOrderNg") <KpiScopeChip Kind="WorkOrder" /></span><span class="kpi-value">@WorkOrderNgText</span></div>
                        <div title="@WorkOrderQualityTooltip"><span class="kpi-label">@L.T("Home_WorkOrderQuality") <KpiScopeChip Kind="WorkOrder" /></span><span class="kpi-value">@WorkOrderQualityText</span></div>
                    </div>
                }
            </section>

            <section class="card" title="@L.Tip("Home_Tip_TrendWindow", RealtimeSpeedText)">
                <div class="card-title">@L.T("Card_Trend") <span class="badge-soft">@L.T("Badge_Recent1Min")</span></div>
                @if (SpeedPointsText is null)
                {
                    <div class="no-data">@L.T("Val_WaitData")</div>
                }
                else
                {
                    <svg class="spark" viewBox="0 0 300 64" preserveAspectRatio="none">
                        <polyline points="@SpeedPointsText" fill="none" stroke="#34D399" stroke-width="1.5" />
                    </svg>
                    <div class="meta-line">@L.T("Meta_TrendCurrent", RealtimeSpeedText) <KpiScopeChip Kind="Realtime" /></div>
                }
            </section>

            <section class="card" title="@(Dashboard.ShiftProgress is { } sp ? L.Tip("Home_Tip_Shift", sp.Name, $"{sp.ElapsedText} · {sp.Pct}") : "")">
                <div class="card-title">@L.T("Card_Shift")</div>
                @if (Dashboard.ShiftProgress is null)
                {
                    <div class="no-data">@L.T("Val_NoData")</div>
                }
                else
                {
                    <div class="dev-head">
                        <span class="dev-name">@Dashboard.ShiftProgress.Name</span>
                        <span class="kpi-value">@Dashboard.ShiftProgress.Pct</span>
                    </div>
                    <div class="time-bar">
                        <div class="seg shift" style="width:@(Dashboard.ShiftProgress.Ratio * 100)%"></div>
                    </div>
                    <div class="duration-row">
                        <div><span class="kpi-label">@L.T("Lbl_Elapsed")</span><span class="kpi-value">@Dashboard.ShiftProgress.ElapsedText</span></div>
                        <div><span class="kpi-label">@L.T("Lbl_Remaining")</span><span class="kpi-value">@Dashboard.ShiftProgress.RemainingText</span></div>
                    </div>
                    <div class="meta-line" title="@LastShiftTooltip">@LastShiftLineText</div>
                    <div class="meta-line">@L.T("Meta_ShiftAuto")</div>
                }
            </section>

            <section class="card">
                <div class="card-title">@L.T("Card_Source")</div>
                <div class="info-list">
                    <div title="@L.Tip("Home_Tip_ConnBadge", Dashboard.IsConnected ? L.T("Conn_Connected") : L.T("Conn_Disconnected"))"><span class="kpi-label">@L.T("Lbl_ConnStatus")</span><span class="kpi-value">@(Dashboard.IsConnected ? L.T("Conn_Connected") : L.T("Conn_Disconnected"))</span></div>
                    <div title="@L.Tip("Home_Tip_DeviceCount", Dashboard.DeviceCount)"><span class="kpi-label">@L.T("Lbl_DevTotal")</span><span class="kpi-value">@Dashboard.DeviceCount</span></div>
                    <div title="@L.Tip("Home_Tip_DataFresh", FreshnessText)"><span class="kpi-label">@L.T("Lbl_DataFresh")</span><span class="kpi-value">@FreshnessText</span></div>
                    <div title="@L.Tip("Home_Tip_SnapSeq", SelectedSnapshot.Seq)"><span class="kpi-label">@L.T("Lbl_SnapSeq")</span><span class="kpi-value">#@SelectedSnapshot.Seq</span></div>
                    <div><span class="kpi-label">@L.T("Lbl_SvcAddr")</span><span class="kpi-value mono">@L.T("Val_DynAddr")</span></div>
                    @if (!string.IsNullOrEmpty(Dashboard.ServerVersion))
                    {
                        <div><span class="kpi-label">@L.T("Lbl_SvcVersion")</span><span class="kpi-value mono">@Dashboard.ServerVersion</span></div>
                    }
                </div>
            </section>
        </main>
        }
    }
</div>

@code {
    /// <summary>
    /// 当前选中设备 id（只读暴露给模板）。持久化与兜底修正见 <see cref="SelectedDeviceId"/> setter 与 <see cref="EnsureSelectedDevice"/>。
    /// </summary>
    private string? _selectedDeviceId;
    private System.Threading.Timer? _renderTimer;
    private bool _disposed;
    private DateTime[] _hourlyOkHours = [];
    private int[] _hourlyOkCounts = [];
    private DateTime _lastHourlyOkQueryAt = DateTime.MinValue;
    private int _hourlyOkRunning;
    private string? _hourlyOkKey;
    private CancellationTokenSource? _hourlyOkCts;
    private static readonly TimeSpan HourlyOkThrottle = TimeSpan.FromSeconds(15);

    private const string DevicePreferenceKey = "kanban.selected-device";

    private void OpenSelectedDevice()
    {
        if (string.IsNullOrEmpty(SelectedDeviceId)) return;
        Nav.NavigateTo($"/device/{Uri.EscapeDataString(SelectedDeviceId)}");
    }

    private void OpenCurrentWorkOrder()
    {
        if (CurrentWorkOrder is null)
        {
            Nav.NavigateTo("/workorders");
            return;
        }
        Nav.NavigateTo($"/workorders?id={CurrentWorkOrder.Id}");
    }

    private void OpenAlarm(string alarmName, DateTime start)
    {
        if (string.IsNullOrEmpty(SelectedDeviceId)) return;
        var from = start.ToString("yyyy-MM-ddTHH:mm");
        var to = Dashboard.ServerNow.ToString("yyyy-MM-ddTHH:mm");
        Nav.NavigateTo($"/history?tab=2&deviceId={Uri.EscapeDataString(SelectedDeviceId)}&alarmName={Uri.EscapeDataString(alarmName)}&from={from}&to={to}");
    }

    /// <summary>用户切换设备或兜底回退时写入，并同步 localStorage。</summary>
    private string? SelectedDeviceId
    {
        get => _selectedDeviceId;
        set
        {
            if (string.IsNullOrEmpty(value))
                value = null;
            if (_selectedDeviceId == value)
                return;

            _selectedDeviceId = value;
            _hourlyOkKey = null;
            _hourlyOkHours = [];
            _hourlyOkCounts = [];
            _lastHourlyOkQueryAt = DateTime.MinValue;
            if (value is null)
                _ = JS.InvokeVoidAsync("localStorage.removeItem", DevicePreferenceKey);
            else
                _ = JS.InvokeVoidAsync("localStorage.setItem", DevicePreferenceKey, value);
        }
    }

    private void OnDeviceSelected(ChangeEventArgs e)
        => SelectedDeviceId = e.Value?.ToString();

    /// <summary>
    /// 快照列表变化后校正选中项：无效或空选时回退第一台，并走 setter 以同步 localStorage。
    /// 不在 getter 内写回，避免与 @bind / localStorage 恢复打架。
    /// </summary>
    private void EnsureSelectedDevice()
    {
        var snaps = Dashboard.Snapshots;
        if (snaps.Count == 0)
            return;

        if (_selectedDeviceId is not null && snaps.Any(s => s.DeviceId == _selectedDeviceId))
            return;

        SelectedDeviceId = snaps[0].DeviceId;
    }

    private DeviceSnapshotDto? SelectedSnapshot
        => SelectedDeviceId is null ? null : Dashboard.GetSnapshot(SelectedDeviceId);

    /// <summary>当前选中设备的工单（Collector 5s 推送缓存，切换设备即时取用）。</summary>
    private WorkOrderDto? CurrentWorkOrder => Dashboard.GetWorkOrder(SelectedDeviceId);

    /// <summary>当前选中设备的缺陷帕累托行（Meta 5s 推送；无数据返回空列表）。</summary>
    private IReadOnlyList<DeviceDefectCountDto> DefectTop
        => SelectedDeviceId is null ? [] : Dashboard.GetDefectTop(SelectedDeviceId);

    private DeviceDefectSummaryDto? DefectSummary
        => SelectedDeviceId is null ? null : Dashboard.GetDefectSummary(SelectedDeviceId);

    private DefectParetoEmptyKind DefectEmptyKind
        => DefectSummary?.EmptyKind
           ?? (DefectTop.Count > 0 ? DefectParetoEmptyKind.HasData : DefectParetoEmptyKind.NoDevice);

    private int DefectTotalCount
        => DefectSummary?.TotalCount ?? DefectTop.Sum(x => x.Count);

    private double? DefectNgShare
    {
        get
        {
            var ng = SelectedSnapshot?.TotalNgProduction ?? 0;
            var total = DefectTotalCount;
            if (ng <= 0 || total <= 0) return null;
            return (double)total / ng;
        }
    }

    /// <summary>当前选中设备的上一班次汇总（Meta 5s 推送；无缓存返回 null）。</summary>
    private DeviceShiftSummaryDto? LastShift
        => SelectedDeviceId is null ? null : Dashboard.GetLastShift(SelectedDeviceId);

    /// <summary>产量差文本（对齐 WPF FormatHelper.FormatDiff 零值语义：+N / -N / 0→空）。</summary>
    private static string FmtDiff(int diff) => diff switch
    {
        > 0 => $"+{diff:N0}",
        < 0 => diff.ToString("N0"),
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        // 恢复上次选中的设备（localStorage 持久化）
        try
        {
            _selectedDeviceId = await JS.InvokeAsync<string?>("localStorage.getItem", DevicePreferenceKey);
        }
        catch (Exception)
        {
            // localStorage 不可用（隐私模式等）时静默忽略，回退默认第一台
        }

        EnsureSelectedDevice();
        Dashboard.StateChanged += OnDashboardStateChanged;
        _ = Dashboard.InitializeAsync(); // 连接 Collector（失败由定时器自动重试）
        // 渲染节流：2s 统一重渲染（推送 500ms 只更新内存，避免 render tree 高频 diff）
        _renderTimer = new System.Threading.Timer(_ => _ = SafeTickAsync(), null, 2000, 2000);
        await Task.CompletedTask;
    }

    /// <summary>渲染 tick：2s 统一重渲染（工单/班次由 Collector 推送，无需轮询）。</summary>
        /// <summary>
    /// 安全渲染 tick：Timer 回调在组件 Dispose 前后触发时，InvokeAsync 会抛 ObjectDisposedException；
    /// 该 Task 若未观察会成为 unhandledrejection → Blazor 显示全局 error UI（页面功能不受影响但横幅误报）。
    /// 统一吞掉释放竞态异常，保证任何时序下不产生未观察异常。
    /// </summary>
    private async Task SafeTickAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(OnRenderTick);
        }
        catch (Exception)
        {
            // 组件已释放的竞态：忽略（页面生命周期正常结束）
        }
    }

    private int _lastRenderFingerprint;

    private void OnRenderTick()
    {
        if (_disposed) return;
        EnsureSelectedDevice();
        Dashboard.RequestWorkOrderProductionRefresh(SelectedDeviceId);
        _ = MaybeRefreshHourlyOkAsync();
        var fingerprint = ComputeRenderFingerprint();
        if (fingerprint == _lastRenderFingerprint) return;
        _lastRenderFingerprint = fingerprint;
        StateHasChanged();
    }

    private int ComputeRenderFingerprint()
    {
        var snap = SelectedSnapshot;
        var sp = Dashboard.ShiftProgress;
        var wo = CurrentWorkOrder;
        var hash = new HashCode();
        hash.Add(SelectedDeviceId);
        hash.Add(snap?.Seq);
        hash.Add(snap?.Status);
        hash.Add(snap?.Oee);
        hash.Add(snap?.TotalOkProduction);
        hash.Add(snap?.TotalNgProduction);
        hash.Add(snap?.ActiveAlarms.Count);
        hash.Add(sp?.Ratio);
        hash.Add(sp?.Name);
        hash.Add(sp?.ElapsedText);
        hash.Add(WorkOrderOkCount);
        hash.Add(WorkOrderNgCount);
        hash.Add(wo?.Id);
        hash.Add(Dashboard.IsConnected);
        hash.Add(_hourlyOkHours.Length);
        if (_hourlyOkCounts.Length > 0)
            hash.Add(_hourlyOkCounts[^1]);
        return hash.ToHashCode();
    }

    private void OnDashboardStateChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            EnsureSelectedDevice();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Dashboard.StateChanged -= OnDashboardStateChanged;
        _renderTimer?.Dispose();
        _hourlyOkCts?.Cancel();
        _hourlyOkCts?.Dispose();
        GC.SuppressFinalize(this);
    }

