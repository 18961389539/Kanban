    private string DeviceHealthTooltip => SelectedSnapshot is null || DeviceHealthScore <= 0
        ? ""
        : $"A {Pct(SelectedSnapshot.AvailabilityRate)} · P {Pct(SelectedSnapshot.PerformanceRate)} · Q {Pct(SelectedSnapshot.QualityRate)} · {DeviceHealthScore:0}";

    private double RunRatio => RatioPercentOf(SelectedSnapshot?.RunTime ?? 0, SelectedSnapshot);
    private double AlarmRatio => RatioPercentOf(SelectedSnapshot?.AlarmTime ?? 0, SelectedSnapshot);
    private double PauseRatio => RatioPercentOf(SelectedSnapshot?.PausedTime ?? 0, SelectedSnapshot);
    private double OfflineRatio => RatioPercentOf(SelectedSnapshot?.OfflineTime ?? 0, SelectedSnapshot);
    private double OkRatio => TotalOutput > 0 ? 100.0 * SelectedSnapshot!.TotalOkProduction / TotalOutput : 0;
    private double NgRatio => TotalOutput > 0 ? 100.0 * SelectedSnapshot!.TotalNgProduction / TotalOutput : 0;

    /// <summary>时长占比（百分比，0~100）；分母含离线，与 WPF HomeViewModel *TimeRatio 一致。</summary>
    private static double RatioPercentOf(double value, DeviceSnapshotDto? s)
        => 100.0 * SnapshotMetrics.TimeRatio(
            value, s?.RunTime ?? 0, s?.AlarmTime ?? 0, s?.PausedTime ?? 0, s?.OfflineTime ?? 0);

    private static string PctRatio(double ratio) => $"{ratio:F0}%";

    private static string LevelClass(AlarmLevel level) => level switch
    {
        AlarmLevel.High => "lvl-high",
        AlarmLevel.Medium => "lvl-medium",
        _ => "lvl-low",
    };

    private readonly record struct DefectParetoBarVis(
        string X, string Y, string W, string H, string Fill,
        string Cx, string Cy, string Title, string CumTitle);

    private IReadOnlyList<DefectParetoBarVis> DefectParetoBars
    {
        get
        {
            var rows = DefectTop;
            if (rows.Count == 0) return [];
            const double left = 6, right = 294, top = 6, bottom = 80;
            var n = rows.Count;
            var max = Math.Max(1, rows.Max(r => r.Count));
            const double gap = 4;
            var barW = Math.Max(3, (right - left - gap * (n + 1)) / n);
            var plotH = bottom - top;
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            var list = new List<DefectParetoBarVis>(n);
            for (var i = 0; i < n; i++)
            {
                var d = rows[i];
                var displayName = d.IsOthers ? L.T("Hp_DefectOthers", d.OtherKindCount) : d.Name;
                var h = d.Count <= 0 ? 0 : Math.Max(1, d.Count / (double)max * plotH);
                var x = left + gap + i * (barW + gap);
                var y = bottom - h;
                var cum = d.CumulativeShare > 0 ? d.CumulativeShare : DefectItemShare(d);
                var cx = x + barW / 2;
                var cy = bottom - cum * plotH;
                var fill = d.IsOthers ? "#9CA3AF" : d.Severity switch
                {
                    DefectSeverity.Critical => "#F87171",
                    DefectSeverity.Major => "#FB923C",
                    _ => "#FBBF24",
                };
                list.Add(new DefectParetoBarVis(
                    x.ToString("0.##", inv),
                    y.ToString("0.##", inv),
                    barW.ToString("0.##", inv),
                    h.ToString("0.##", inv),
                    fill,
                    cx.ToString("0.##", inv),
                    cy.ToString("0.##", inv),
                    DefectTooltip(d, displayName) + $"\n{d.Count:N0}",
                    L.T("Hp_DefectCumulative", cum)));
            }
            return list;
        }
    }

    private string? DefectParetoLinePoints
    {
        get
        {
            var bars = DefectParetoBars;
            if (bars.Count == 0) return null;
            return string.Join(" ", bars.Select(b => $"{b.Cx},{b.Cy}"));
        }
    }

    private static double DefectItemShare(DeviceDefectCountDto d) => d.ShareOfTotal;

    private static string DefectTooltip(DeviceDefectCountDto d, string displayName)
    {
        if (d.IsOthers) return displayName;
        var sev = d.Severity switch
        {
            DefectSeverity.Critical => L.T("Severity_Critical"),
            DefectSeverity.Major => L.T("Severity_Major"),
            _ => L.T("Severity_Minor"),
        };
        var cat = d.Category switch
        {
            DefectCategory.Appearance => L.T("Defect_Appearance"),
            DefectCategory.Dimension => L.T("Defect_Dimension"),
            DefectCategory.Function => L.T("Defect_Function"),
            DefectCategory.Packaging => L.T("Defect_Packaging"),
            _ => L.T("Defect_Other"),
        };
        var detail = string.IsNullOrWhiteSpace(d.PlcAddress)
            ? L.T("Hp_DefectTooltipNoAddr", sev, cat)
            : L.T("Hp_DefectTooltip", sev, cat, d.PlcAddress);
        return $"{displayName}\n{detail}";
    }
}
