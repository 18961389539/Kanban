@page "/devices"
@implements IDisposable
@inject DashboardState Dashboard
@inject NavigationManager Nav
@inject ILogger<Devices> Logger
@using Kanban.Contracts.Dtos
@using Kanban.Contracts.Enums
@using Kanban.Contracts.Metrics
@using Microsoft.Extensions.Logging

<div class="query-page">
    <div class="line-header">
        <div class="brand">
            <span class="brand-title">@L.T("Dv_Title")</span>
            <span class="brand-sub">@L.T("Dv_ReadOnly")</span>
        </div>
        @* 刷新失败但已有旧数据：保留展示，标题行提示 + 手动重试（30s 后也会自动重拉） *@
        @if (_firstLoadDone && _loadFailed)
        {
            <div class="line-shift dv-refresh-failed">
                <span>@L.T("Dv_LoadFailed")</span>
                <button class="chip-btn" @onclick="RetryAsync">@L.T("Dv_Retry")</button>
            </div>
        }
    </div>

    @if (!_firstLoadDone)
    {
        <EmptyState Title="@L.T("Dv_Loading")" Hint="" Icon="⏳" />
    }
    else if (DeviceList.Count == 0)
    {
        @if (_loadFailed)
        {
            @* 拉取失败且无数据：区别于"真的没有设备"，给出原因提示与重试入口 *@
            <EmptyState Title="@L.T("Dv_LoadFailed")" Hint="@L.T("Dv_LoadFailedHint")" Icon="⚠️" />
            <div class="filter-bar compact">
                <button class="chip-btn" @onclick="RetryAsync">@L.T("Dv_Retry")</button>
            </div>
        }
        else
        {
            <EmptyState Title="@L.T("Dv_NoDevices")" Hint="" Icon="🖥️" />
        }
    }
    else
    {
        <div class="mon-grid">
            @foreach (var d in DeviceList)
            {
                <div class="mon-card line-card @(SelectedDeviceId == d.Id ? "selected" : "")"
                     role="button"
                     tabindex="0"
                     aria-pressed="@(SelectedDeviceId == d.Id)"
                     @onclick="() => SelectDevice(d.Id)"
                     @onkeydown="(e) => OnDeviceCardKey(e, d.Id)">
                    <div class="dev-head">
                        <span class="dev-name">@d.Name</span>
                        <span class="status-badge @StateClass(d.Id)" title="@L.Tip("Home_Tip_DeviceStatus", StateText(d.Id))">@StateText(d.Id)</span>
                    </div>
                    <div class="metric-grid">
                        <div><span class="kpi-label">@L.T("Dv_DeviceId")</span><span class="kpi-value mono">@d.Id</span></div>
                        <div><span class="kpi-label">@L.T("Dv_MachineType")</span><span class="kpi-value">@(string.IsNullOrEmpty(d.MachineType) ? "—" : d.MachineType)</span></div>
                        <div title="@L.Tip("Home_Tip_Recipe", string.IsNullOrEmpty(d.RecipeName) ? "—" : d.RecipeName)"><span class="kpi-label">@L.T("Rv_Recipe")</span><span class="kpi-value">@(string.IsNullOrEmpty(d.RecipeName) ? "—" : d.RecipeName)</span></div>
                        <div title="@L.Tip("Home_Tip_TargetCycle", d.TargetCycle, d.TargetCycle > 0 ? $"{SnapshotMetrics.CycleSeconds(d.TargetCycle):F2}s" : "—")"><span class="kpi-label">@L.T("Lbl_TargetCapacity")</span><span class="kpi-value">@(d.TargetCycle > 0 ? $"{d.TargetCycle} {L.T("Unit_PerHour")}" : "—")</span></div>
                    </div>
                    <div class="meta-line">@L.T("Dv_AlarmCount", d.Alarms.Count) · @L.T("Dv_DefectCount", d.Defects.Count) · @L.T("Dv_CountAlarmCount", d.CounterAlarms.Count)</div>
                </div>
            }
        </div>

        @if (Selected is { } sel)
        {
            <section class="card">
                <div class="card-title">
                    <span>@L.T("Dv_Detail", sel.Name)</span>
                    <button class="chip-btn" @onclick="() => OpenRuntime(sel.Id)">@L.T("Dd_OpenRuntime")</button>
                </div>

                <div class="card-title sub">@L.T("Dv_AddressConfig")</div>
                <div class="table-scroll">
                    <table class="hq-table">
                    <tbody>
                        <tr><td>@L.T("Dv_OkCountAddr")</td><td class="mono">@sel.OkCountAddress</td></tr>
                        <tr><td>@L.T("Dv_NgCountAddr")</td><td class="mono">@sel.NgCountAddress</td></tr>
                        <tr><td>@L.T("Dv_StatusAddr")</td><td class="mono">@sel.StatusCountAddress</td></tr>
                        <tr><td>@L.T("Dv_ResetAddr")</td><td class="mono">@sel.ProductionResetAddress</td></tr>
                        <tr><td>@L.T("Dv_RecipeAddr")</td><td class="mono">@sel.RecipeAddress</td></tr>
                    </tbody>
                </table>
                </div>

                <div class="card-title sub">@L.T("Dv_AlarmConfig")</div>
                @if (sel.Alarms.Count == 0)
                {
                    <div class="no-data">@L.T("Dv_None")</div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="hq-table">
                        <thead>
                            <tr>
                                <th>@L.T("Dv_Name")</th>
                                <th>@L.T("Dv_PlcAddr")</th>
                                <th>@L.T("Ac_Level")</th>
                                <th>@L.T("Dv_Description")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in sel.Alarms)
                            {
                                <tr>
                                    <td>@a.Name</td>
                                    <td class="mono">@a.PlcAddress</td>
                                    <td><span class="lvl-dot @LevelClass(a.Level)"></span>@LevelText(a.Level)</td>
                                    <td class="dim">@a.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }

                <div class="card-title sub">@L.T("Dv_DefectConfig")</div>
                @if (sel.Defects.Count == 0)
                {
                    <div class="no-data">@L.T("Dv_None")</div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="hq-table">
                        <thead>
                            <tr>
                                <th>@L.T("Dv_Name")</th>
                                <th>@L.T("Dv_PlcAddr")</th>
                                <th>@L.T("Dv_Severity")</th>
                                <th>@L.T("Dv_Category")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in sel.Defects)
                            {
                                <tr>
                                    <td>@d.Name</td>
                                    <td class="mono">@d.PlcAddress</td>
                                    <td>@SeverityText(d.Severity)</td>
                                    <td>@CategoryText(d.Category)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }

                <div class="card-title sub">@L.T("Dv_CountAlarmConfig")</div>
                @if (sel.CounterAlarms.Count == 0)
                {
                    <div class="no-data">@L.T("Dv_None")</div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="hq-table">
                        <thead>
                            <tr>
                                <th>@L.T("Dv_Name")</th>
                                <th>@L.T("Dv_PlcAddr")</th>
                                <th>@L.T("Dv_Threshold")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in sel.CounterAlarms)
                            {
                                <tr>
                                    <td>@c.Name</td>
                                    <td class="mono">@c.PlcAddress</td>
                                    <td>@c.MaxValue</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }

                <div class="card-title sub">@L.T("Dv_Sources")</div>
                @if (sel.Sources.Count == 0)
                {
                    <div class="no-data">@L.T("Dv_None")</div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="hq-table">
                        <thead>
                            <tr>
                                <th>@L.T("Dv_Name")</th>
                                <th>@L.T("Dv_SourceType")</th>
                                <th>@L.T("Dv_TriggerAddr")</th>
                                <th>@L.T("Dv_ValueItems")</th>
                                <th>@L.T("Dv_SourceEnabled")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var src in sel.Sources)
                            {
                                <tr>
                                    <td>@src.Name</td>
                                    <td>@src.Type</td>
                                    <td class="mono">@src.TriggerAddress</td>
                                    <td>@src.Values.Count</td>
                                    <td>@(src.Enabled ? L.T("Dv_SourceEnabled") : L.T("Dv_None"))</td>
                                </tr>
                            }
                        </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private System.Threading.Timer? _renderTimer;
    private bool _disposed;
    private List<DeviceConfigDto> DeviceList { get; set; } = [];
    private string? SelectedDeviceId { get; set; }
    private DeviceConfigDto? Selected => DeviceList.FirstOrDefault(d => d.Id == SelectedDeviceId);

    // ──── 加载状态：首次加载中 / 失败 / 真空态三分支，避免拉取失败伪装成"暂无设备" ────
    private bool _firstLoadDone;
    private bool _loadFailed;
    private DateTime _lastLoadAttemptAt = DateTime.MinValue;

    /// <summary>设备配置重拉节流：与 DashboardState 查询连接失败后的 30s 冷却守卫对齐。</summary>
    private static readonly TimeSpan ReloadInterval = TimeSpan.FromSeconds(30);

    protected override async Task OnInitializedAsync()
    {
        await Dashboard.InitializeAsync();
        await LoadDevicesAsync();
        _renderTimer = new System.Threading.Timer(_ => _ = SafeTickAsync(), null, 3000, 3000);
    }

    private async Task LoadDevicesAsync()
    {
        _lastLoadAttemptAt = DateTime.Now;
        try
        {
            DeviceList = [.. await Dashboard.QueryDevicesAsync()];
            _loadFailed = false;
        }
        catch (Exception ex)
        {
            // 失败时保留现有列表（若有）继续展示，仅置失败标记；30s 后 tick 自动重拉
            _loadFailed = true;
            Logger.LogDebug(ex, "拉取设备配置失败（30s 后自动重试，或点击重试按钮）");
        }
        finally
        {
            _firstLoadDone = true;
            if (!_disposed) StateHasChanged(); // fire-and-forget 重拉完成后立即反映结果（dispose 竞态防护：避免渲染队列异常触发全局错误横幅）
        }
    }

    private async Task RetryAsync() => await LoadDevicesAsync();

    private void SelectDevice(string id) => SelectedDeviceId = SelectedDeviceId == id ? null : id;

    private void OnDeviceCardKey(KeyboardEventArgs e, string id)
    {
        if (e.Key is "Enter" or " ")
            SelectDevice(id);
    }

    private void OpenRuntime(string id) => Nav.NavigateTo("/device/" + Uri.EscapeDataString(id));

    /// <summary>
    /// 安全渲染 tick：Timer 回调在组件 Dispose 前后触发时，InvokeAsync 会抛 ObjectDisposedException；
    /// 该 Task 若未观察会成为 unhandledrejection → Blazor 显示全局 error UI（页面功能不受影响但横幅误报）。
    /// 仅吞掉释放竞态（ObjectDisposedException），其余异常记日志——避免真实渲染缺陷被静默吞掉导致页面停更无迹可查。
    /// </summary>
    private async Task SafeTickAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(OnRenderTick);
        }
        catch (ObjectDisposedException)
        {
            // 组件已释放的竞态：忽略（页面生命周期正常结束）
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "设备管理页渲染 tick 异常");
        }
    }

    private void OnRenderTick()
    {
        if (_disposed) return;
        // 设备配置无推送通道：低频重拉（30s 节流）兜底 Collector 侧配置变更；状态徽标仍按 3s 快照刷新
        if (DateTime.Now - _lastLoadAttemptAt >= ReloadInterval)
        {
            _ = LoadDevicesAsync(); // 内部全捕获，不会 fault
        }
        StateHasChanged();
    }

    private string StateText(string deviceId)
    {
        var snap = Dashboard.GetSnapshot(deviceId);
        if (snap is null) return L.T("Status_Offline");
        return snap.Status switch
        {
            DeviceStatus.Running => L.T("Status_Running"),
            DeviceStatus.Alarm => L.T("Status_Alarm"),
            DeviceStatus.Paused => L.T("Status_Paused"),
            _ => L.T(DeviceStatusLocKeys.For(DeviceStatus.Offline, snap.OfflineCause)),
        };
    }

    private string StateClass(string deviceId) => Dashboard.GetSnapshot(deviceId)?.Status switch
    {
        DeviceStatus.Running => "run",
        DeviceStatus.Alarm => "alarm",
        DeviceStatus.Paused => "paused",
        _ => "offline",
    };

    private static string LevelText(AlarmLevel level) => level switch
    {
        AlarmLevel.High => L.T("Ac_LevelHigh"),
        AlarmLevel.Medium => L.T("Ac_LevelMedium"),
        _ => L.T("Ac_LevelLow"),
    };

    private static string LevelClass(AlarmLevel level) => level switch
    {
        AlarmLevel.High => "lvl-high",
        AlarmLevel.Medium => "lvl-medium",
        _ => "lvl-low",
    };

    // 缺陷严重度/类别枚举 → 本地化文本（与首页帕累托 tooltip 同一组键，原直接输出枚举英文名）
    private static string SeverityText(DefectSeverity severity) => severity switch
    {
        DefectSeverity.Critical => L.T("Severity_Critical"),
        DefectSeverity.Major => L.T("Severity_Major"),
        _ => L.T("Severity_Minor"),
    };

    private static string CategoryText(DefectCategory category) => category switch
    {
        DefectCategory.Appearance => L.T("Defect_Appearance"),
        DefectCategory.Dimension => L.T("Defect_Dimension"),
        DefectCategory.Function => L.T("Defect_Function"),
        DefectCategory.Packaging => L.T("Defect_Packaging"),
        _ => L.T("Defect_Other"),
    };

    public void Dispose()
    {
        _disposed = true;
        _renderTimer?.Dispose();
        GC.SuppressFinalize(this);
    }
}
