@page "/review"
@inject DashboardState Dashboard
@inject IJSRuntime JS
@using System.Globalization
@using System.Text
@using Kanban.Analysis
@using Kanban.Contracts.Dtos
@using Kanban.Contracts.Enums
@using Kanban.Web.Services

<div class="query-page">
    <div class="filter-bar">
        <label class="filter-item">
            <span class="filter-label">@L.T("Hq_Device")</span>
            <select class="filter-input" @bind="DeviceId">
                <option value="">@L.T("Hq_AllDevices")</option>
                @foreach (var d in DeviceOptions)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </label>
        <label class="filter-item">
            <span class="filter-label">@L.T("Hq_QuickRange")</span>
            <select class="filter-input" value="@QuickIndex" @onchange="OnQuickChanged">
                <option value="-1">@L.T("Hq_Custom")</option>
                <option value="1">@L.T("Hq_Today")</option>
                <option value="2">@L.T("Hq_Yesterday")</option>
                <option value="3">@L.T("Hq_Last7d")</option>
                <option value="4">@L.T("Hq_Last30d")</option>
            </select>
        </label>
        <label class="filter-item">
            <span class="filter-label">@L.T("Hq_From")</span>
            <input class="filter-input" type="datetime-local" lang="en-GB" value="@FromText" @onchange="OnFromChanged" />
        </label>
        <label class="filter-item">
            <span class="filter-label">@L.T("Hq_To")</span>
            <input class="filter-input" type="datetime-local" lang="en-GB" value="@ToText" @onchange="OnToChanged" />
        </label>
        <div class="filter-actions">
            <button class="btn btn-primary" disabled="@IsLoading" @onclick="SearchAsync">@L.T("Hq_Search")</button>
            <button class="btn" disabled="@IsLoading" @onclick="Reset">@L.T("Hq_Reset")</button>
            <button class="btn" disabled="@IsLoading" @onclick="ExportYesterdayAsync">@L.T("Rv_Daily")</button>
            <button class="btn" disabled="@(Result is null || IsLoading)" @onclick="ExportCsvAsync">@L.T("Rv_Export")</button>
            <button class="btn" disabled="@(Result is null || IsLoading)" @onclick="PrintAsync">@L.T("Rv_Print")</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ValidationMessage))
    {
        <div class="msg-banner msg-error">@ValidationMessage</div>
    }
    @if (!string.IsNullOrEmpty(QueryError))
    {
        <div class="msg-banner msg-error">@QueryError</div>
    }

    @if (IsLoading)
    {
        <div class="loading-row">@L.T("Hq_Analyzing")</div>
    }
    else if (QueryError is not null)
    {
    }
    else if (!HasQueried)
    {
        <EmptyState Title="@L.T("Rv_HintTitle")" Hint="@L.T("Rv_HintBody")" Icon="📊" />
    }
    else if (Result is null)
    {
        <EmptyState Title="@L.T("Hq_NoData")" Hint="@L.T("Hq_NoDataHint")" Icon="📭" />
    }
    else
    {
        @if (Result.Truncated)
        {
            <div class="msg-banner msg-warn">@L.T("Hq_Truncated")</div>
        }
        @* ──── 首屏摘要条 ──── *@
        <div class="review-summary">
            <span class="rs-item" title="@L.Tip("Rv_Tip_Health", Result.HealthScore)"><b>@L.T("Rv_Health")</b> <span class="rs-strong">@Result.HealthScore</span></span>
            <span class="rs-item" title="@ReviewOeeTooltip"><b>OEE</b> <span class="rs-strong">@Pct(Result.Oee)</span></span>
            <span class="rs-item" title="@ReviewQualityTooltip"><b>@L.T("Hq_QualityRate")</b> <span class="rs-strong">@Pct(Result.QualityRate)</span></span>
            <span class="rs-item" title="@ReviewOutputTooltip"><b>@L.T("Lbl_TotalOutput")</b> <span class="rs-strong">@(Result.TotalOk + Result.TotalNg).ToString("N0")</span></span>
            <span class="rs-item" title="@ReviewAlarmTooltip"><b>@L.T("Rv_AlarmCount")</b> <span class="rs-strong rs-alarm">@Result.AlarmTriggered.ToString("N0")</span></span>
            <span class="rs-item"><b>@L.T("Rv_CurrentShift")</b> <span class="rs-strong">@Result.ShiftName</span></span>
        </div>

        @* ──── 健康评分 + 工单/产品/配方 ──── *@
        <section class="card">
            <div class="review-grid3">
                <div>
                    <div class="card-title">@L.T("Rv_Health")</div>
                    <div class="health-score" title="@L.Tip("Rv_Tip_Health", Result.HealthScore)">@Result.HealthScore</div>
                    @foreach (var issue in Result.HealthIssues)
                    {
                        <div class="health-issue">⚠ @issue</div>
                    }
                    @if (Result.HealthIssues.Count == 0)
                    {
                        <div class="health-ok">✓ @L.T("Rv_NoIssues")</div>
                    }
                </div>
                <div>
                    <div class="card-title">@L.T("Rv_WorkOrder")</div>
                    <div class="rv-text">@Result.WorkOrderText</div>
                    <div class="card-title sub" style="margin-top:10px">@L.T("Rv_Product")</div>
                    <div class="rv-text dim">@Result.ProductText</div>
                </div>
                <div>
                    <div class="card-title">@L.T("Rv_Recipe")</div>
                    <div class="rv-text">@Result.RecipeText</div>
                    <div class="card-title sub" style="margin-top:10px">@L.T("Rv_RecipeHint")</div>
                </div>
            </div>
        </section>

        @* ──── 复盘结论 ──── *@
        <section class="card">
            <div class="card-title">@L.T("Rv_Conclusions") <span class="badge-soft">@L.T("Rv_ConclusionsHint")</span></div>
            @if (!string.IsNullOrEmpty(Result.Takeaway))
            {
                <div class="review-takeaway">@Result.Takeaway</div>
            }
            @foreach (var c in Result.Conclusions)
            {
                <div class="conclusion-row">
                    <span class="conclusion-icon @c.Kind">@ConclusionIcon(c.Kind)</span>
                    <span class="conclusion-text">@c.Text</span>
                    @if (c.Met is { } met)
                    {
                        <span class="conclusion-badge @(met ? "met" : "notmet")">@(met ? L.T("Rv_Met") : L.T("Rv_NotMet"))</span>
                    }
                </div>
            }
        </section>

        @* ──── 核心指标 ──── *@
        <section class="kpi-row">
            <div class="kpi-card" title="@ReviewOutputTooltip">
                <span class="kpi-label">@L.T("Lbl_TotalOutput")</span>
                <span class="kpi-value">@(Result.TotalOk + Result.TotalNg).ToString("N0")</span>
                <span class="kpi-sub">@L.T("Lbl_Ok") @Result.TotalOk.ToString("N0") · @L.T("Lbl_Ng") @Result.TotalNg.ToString("N0")</span>
                <span class="kpi-sub dim">@L.T("Rv_OutputAchievement") @Pct(Result.PerformanceRate)</span>
            </div>
            <div class="kpi-card" title="@ReviewAlarmTooltip">
                <span class="kpi-label">@L.T("Rv_AlarmCount")</span>
                <span class="kpi-value kpi-ng">@Result.AlarmTriggered.ToString("N0")</span>
                <span class="kpi-sub">@L.T("Hq_AlarmRecovered") @Result.AlarmRecovered.ToString("N0") · @L.T("Hq_AlarmPending") @Result.AlarmPending.ToString("N0")</span>
            </div>
            <div class="kpi-card" title="@ReviewDowntimeTooltip">
                <span class="kpi-label">@L.T("Rv_LongestDowntime")</span>
                <span class="kpi-value kpi-ng">@Result.LongestDowntimeText</span>
                <span class="kpi-sub">@Result.LongestDowntimeDevice</span>
                <span class="kpi-sub dim">@Result.LongestDowntimeAlarm</span>
            </div>
            <div class="kpi-card" title="@ReviewPeakValleyTooltip">
                <span class="kpi-label">@L.T("Rv_PeakHour") ▲ / @L.T("Rv_ValleyHour") ▼</span>
                <span class="kpi-value">@Result.PeakHour / @Result.ValleyHour</span>
                <span class="kpi-sub kpi-ok">@L.T("Rv_PeakValleyOk", Result.PeakOk.ToString("N0"), Result.PeakShare)</span>
                <span class="kpi-sub kpi-ng">@L.T("Rv_PeakValleyOk", Result.ValleyOk.ToString("N0"), Result.ValleyShare)</span>
            </div>
        </section>

        @* ──── 周期对比 ──── *@
        <section class="card">
            <div class="card-title">@L.T("Rv_Comparison") <span class="badge-soft">@L.T("Rv_ComparisonHint")</span></div>
            <div class="kpi-row">
                <div class="kpi-card" title="@ReviewOutputTooltip"><span class="kpi-label">@L.T("Rv_CurrentOutput")</span><span class="kpi-value">@(Result.TotalOk + Result.TotalNg).ToString("N0")</span><span class="kpi-sub dim">@L.T("Rv_BaselineOutput") @Result.BaselineOutput.ToString("N0")</span></div>
                <div class="kpi-card" title="@ReviewQualityTooltip"><span class="kpi-label">@L.T("Hq_QualityRate")</span><span class="kpi-value">@Pct(Result.QualityRate)</span><span class="kpi-sub dim">@L.T("Rv_BaselineQuality") @Pct(Result.BaselineQuality)</span></div>
                <div class="kpi-card" title="@ReviewOeeTooltip"><span class="kpi-label">OEE</span><span class="kpi-value">@Pct(Result.Oee)</span><span class="kpi-sub dim">@L.T("Rv_BaselineOee") @Pct(Result.BaselineOee)</span></div>
            </div>
        </section>

        @* ──── 产量趋势 + 报警排行 ──── *@
        <div class="chart-grid two">
            <section class="card">
                <div class="card-title">@L.T("Rv_Trend") <span class="badge-soft">15 min</span></div>
                @if (Result.ChartData.Count > 0)
                {
                    <EChart Option="@Result.TrendOption" Height="300px" />
                }
                else
                {
                    <div class="no-data">@L.T("Val_WaitData")</div>
                }
            </section>
            <section class="card">
                <div class="card-title">@L.T("Rv_AlarmRank")</div>
                @if (Result.Alarms.Count > 0)
                {
                    <EChart Option="@Result.AlarmOption" Height="300px" />
                }
                else
                {
                    <div class="no-data">@L.T("Val_NoAlarms")</div>
                }
            </section>
        </div>

        @* ──── 状态时间线 ──── *@
        <section class="card">
            <div class="card-title">@L.T("Rv_Timeline") <span class="badge-soft">@L.T("Rv_TimelineHint")</span></div>
            @if (Result.Timeline.Count > 0)
            {
                <EChart Option="@Result.TimelineOption" Height="220px" />
            }
            else
            {
                <div class="no-data">@L.T("Val_WaitData")</div>
            }
        </section>

        @* ──── 班次明细 ──── *@
        <section class="card">
            <div class="card-title">@L.T("Rv_ShiftDetails")</div>
            <div class="table-scroll">
                <table class="hq-table">
                <thead>
                    <tr>
                        <th>@L.T("Hq_Shift")</th>
                        <th class="num">@L.T("Hq_OkCol")</th>
                        <th class="num">@L.T("Hq_NgCol")</th>
                        <th class="num">@L.T("Rv_AlarmCol")</th>
                        <th class="num">@L.T("Hq_QualityRate")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Result.Shifts)
                    {
                        var total = s.OkCount + s.NgCount;
                        <tr>
                            <td>@s.ShiftName</td>
                            <td class="num kpi-ok">@s.OkCount.ToString("N0")</td>
                            <td class="num kpi-ng">@s.NgCount.ToString("N0")</td>
                            <td class="num">@s.AlarmCount</td>
                            <td class="num">@(total > 0 ? $"{(double)s.OkCount / total:P1}" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </section>

        @* ──── 缺陷集中度 ──── *@
        <section class="card">
            <div class="card-title">@L.T("Rv_Defects")</div>
            @if (Result.Defects.Count == 0)
            {
                <div class="no-data">@L.T("Rv_DefectEmpty")</div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="hq-table">
                    <thead>
                        <tr>
                            <th>@L.T("Rv_DefectName")</th>
                            <th>@L.T("Hq_Shift")</th>
                            <th>@L.T("Rv_DefectHour")</th>
                            <th class="num">@L.T("Ac_Count")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Result.Defects)
                        {
                            <tr>
                                <td>@d.DefectName</td>
                                <td>@d.ShiftName</td>
                                <td>@d.TimeRangeText</td>
                                <td class="num kpi-ng">@d.Count.ToString("N0")</td>
                                <td>
                                    <div class="time-bar">
                                        <div class="seg alarm" style="width:@(Math.Clamp(d.Share, 0, 1) * 100)%"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@code {
    private const string TimeFormat = "yyyy-MM-ddTHH:mm";
    private const int DefaultQuickIndex = 3; // 近 7 天

    private List<(string Id, string Name)> DeviceOptions { get; set; } = [];
    private List<DeviceConfigDto> _deviceConfigs = [];
    private string DeviceId { get; set; } = "";
    private int QuickIndex { get; set; } = DefaultQuickIndex;
    private string FromText { get; set; } = "";
    private string ToText { get; set; } = "";

    private bool HasQueried { get; set; }
    private bool IsLoading { get; set; }
    private string? ValidationMessage { get; set; }
    private string? QueryError { get; set; }
    private ReviewResult? Result { get; set; }
    private DateTime _reviewFrom;
    private DateTime _reviewTo;
    private bool _exportDailyAfterSearch;

    private sealed class ReviewResult
    {
        public int TotalOk, TotalNg, AlarmTriggered, AlarmRecovered, AlarmPending;
        public double QualityRate, PerformanceRate, AvailabilityRate, Oee, PeakShare, ValleyShare;
        public string LongestDowntimeText = "—", LongestDowntimeDevice = "", LongestDowntimeAlarm = "";
        public string PeakHour = "—", ValleyHour = "—";
        public int PeakOk, ValleyOk;
        public int HealthScore;
        public List<string> HealthIssues = [];
        public List<ReviewAnalysis.ReviewConclusion> Conclusions = [];
        public List<ReviewAlarmItemDto> Alarms = [];
        public List<ReviewTimelineSegmentDto> Timeline = [];
        public List<ReviewDefectRowDto> Defects = [];
        public List<ReviewShiftRowDto> Shifts = [];
        public int BaselineOutput;
        public double BaselineQuality, BaselineOee;
        public string WorkOrderText = "—", ProductText = "—", RecipeText = "—";
        public string ShiftName = "—";
        public string Takeaway = "";
        public List<(DateTime Time, int Ok, int Ng)> ChartData = [];
        public object? TrendOption, AlarmOption, TimelineOption;
        public bool Truncated;
    }

    protected override async Task OnInitializedAsync()
    {
        ApplyQuickRange(QuickIndex);
        await Dashboard.InitializeAsync();
        await LoadDevicesAsync();
    }

    private async Task LoadDevicesAsync()
    {
        if (Dashboard.Snapshots.Count > 0)
            DeviceOptions = Dashboard.Snapshots.Select(s => (s.DeviceId, s.DeviceName)).ToList();
        try
        {
            _deviceConfigs = [.. await Dashboard.QueryDevicesAsync()];
            if (DeviceOptions.Count == 0)
                DeviceOptions = _deviceConfigs.Select(d => (d.Id, d.Name)).ToList();
        }
        catch (Exception)
        {
        }
    }

    private void OnQuickChanged(ChangeEventArgs e)
    {
        QuickIndex = int.TryParse(e.Value?.ToString(), out var v) ? v : -1;
        if (QuickIndex > 0) ApplyQuickRange(QuickIndex);
    }

    private void OnFromChanged(ChangeEventArgs e) => FromText = e.Value?.ToString() ?? "";
    private void OnToChanged(ChangeEventArgs e) => ToText = e.Value?.ToString() ?? "";

    private void ApplyQuickRange(int index)
    {
        // 快捷窗口以工厂墙钟为准（浏览器时区可能与工厂不同）
        var now = Dashboard.ServerNow;
        (FromText, ToText) = index switch
        {
            1 => (now.Date.ToString(TimeFormat), now.ToString(TimeFormat)),
            2 => (now.Date.AddDays(-1).ToString(TimeFormat), now.Date.AddSeconds(-1).ToString(TimeFormat)),
            3 => (now.Date.AddDays(-7).ToString(TimeFormat), now.ToString(TimeFormat)),
            4 => (now.Date.AddDays(-30).ToString(TimeFormat), now.ToString(TimeFormat)),
            _ => (FromText, ToText),
        };
    }

    private async Task SearchAsync()
    {
        ValidationMessage = null;
        QueryError = null;
        if (!DateTime.TryParseExact(FromText, TimeFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var from)
            || !DateTime.TryParseExact(ToText, TimeFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var to)
            || from > to)
        {
            ValidationMessage = L.T("Hq_ValidationRange");
            _exportDailyAfterSearch = false;
            return;
        }
        if (string.IsNullOrEmpty(DeviceId))
        {
            ValidationMessage = L.T("Hq_NeedDevice");
            _exportDailyAfterSearch = false;
            return;
        }
        await RunReviewAsync(from, to);
    }

    private void Reset()
    {
        ValidationMessage = null;
        QueryError = null;
        HasQueried = false;
        Result = null;
        QuickIndex = DefaultQuickIndex;
        ApplyQuickRange(QuickIndex);
    }

    /// <summary>
    /// 复盘主流程：窗口/基准/对比周期数据并行拉取 → 分析装配 → 图表构建。
    /// 对比周期 = 窗口前同长度区间（WPF 上一周期口径）。
    /// </summary>
    private async Task RunReviewAsync(DateTime from, DateTime to)
    {
        IsLoading = true;
        QueryError = null;
        Result = null;
        try
        {
            var deviceId = DeviceId;
            var device = _deviceConfigs.FirstOrDefault(d => d.Id == deviceId);
            var dto = await HistoryFetch.AnalyzeReviewWindowAsync(Dashboard, from, to, deviceId, null);

            var r = new ReviewResult
            {
                Truncated = dto.Truncated,
            };

            var ok = dto.Ok;
            var ng = dto.Ng;
            r.TotalOk = ok;
            r.TotalNg = ng;
            r.QualityRate = dto.QualityRate;
            var targetCycle = device?.TargetCycle ?? 0;
            r.PerformanceRate = OeeCalculator.CalculatePerformanceRate(ok, ng, targetCycle, dto.RunSeconds);
            r.AvailabilityRate = OeeCalculator.CalculateAvailabilityRate(dto.RunSeconds, dto.AlarmSeconds);
            r.Oee = OeeCalculator.CalculateOee(r.QualityRate, r.PerformanceRate, r.AvailabilityRate);

            r.AlarmTriggered = dto.AlarmTriggered;
            r.AlarmRecovered = dto.AlarmRecovered;
            r.AlarmPending = dto.AlarmPending;
            r.Alarms = dto.Alarms.ToList();
            r.LongestDowntimeText = dto.LongestAlarmHours > 0 ? $"{dto.LongestAlarmHours:F1} h" : "—";
            if (dto.LongestAlarmHours > 0)
            {
                r.LongestDowntimeDevice = device?.Name ?? deviceId;
                r.LongestDowntimeAlarm = dto.LongestAlarmName;
            }

            r.PeakHour = dto.PeakHour;
            r.PeakOk = dto.PeakOk;
            r.ValleyHour = dto.ValleyHour;
            r.ValleyOk = dto.ValleyOk;
            r.PeakShare = ok > 0 ? (double)dto.PeakOk / ok : 0;
            r.ValleyShare = ok > 0 ? (double)dto.ValleyOk / ok : 0;
            r.ChartData = dto.ChartPoints.Count > 0
                ? dto.ChartPoints.Select(p => (p.Time, p.Ok, p.Ng)).ToList()
                : [];

            r.Timeline = dto.Timeline.ToList();
            r.Defects = dto.Defects.ToList();
            r.Shifts = dto.Shifts.ToList();
            r.ShiftName = r.Shifts.FirstOrDefault()?.ShiftName ?? "—";

            r.BaselineOutput = dto.BaselineOutput;
            r.BaselineQuality = dto.BaselineQuality;
            var baselineOk = dto.BaselineOutput == 0
                ? 0
                : (int)Math.Round(dto.BaselineOutput * dto.BaselineQuality);
            var baselineNg = Math.Max(0, dto.BaselineOutput - baselineOk);
            r.BaselineOee = OeeCalculator.CalculateOee(
                dto.BaselineQuality,
                OeeCalculator.CalculatePerformanceRate(baselineOk, baselineNg, targetCycle, dto.BaselineRunSeconds),
                OeeCalculator.CalculateAvailabilityRate(dto.BaselineRunSeconds, dto.BaselineAlarmSeconds));

            (r.HealthIssues, r.HealthScore) = ReviewAnalysis.CalculateHealth(
                targetCycle, dto.Ok + dto.Ng, dto.AlarmTriggered, r.Timeline, r.Defects,
                dto.PreviousAlarmTriggered, dto.PreviousDefectCount, from, to, L.T);
            r.Conclusions = ReviewAnalysis.BuildConclusions(
                ok, ng, r.AlarmTriggered, dto.LongestAlarmHours, r.LongestDowntimeDevice, dto.LongestAlarmName,
                r.Shifts, r.Defects, r.QualityRate, r.Oee, L.T);

            // ── 工单/产品/配方 ──
            var wo = Dashboard.GetWorkOrder(deviceId);
            r.WorkOrderText = wo is null ? "—" : $"{wo.OrderNo} · {L.T("Meta_PlanWo", wo.TargetQuantity.ToString("N0"))}";
            r.ProductText = wo is null ? "—" : $"{wo.ProductCode} · {wo.ProductName}";
            r.RecipeText = string.IsNullOrWhiteSpace(device?.RecipeName) ? "—" : $"{device.RecipeName} · {device.RecipeValue:N0}";
            var metText = r.Oee >= ReviewAnalysis.OeeTarget ? L.T("Rv_Met") : L.T("Rv_NotMet");
            r.Takeaway = L.T("Rv_Takeaway", r.HealthScore, metText, r.LongestDowntimeText,
                string.IsNullOrEmpty(r.LongestDowntimeDevice) ? "—" : r.LongestDowntimeDevice);

            BuildCharts(r);
            _reviewFrom = from;
            _reviewTo = to;
            Result = r;
            HasQueried = true;
            if (_exportDailyAfterSearch)
            {
                _exportDailyAfterSearch = false;
                await ExportCsvAsync(daily: true);
            }
        }
        catch (Exception)
        {
            QueryError = L.T("Hq_QueryFailed");
            HasQueried = true;
            _exportDailyAfterSearch = false;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void BuildCharts(ReviewResult r)
    {
        // 产量趋势（15 分钟堆叠柱，与历史查询页同构）
        if (r.ChartData.Count > 0)
        {
            r.TrendOption = new Dictionary<string, object?>
            {
                ["backgroundColor"] = "transparent",
                ["tooltip"] = Tooltip(),
                ["legend"] = Legend([L.T("Hq_ChartOk"), L.T("Hq_ChartNg")]),
                ["grid"] = new Dictionary<string, object?> { ["left"] = 52, ["right"] = 16, ["top"] = 36, ["bottom"] = 28 },
                ["xAxis"] = new Dictionary<string, object?>
                {
                    ["type"] = "category",
                    ["data"] = r.ChartData.Select(d => d.Time.ToString("MM-dd HH:mm")).ToList(),
                    ["axisLabel"] = AxisLabel(),
                    ["axisLine"] = AxisLine(),
                },
                ["yAxis"] = ValueAxis(),
                ["series"] = new object[]
                {
                    new Dictionary<string, object?> { ["name"] = L.T("Hq_ChartOk"), ["type"] = "bar", ["stack"] = "t", ["data"] = r.ChartData.Select(d => d.Ok).ToList(), ["itemStyle"] = new Dictionary<string, object?> { ["color"] = "#34D399" } },
                    new Dictionary<string, object?> { ["name"] = L.T("Hq_ChartNg"), ["type"] = "bar", ["stack"] = "t", ["data"] = r.ChartData.Select(d => d.Ng).ToList(), ["itemStyle"] = new Dictionary<string, object?> { ["color"] = "#F87171" } },
                },
            };
        }

        // 报警排行（触发次数降序）
        if (r.Alarms.Count > 0)
        {
            r.AlarmOption = new Dictionary<string, object?>
            {
                ["backgroundColor"] = "transparent",
                ["tooltip"] = Tooltip(),
                ["grid"] = new Dictionary<string, object?> { ["left"] = 48, ["right"] = 16, ["top"] = 24, ["bottom"] = 28 },
                ["xAxis"] = new Dictionary<string, object?>
                {
                    ["type"] = "category",
                    ["data"] = r.Alarms.Select(a => a.AlarmName).ToList(),
                    ["axisLabel"] = AxisLabel(),
                    ["axisLine"] = AxisLine(),
                },
                ["yAxis"] = ValueAxis(),
                ["series"] = new object[]
                {
                    new Dictionary<string, object?> { ["name"] = L.T("Rv_AlarmCol"), ["type"] = "bar", ["data"] = r.Alarms.Select(a => a.TriggerCount).ToList(), ["itemStyle"] = new Dictionary<string, object?> { ["color"] = "#F87171" } },
                },
            };
        }

        // 状态时间线（4 状态行：运行/报警/待机/离线；custom series 区间矩形——
        // bar 系列不支持 [起点,时长] 数据（旧实现整图空白），'__gantt' 标记由 echartsInterop.js 解析）
        if (r.Timeline.Count > 0)
        {
            var stateNames = new[] { L.T("Status_Running"), L.T("Status_Alarm"), L.T("Status_Paused"), L.T("Status_Offline") };
            // 行序按 DeviceStatus 枚举值：Running=1→行0 … Offline=0→行3
            var rowOf = new[] { 3, 0, 1, 2 };
            var stateColors = new[] { UiPalette.Run, UiPalette.Alarm, UiPalette.Pause, UiPalette.Offline };

            var data = new List<Dictionary<string, object?>>();
            foreach (var s in r.Timeline)
            {
                if (s.StatusWord < 0 || s.StatusWord > 3) continue;
                var startMs = new DateTimeOffset(s.Start).ToUnixTimeMilliseconds();
                var endMs = new DateTimeOffset(s.End).ToUnixTimeMilliseconds();
                if (endMs <= startMs) continue;
                var row = rowOf[s.StatusWord];
                data.Add(new Dictionary<string, object?>
                {
                    ["value"] = new object[] { startMs, endMs, row },
                    ["itemStyle"] = new Dictionary<string, object?> { ["color"] = stateColors[row] },
                });
            }
            r.TimelineOption = new Dictionary<string, object?>
            {
                ["backgroundColor"] = "transparent",
                ["__ganttStateNames"] = stateNames,
                ["tooltip"] = new Dictionary<string, object?>
                {
                    ["trigger"] = "item",
                    ["formatter"] = "__ganttTooltip",
                    ["backgroundColor"] = "#212834",
                    ["borderColor"] = "#2A323F",
                    ["textStyle"] = new Dictionary<string, object?> { ["color"] = "#E5E7EB" },
                },
                ["grid"] = new Dictionary<string, object?> { ["left"] = 16, ["right"] = 24, ["top"] = 16, ["bottom"] = 28 },
                ["xAxis"] = new Dictionary<string, object?> { ["type"] = "time", ["axisLabel"] = AxisLabel(), ["axisLine"] = AxisLine() },
                ["yAxis"] = new Dictionary<string, object?>
                {
                    ["type"] = "category",
                    ["data"] = stateNames,
                    ["axisLabel"] = new Dictionary<string, object?> { ["color"] = "#9CA3AF" },
                    ["splitLine"] = new Dictionary<string, object?> { ["lineStyle"] = new Dictionary<string, object?> { ["color"] = "#212834" } },
                },
                ["series"] = new object[]
                {
                    new Dictionary<string, object?>
                    {
                        ["type"] = "custom",
                        ["renderItem"] = "__gantt",
                        ["data"] = data,
                    },
                },
            };
        }
    }

