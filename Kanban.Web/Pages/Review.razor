    private Task ExportCsvAsync() => ExportCsvAsync(daily: false);

    private async Task ExportCsvAsync(bool daily)
    {
        if (Result is null)
            return;
        var sb = new StringBuilder();
        sb.AppendLine(C(Result.Takeaway));
        sb.AppendLine(L.T("Csv_SumRange", _reviewFrom, _reviewTo));
        sb.AppendLine($"{C(L.T("Rv_Health"))},{Result.HealthScore}");
        sb.AppendLine($"OEE,{Pct(Result.Oee)}");
        sb.AppendLine($"{C(L.T("Hq_QualityRate"))},{Pct(Result.QualityRate)}");
        sb.AppendLine($"{C(L.T("Lbl_TotalOutput"))},{Result.TotalOk + Result.TotalNg}");
        sb.AppendLine($"{C(L.T("Lbl_Ok"))},{Result.TotalOk}");
        sb.AppendLine($"{C(L.T("Lbl_Ng"))},{Result.TotalNg}");
        sb.AppendLine($"{C(L.T("Rv_AlarmCount"))},{Result.AlarmTriggered}");
        sb.AppendLine($"{C(L.T("Rv_LongestDowntime"))},{C(Result.LongestDowntimeText)},{C(Result.LongestDowntimeDevice)},{C(Result.LongestDowntimeAlarm)}");
        foreach (var issue in Result.HealthIssues)
            sb.AppendLine($"{C(L.T("Rv_Health"))},{C(issue)}");
        foreach (var c in Result.Conclusions)
            sb.AppendLine($"{C(L.T("Rv_Conclusions"))},{C(c.Text)}");
        sb.AppendLine(string.Join(',', C(L.T("Hq_Shift")), C(L.T("Hq_OkCol")), C(L.T("Hq_NgCol")), C(L.T("Rv_AlarmCol")), C(L.T("Hq_QualityRate"))));
        foreach (var s in Result.Shifts)
        {
            var total = s.OkCount + s.NgCount;
            sb.AppendLine(string.Join(',',
                C(s.ShiftName), s.OkCount.ToString(), s.NgCount.ToString(), s.AlarmCount.ToString(),
                total > 0 ? $"{(double)s.OkCount / total:P1}" : "—"));
        }

        var fileName = daily
            ? L.T("Rv_DailyCsvFile", _reviewFrom.Date)
            : L.T("Rv_CsvFile", _reviewFrom, _reviewTo);
        await JS.InvokeVoidAsync("KanbanECharts.download", fileName, "\uFEFF" + sb, "text/csv;charset=utf-8");
    }

