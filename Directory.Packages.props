<Project>
  <!--
    Central Package Management (CPM)
    所有项目的 NuGet 包版本在此统一声明，csproj 中 <PackageReference> 不再指定 Version 属性。
    升级包版本只需修改本文件一处。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ============ MainAPP ============ -->
  <ItemGroup>
    <PackageVersion Include="AutoMapper" Version="14.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="HandyControl" Version="3.5.1" />
    <PackageVersion Include="Material.Icons.WPF" Version="3.0.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- NodaTime 3.3.3：当前最新稳定版（4.x 尚未发布） -->
    <PackageVersion Include="NodaTime" Version="3.3.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageVersion Include="OxyPlot.Core" Version="2.2.0" />
    <PackageVersion Include="OxyPlot.SkiaSharp" Version="2.2.0" />
    <PackageVersion Include="PdfSharpCore" Version="1.3.67" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="System.IO.Ports" Version="9.0.0" />
    <PackageVersion Include="System.Management" Version="9.0.5" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <!-- SignalR：Collector 服务端（框架内）与 MainAPP 客户端（包）共用 -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.10" />
  </ItemGroup>

  <!-- ============ 测试 ============ -->
  <ItemGroup>
    <!-- xunit.v3.mtp-v2：使用 Microsoft.Testing.Platform v2，支持 MTP 原生扩展。 -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <!-- coverlet.MTP：覆盖率扩展，替代仅支持 VSTest 的 coverlet.collector。 -->
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.10" />
    <PackageVersion Include="Appium.WebDriver" Version="5.0.0" />
    <!-- Mock 库：用于解耦测试 WorkOrderService/LicenseGate 等业务服务对具体 Repository/Store 的依赖 -->
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

  <!-- ============ 基准测试 ============ -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- ============ 混淆工具（仅 LicenseManager.App Release 构建用） ============ -->
  <ItemGroup>
    <PackageVersion Include="Obfuscar" Version="2.2.50" />
  </ItemGroup>
</Project>
